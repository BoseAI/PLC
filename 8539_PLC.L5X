<Line Number="33">
<![CDATA[xStatusWord_IncorrectTargetValue 			:= i_iStatus_Word.12;]]>
</Line>
<Line Number="34">
<![CDATA[xStatusWord_MotorPowerWasMissing 			:= i_iStatus_Word.13;]]>
</Line>
<Line Number="35">
<![CDATA[xStatusWord_PositiveRangeLimit 				:= i_iStatus_Word.14;]]>
