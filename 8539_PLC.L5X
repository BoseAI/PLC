<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[v0.1        : Initial creation
Author      : Ing.Utili Nicola
Comment: Note software
Last Change : 02.10.2020]]>
</Comment>
<Text>
<![CDATA[XIC(BB.FirstScan)FLL(0,OM_MechanicalAdjustment,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Config,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(MechanicalAdjustment,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(TeachPosition,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(Network_Anybus,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="MechanicalAdjustment" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
TARGET POS
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(SizeWork.Fiama.MechanicalAdjustment_Adr1,OM_MechanicalAdjustment.aCOMM[1].IN_diNewTarget);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(SizeWork.Fiama.MechanicalAdjustment_Adr2,OM_MechanicalAdjustment.aCOMM[2].IN_diNewTarget);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(SizeWork.Fiama.MechanicalAdjustment_Adr3,OM_MechanicalAdjustment.aCOMM[3].IN_diNewTarget);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[///////////////////////////////////////////////////////////////////////////////////////
ACTUAL POS
////////////////////////////////////////////////////////////////////////////////////////

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[MOVE(OM_MechanicalAdjustment.aCOMM[1].OUT_diActualPos,OM_MechanicalAdjustment_HMI_PB.St_iActualPosition_Adr01);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[MOVE(OM_MechanicalAdjustment.aCOMM[2].OUT_diActualPos,OM_MechanicalAdjustment_HMI_PB.St_iActualPosition_Adr02);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[MOVE(OM_MechanicalAdjustment.aCOMM[3].OUT_diActualPos,OM_MechanicalAdjustment_HMI_PB.St_iActualPosition_Adr03);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[///////////////////////////////////////////////////////////////////////////////////////
VALUE OUT OF RANGE
////////////////////////////////////////////////////////////////////////////////////////

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[OTU(OM_Interface.xMechanicalAdjustmentNotInRange);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[------- Reg 1 Out of range ------- ]]>
</Comment>
<Text>
<![CDATA[XIC(OM_MechanicalAdjustment_HMI_PB.St_xEnable)XIO(BB.Automatic_CycleActive)XIC(OM_MechanicalAdjustment.aCOMM[1].OUT_xOutOfRange)XIC(OM_MechanicalAdjustment.aCOMM[1].IN_xNodeEnabled)[OTL(MSG[125]) ,OTL(OM_Interface.xMechanicalAdjustmentNotInRange) ,OTL(BB.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[------- Reg 2 Out of range ------- ]]>
</Comment>
<Text>
<![CDATA[XIC(OM_MechanicalAdjustment_HMI_PB.St_xEnable)XIO(BB.Automatic_CycleActive)XIC(OM_MechanicalAdjustment.aCOMM[2].OUT_xOutOfRange)XIC(OM_MechanicalAdjustment.aCOMM[2].IN_xNodeEnabled)[OTL(MSG[126]) ,OTL(OM_Interface.xMechanicalAdjustmentNotInRange) ,OTL(BB.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[------- Reg 3 Out of range ------- ]]>
</Comment>
<Text>
<![CDATA[XIC(OM_MechanicalAdjustment_HMI_PB.St_xEnable)XIO(BB.Automatic_CycleActive)XIC(OM_MechanicalAdjustment.aCOMM[3].OUT_xOutOfRange)XIC(OM_MechanicalAdjustment.aCOMM[3].IN_xNodeEnabled)[OTL(MSG[127]) ,OTL(OM_Interface.xMechanicalAdjustmentNotInRange) ,OTL(BB.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[///////////////////////////////////////////////////////////////////////////////////////
ALRM NODE FIAMA
////////////////////////////////////////////////////////////////////////////////////////

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[------- Reg 1 Out of range ------- ]]>
</Comment>
<Text>
<![CDATA[XIC(OM_MechanicalAdjustment_HMI_PB.St_xEnable)XIO(BB.Automatic_CycleActive)XIC(OM_MechanicalAdjustment.aCOMM[1].OUT_xNodeFaulted)XIC(OM_MechanicalAdjustment.aCOMM[1].IN_xNodeEnabled)[TON(L_TON_001,?,?) ,XIC(L_TON_001.DN) OTE(ALRM[428]) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[------- Reg 2 Out of range ------- ]]>
</Comment>
<Text>
<![CDATA[XIC(OM_MechanicalAdjustment_HMI_PB.St_xEnable)XIO(BB.Automatic_CycleActive)XIC(OM_MechanicalAdjustment.aCOMM[2].OUT_xNodeFaulted)XIC(OM_MechanicalAdjustment.aCOMM[2].IN_xNodeEnabled)[TON(L_TON_002,?,?) ,XIC(L_TON_002.DN) OTE(ALRM[429]) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[------- Reg 3 Out of range ------- ]]>
</Comment>
<Text>
<![CDATA[XIC(OM_MechanicalAdjustment_HMI_PB.St_xEnable)XIO(BB.Automatic_CycleActive)XIC(OM_MechanicalAdjustment.aCOMM[3].OUT_xNodeFaulted)XIC(OM_MechanicalAdjustment.aCOMM[3].IN_xNodeEnabled)[TON(L_TON_003,?,?) ,XIC(L_TON_003.DN) OTE(ALRM[430]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Network_Anybus" Type="RLL">
<RLLContent>
<Rung Number="0" Type="er">
<Text>
<![CDATA[[XIC(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) XIC(BB.Automatic_CycleActive) [OTL(MSG[12]) ,OTU(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) ] ,XIC(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) XIO(OM_MechanicalAdjustment_HMI_PB.St_xEnable) [OTL(OM_MechanicalAdjustment_HMI_PB.St_xEnable) ,OTU(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) ] ,XIC(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) XIC(OM_MechanicalAdjustment_HMI_PB.St_xEnable) [OTU(OM_MechanicalAdjustment_HMI_PB.St_xEnable) ,OTU(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="rN">
<Text>
<![CDATA[[XIC(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) XIC(BB.Automatic_CycleActive) [OTL(MSG[12]) ,OTU(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) ] ,XIC(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) XIO(OM_MechanicalAdjustment_HMI_PB.St_xEnable) [OTL(OM_MechanicalAdjustment_HMI_PB.St_xEnable) ,OTU(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) ] ,XIC(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) XIC(OM_MechanicalAdjustment_HMI_PB.St_xEnable) [OTU(OM_MechanicalAdjustment_HMI_PB.St_xEnable) ,OTU(OM_MechanicalAdjustment_HMI_PB.Rq_xEnable) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB.Automatic_CycleActive)XIO(OM_MechanicalAdjustment_HMI_PB.St_xEnable)OTL(WRNG[56]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(IN.T0130_02_24V)NetworkSmall_Anybus(DB_NetworkSmall_Anybus,OM_MechanicalAdjustment.aCOMM,K0400_01_AnyBus:O,K0400_01_AnyBus:I,OM_MechanicalAdjustment_HMI_PB.St_xEnable,SYS.N[340],10,4,4,4);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(DB_NetworkSmall_Anybus.q_xAnybusFaulted)OTE(ALRM[448]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="TeachPosition" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NE(OM_MechanicalAdjustment_HMI_PB.Rq_iTeachPosition,0)[MOVE(OM_MechanicalAdjustment_HMI_PB.Rq_iTeachPosition,OM_MechanicalAdjustment_HMI_PB.St_iTeachPosition) ,MOVE(0,OM_MechanicalAdjustment_HMI_PB.Rq_iTeachPosition) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQ(OM_MechanicalAdjustment_HMI_PB.St_iTeachPosition,1)MOVE(OM_MechanicalAdjustment_HMI_PB.St_iActualPosition_Adr01,SizeWork.Fiama.MechanicalAdjustment_Adr1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQ(OM_MechanicalAdjustment_HMI_PB.St_iTeachPosition,2)MOVE(OM_MechanicalAdjustment_HMI_PB.St_iActualPosition_Adr02,SizeWork.Fiama.MechanicalAdjustment_Adr2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQ(OM_MechanicalAdjustment_HMI_PB.St_iTeachPosition,3)MOVE(OM_MechanicalAdjustment_HMI_PB.St_iActualPosition_Adr03,SizeWork.Fiama.MechanicalAdjustment_Adr3);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Reset St]]>
</Comment>
<Text>
<![CDATA[NE(OM_MechanicalAdjustment_HMI_PB.St_iTeachPosition,0)MOVE(0,OM_MechanicalAdjustment_HMI_PB.St_iTeachPosition);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
