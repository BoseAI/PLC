<Routine Name="Axis_Management" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(MAM1_REAL.EN)MAM(M2600_01_Hopper,MAM1_REAL,0,ALPHA,100000000,Units per sec,100000000,Units per sec2,100000000,Units per sec2,Trapezoidal,1000000,1000000,Units per sec3,Disabled,Programmed,0,None,0,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Calculation_Direct" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[OFFSET := (SYS.N[215] / 20.0);]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[(*********************************************************************)]]>
</Line>
<Line Number="4">
<![CDATA[(************************** FORMULE DIRETTE **************************)]]>
</Line>
<Line Number="5">
<![CDATA[(*********************************************************************)]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[REAL_DEGREE_POSITION := RAD(M2600_01_Hopper.ActualPosition);]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[add2	:= (L * SIN(REAL_DEGREE_POSITION));]]>
</Line>
<Line Number="10">
<![CDATA[X		:= (add2 + OFFSET);]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[MRP(Mv_Hopper	//Axis]]>
</Line>
<Line Number="13">
<![CDATA[	,MRP1_X		//Motion Control]]>
</Line>
<Line Number="14">
<![CDATA[	,Absolute	//Type]]>
</Line>
<Line Number="15">
<![CDATA[	,Command	//Position Select]]>
</Line>
<Line Number="16">
<![CDATA[	,X);		//Position]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Calculation_Inverse" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[(*********************************************************************)]]>
</Line>
<Line Number="2">
<![CDATA[(************************** FORMULE INVERSE **************************)]]>
</Line>
<Line Number="3">
<![CDATA[(*********************************************************************)]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[DELTA	:= ((Mv_Hopper.ActualPosition - OFFSET) / L);]]>
</Line>
<Line Number="6">
<![CDATA[ALPHA 	:= DEG(ASIN(DELTA));]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[IF xEnableInverse]]>
</Line>
<Line Number="9">
<![CDATA[THEN]]>
</Line>
<Line Number="10">
<![CDATA[	JSR(Axis_Management);]]>
</Line>
<Line Number="11">
<![CDATA[END_IF;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Run" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(M2600_01_Hopper.AxisHomedStatus)EQ(M2600_01_Hopper.AxisFault,0)XIC(M2600_01_Hopper.DriveEnableStatus)XIC(M2600_01_Hopper.ServoActionStatus)OTE(xEnableInverse)JSR(Calculation_Inverse,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(M2600_01_Hopper.AxisHomedStatus)XIO(M2600_01_Hopper.DriveEnableStatus)XIO(M2600_01_Hopper.ServoActionStatus)JSR(Calculation_Direct,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[DIV(SYS.N[215],20,L_rHomePos)DIV(L_rHomePos,L,L_rHomePos)ASIN(L_rHomePos,L_rHomePos)DEG(L_rHomePos,L_rHomePos)MUL(L_rHomePos,10.0,OM_Interface.CaseF_iRoboticHopperHomeDegreePosition);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[DIV(SYS.N[219],10,L_rTargetHomePos)SUB(L_rTargetHomePos,OFFSET,L_rTargetHomePos)DIV(L_rTargetHomePos,L,L_rTargetHomePos)ASIN(L_rTargetHomePos,L_rTargetHomePos)DEG(L_rTargetHomePos,OM_Interface.CaseF_iRoboticHopperHomeTargetDegPos);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
