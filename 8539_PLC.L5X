<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(IO_Axis.ModuleConnFault)JMP(NoConn);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(IO_Axis.DriveEnableStatus)XIC(IO_Axis.ServoActionStatus)OTL(O_xAxisEnable);]]>
</Text>
