<Line Number="210">
<![CDATA[]]>
</Line>
<Line Number="211">
<![CDATA[///////////////////////////////]]>
</Line>
<Line Number="212">
<![CDATA[//       SAFETY INPUT]]>
</Line>
<Line Number="213">
<![CDATA[///////////////////////////////]]>
</Line>
<Line Number="214">
<![CDATA[]]>
</Line>
<Line Number="215">
<![CDATA[//E-Stop]]>
</Line>
<Line Number="216">
<![CDATA[IN.S1201_01 := sDCS.S1201.DCS.O1 AND NOT sDCS.S1201.DCS.FP; //E-Stop 1]]>
</Line>
<Line Number="217">
<![CDATA[IN.S1211_01 := sDCS.S1211.DCS.O1 AND NOT sDCS.S1211.DCS.FP; //E-Stop 11]]>
</Line>
<Line Number="218">
<![CDATA[IN.S6211_01 := sDCS.S6211.DCS.O1 AND NOT sDCS.S6211.DCS.FP; //E-Stop 11 ]]>
</Line>
<Line Number="219">
<![CDATA[IN.S6214_01 := sDCS.S6214.DCS.O1 AND NOT sDCS.S6214.DCS.FP; //E-Stop 12 (DCS S6214) ]]>
</Line>
<Line Number="220">
<![CDATA[]]>
</Line>
<Line Number="221">
<![CDATA[//PALLET MAGAZINE GUARD]]>
</Line>
<Line Number="222">
<![CDATA[IN.B7810_01_NC := sDCS.B7810.DCS.O1 AND NOT sDCS.B7810.DCS.FP; ]]>
</Line>
<Line Number="223">
<![CDATA[]]>
</Line>
<Line Number="224">
<![CDATA[//Local guard safety auxiliary]]>
</Line>
<Line Number="225">
<![CDATA[IN.K1403_04 := LampReset_ZoneOppOpSide; //GUARD 5 and 6 zone reset]]>
</Line>
<Line Number="226">
<![CDATA[]]>
</Line>
<Line Number="227">
<![CDATA[//Guard used InputStatus to get actual status open/closed, using O1 we would get the "resetted" status that is not usable for local reset guards]]>
</Line>
<Line Number="228">
<![CDATA[IN.B1401_L := sDCS.B1401.DCS.O1 AND NOT sDCS.B1401.DCS.FP; //GUARD 1 ]]>
</Line>
<Line Number="229">
<![CDATA[IN.B1402_L := sDCS.B1402.DCS.O1 AND NOT sDCS.B1402.DCS.FP; //GUARD 2]]>
</Line>
<Line Number="230">
<![CDATA[IN.B1403_L := sDCS.B1403.DCS.O1 AND NOT sDCS.B1403.DCS.FP; //GUARD 3]]>
</Line>
<Line Number="231">
<![CDATA[IN.B1404_L := sDCS.B1404.DCS.O1 AND NOT sDCS.B1404.DCS.FP; //GUARD 4]]>
</Line>
<Line Number="232">
<![CDATA[IN.B6401_L := sDCS.B6401.DCS.O1 AND NOT sDCS.B6401.DCS.FP; //GUARD 1]]>
</Line>
<Line Number="233">
<![CDATA[IN.B6402_L := sDCS.B6402.DCS.O1 AND NOT sDCS.B6402.DCS.FP; //GUARD 2]]>
</Line>
<Line Number="234">
<![CDATA[IN.B6403_L := sDCS.B6403.DCS.O1 AND NOT sDCS.B6403.DCS.FP; //GUARD 3]]>
</Line>
<Line Number="235">
<![CDATA[IN.B6404_L := sDCS.B6404.DCS.O1 AND NOT sDCS.B6404.DCS.FP; //GUARD 4]]>
</Line>
<Line Number="236">
<![CDATA[]]>
</Line>
<Line Number="237">
<![CDATA[//Reset general]]>
</Line>
<Line Number="238">
<![CDATA[IN.S1100_04 := NOT sDCS.S1100.DCS.O1 AND NOT sDCS.S1100.DCS.FP;]]>
</Line>
<Line Number="239">
<![CDATA[]]>
</Line>
<Line Number="240">
<![CDATA[//Local guard reset buttons]]>
</Line>
<Line Number="241">
<![CDATA[IN.S1491_01 := NOT sDCS.S1491.DCS.O1 AND NOT sDCS.S1491.DCS.FP;]]>
</Line>
<Line Number="242">
<![CDATA[]]>
</Line>
<Line Number="243">
<![CDATA[//Safety barriers]]>
</Line>
<Line Number="244">
<![CDATA[IN.B7801_01 := sDCS.B7801.DCS.O1 AND NOT sDCS.B7801.DCS.FP;]]>
</Line>
<Line Number="245">
<![CDATA[IN.B8001_01 := sDCS.B8001.DCS.O1 AND NOT sDCS.B8001.DCS.FP;]]>
</Line>
<Line Number="246">
<![CDATA[]]>
</Line>
<Line Number="247">
<![CDATA[//ACCESS SENSOR]]>
</Line>
<Line Number="248">
<![CDATA[IN.K6340_04 := sDCS.K6340_04.DCS.O1 AND NOT sDCS.K6340_04.DCS.FP; //ACCESS SENSOR 4 (Pallet magazine)]]>
</Line>
<Line Number="249">
<![CDATA[]]>
</Line>
<Line Number="250">
<![CDATA[//Ist, Delayed]]>
</Line>
<Line Number="251">
<![CDATA[IN.K1440_01 	   := SafetyCircuit_ACTIVE;		    //Pilz-Ist]]>
</Line>
<Line Number="252">
<![CDATA[IN.K1440_01_Delay  := SafetyCircuit_ACTIVE_DELAYED; //Pilz-Delayed]]>
</Line>
<Line Number="253">
<![CDATA[]]>
</Line>
<Line Number="254">
<![CDATA[//Main air group diagnostic reed]]>
</Line>
<Line Number="255">
<![CDATA[IN.K1500_01 := SafetyIN.Q1500_01_S1 AND SafetyIN.Q1500_01_S2;]]>
</Line>
<Line Number="256">
<![CDATA[IN.K7830_01 := SafetyIN.Q7830_01_S1 AND SafetyIN.Q7830_01_S2;]]>
</Line>
<Line Number="257">
<![CDATA[]]>
</Line>
<Line Number="258">
<![CDATA[//Reset buttons light directly linked with zone status]]>
</Line>
<Line Number="259">
<![CDATA[OUT.P1491_01 := IN.K1403_04;]]>
</Line>
<Line Number="260">
<![CDATA[OUT.P7801_01 := IN.B7801_01;]]>
</Line>
<Line Number="261">
<![CDATA[OUT.P8001_01 := IN.B8001_01;]]>
</Line>
<Line Number="262">
<![CDATA[]]>
</Line>
<Line Number="263">
<![CDATA[//IN.K2810_03	:= sDCS.K2810.DCS.O1 AND NOT sDCS.K2810.DCS.FP; //Box end]]>
</Line>
</STContent>
</Routine>
