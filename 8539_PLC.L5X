<Routine Name="Cycle_CaseFilling_T12" Type="RLL">
<Description>
<![CDATA[.]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[m154.0]]>
</Comment>
<Text>
<![CDATA[[XIC(EM_CaseF.xAutomaticCycle) ,XIC(EM_CaseF.xManualCycle) ,XIC(OM_Interface.Infeed_xProductFeedingManual) ]XIC(BB.Machine_Ready)XIO(EM_CaseF.xSt_ImmediateStop)OTL(OM_Interface.CaseF_xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[m154.0]]>
</Comment>
<Text>
<![CDATA[[XIC(BB.St_Emergency_ImmediateStop) ,XIC(EM_CaseF.xSt_ImmediateStop) ]OTU(OM_Interface.CaseF_xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[m154.0]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.CaseF_xCycleInProgress)EQ(EM_CaseF.iFilling_SeqChange,0)XIO(EM_CaseF.xAutomaticCycle)XIO(EM_CaseF.xManualCycle)XIO(OM_Interface.Infeed_xProductFeedingManual)OTU(OM_Interface.CaseF_xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[m154.0]]>
</Comment>
<Text>
<![CDATA[XIC(BB.St_Emergency_PhaseStop)[EQ(EM_CaseF.iFilling_SeqChange,0) ,EQ(EM_CaseF.iFilling_SeqChange,14) XIC(OM_Interface.CaseF_xStCycleInhibition) ]XIO(EM_CaseF.xAutomaticCycle)XIO(EM_CaseF.xManualCycle)OTU(OM_Interface.CaseF_xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Rq Trigger Camera 1]]>
</Comment>
<Text>
<![CDATA[XIC(OM_TeT.IN_CaseF.xRqTriggerCam1)[MOVE(Timers.N[9].PRE,EM_CaseF.Ton_DelayPhoto.PRE) ,TON(EM_CaseF.Ton_DelayPhoto,?,?) ,EQ(EM_CaseF.iFilling_SeqChange,0) OTU(OM_TeT.IN_CaseF.xRqTriggerCam1) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[MOVE(Timers.N[11].PRE,EM_CaseF.Ton_DelaySimPhoto.PRE);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Lifter Disable/Enable]]>
</Comment>
<Text>
<![CDATA[[XIO(OM_TeT.OUT_Machine.xTeTEnabled) EQ(EM_CaseF.Ton_DelaySimPhoto.PRE,0) ,XIO(UM_Config.CP.EnablePusherDriveLifting) ,XIC(OM_TeT.IN_Infeed.xLifterDisableForBadLayer) ,XIC(OM_Empty.xEnable) GT(UM_HMI.MachineWorkData.St_iActualRowsNumber,1) ][OTE(EM_CaseF.xLifterDisable) ,OTE(OM_Interface.CaseF_xLifterDisabled) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Network 7]]>
</Comment>
<Text>
<![CDATA[XIC(EM_CaseF.xRqSimCam)TON(EM_CaseF.Ton_DelaySimPhoto,?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Network 8]]>
</Comment>
<Text>
<![CDATA[XIC(EM_CaseF.Ton_DelaySimPhoto.DN)[OTL(EM_CaseF.xPhotoDone) ,OTU(EM_CaseF.xRqSimCam) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Inibition Bundle Transfer]]>
</Comment>
<Text>
<![CDATA[NE(EM_CaseF.iFilling_SeqChange,0)OTL(OM_Interface.BundleTrans_xInhibit);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[**************************
State machine
**************************]]>
</Comment>
<Text>
<![CDATA[[XIC(OM_Interface.CaseF_xCycleInProgress) ,XIC(OM_Interface.CaseP_xCycleInProgress) ]EQ(EM_CaseF.iFilling_SeqChange,0)[NE(EM_CaseF.CM_Pusher.AxisIN_POS_iRqPos,1) EQ(EM_CaseF.CM_Pusher.AxisOUT_POS_iPosDone,1) [NE(EM_CaseF.CM_HopperMaster.AxisIN_POS_iRqPos,1) NE(EM_CaseF.CM_HopperMaster.AxisOUT_POS_iPosDone,1) MOVE(1,EM_CaseF.CM_HopperMaster.AxisIN_POS_iRqPos) ,EQ(EM_CaseF.CM_Lifter.AxisIN_POS_iRqPos,0) NE(EM_CaseF.CM_Lifter.AxisOUT_POS_iPosDone,1) MOVE(1,EM_CaseF.CM_Lifter.AxisIN_POS_iRqPos) ] ,NE(EM_CaseF.CM_Pusher.AxisIN_POS_iRqPos,1) NE(EM_CaseF.CM_Pusher.AxisOUT_POS_iPosDone,1) MOVE(1,EM_CaseF.CM_Pusher.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[EQ(EM_CaseF.CM_Pusher.AxisOUT_POS_iPosDone,1)EQ(EM_CaseF.CM_Lifter.AxisOUT_POS_iPosDone,1)EQ(EM_CaseF.CM_HopperMaster.AxisOUT_POS_iPosDone,1)OTE(EM_CaseF.xAuxFillingBack);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[if Lifter Disabled]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.CaseF_xCycleInProgress)EQ(EM_CaseF.iFilling_SeqChange,0)XIC(EM_CaseF.xAuxFillingBack)XIC(EM_CaseF.xLifterDisable)[XIC(OM_Interface.BundleTransfer_xBundleReady) ,XIC(EM_CaseF.xManualCycle) ,XIC(OM_Empty.xEnable) GE(UM_HMI.MachineWorkData.St_iActualRowsNumber,1) ]MOVE(11,EM_CaseF.iFilling_SeqChange);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[if Lifter Enabled]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.CaseF_xCycleInProgress)EQ(EM_CaseF.iFilling_SeqChange,0)XIC(EM_CaseF.xAuxFillingBack)XIO(EM_CaseF.xLifterDisable)[XIC(OM_Interface.BundleTransfer_xBundleReady) ,XIC(EM_CaseF.xManualCycle) ][XIC(UM_Config.CP.TeT_BoxChecking) XIC(EM_CaseF_HMI_PB.St_xOptGr_CaseCompletenessCheckEnabling) ,XIO(UM_Config.CP.TeT_BoxChecking) ]OTL(EM_CaseF.xSeqCaseChangeIncreaseAux);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[STEP 1
]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.CaseF_xCycleInProgress)EQ(EM_CaseF.iFilling_SeqChange,1)[EQ(EM_CaseF.CM_Pusher.AxisOUT_POS_iPosDone,5) OTL(EM_CaseF.xSeqCaseChangeIncreaseAux) ,NE(EM_CaseF.CM_Pusher.AxisOUT_POS_iPosDone,5) MOVE(5,EM_CaseF.CM_Pusher.AxisIN_POS_iRqPos) ,OTU(OM_TeT.IN_CaseF.xRqTriggerCam1) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[STEP 2]]>
