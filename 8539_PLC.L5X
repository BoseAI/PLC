<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(iq_Hmi_xRqManualForward)XIO(iq_BB.Manual_CmdEnable)[OTL(iq_Msg_xManualFunctionOff) ,OTU(iq_Hmi_xRqManualForward) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(iq_Hmi_xRqManualForward)XIO(iq_Hmi_xStManualForward)[OTL(iq_Hmi_xStManualForward) ,OTU(iq_Hmi_xRqManualForward) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(iq_Hmi_xRqManualForward) XIC(iq_Hmi_xStManualForward) ,XIO(iq_BB.Manual_CmdEnable) ,XIC(iq_BB.Automatic_CycleActive) ,XIC(iq_BB.St_Emergency_ImmediateStop) ][OTU(iq_Hmi_xStManualForward) ,OTU(iq_Hmi_xRqManualForward) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(iq_Hmi_xStManualForward)OTL(iq_CM.Inverter_xManualCycle);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CMD INVERTER]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(iq_BB.Pilz_StorageActivated)OTE(iq_CM.Inverter_xPowerOn);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(i_xRqRun)OTL(iq_CM.Inverter_xAutomaticCycle);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(iq_CM.Inverter_xAutomaticCycle) ,XIC(iq_CM.Inverter_xManualCycle) ]OTL(iq_CM.InverterOUT_xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIO(iq_CM.Inverter_xAutomaticCycle) XIO(iq_CM.Inverter_xManualCycle) ,XIC(i_EM_xStopImmediate) ]OTU(iq_CM.InverterOUT_xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(iq_CM.InverterOUT_xCycleInProgress)XIC(iq_CM.Inverter_xPowerOn)XIO(i_EM_xInhibitRun)XIO(i_xRqReverseDir)XIO(i_EM_xStopImmediate)XIO(i_xRqStopForward)OTE(iq_CM.InverterIN_xForward_Rq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(iq_CM.InverterOUT_xCycleInProgress)XIC(iq_CM.Inverter_xPowerOn)XIO(i_EM_xInhibitRun)XIC(i_xRqReverseDir)XIO(i_EM_xStopImmediate)OTE(iq_CM.Inverter_xReverseDirection);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(iq_CM.InverterIN_xForward_Rq) ,XIC(iq_CM.Inverter_xReverseDirection) ]OTE(iq_CM.Inverter_xCommand);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(iq_BB.AlwaysOFF)[OTU(iq_CM.Inverter_xAutomaticCycle) ,OTU(iq_CM.Inverter_xManualCycle) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
