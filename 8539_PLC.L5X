</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[/////////////////////////////////////////////////////]]>
</Line>
<Line Number="12">
<![CDATA[// define type of pickup cases on channel A-B]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[CASE I_PickUpTypeAsp]]>
</Line>
<Line Number="15">
<![CDATA[of]]>
</Line>
<Line Number="16">
<![CDATA[	0,1,2:	// =0 	HeadAsp Type A]]>
</Line>
<Line Number="17">
<![CDATA[			// =1  	HeadAsp Type A+B indip.Standard]]>
</Line>
<Line Number="18">
<![CDATA[			// =2  	HeadAsp Type A reinforced with B				]]>
</Line>
<Line Number="19">
<![CDATA[			CASE I_iPickUpOffsetRot]]>
</Line>
<Line Number="20">
<![CDATA[			OF]]>
</Line>
<Line Number="21">
<![CDATA[				0,180:	//Offset R Pick =0°]]>
</Line>
<Line Number="22">
<![CDATA[					xN_Y:=1;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[				90,270:	//Offset R Pick =90°]]>
</Line>
<Line Number="25">
<![CDATA[					xN_X:=1;		]]>
</Line>
<Line Number="26">
<![CDATA[			]]>
</Line>
<Line Number="27">
<![CDATA[			END_CASE;]]>
</Line>
<Line Number="28">
<![CDATA[			]]>
</Line>
<Line Number="29">
<![CDATA[	3:// HeadAsp Type A+B indip.in Line]]>
</Line>
<Line Number="30">
<![CDATA[			CASE I_iPickUpOffsetRot]]>
</Line>
<Line Number="31">
<![CDATA[			OF]]>
</Line>
<Line Number="32">
<![CDATA[				0,180:	//Offset R Pick =0°]]>
</Line>
<Line Number="33">
<![CDATA[					xN_X:=1;]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[				90,270:	//Offset R Pick =90°]]>
</Line>
<Line Number="36">
<![CDATA[					xN_Y:=1;	]]>
</Line>
<Line Number="37">
<![CDATA[					]]>
</Line>
<Line Number="38">
<![CDATA[			END_CASE;				]]>
</Line>
<Line Number="39">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[/////////////////////////////////////////////////////]]>
</Line>
<Line Number="42">
<![CDATA[// Calc Number cases on channel A]]>
</Line>
<Line Number="43">
<![CDATA[// Calc Number cases on channel B]]>
</Line>
<Line Number="44">
<![CDATA[]]>
</Line>
<Line Number="45">
<![CDATA[IF	xN_X ]]>
</Line>
<Line Number="46">
<![CDATA[then]]>
</Line>
<Line Number="47">
<![CDATA[	iA_Cases:=I_iRowsChA*I_iNumberCasesX;]]>
</Line>
<Line Number="48">
<![CDATA[	iB_Cases:=I_iRowsChB*I_iNumberCasesX;]]>
</Line>
<Line Number="49">
<![CDATA[ELSIF xN_Y]]>
</Line>
<Line Number="50">
<![CDATA[then]]>
</Line>
<Line Number="51">
<![CDATA[	iA_Cases:=I_iRowsChA*I_iNumberCasesY;]]>
</Line>
<Line Number="52">
<![CDATA[	iB_Cases:=I_iRowsChB*I_iNumberCasesY;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[END_IF;]]>
</Line>
<Line Number="55">
<![CDATA[]]>
</Line>
<Line Number="56">
<![CDATA[/////////////////////////////////////////////////]]>
</Line>
<Line Number="57">
<![CDATA[// Calc Total cases On Head]]>
</Line>
<Line Number="58">
<![CDATA[	]]>
</Line>
<Line Number="59">
<![CDATA[iTotal_Composition_Cases:=iA_Cases+iB_Cases;]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[iCurrent_A_Cases_No:=iA_Cases;]]>
</Line>
<Line Number="62">
<![CDATA[q_iCurrent_A_Cases_No:=iA_Cases;]]>
</Line>
<Line Number="63">
<![CDATA[]]>
</Line>
<Line Number="64">
<![CDATA[iCurrent_B_Cases_No:=iB_Cases;]]>
</Line>
<Line Number="65">
<![CDATA[q_iCurrent_B_Cases_No:=iB_Cases;]]>
</Line>
<Line Number="66">
<![CDATA[]]>
</Line>
<Line Number="67">
<![CDATA[]]>
</Line>
<Line Number="68">
<![CDATA[///////////////////////////////////////////////]]>
</Line>
<Line Number="69">
<![CDATA[// Calc Total cases on Layer]]>
</Line>
<Line Number="70">
<![CDATA[]]>
</Line>
<Line Number="71">
<![CDATA[FOR iCount := 1 TO I_iPlaceDone_No BY 1 DO]]>
</Line>
<Line Number="72">
<![CDATA[	CASE LayerSequence[I_iLayersCompleted_No + 1]]]>
</Line>
<Line Number="73">
<![CDATA[		OF]]>
</Line>
<Line Number="74">
<![CDATA[			1,3,5:	]]>
</Line>
<Line Number="75">
<![CDATA[				//Layer type A ]]>
</Line>
<Line Number="76">
<![CDATA[				//Layer type A + Interlayer ]]>
</Line>
<Line Number="77">
<![CDATA[				//Layer type A + Glue ]]>
</Line>
<Line Number="78">
<![CDATA[				CASE PlaceSequence_LayerTypeA[iCount]]]>
</Line>
<Line Number="79">
<![CDATA[				OF]]>
</Line>
<Line Number="80">
<![CDATA[					2:	//Place Channel A]]>
</Line>
<Line Number="81">
<![CDATA[						iCurrent_Layer_Cases_No	:=	iCurrent_Layer_Cases_No + I_iRowsChA;]]>
</Line>
<Line Number="82">
<![CDATA[]]>
</Line>
<Line Number="83">
<![CDATA[					3:	//Place Channel B]]>
</Line>
<Line Number="84">
<![CDATA[						iCurrent_Layer_Cases_No	:=	iCurrent_Layer_Cases_No + I_iRowsChB;]]>
</Line>
<Line Number="85">
<![CDATA[]]>
</Line>
<Line Number="86">
<![CDATA[					0:	//Place Channel A+B]]>
</Line>
<Line Number="87">
<![CDATA[						IF I_PickUpTypeAsp<>2 ]]>
</Line>
<Line Number="88">
<![CDATA[						then	]]>
</Line>
<Line Number="89">
<![CDATA[							iCurrent_Layer_Cases_No	:=	iCurrent_Layer_Cases_No + iTotal_Composition_Cases;]]>
</Line>
<Line Number="90">
<![CDATA[						else //A+b Reinfoiced]]>
</Line>
<Line Number="91">
<![CDATA[							iCurrent_Layer_Cases_No	:=	iCurrent_Layer_Cases_No + I_iRowsChA;]]>
</Line>
<Line Number="92">
<![CDATA[						END_IF;	]]>
</Line>
<Line Number="93">
<![CDATA[				END_CASE;]]>
</Line>
<Line Number="94">
<![CDATA[					]]>
</Line>
<Line Number="95">
<![CDATA[			2,4,6:	]]>
</Line>
<Line Number="96">
<![CDATA[				//Layer type B ]]>
</Line>
<Line Number="97">
<![CDATA[				//Layer type B + Interlayer ]]>
</Line>
<Line Number="98">
<![CDATA[				//Layer type B + Glue ]]>
</Line>
<Line Number="99">
<![CDATA[				CASE PlaceSequence_LayerTypeB[iCount]]]>
</Line>
<Line Number="100">
<![CDATA[				OF]]>
</Line>
<Line Number="101">
<![CDATA[					2:	//Place Channel A]]>
</Line>
<Line Number="102">
<![CDATA[							iCurrent_Layer_Cases_No	:=	iCurrent_Layer_Cases_No + I_iRowsChA;]]>
</Line>
<Line Number="103">
<![CDATA[]]>
</Line>
<Line Number="104">
<![CDATA[					3:	//Place Channel B]]>
</Line>
<Line Number="105">
<![CDATA[							iCurrent_Layer_Cases_No	:=	iCurrent_Layer_Cases_No + I_iRowsChB;]]>
</Line>
<Line Number="106">
<![CDATA[]]>
</Line>
<Line Number="107">
<![CDATA[					0:	//Place Channel A+B]]>
</Line>
<Line Number="108">
<![CDATA[						IF I_PickUpTypeAsp<>2 ]]>
</Line>
<Line Number="109">
<![CDATA[						then	]]>
</Line>
<Line Number="110">
<![CDATA[							iCurrent_Layer_Cases_No	:=	iCurrent_Layer_Cases_No + iTotal_Composition_Cases;]]>
</Line>
<Line Number="111">
<![CDATA[						else //A+b Reinfoiced]]>
</Line>
<Line Number="112">
<![CDATA[							iCurrent_Layer_Cases_No	:=	iCurrent_Layer_Cases_No + I_iRowsChA;]]>
</Line>
<Line Number="113">
<![CDATA[						END_IF;	]]>
</Line>
<Line Number="114">
<![CDATA[]]>
</Line>
<Line Number="115">
<![CDATA[				END_CASE;]]>
</Line>
<Line Number="116">
<![CDATA[				]]>
</Line>
<Line Number="117">
<![CDATA[		END_CASE;]]>
</Line>
<Line Number="118">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="119">
<![CDATA[]]>
</Line>
<Line Number="120">
<![CDATA[]]>
</Line>
<Line Number="121">
<![CDATA[]]>
</Line>
<Line Number="122">
<![CDATA[q_iCurrent_Layer_Cases_No:= iCurrent_Layer_Cases_No;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
