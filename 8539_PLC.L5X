<Routine Name="Config" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[////////////////////////////////]]>
</Line>
<Line Number="1">
<![CDATA[//MAIN SUB MODULE]]>
</Line>
<Line Number="2">
<![CDATA[////////////////////////////////]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[//Hardware configuration]]>
</Line>
<Line Number="5">
<![CDATA[UM_Config.PAL.PAL_DOUBLE_PICK := 0;]]>
</Line>
<Line Number="6">
<![CDATA[UM_Config.PAL.Buffer_RobotData := 0;]]>
</Line>
<Line Number="7">
<![CDATA[UM_Config.PAL.Reject_RobotData := 0;]]>
</Line>
<Line Number="8">
<![CDATA[UM_Config.PAL.RejectOnTape := 1;]]>
</Line>
<Line Number="9">
<![CDATA[UM_Config.PAL.Sampling := 1;]]>
</Line>
<Line Number="10">
<![CDATA[UM_Config.PAL.Rework := 1;]]>
</Line>
<Line Number="11">
<![CDATA[UM_Config.PAL.Spreading_Path := 0;// Flex enable spalm 10]]>
</Line>
<Line Number="12">
<![CDATA[UM_Config.PAL.Spreading2_PathRobotData := 0;]]>
</Line>
<Line Number="13">
<![CDATA[UM_Config.PAL.SamplingWithBox := 0;]]>
</Line>
<Line Number="14">
<![CDATA[UM_Config.PAL.RejectPlaneRollLifter := 1;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[UM_Config.PAL.TeT_FLEX := 1;]]>
</Line>
<Line Number="17">
<![CDATA[UM_Config.PAL.RobotSafetyPickupCase := 0;]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[//Option]]>
</Line>
<Line Number="20">
<![CDATA[UM_Config.PAL.CASE_INFEED_BARRIER := 0;]]>
</Line>
<Line Number="21">
<![CDATA[UM_Config.PAL.Interlayer_RobotData := 0;// Interlayer robot data enabling]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[UM_Config.PAL.DemoulderInterlRobot:= UM_Config.PAL.Interlayer_RobotData AND 0;// Interlayer robot data enabling]]>
</Line>
<Line Number="24">
<![CDATA[UM_Config.PAL.Labeller1 := 0;]]>
</Line>
<Line Number="25">
<![CDATA[UM_Config.PAL.Labeller2 := 0;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[UM_Config.PAL.CheckAppliedLabel1 := UM_Config.PAL.Labeller1 OR 0;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[UM_Config.PAL.CheckNotAppliedLabel1 := NOT (UM_Config.PAL.Labeller1 AND NOT UM_Config.PAL.CheckAppliedLabel1) OR 1;]]>
</Line>
<Line Number="30">
<![CDATA[EM_PAL.CM_CheckLabel_1.xCheckNotAppliedLabelEnabled := UM_Config.PAL.CheckNotAppliedLabel1 AND (OM_TeT_HMI_PB.iSelSerializationMode = 3);]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[UM_Config.PAL.CheckNotAppliedLabel2 := NOT UM_Config.PAL.Labeller2 AND NOT UM_Config.PAL.CheckAppliedLabel2;]]>
</Line>
<Line Number="33">
<![CDATA[EM_PAL.CM_CheckLabel_2.xCheckNotAppliedLabelEnabled := UM_Config.PAL.CheckNotAppliedLabel2 AND (OM_TeT_HMI_PB.iSelSerializationMode = 3);]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[UM_Config.PAL.CheckAppliedLabel2 := UM_Config.PAL.Labeller2 OR 0;]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[// UM_Config.PAL.ZoneReject_WaitingFree := 	UM_Config.PAL.Reject_RobotData AND UM_Config.PAL.RejectOnTape AND 0;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[// Enabling when you have case bundles at Flex infeed with ELAU pusher]]>
</Line>
<Line Number="42">
<![CDATA[UM_Config.PAL.AxisPusher := UM_Config.PAL.OnlyPal_Enable AND 1;]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[]]>
</Line>
<Line Number="45">
<![CDATA[// Enable when, besides pallet A, pallet B is also present]]>
</Line>
<Line Number="46">
<![CDATA[UM_Config.PAL.PalletB := 1;]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[// Enable when grippers are present in the robot head]]>
</Line>
<Line Number="49">
<![CDATA[UM_Config.PAL.EnableGripper := 1;]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[// Enable when the puller is present in the robot head]]>
</Line>
<Line Number="52">
<![CDATA[UM_Config.PAL.EnableChannelC := 0;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[// Enable when the double suction channel is present in the robot head]]>
</Line>
<Line Number="55">
<![CDATA[UM_Config.PAL.EnableChannelB := 1;]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[// Abilitare quando lo scarto viene fatto dal robot depositando la cassa da ]]>
</Line>
<Line Number="58">
<![CDATA[// scartare sul ribaltatore lato opposto operatore]]>
</Line>
<Line Number="59">
<![CDATA[UM_Config.PAL.EnableRejectionOnOvertuning := 0;]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[// Mult pal mag enabling + automatic load + automatic output]]>
</Line>
<Line Number="62">
<![CDATA[]]>
</Line>
<Line Number="63">
<![CDATA[UM_Config.PAL.PMM_CAP_UAP:=	NOT UM_Config.PAL.PMS AND]]>
</Line>
<Line Number="64">
<![CDATA[								UM_Config.PAL.PMM AND]]>
</Line>
<Line Number="65">
<![CDATA[								UM_Config.PAL.CAP AND]]>
</Line>
<Line Number="66">
<![CDATA[								UM_Config.PAL.UAP AND ]]>
</Line>
<Line Number="67">
<![CDATA[								NOT UM_Config.PAL.DZP;]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[// Abilitazione  Mag pal sin + caricamento auto + uscita automatica + trasferimeto pallet con inv ]]>
</Line>
<Line Number="70">
<![CDATA[UM_Config.PAL.PMS_CAP_UAP :=	UM_Config.PAL.PMS AND ]]>
</Line>
<Line Number="71">
<![CDATA[								NOT UM_Config.PAL.PMM AND]]>
</Line>
<Line Number="72">
<![CDATA[								UM_Config.PAL.CAP AND ]]>
</Line>
<Line Number="73">
<![CDATA[								UM_Config.PAL.UAP AND ]]>
</Line>
<Line Number="74">
<![CDATA[								NOT UM_Config.PAL.DZP;]]>
</Line>
<Line Number="75">
<![CDATA[]]>
</Line>
<Line Number="76">
<![CDATA[UM_Config.PAL.NoPalletOnPalletMagPhotocellPresence := 0;]]>
</Line>
<Line Number="77">
<![CDATA[]]>
</Line>
<Line Number="78">
<![CDATA[// This enabling allows selecting whether you have the pallet magazine pneumatic circuit in CAT3]]>
</Line>
<Line Number="79">
<![CDATA[// or the even more outdated CAT3 pallet magazine pneumatic circuit]]>
</Line>
<Line Number="80">
<![CDATA[UM_Config.PAL.PneumCirucitMagazinePal := 1;]]>
</Line>
<Line Number="81">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Cycle_AutoRobot_T102" Type="RLL">
<Description>
<![CDATA[v0.2        : 11.05.20226
Author      : Boselli Mattia

v0.1        : Initial creation
Author      : Ing.Utili Nicola
Comment: Note software
Last Change : 02.10.2020]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
