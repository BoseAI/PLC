<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[###########################
NW 1 - Input FB axis
NW 4 - JOG MANUAL ENABLE
NW 12 - ABS HOME
NW 16 - POS HOME
NW 23 - AUTO
NW 25 - Ready for Command
NW 27 - MANUAL MISSION
NW 31 - POS
NW 33 - JOG IN PATH
NW 38 - JOG DIR
 NW 45 - MANUAL CYCLE
NW 50 - IMA SAFE STANDARD
NW 52 - MANAGE UNBRAKE 
NW 60 - MANAGE TEST BRAKE PNEUMATIC
NW 71 - COMMUNICATION ADDON AXIS
NW 73 - COMMUNICATION WITH LOGIC
NW 86 - COMMUNICATION WITH CIP
NW 98 - FAULT MANAGEMENT
NW 118 - HOME ABS
NW 127 - JOG
NW 134 - ENDLESS
NW 137 - REPHASING
NW 147 - POS
NW 164 - HOME POS
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[############################
INPUT FB AXIS
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(iq_BB.AlwaysOFF)[OTU(iq_Axis.xNotUsed) ,MOVE(0,iq_Axis.iNotUsed) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[############################
JOG MANUAL ENABLE
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(iq_BB.Automatic_CycleActive) ,XIO(iq_BB.SetSize) ]OTU(iq_Hmi_xStJogWithoutEnableMan);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(iq_BB.Automatic_CycleActive) ,XIO(iq_BB.SetSize) ,XIC(iq_BB.SizeDisplay_ChangePagePulse) ][OTU(iq_Hmi_xStJogInPath) ,OTU(iq_Hmi_xStJogEnable) ,OTU(iq_Hmi_xStManualCycle) ,MOVE(0,iq_Hmi_iRqManMission) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(iq_BB.Machine_Ready)MOVE(0,iq_Hmi_iRqManMission);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[NE(iq_Hmi_iRqManMission,0) ,XIC(iq_Hmi_xRqManualCycle) ][OTU(iq_Hmi_xStJogInPath) ,OTU(iq_Hmi_xStJogEnable) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(iq_Hmi_xRqJogInPath)[OTU(iq_Hmi_xStManualCycle) ,OTU(iq_Hmi_xStJogEnable) ,MOVE(0,iq_Hmi_iRqManMission) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(iq_Hmi_xRqJogEnable)[OTU(iq_Hmi_xStManualCycle) ,OTU(iq_Hmi_xStJogInPath) ,MOVE(0,iq_Hmi_iRqManMission) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[NE(iq_Hmi_iRqManMission,0) ,NE(iq_Hmi_iRqManMission,0) ,XIC(iq_Axis.xStopInPhase) ONS(axPTrig[2]) ]OTU(iq_Hmi_xStManualCycle);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[############################
ABS HOME
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(iq_Hmi_xRqAbsHomeSave)[OTL(iq_Hmi_xStAbsHomeSave) ,OTU(iq_Hmi_xRqAbsHomeSave) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(iq_Hmi_xStAbsHomeSave)OTL(iq_CIP_Axis.xRqAbsHome);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[############################
POS HOME
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(iq_Axis.AxisOUT_HOME_xHomeDone)[OTL(iq_EM_xAutomatic_CycleInhibition) ,XIC(i_Config_xEnableHomeFromInput) OTL(iq_Msg_RqResetCount) ,MOVE(0,iq_Axis.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(iq_EM_xRqResetHomeFromResetCount) ,XIC(iq_Hmi_xRqHome) ,XIC(iq_BB.Count_EnableCheckOfResetCounts) ]XIC(i_Config_xEnableHomeFromInput)OTL(iq_Axis.xRqhome);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(iq_Axis.AxisOUT_HOME_xHomeDone)ONS(axPTrig[0])[OTU(iq_Axis.xRqhome) ,OTU(iq_Hmi_xRqHome) ,OTU(iq_EM_xRqResetHomeFromResetCount) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[XIC(iq_Axis.xRqhome) XIC(iq_Axis.AxisOUT_HOME_xHomeDone) ,XIC(iq_BB.FirstScan) ,XIC(iq_CIP_Axis.StdBits.I_AxisAlarm) ,XIC(iq_Axis.AxisIN_HOME_xRqhome) ][OTU(iq_Axis.AxisOUT_HOME_xHomeDone) ,OTU(iq_Axis.AxisIN_POS_xEnableStartPos) ,OTU(iq_Axis.AxisIN_HOME_xRqhome) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIO(i_Config_xEnableHomeFromInput) ,XIC(i_Config_xEnableHomeFromInput) [XIC(iq_Hmi_xRqHome) ,XIC(iq_EM_xRqResetHomeFromResetCount) ] ]XIO(iq_Hmi_xStJogEnable)[XIC(iq_Axis.AxisIN_HOME_xHomeSequenceStart) ,XIC(i_Config_xEnableHomeAbsolute) ]XIC(iq_BB.Machine_Ready)[XIC(iq_Axis.AxisOUT_HOME_xAbsHomeOk) ,XIO(i_Config_xEnableHomeAbsolute) ][XIO(iq_Axis.AxisIN_xInhibitMoving) [OTE(iq_Axis.AxisIN_HOME_xHomeEnabling) ,OTU(iq_Axis.AxisIN_HOME_xHomeSequenceStart) ,XIO(iq_Axis.AxisOUT_HOME_xHomeDone) OTL(iq_Msg_HomeInProgress) ] ,XIO(iq_Axis.AxisOUT_HOME_xHomeDone) XIC(iq_Axis.AxisIN_xInhibitMoving) OTL(iq_Msg_RqInhibitMoving) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[############################
AUTO
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(iq_Axis.AxisOUT_HOME_xHomeDone)XIO(iq_Hmi_xStJogEnable)OTE(iq_Axis.AxisOUT_xAutomatic);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[############################
Ready for Command
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(iq_CIP_Axis.StdBits.O_DriveEnable)XIO(iq_CIP_Axis.StdBits.IO_StopRq)XIO(iq_CIP_Axis.StdBits.I_AxisAlarm)XIC(iq_HW_Axis.ServoActionStatus)[OTE(iq_CIP_Axis.StdBits.O_AxisReadyForMotionCmd) ,OTE(q_Vis_xReadyForMotionCmd) ,OTE(iq_Axis.AxisOUT_xReadyForMotionCmd) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[############################
MANUAL MISSION
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[NE(iq_Hmi_iRqManMission,0)XIO(iq_BB.Manual_CmdEnable)[OTL(iq_Msg_ManualFunctionOff) ,MOVE(0,iq_Hmi_iRqManMission) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[NE(iq_Hmi_iRqManMission,0)[MOVE(iq_Hmi_iRqManMission,iq_Axis.AxisIN_POS_iRqPos) ,MOVE(i_diHomeSpeed_PercentageMaxSpeed,iq_Axis.POS_iSpeed) ,MOVE(5,iq_Axis.POS_iAcc) ,MOVE(5,iq_Axis.POS_iDec) ,OTL(iq_Axis.AxisIN_POS_xEnableStartPos) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[EQ(iq_Hmi_iRqManMission,iq_Hmi_iStManMission)MOVE(0,iq_Hmi_iRqManMission);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[############################
POS
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[EQ(iq_Axis.AxisIN_POS_iRqPos,0)OTU(iq_Axis.AxisIN_POS_xEnableStartPos);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[GT(iq_Axis.AxisIN_POS_iRqPos,9)[OTL(iq_Msg_IllegalFunction) ,MOVE(0,iq_Axis.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[NE(iq_Axis.AxisIN_POS_iRqPos,0)[MOVE(iq_Axis.AxisIN_POS_arTargetPos[iq_Axis.AxisIN_POS_iRqPos],iq_Axis.AxisIN_POS_rTargetPos) ,MOVE(iq_Axis.AxisIN_POS_aiSpeed[iq_Axis.AxisIN_POS_iRqPos],iq_Axis.POS_iSpeed) ,MOVE(iq_Axis.AxisIN_POS_aiAcc[iq_Axis.AxisIN_POS_iRqPos],iq_Axis.POS_iAcc) ,MOVE(iq_Axis.AxisIN_POS_aiDec[iq_Axis.AxisIN_POS_iRqPos],iq_Axis.POS_iDec) ];]]>
</Text>
</Rung>
