<Routines>
<Routine Name="CM_Mot_PalletInfeedChain" Type="RLL">
<Description>
<![CDATA[v0.1        : 21.02.2023
Author      : Ing.Utili Nicola
Comment: Startup from base cph2 V142]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Pallet chain motor]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PalMag.xRqStartForwardPalletConveyor)[XIC(IN.K7903_01) [OTE(OUT.K7903_01_FWD) ,OTE(OM_Interface.PalMag_xPalletConvMotorInPalletArea) ] ,OTU(EM_PalMag.xRqStartForwardPalletConveyor) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Alarm: Protezione motore di uscita pallet zona pallettizazione]]>
</Comment>
<Text>
<![CDATA[XIO(IN.K7903_01)[OTE(ALRM[341]) ,OTL(OM_ShiftPalChange.xRq_ImmediateStop) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CM_PalMagMulEncoder" Type="RLL">
<Description>
<![CDATA[v0.1        : 21.02.2023
Author      : Ing.Utili Nicola
Comment: Startup from base cph2 V142]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Service message: Function not allowed]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PalMag_Hmi_PB.Rq_xManual_MagCycle_Reset)[XIO(IN.B7904_03) ,XIC(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletPresenceUnderMag) ][OTL(MSG[12]) ,OTU(EM_PalMag_Hmi_PB.Rq_xManual_MagCycle_Reset) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[Sel_AbolsuteHomeSetPos(DB_SelAbsoluteHomeMagPal,UM_Config.HOME_ABSOLUTE.xDataEditHmi_PAL_Magazine,SYS.N[388],EM_PalMag_Hmi_PB.St_iHomeAxisPosition,BB);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(EM_PalMag.CM_Encoder_PalletMagazine.lrActualPos,EM_PalMag_Hmi_PB.St_iAxisPosition_MagPallet);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EncoderLika(DB_EncoderPalletMag,-9000,EM_PalMag_Hmi_PB.St_iHomeAxisPosition,10,B7821_01_EncoderPalletMagazine:C,B7821_01_EncoderPalletMagazine:I1,EM_PalMag.CM_Encoder_PalletMagazine,EM_PalMag_Hmi_PB.Rq_xAbsHome_EncoderPalMag_Save,MSG[12],DB_Encoder_PresetMessage,DB_Encoder_PresetMessage1,ALRM[660],ALRM[661]);]]>
