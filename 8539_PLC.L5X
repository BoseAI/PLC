<LocalTags/>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Real Axis ]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[//Init Maximum speed]]>
</Line>
<Line Number="3">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV:=i_diMaximumSpeed;]]>
</Line>
<Line Number="4">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,MaximumSpeed,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[//Init MaximumAcceleration]]>
</Line>
<Line Number="7">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV:=i_diMaximumAcceleration;]]>
</Line>
<Line Number="8">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,MaximumAcceleration,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[//Init MaximumDeceleration]]>
</Line>
<Line Number="11">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV:=i_diMaximumDeceleration;]]>
</Line>
<Line Number="12">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,MaximumDeceleration,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[//Init iPositionErrorTolerance]]>
</Line>
<Line Number="15">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV:=i_diPositionErrorTolerance;]]>
</Line>
<Line Number="16">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,PositionErrorTolerance,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[//Init HomeSpeed]]>
</Line>
<Line Number="19">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV:=(i_diHomeSpeed*i_diMaximumSpeed)/100;]]>
</Line>
<Line Number="20">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,HomeSpeed,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[//Init HomeReturnSpeed]]>
</Line>
<Line Number="23">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV:=(i_diHomeSpeed*i_diMaximumSpeed)/100;]]>
</Line>
<Line Number="24">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,HomeReturnSpeed,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[//Init HomePosition]]>
</Line>
<Line Number="27">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV:=i_diHomePosition/10.0;]]>
</Line>
<Line Number="28">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,HomePosition,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[//Init HomeOffset]]>
</Line>
<Line Number="31">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV:=i_diHomeOffset/10.0;]]>
</Line>
<Line Number="32">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,HomeOffset,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[//Init TorqueLimitPositive]]>
</Line>
<Line Number="35">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV:=i_diTorqueLimitPositive;]]>
</Line>
<Line Number="36">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,TorqueLimitPositive,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[//Init TorqueLimitNegative]]>
</Line>
<Line Number="39">
<![CDATA[iq_CIP_Axis_Real.rCalcSSV := -1 * iq_CIP_Axis_Real.rCalcSSV;]]>
</Line>
<Line Number="40">
<![CDATA[SSV(Axis,iq_HW_Axis_Real,TorqueLimitNegative,iq_CIP_Axis_Real.rCalcSSV);]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[//END]]>
</Line>
<Line Number="43">
<![CDATA[iq_CIP_Axis_Real.xRqSSV := 0;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
