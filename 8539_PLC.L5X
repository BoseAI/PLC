<Routine Name="Config_T1" Type="ST">
<Description>
<![CDATA[v01: 06/09/2021
Author :Utili Nicola
Comment: Startup from Hywrap base TIA15.1-BaseCPH2 Studio5000]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[//Hardware configuration]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[//Option]]>
</Line>
<Line Number="5">
<![CDATA[UM_Config.CP.EnableCaseLowLevelWrng 	:= 1;]]>
</Line>
<Line Number="6">
<![CDATA[UM_Config.CP.EnableTapeLowWrng			:= 1;]]>
</Line>
<Line Number="7">
<![CDATA[UM_Config.CP.PresenceClosingGlueZone	:= 0;]]>
</Line>
<Line Number="8">
<![CDATA[UM_Config.CP.EnableFifthFlap			:= 0;]]>
</Line>
<Line Number="9">
<![CDATA[UM_Config.CP.EnableGlue					:= 0;]]>
</Line>
<Line Number="10">
<![CDATA[UM_Config.CP.EnableGluePurge			:= 0;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Cycle_AdesiveTape" Type="RLL">
<Description>
<![CDATA[v0.2        : 07.05.2026
Author      : Boselli Mattia


v0.1        : 27.06.2022
Author      : Ing.Utili Nicola]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(EM_CaseP.xCaseTransferRun)GT(EM_CaseP_HMI_PB.St_iHomeAxisPosition_CaseTransfer,0.5)LT(EM_CaseP_HMI_PB.St_iHomeAxisPosition_CaseTransfer,1515)[OTL(EM_CaseP.CM_InsertionReelUnwinder.Mot_xRqForward) ,OTL(EM_CaseP.CM_BottomReelUnwinder.Mot_xRqForward) ,OTE(OUT.Q3500_01) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(EM_CaseP.xCaseTransferRun)[OTL(EM_CaseP.CM_InsertionReelUnwinder.Mot_xRqStop) ,OTL(EM_CaseP.CM_BottomReelUnwinder.Mot_xRqStop) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[A244-End of introduction side adhesive tape]]>
</Comment>
<Text>
<![CDATA[XIO(IN.B3500_01)XIO(BB.NoLoadRun_Enable)[TON(Timers.N[231],?,?) ,XIC(Timers.N[231].DN) [OTE(ALRM[244]) ,OTL(EM_CaseP.xRq_ImmediateStop) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[A245-End of case bottom side adhesive tape]]>
</Comment>
<Text>
<![CDATA[XIO(IN.B3501_01)XIO(BB.NoLoadRun_Enable)[TON(Timers.N[232],?,?) ,XIC(Timers.N[232].DN) [OTE(ALRM[245]) ,OTL(EM_CaseP.xRq_ImmediateStop) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Tape ending introduction side]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Config.CP.EnableTapeLowWrng)XIO(IN.B3500_02)[XIC(BB.Automatic_CycleActive) OTL(WRNG[36]) ,OTL(BB.WrngRq_PackingMatOutCondition) ,ONS(EM_CaseP.axPTrig[40]) OTL(BB.WrngRq_StartHornFromPackingCond) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Tape ending introduction side]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Config.CP.EnableTapeLowWrng)XIO(IN.B3501_02)[XIC(BB.Automatic_CycleActive) OTL(WRNG[37]) ,OTL(BB.WrngRq_PackingMatOutCondition) ,ONS(EM_CaseP.axPTrig[41]) OTL(BB.WrngRq_StartHornFromPackingCond) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[A285-Outfeed belt lifting out of position]]>
</Comment>
<Text>
<![CDATA[XIO(IN.B3600_01)[OTE(ALRM[285]) ,OTL(BB.Rq_EmergencyPneum) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Cycle_CaseMagazine" Type="RLL">
<Description>
<![CDATA[v0.2        : 07.05.2026
Author      : Boselli Mattia

v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(IN.B2800_01) ,XIO(IN.B2800_03) ][MOVE(Timers.N[467].PRE,EM_CaseP.Ton_DelayReadSensorMagazine.PRE) ,TON(EM_CaseP.Ton_DelayReadSensorMagazine,?,?) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(SizeWork.Casepacker.NumberCasesToBePickedUpToMagazinStart,EM_CaseP.COUNT_MagForward.PRE);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(OM_Interface.CaseP_xTransferEnableToPickUp)CTU(EM_CaseP.COUNT_MagForward,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB.NoLoadRun_Enable)RES(EM_CaseP.COUNT_MagForward);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Box magazine motors]]>
</Comment>
<Text>
