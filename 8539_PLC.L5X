</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQ(Step,2)XIC(NoFaultAxis)XIC(IO_xRqEnableDrive)XIO(IO_Axis.DriveEnableStatus)XIC(O_xAxisStopped)[XIC(IO_Axis.DCBusUpStatus) XIC(IO_Axis.GuardGateDriveOutputStatus) XIC(IO_Axis.GuardOKStatus) [TON(TonEnable,?,?) ,XIC(TonEnable.DN) [MSO(IO_Axis,IO_MotionControl_MSO) ,ADD(Step,1,Step) ] ] ,OTL(O_xAxisEnableInProgress) ];]]>
