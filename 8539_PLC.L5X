<Line Number="198">
<![CDATA[MC_Move(]]>
</Line>
<Line Number="199">
<![CDATA[MC_Move]]>
</Line>
<Line Number="200">
<![CDATA[,MC]]>
</Line>
<Line Number="201">
<![CDATA[,i_xConnectionFaulted]]>
</Line>
<Line Number="202">
<![CDATA[,i_iStatus_Word]]>
</Line>
<Line Number="203">
<![CDATA[,i_diActual_Position]]>
</Line>
<Line Number="204">
<![CDATA[,q_iControl_Word]]>
</Line>
<Line Number="205">
<![CDATA[,q_diTarget_Position]]>
</Line>
<Line Number="206">
<![CDATA[,100]]>
</Line>
<Line Number="207">
<![CDATA[);]]>
</Line>
<Line Number="208">
<![CDATA[]]>
</Line>
<Line Number="209">
<![CDATA[IF NOT i_xEnable THEN]]>
</Line>
<Line Number="210">
<![CDATA[       iMoveStep := 0;]]>
</Line>
<Line Number="211">
<![CDATA[END_IF;]]>
</Line>
<Line Number="212">
<![CDATA[]]>
</Line>
<Line Number="213">
<![CDATA[case iMoveStep of ]]>
</Line>
<Line Number="214">
<![CDATA[	]]>
</Line>
<Line Number="215">
<![CDATA[	0:]]>
</Line>
<Line Number="216">
<![CDATA[		MC_Move.ManualRunToLargerValues 	:= 0;]]>
</Line>
<Line Number="217">
<![CDATA[		MC_Move.ManualRunToSmallerValues 	:= 0;]]>
</Line>
<Line Number="218">
<![CDATA[		MC_Move.Release						:= 0;]]>
</Line>
<Line Number="219">
<![CDATA[		MC_Move.Position					:= MC_Move.ActualPosition;	//0;]]>
</Line>
<Line Number="220">
<![CDATA[		q_xInPosition						:= 0;]]>
</Line>
<Line Number="221">
<![CDATA[		]]>
</Line>
<Line Number="222">
<![CDATA[		if i_xEnableRun]]>
</Line>
<Line Number="223">
<![CDATA[		and i_xEnable]]>
</Line>
<Line Number="224">
<![CDATA[		then]]>
</Line>
<Line Number="225">
<![CDATA[			iMoveStep := 100;]]>
</Line>
<Line Number="226">
<![CDATA[		end_if;]]>
</Line>
<Line Number="227">
<![CDATA[		]]>
</Line>
<Line Number="228">
<![CDATA[	100:]]>
</Line>
<Line Number="229">
<![CDATA[		if i_xEnableRun]]>
</Line>
<Line Number="230">
<![CDATA[		then]]>
</Line>
<Line Number="231">
<![CDATA[			if iq_xRqJogFw or iq_xRqJogBw]]>
</Line>
<Line Number="232">
<![CDATA[			then]]>
</Line>
<Line Number="233">
<![CDATA[				iMoveStep := 200;]]>
</Line>
<Line Number="234">
<![CDATA[			elsif iq_xRqCmdPos]]>
</Line>
<Line Number="235">
<![CDATA[			then]]>
</Line>
<Line Number="236">
<![CDATA[				iMoveStep := 300;]]>
</Line>
<Line Number="237">
<![CDATA[			end_if;]]>
</Line>
<Line Number="238">
<![CDATA[		else]]>
</Line>
<Line Number="239">
<![CDATA[			iMoveStep := 0;]]>
</Line>
<Line Number="240">
<![CDATA[		end_if;]]>
</Line>
<Line Number="241">
<![CDATA[		]]>
</Line>
<Line Number="242">
<![CDATA[	200:]]>
</Line>
<Line Number="243">
<![CDATA[		if iq_xRqJogFw or iq_xRqJogBw]]>
</Line>
<Line Number="244">
<![CDATA[		then]]>
</Line>
<Line Number="245">
<![CDATA[			q_xInPosition 		:= 0;]]>
</Line>
<Line Number="246">
<![CDATA[			xMoveStepIncrease	:= 1;	//go to 210]]>
</Line>
<Line Number="247">
<![CDATA[		else]]>
</Line>
<Line Number="248">
<![CDATA[			iMoveStep := 0;]]>
</Line>
<Line Number="249">
<![CDATA[		end_if;]]>
</Line>
<Line Number="250">
<![CDATA[		]]>
</Line>
<Line Number="251">
<![CDATA[	210:]]>
</Line>
<Line Number="252">
<![CDATA[		MC_Move.ManualRunToLargerValues		:= iq_xRqJogFw;]]>
</Line>
<Line Number="253">
<![CDATA[		MC_Move.ManualRunToSmallerValues 	:= iq_xRqJogBw;]]>
</Line>
<Line Number="254">
<![CDATA[		MC_Move.Release						:= 1;]]>
</Line>
<Line Number="255">
<![CDATA[		]]>
</Line>
<Line Number="256">
<![CDATA[		if not iq_xRqJogFw]]>
</Line>
<Line Number="257">
<![CDATA[			and not iq_xRqJogBw]]>
</Line>
<Line Number="258">
<![CDATA[			and i_xEnableRun]]>
</Line>
<Line Number="259">
<![CDATA[		then]]>
</Line>
<Line Number="260">
<![CDATA[			iMoveStep := 250;]]>
</Line>
<Line Number="261">
<![CDATA[		elsif not i_xEnableRun]]>
</Line>
<Line Number="262">
<![CDATA[		then]]>
</Line>
<Line Number="263">
<![CDATA[			iMoveStep := 0;]]>
</Line>
<Line Number="264">
<![CDATA[		end_if;]]>
</Line>
<Line Number="265">
<![CDATA[		]]>
</Line>
<Line Number="266">
<![CDATA[	250:]]>
</Line>
<Line Number="267">
<![CDATA[		MC_Move.ManualRunToLargerValues 	:= 0;]]>
</Line>
<Line Number="268">
<![CDATA[		MC_Move.ManualRunToSmallerValues 	:= 0;]]>
</Line>
<Line Number="269">
<![CDATA[		MC_Move.Position 					:= MC_Move.ActualPosition;]]>
</Line>
<Line Number="270">
<![CDATA[		xMoveStepIncrease					:= 1;	//go to 260]]>
</Line>
<Line Number="271">
<![CDATA[		]]>
</Line>
<Line Number="272">
<![CDATA[	260:]]>
</Line>
<Line Number="273">
<![CDATA[		if not xStatusWord_DriveRunning]]>
</Line>
<Line Number="274">
<![CDATA[		then]]>
</Line>
<Line Number="275">
<![CDATA[			//drive stopped running]]>
</Line>
<Line Number="276">
<![CDATA[			MC_Move.Release	:= 0;]]>
</Line>
<Line Number="277">
<![CDATA[			iMoveStep 	:= 100;]]>
</Line>
<Line Number="278">
<![CDATA[		end_if;]]>
</Line>
<Line Number="279">
<![CDATA[		]]>
</Line>
<Line Number="280">
<![CDATA[	300:]]>
</Line>
<Line Number="281">
<![CDATA[		if iq_xRqCmdPos]]>
</Line>
<Line Number="282">
<![CDATA[			and i_xEnableRun]]>
</Line>
<Line Number="283">
<![CDATA[		then]]>
</Line>
<Line Number="284">
<![CDATA[			q_xInPosition 	:= 0;]]>
</Line>
<Line Number="285">
<![CDATA[			iMoveStep 	:= 310;]]>
</Line>
<Line Number="286">
<![CDATA[		else]]>
</Line>
<Line Number="287">
<![CDATA[			iMoveStep := 0;]]>
</Line>
<Line Number="288">
<![CDATA[		end_if;	]]>
</Line>
<Line Number="289">
<![CDATA[			]]>
</Line>
<Line Number="290">
<![CDATA[	310:]]>
</Line>
<Line Number="291">
<![CDATA[		MC_Move.Position 	:=iPosTarget* diDecimalCorr ;]]>
</Line>
<Line Number="292">
<![CDATA[		MC_Move.Release		:= 1;]]>
</Line>
<Line Number="293">
<![CDATA[		xMoveStepIncrease := 1;]]>
</Line>
<Line Number="294">
<![CDATA[		]]>
</Line>
<Line Number="295">
<![CDATA[	320:]]>
</Line>
<Line Number="296">
<![CDATA[		if xStatusWord_DriveRunning]]>
</Line>
<Line Number="297">
<![CDATA[		then]]>
</Line>
<Line Number="298">
<![CDATA[			xMoveStepIncrease := 1;]]>
</Line>
<Line Number="299">
<![CDATA[		elsif not xStatusWord_DriveRunning]]>
</Line>
<Line Number="300">
<![CDATA[			and i_xEnableRun]]>
</Line>
<Line Number="301">
<![CDATA[		then]]>
</Line>
<Line Number="302">
<![CDATA[			iMoveStep 		:= 310;]]>
</Line>
<Line Number="303">
<![CDATA[		elsif not i_xEnableRun]]>
</Line>
<Line Number="304">
<![CDATA[		then]]>
</Line>
<Line Number="305">
<![CDATA[			iMoveStep 		:= 0;]]>
</Line>
<Line Number="306">
<![CDATA[		end_if;]]>
</Line>
<Line Number="307">
<![CDATA[]]>
</Line>
<Line Number="308">
<![CDATA[	330:]]>
</Line>
<Line Number="309">
<![CDATA[		if (MC_Move.ActualPosition > MC_Move.Position -diPosWindow )]]>
</Line>
<Line Number="310">
<![CDATA[			and (MC_Move.ActualPosition < MC_Move.Position + diPosWindow)]]>
</Line>
<Line Number="311">
<![CDATA[			and iq_xRqCmdPos]]>
</Line>
<Line Number="312">
<![CDATA[		then]]>
</Line>
<Line Number="313">
<![CDATA[			if not xStatusWord_DriveRunning]]>
</Line>
<Line Number="314">
<![CDATA[			then]]>
</Line>
<Line Number="315">
<![CDATA[				iMoveStep := 350;]]>
</Line>
<Line Number="316">
<![CDATA[			end_if;]]>
</Line>
<Line Number="317">
<![CDATA[		elsif not xStatusWord_DriveRunning]]>
</Line>
<Line Number="318">
<![CDATA[			or not i_xEnableRun]]>
</Line>
<Line Number="319">
<![CDATA[		then]]>
</Line>
<Line Number="320">
<![CDATA[			iMoveStep 	:= 0;]]>
</Line>
<Line Number="321">
<![CDATA[		end_if;]]>
</Line>
<Line Number="322">
<![CDATA[		]]>
</Line>
<Line Number="323">
<![CDATA[	350:]]>
</Line>
<Line Number="324">
<![CDATA[		xMoveStepIncrease	:= 1;	//go to 360]]>
</Line>
<Line Number="325">
<![CDATA[		]]>
</Line>
<Line Number="326">
<![CDATA[	360:]]>
</Line>
<Line Number="327">
<![CDATA[		if not xStatusWord_DriveRunning]]>
</Line>
<Line Number="328">
<![CDATA[		then]]>
</Line>
<Line Number="329">
<![CDATA[			//drive stopped running, that means it is in position]]>
</Line>
<Line Number="330">
<![CDATA[			MC_Move.Release		:= 0;]]>
</Line>
<Line Number="331">
<![CDATA[			q_xInPosition 		:= 1;]]>
</Line>
<Line Number="332">
<![CDATA[			xMoveStepIncrease	:= 1;]]>
</Line>
<Line Number="333">
<![CDATA[		end_if;]]>
</Line>
<Line Number="334">
<![CDATA[		]]>
</Line>
<Line Number="335">
<![CDATA[	370:]]>
</Line>
<Line Number="336">
<![CDATA[		if not iq_xRqCmdPos]]>
</Line>
<Line Number="337">
<![CDATA[		then]]>
</Line>
<Line Number="338">
<![CDATA[			q_xInPosition 	:= 0;]]>
</Line>
<Line Number="339">
<![CDATA[			iMoveStep 	:= 0;]]>
</Line>
<Line Number="340">
<![CDATA[		end_if;]]>
</Line>
<Line Number="341">
<![CDATA[]]>
</Line>
<Line Number="342">
<![CDATA[end_case;]]>
</Line>
<Line Number="343">
<![CDATA[]]>
</Line>
<Line Number="344">
<![CDATA[if xMoveStepIncrease]]>
</Line>
<Line Number="345">
<![CDATA[then]]>
</Line>
<Line Number="346">
<![CDATA[	iMoveStep 		:= iMoveStep + 10;]]>
</Line>
<Line Number="347">
<![CDATA[	xMoveStepIncrease := 0;]]>
</Line>
<Line Number="348">
<![CDATA[end_if;]]>
</Line>
<Line Number="349">
<![CDATA[]]>
</Line>
<Line Number="350">
<![CDATA[if MC_Move.Error]]>
</Line>
<Line Number="351">
<![CDATA[	and (MC_Move.ErrorID <> 0)]]>
</Line>
<Line Number="352">
<![CDATA[	and MC_Move.Release]]>
</Line>
<Line Number="353">
<![CDATA[then]]>
</Line>
<Line Number="354">
<![CDATA[	iq_sErrorID 		:= MC_Move.ErrorID;]]>
</Line>
<Line Number="355">
<![CDATA[end_if;]]>
</Line>
<Line Number="356">
<![CDATA[]]>
</Line>
<Line Number="357">
<![CDATA[(*]]>
</Line>
<Line Number="358">
<![CDATA[############################]]>
</Line>
<Line Number="359">
<![CDATA[MC_PosParametrization]]>
</Line>
<Line Number="360">
<![CDATA[############################]]>
</Line>
<Line Number="361">
<![CDATA[*)]]>
</Line>
<Line Number="362">
<![CDATA[]]>
</Line>
<Line Number="363">
<![CDATA[]]>
</Line>
<Line Number="364">
<![CDATA[(*]]>
</Line>
<Line Number="365">
<![CDATA[CalcNewSetPoint      LowerLimit                                     Setpoint                  UpperLimit                CalcUpperMappingEnd]]>
</Line>
<Line Number="366">
<![CDATA[0------------------------|---------------------------------------------0--------------------------|------------------------------0]]>
</Line>
<Line Number="367">
<![CDATA[L_PosParCalc[1] = CalcNewSetPoint : Lower for 128 revolutions from ZeroPos]]>
</Line>
<Line Number="368">
<![CDATA[L_PosParCalc[2] = CalcUpperMappingEnd : 256 revolutions more from the new calculated set point]]>
</Line>
<Line Number="369">
<![CDATA[L_PosParCalc[3] = LowerLimit : 253 revolutions less from UpperMappingEnd]]>
</Line>
<Line Number="370">
<![CDATA[L_PosParCalc[4] = UpperLimit : 3 revolutions less from UpperMappingEnd]]>
</Line>
<Line Number="371">
<![CDATA[*)]]>
</Line>
<Line Number="372">
<![CDATA[]]>
</Line>
<Line Number="373">
<![CDATA[if (i_iNumberDrive = iq_iRqZeroPos)]]>
</Line>
<Line Number="374">
<![CDATA[	and not MC_PosParametrization.Execute]]>
</Line>
<Line Number="375">
<![CDATA[	and 0 // Disabled]]>
</Line>
<Line Number="376">
<![CDATA[then]]>
</Line>
<Line Number="377">
<![CDATA[	MC_PosParametrization.SetPoint_10 		:= i_diZeroPos_10 * diDecimalCorr;]]>
</Line>
<Line Number="378">
<![CDATA[	MC_PosParametrization.Direction_26 		:= i_diZeroDirection_26;]]>
</Line>
<Line Number="379">
<![CDATA[	MC_PosParametrization.StepsPerTurn_30	:= i_diPosScaleDenominator_30;]]>
</Line>
<Line Number="380">
<![CDATA[	//CalcNewSetPoint : Lower for 128 revolutions from ZeroPos AKA SetPoint_10]]>
</Line>
<Line Number="381">
<![CDATA[	diPosParCalc[1]							:= MC_PosParametrization.SetPoint_10 - (MC_PosParametrization.StepsPerTurn_30 * 128);]]>
</Line>
<Line Number="382">
<![CDATA[	//CalcUpperMappingEnd : 256 revolutions more from the new calculated SetPoint_10]]>
</Line>
<Line Number="383">
<![CDATA[	diPosParCalc[2]							:= diPosParCalc[1] + (MC_PosParametrization.StepsPerTurn_30 * 256);]]>
</Line>
<Line Number="384">
<![CDATA[	//LowerLimit : 253 revolutions less from UpperMappingEnd]]>
</Line>
<Line Number="385">
<![CDATA[	diPosParCalc[3]							:= diPosParCalc[2] - (MC_PosParametrization.StepsPerTurn_30 * 253);]]>
</Line>
<Line Number="386">
<![CDATA[	//UpperLimit : 3 revolutions less from UpperMappingEnd]]>
</Line>
<Line Number="387">
<![CDATA[	diPosParCalc[4]							:= diPosParCalc[2] - (MC_PosParametrization.StepsPerTurn_30 * 3);]]>
</Line>
<Line Number="388">
<![CDATA[	MC_PosParametrization.UpperLimit_36		:= diPosParCalc[4];]]>
</Line>
<Line Number="389">
<![CDATA[	MC_PosParametrization.LowerLimit_38		:= diPosParCalc[3];]]>
</Line>
<Line Number="390">
<![CDATA[	MC_PosParametrization.SaveSettings_113	:= 1;]]>
</Line>
<Line Number="391">
<![CDATA[	MC_PosParametrization.Execute			:= 1;]]>
</Line>
<Line Number="392">
<![CDATA[end_if;]]>
</Line>
<Line Number="393">
<![CDATA[]]>
</Line>
<Line Number="394">
<![CDATA[MC_PosParametrization(]]>
</Line>
<Line Number="395">
<![CDATA[MC_PosParametrization]]>
</Line>
<Line Number="396">
<![CDATA[,MC]]>
</Line>
<Line Number="397">
<![CDATA[,i_xConnectionFaulted]]>
</Line>
<Line Number="398">
<![CDATA[,i_iParameter_ID]]>
</Line>
<Line Number="399">
<![CDATA[,i_diParameter_Value]]>
</Line>
<Line Number="400">
<![CDATA[,i_iSubindex]]>
</Line>
<Line Number="401">
<![CDATA[,q_iParameter_ID]]>
</Line>
<Line Number="402">
<![CDATA[,q_diParameter_Value]]>
</Line>
<Line Number="403">
<![CDATA[,q_iSubindex]]>
</Line>
<Line Number="404">
<![CDATA[,4000]]>
</Line>
<Line Number="405">
<![CDATA[);]]>
</Line>
<Line Number="406">
<![CDATA[]]>
</Line>
<Line Number="407">
<![CDATA[if MC_PosParametrization.Execute]]>
</Line>
<Line Number="408">
<![CDATA[then]]>
</Line>
<Line Number="409">
<![CDATA[	if MC_PosParametrization.Done]]>
</Line>
<Line Number="410">
<![CDATA[	then]]>
</Line>
<Line Number="411">
<![CDATA[		diPositionSetpointSaved		:= MC_PosParametrization.SetPoint_10;]]>
</Line>
<Line Number="412">
<![CDATA[		MC_PosParametrization.Execute 	:= 0;]]>
</Line>
<Line Number="413">
<![CDATA[		iq_sErrorID						:= 0;]]>
</Line>
<Line Number="414">
<![CDATA[		q_iErrorParameter				:= 0;]]>
</Line>
<Line Number="415">
<![CDATA[		iq_iRqZeroPos					:= 0;]]>
</Line>
<Line Number="416">
<![CDATA[	elsif (MC_PosParametrization.Error and (MC_PosParametrization.ErrorID <> 0))]]>
</Line>
<Line Number="417">
<![CDATA[	then]]>
</Line>
<Line Number="418">
<![CDATA[		diPositionSetpointSaved		:= 0;]]>
</Line>
<Line Number="419">
<![CDATA[		MC_PosParametrization.Execute 	:= 0;]]>
</Line>
<Line Number="420">
<![CDATA[		iq_sErrorID						:= MC_PosParametrization.ErrorID;]]>
</Line>
<Line Number="421">
<![CDATA[		q_iErrorParameter				:= MC_PosParametrization.ErrorParameter;]]>
</Line>
<Line Number="422">
<![CDATA[		iq_iRqZeroPos					:= 0;]]>
</Line>
<Line Number="423">
<![CDATA[	end_if;]]>
</Line>
<Line Number="424">
<![CDATA[end_if;]]>
</Line>
<Line Number="425">
<![CDATA[]]>
</Line>
<Line Number="426">
<![CDATA[]]>
</Line>
<Line Number="427">
<![CDATA[(*]]>
</Line>
<Line Number="428">
<![CDATA[############################]]>
</Line>
<Line Number="429">
<![CDATA[MC_Parametrization]]>
</Line>
<Line Number="430">
<![CDATA[############################]]>
</Line>
<Line Number="431">
<![CDATA[*)]]>
</Line>
<Line Number="432">
<![CDATA[]]>
</Line>
<Line Number="433">
<![CDATA[]]>
</Line>
<Line Number="434">
<![CDATA[if (i_iNumberDrive = iq_iRqZeroPos)]]>
</Line>
<Line Number="435">
<![CDATA[	and not MC_Parametrization.Execute]]>
</Line>
<Line Number="436">
<![CDATA[then]]>
</Line>
<Line Number="437">
<![CDATA[]]>
</Line>
<Line Number="438">
<![CDATA[	//calcs]]>
</Line>
<Line Number="439">
<![CDATA[	rUpperMappingEndCalc 								:= (i_diZeroUpperLimit_36 * diDecimalCorr) + (i_diPosScaleDenominator_30 * 3);]]>
</Line>
<Line Number="440">
<![CDATA[	rUpperLimitCalc									:= (i_diZeroUpperLimit_36 * diDecimalCorr);]]>
</Line>
<Line Number="441">
<![CDATA[	rLowerLimitCalc									:= (i_diZeroLowerLimit_38 * diDecimalCorr);]]>
</Line>
<Line Number="442">
<![CDATA[	rPositionWindowCalc								:= ((i_diPosScaleDenominator_30 / i_diPosScaleNumerator_28) * 100);]]>
</Line>
<Line Number="443">
<![CDATA[	//endcalcs]]>
</Line>
<Line Number="444">
<![CDATA[]]>
</Line>
<Line Number="445">
<![CDATA[	MC_Parametrization.DirRotation_Enable 				:= 1;]]>
</Line>
<Line Number="446">
<![CDATA[	MC_Parametrization.DirRotation_Value_26 			:= i_diZeroDirection_26;]]>
</Line>
<Line Number="447">
<![CDATA[	MC_Parametrization.PosScaleNumerator_Enable 		:= 1;]]>
</Line>
<Line Number="448">
<![CDATA[	MC_Parametrization.PosScaleNumerator_Value_28 		:= i_diPosScaleNumerator_28;]]>
</Line>
<Line Number="449">
<![CDATA[	MC_Parametrization.PosScaleDenominator_Enable 		:= 1;]]>
</Line>
<Line Number="450">
<![CDATA[	MC_Parametrization.PosScaleDenominator_Value_30 	:= i_diPosScaleDenominator_30;]]>
</Line>
<Line Number="451">
<![CDATA[]]>
</Line>
<Line Number="452">
<![CDATA[	//in case of an absolute homing we do apply the actual value]]>
</Line>
<Line Number="453">
<![CDATA[	MC_Parametrization.ActualValue_Enable 			:= 1;]]>
</Line>
<Line Number="454">
<![CDATA[	MC_Parametrization.ActualValue_Value_10 		:= i_diZeroPos_10 * diDecimalCorr;]]>
</Line>
<Line Number="455">
<![CDATA[]]>
</Line>
<Line Number="456">
<![CDATA[	MC_Parametrization.UpperMappingEnd_Enable			:= 1;]]>
</Line>
<Line Number="457">
<![CDATA[	MC_Parametrization.UpperMappingEnd_Value_34 		:= rUpperMappingEndCalc;]]>
</Line>
<Line Number="458">
<![CDATA[	MC_Parametrization.UpperLimit_Enable 				:= 1;]]>
</Line>
<Line Number="459">
<![CDATA[	MC_Parametrization.UpperLimit_Value_36 				:= rUpperLimitCalc;]]>
</Line>
<Line Number="460">
<![CDATA[	MC_Parametrization.LowerLimit_Enable 				:= 1;]]>
</Line>
<Line Number="461">
<![CDATA[	MC_Parametrization.LowerLimit_Value_38 				:= rLowerLimitCalc;]]>
</Line>
<Line Number="462">
<![CDATA[	MC_Parametrization.PositioningWindow_Enable			:= 1;]]>
</Line>
<Line Number="463">
<![CDATA[	MC_Parametrization.PositioningWindow_Value_40		:= rPositionWindowCalc;]]>
</Line>
<Line Number="464">
<![CDATA[	MC_Parametrization.LoopLength_Enable 				:= 1;]]>
</Line>
<Line Number="465">
<![CDATA[	MC_Parametrization.LoopLength_Value_42 				:= i_diZeroLoopLength_42;]]>
</Line>
<Line Number="466">
<![CDATA[	MC_Parametrization.TargetSpeed_Enable				:= 1;]]>
</Line>
<Line Number="467">
<![CDATA[	MC_Parametrization.TargetSpeed_Value_52				:= i_diZeroTargetSpeed_52;]]>
</Line>
<Line Number="468">
<![CDATA[	MC_Parametrization.TargetSpeedManualRun_Enable 		:= 1;]]>
</Line>
<Line Number="469">
<![CDATA[	MC_Parametrization.TargetSpeedManualRun_Value_58	:= i_diZeroTargetSpeedManual_58;]]>
</Line>
<Line Number="470">
<![CDATA[	MC_Parametrization.DeliveryState_113 				:= 1;]]>
</Line>
<Line Number="471">
<![CDATA[	MC_Parametrization.SaveSettings_113 				:= 1;]]>
</Line>
<Line Number="472">
<![CDATA[	MC_Parametrization.Execute 							:= 1;]]>
</Line>
<Line Number="473">
<![CDATA[	]]>
</Line>
<Line Number="474">
<![CDATA[end_if;]]>
</Line>
<Line Number="475">
<![CDATA[]]>
</Line>
<Line Number="476">
<![CDATA[MC_Parametrization(]]>
</Line>
<Line Number="477">
<![CDATA[MC_Parametrization]]>
</Line>
<Line Number="478">
<![CDATA[,MC]]>
</Line>
<Line Number="479">
<![CDATA[,i_xConnectionFaulted]]>
</Line>
<Line Number="480">
<![CDATA[,i_iParameter_ID]]>
</Line>
<Line Number="481">
<![CDATA[,i_diParameter_Value]]>
</Line>
<Line Number="482">
<![CDATA[,i_iSubindex]]>
</Line>
<Line Number="483">
<![CDATA[,q_iParameter_ID]]>
</Line>
<Line Number="484">
<![CDATA[,q_diParameter_Value]]>
</Line>
<Line Number="485">
<![CDATA[,q_iSubindex]]>
</Line>
<Line Number="486">
<![CDATA[,4000]]>
</Line>
<Line Number="487">
<![CDATA[);]]>
</Line>
<Line Number="488">
<![CDATA[]]>
</Line>
<Line Number="489">
<![CDATA[if MC_Parametrization.Execute]]>
</Line>
<Line Number="490">
<![CDATA[then]]>
</Line>
<Line Number="491">
<![CDATA[	if MC_Parametrization.Done]]>
</Line>
<Line Number="492">
<![CDATA[	then]]>
</Line>
<Line Number="493">
<![CDATA[		diPositionSetpointSaved		:= MC_Parametrization.ActualValue_Value_10;]]>
</Line>
<Line Number="494">
<![CDATA[		MC_Parametrization.Execute 		:= 0;]]>
</Line>
<Line Number="495">
<![CDATA[		iq_sErrorID						:= 0;]]>
</Line>
<Line Number="496">
<![CDATA[		q_iErrorParameter				:= 0;]]>
</Line>
<Line Number="497">
<![CDATA[		iq_iRqZeroPos					:= 0;]]>
</Line>
<Line Number="498">
<![CDATA[	elsif (MC_Parametrization.Error and (MC_Parametrization.ErrorID <> 0))]]>
</Line>
<Line Number="499">
<![CDATA[	then]]>
</Line>
<Line Number="500">
<![CDATA[		diPositionSetpointSaved		:= 0;]]>
</Line>
<Line Number="501">
<![CDATA[		MC_Parametrization.Execute 		:= 0;]]>
</Line>
<Line Number="502">
<![CDATA[		iq_sErrorID						:= MC_Parametrization.ErrorID;]]>
</Line>
<Line Number="503">
<![CDATA[		q_iErrorParameter				:= MC_Parametrization.ErrorParameter;]]>
</Line>
<Line Number="504">
<![CDATA[		iq_iRqZeroPos					:= 0;]]>
</Line>
<Line Number="505">
<![CDATA[	end_if;]]>
</Line>
<Line Number="506">
<![CDATA[end_if;]]>
</Line>
<Line Number="507">
<![CDATA[	]]>
</Line>
<Line Number="508">
<![CDATA[	]]>
</Line>
<Line Number="509">
<![CDATA[(*]]>
</Line>
<Line Number="510">
<![CDATA[############################]]>
</Line>
<Line Number="511">
<![CDATA[MC_Error]]>
</Line>
<Line Number="512">
<![CDATA[############################]]>
</Line>
<Line Number="513">
<![CDATA[*)]]>
</Line>
<Line Number="514">
<![CDATA[]]>
</Line>
<Line Number="515">
<![CDATA[MC_Error(]]>
</Line>
<Line Number="516">
<![CDATA[MC_Error]]>
</Line>
<Line Number="517">
<![CDATA[,MC]]>
</Line>
<Line Number="518">
<![CDATA[,strMcErrorDescription]]>
</Line>
<Line Number="519">
<![CDATA[,i_xConnectionFaulted]]>
</Line>
<Line Number="520">
<![CDATA[,i_iStatus_Word]]>
</Line>
<Line Number="521">
<![CDATA[);]]>
</Line>
<Line Number="522">
<![CDATA[]]>
</Line>
<Line Number="523">
<![CDATA[MC_Error.Enable := 1;]]>
</Line>
<Line Number="524">
<![CDATA[]]>
</Line>
<Line Number="525">
<![CDATA[if MC_Error.Error]]>
</Line>
<Line Number="526">
<![CDATA[	and (MC_Error.ErrorID <> 0)]]>
</Line>
<Line Number="527">
<![CDATA[then]]>
</Line>
<Line Number="528">
<![CDATA[	iq_sErrorID 			:= MC_Error.ErrorID;]]>
</Line>
<Line Number="529">
<![CDATA[end_if;]]>
</Line>
<Line Number="530">
<![CDATA[]]>
</Line>
<Line Number="531">
<![CDATA[(*]]>
</Line>
<Line Number="532">
<![CDATA[############################]]>
</Line>
<Line Number="533">
<![CDATA[Alarm Management]]>
</Line>
<Line Number="534">
<![CDATA[############################]]>
</Line>
<Line Number="535">
<![CDATA[*)]]>
</Line>
<Line Number="536">
<![CDATA[]]>
</Line>
<Line Number="537">
<![CDATA[//first there's the check if the fault comes from a network problem]]>
</Line>
<Line Number="538">
<![CDATA[// If presence alrm communication whne rq running, waiting time for reset alrm, because this alrm in ]]>
</Line>
<Line Number="539">
<![CDATA[// PLC Open and clear only presence new comand, if not clear cmd problem in communication]]>
</Line>
<Line Number="540">
<![CDATA[]]>
</Line>
<Line Number="541">
<![CDATA[//xEnableCheckTimeOutNetwork:=i_xEnable ]]>
</Line>
<Line Number="542">
<![CDATA[//			AND (iq_xRqCmdPos OR iq_xRqJogFw OR iq_xRqJogBw OR (i_iNumberDrive = iq_iRqZeroPos));]]>
</Line>
<Line Number="543">
<![CDATA[]]>
</Line>
<Line Number="544">
<![CDATA[TONR(tonCommunicationAlrm);]]>
</Line>
<Line Number="545">
<![CDATA[tonCommunicationAlrm.EnableIn:=1 ;]]>
</Line>
<Line Number="546">
<![CDATA[tonCommunicationAlrm.PRE:=i_diDelayTimeAlrmNetwork;]]>
</Line>
<Line Number="547">
<![CDATA[//tonCommunicationAlrm.TimerEnable:=((MC_Error.ErrorID & 16#0F00) = 16#0700)]]>
</Line>
<Line Number="548">
<![CDATA[//				AND  xEnableCheckTimeOutNetwork ;]]>
</Line>
<Line Number="549">
<![CDATA[				]]>
</Line>
<Line Number="550">
<![CDATA[tonCommunicationAlrm.TimerEnable:=i_xConnectionFaulted AND i_xEnable ;]]>
</Line>
<Line Number="551">
<![CDATA[]]>
</Line>
<Line Number="552">
<![CDATA[if tonCommunicationAlrm.DN]]>
</Line>
<Line Number="553">
<![CDATA[then]]>
</Line>
<Line Number="554">
<![CDATA[	q_xNetworkFault := 1;]]>
</Line>
<Line Number="555">
<![CDATA[	iq_xSelStopType := 1;]]>
</Line>
<Line Number="556">
<![CDATA[	iMoveStep := 0;]]>
</Line>
<Line Number="557">
<![CDATA[else]]>
</Line>
<Line Number="558">
<![CDATA[	q_xNetworkFault := 0;]]>
</Line>
<Line Number="559">
<![CDATA[end_if;]]>
</Line>
<Line Number="560">
<![CDATA[]]>
</Line>
<Line Number="561">
<![CDATA[//in case the fault is not coming from a network problem we deliver the motor fault]]>
</Line>
<Line Number="562">
<![CDATA[//#xErrorSetupParam:= not filter from #xErrorActive, because It does not have to be resettable]]>
</Line>
<Line Number="563">
<![CDATA[//#xErrorActive:= filter signal for PlcOpen Alrm of MC, necessary for reset alarm]]>
</Line>
<Line Number="564">
<![CDATA[//#q_xNetworkFault:= disable alrm ]]>
</Line>
<Line Number="565">
<![CDATA[xErrorSetupParam:=]]>
</Line>
<Line Number="566">
<![CDATA[(MC_PosParametrization.Error and (MC_PosParametrization.ErrorID <> 0))]]>
</Line>
<Line Number="567">
<![CDATA[or (MC_Parametrization.Error and (MC_Parametrization.ErrorID <> 0));]]>
</Line>
<Line Number="568">
<![CDATA[]]>
</Line>
<Line Number="569">
<![CDATA[q_xMotorFault :=]]>
</Line>
<Line Number="570">
<![CDATA[(xErrorSetupParam]]>
</Line>
<Line Number="571">
<![CDATA[OR (]]>
</Line>
<Line Number="572">
<![CDATA[	(MC_ReadParameter.Error	and (MC_ReadParameter.ErrorID <> 0))]]>
</Line>
<Line Number="573">
<![CDATA[	or (MC_WriteParameter.Error and (MC_WriteParameter.ErrorID <> 0))]]>
</Line>
<Line Number="574">
<![CDATA[	or (MC_Move.Error and (MC_Move.ErrorID <> 0) and MC_Move.Release)]]>
</Line>
<Line Number="575">
<![CDATA[	or (MC_Error.Error 	and (MC_Error.ErrorID <> 0))]]>
</Line>
<Line Number="576">
<![CDATA[	]]>
</Line>
<Line Number="577">
<![CDATA[	) and xErrorActive]]>
</Line>
<Line Number="578">
<![CDATA[	)]]>
</Line>
<Line Number="579">
<![CDATA[	And i_xEnable]]>
</Line>
<Line Number="580">
<![CDATA[	and not q_xNetworkFault;]]>
</Line>
<Line Number="581">
<![CDATA[	]]>
</Line>
<Line Number="582">
<![CDATA[if q_xMotorFault]]>
</Line>
<Line Number="583">
<![CDATA[then]]>
</Line>
<Line Number="584">
<![CDATA[	iq_xSelStopType 			:= 1;]]>
</Line>
<Line Number="585">
<![CDATA[end_if;]]>
</Line>
<Line Number="586">
<![CDATA[]]>
</Line>
<Line Number="587">
<![CDATA[]]>
</Line>
<Line Number="588">
<![CDATA[]]>
</Line>
<Line Number="589">
<![CDATA[]]>
</Line>
<Line Number="590">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
