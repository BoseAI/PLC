//////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(xAlwaysOFF)[OTE(DB_MiddlePos.i_xEnable) ,OTE(DB_MiddlePos.i_xMot_Safety) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(xAlwaysOFF)[OTE(DB_MiddlePos.i_xJogEnable) ,OTE(DB_MiddlePos.i_xCheckEncMoving) ,OTE(DB_MiddlePos.i_xDisableAlrmSafety) ,OTE(DB_MiddlePos.i_xExclusionTimeout) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.HW_IN_xMagBarrier)XIC(iq_CM_MultiPalletsMagazine.HW_IN_xDelayEmergency)OTE(DB_MiddlePos.i_xDelayEmergency);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[Manag_Motor_Or_Inverter_TargetPos(DB_MiddlePos,i_iHighLimit,i_iLowLimit,i_iMiddlePos,i_DeltaMoveSlowSpeed,iWindow,i_WorkSpeed,i_SlowSpeed,i_iDeltaError_Speed,TON_MotorTimeOut.PRE,iq_CM_MultiPalletsMagazine.IN_xRqMiddlePos,xNotUsed,xNotUsed,xNotUsed,xNotUsed,iq_DB_Encoder);]]>
</Text>
