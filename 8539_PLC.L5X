<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(IQ_ResetButton)XIC(I_AutomaticCycleActive)[OTL(IQ_MsgBit014) ,OTU(IQ_ResetButton) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(IQ_ResetButton)XIO(I_AutomaticCycleActive)[OTL(L_CountResetRequest) ,OTU(IQ_ResetButton) ,MOVE(0,L_CaseState) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(L_CountResetRequest)[TON(L_T_Exit,?,?) ,XIC(IQ_PlcPanel_TextPanel8) TON(L_T_Message,?,?) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(L_T_Message.DN)OTE(IQ_ResetRequest);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(L_CountResetRequest)JMP(END);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQ(L_CaseState,0)[MOVE(I_PlcPanel_PageDisplayed,L_PageSaved) ,MOVE(I_DataDefined_PageReset,IQ_PlcPanel_PageToDisplay) ,OTU(IQ_CancelResetButton) ,OTU(IQ_ConfirmResetButton) ,MOVE(10,L_CaseState) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQ(L_CaseState,10)[XIC(IQ_ConfirmResetButton) [OTL(IQ_Movement_InhibitionRq) ,OTL(IQ_PlcPanel_TextPanel8) ,MOVE(L_PageSaved,IQ_PlcPanel_PageToDisplay) ] ,[XIC(IQ_CancelResetButton) ,XIC(L_T_Message.DN) ,XIC(L_T_Exit.DN) ] [MOVE(L_PageSaved,IQ_PlcPanel_PageToDisplay) ,MOVE(20,L_CaseState) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQ(L_CaseState,20)EQ(I_PlcPanel_PageDisplayed,L_PageSaved)OTU(L_CountResetRequest)OTU(IQ_ConfirmResetButton)OTU(IQ_CancelResetButton)OTU(IQ_PlcPanel_TextPanel8);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[LBL(END)NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
