<Routine Name="CM_PAL_Sampling_OnRoller" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(Timers.N[132].PRE,EM_PAL.TON_DelayTimeForResetSampling.PRE)MOVE(Timers.N[133].PRE,EM_PAL.TON_DelayBeltStartSampling.PRE)MOVE(Timers.N[134].PRE,EM_PAL.TON_DelayBeltStopSampling.PRE)MOVE(Timers.N[135].PRE,EM_PAL.TON_DelayWaitingCaseDepositForSampling.PRE)MOVE(Timers.N[136].PRE,EM_PAL.TON_DelayMovementCaseDepositForSampling.PRE)MOVE(Timers.N[141].PRE,EM_PAL.TON_DelayCaseExitWaitingForSampling.PRE)MOVE(10000,EM_PAL.TON_MaxLoadSamplingDelay.PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Button rq sampling]]>
</Comment>
<Text>
<![CDATA[XIC(IN.S7415_01)ONS(EM_PAL.AxPtrig[2])OTL(EM_Pal_HMI_PB.Rq_xSampling);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Button HMI rq sampling]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.MachineWorkData.Rq_xSampling)XIO(UM_HMI.MachineWorkData.St_xSampling)[OTL(UM_HMI.MachineWorkData.St_xSampling) ,OTU(UM_HMI.MachineWorkData.Rq_xSampling) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(UM_HMI.MachineWorkData.Rq_xSampling) XIC(UM_HMI.MachineWorkData.St_xSampling) ,XIC(BB.FirstScan) ,XIO(EM_PAL.Sampling_xIN_PROGRESS) ONS(EM_PAL.AxPtrig[5]) ][OTU(UM_HMI.MachineWorkData.St_xSampling) ,OTU(UM_HMI.MachineWorkData.Rq_xSampling) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(UM_HMI.MachineWorkData.St_xSampling)ONS(EM_PAL.AxPtrig[3])OTL(EM_Pal_HMI_PB.Rq_xSampling);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[MES rq sampling]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.MachineWorkData.Rq_xSampling)ONS(EM_PAL.AxPtrig[4])OTL(EM_Pal_HMI_PB.Rq_xSampling);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Size Rq Sampling]]>
</Comment>
<Text>
<![CDATA[GT(SizeWork.Outfeed.AutomaticSamplingFrequency,1)EQ(SizeWork.Outfeed.AutomaticSamplingFrequency,UM_HMI.Production.iAutomaticSamplingCaseNumberCount)[OTL(EM_Pal_HMI_PB.Rq_xSampling) ,MOVE(0,UM_HMI.Production.iAutomaticSamplingCaseNumberCount) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(OM_Interface.xCaseShiftPos4ToRobot)ONS(EM_PAL.AxPtrig[4])ADD(UM_HMI.Production.iAutomaticSamplingCaseNumberCount,1,UM_HMI.Production.iAutomaticSamplingCaseNumberCount);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(BB.FirstScan)MOVE(0,UM_HMI.Production.iAutomaticSamplingCaseNumberCount);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Service message: Function not allowed]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Pal_HMI_PB.Rq_xSampling)[XIC(EM_PAL.Sampling_xIN_PROGRESS) ,XIC(EM_PAL.Rework_xIN_PROGRESS) ,XIC(OM_Empty.xEnable) ][OTL(MSG[12]) ,OTU(EM_Pal_HMI_PB.Rq_xSampling) ,OTU(UM_HMI.MachineWorkData.St_xSampling) ];]]>
