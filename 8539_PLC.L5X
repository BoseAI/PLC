<Routine Name="CM_PAL_LayerConfig_Finder" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[//load number of layers on pallet.]]>
</Line>
<Line Number="2">
<![CDATA[EM_PAL.iLayerTypeFinder_PalletLayers := PAL_SizeWork.Palletizer.Generals.R112;]]>
</Line>
<Line Number="3">
<![CDATA[//load the number of elements in the structure.]]>
</Line>
<Line Number="4">
<![CDATA[EM_PAL.iLayerTypeFinder_Elements := 120;]]>
</Line>
<Line Number="5">
<![CDATA[EM_PAL.iLayerTypeFinder_ElementToStartSearch := 48;]]>
</Line>
<Line Number="6">
<![CDATA[EM_PAL.iLayerTypeFinder_ElementToEndSearch := 95;]]>
</Line>
<Line Number="7">
<![CDATA[//load the configuration of the palletizer generals.]]>
</Line>
<Line Number="8">
<![CDATA[COP(PAL_SizeWork.Palletizer.Generals, EM_PAL.arrLayerTypeFinder_PalGenerals[0], EM_PAL.iLayerTypeFinder_Elements);]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[//clear the found configuration to check afterwards.]]>
</Line>
<Line Number="11">
<![CDATA[EM_PAL.iLayerTypeFinder_InterlayerFound := 0;]]>
</Line>
<Line Number="12">
<![CDATA[EM_PAL.iLayerTypeFinder_GlueFound := 0;]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[FOR EM_PAL.iLayerTypeFinder_Index := EM_PAL.iLayerTypeFinder_ElementToStartSearch TO EM_PAL.iLayerTypeFinder_ElementToEndSearch BY 1]]>
</Line>
<Line Number="15">
<![CDATA[DO]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[	IF EM_PAL.iLayerTypeFinder_PalletLayers >= EM_PAL.iLayerTypeFinder_Index - EM_PAL.iLayerTypeFinder_ElementToStartSearch]]>
</Line>
<Line Number="18">
<![CDATA[	THEN]]>
</Line>
<Line Number="19">
<![CDATA[	]]>
</Line>
<Line Number="20">
<![CDATA[		CASE EM_PAL.arrLayerTypeFinder_PalGenerals[EM_PAL.iLayerTypeFinder_Index]]]>
</Line>
<Line Number="21">
<![CDATA[		OF]]>
</Line>
<Line Number="22">
<![CDATA[			0:]]>
</Line>
<Line Number="23">
<![CDATA[				//error - not programmed on HMI.]]>
</Line>
<Line Number="24">
<![CDATA[				]]>
</Line>
<Line Number="25">
<![CDATA[			1:]]>
</Line>
<Line Number="26">
<![CDATA[				//A config.]]>
</Line>
<Line Number="27">
<![CDATA[				]]>
</Line>
<Line Number="28">
<![CDATA[			2:]]>
</Line>
<Line Number="29">
<![CDATA[				//B config.]]>
</Line>
<Line Number="30">
<![CDATA[				]]>
</Line>
<Line Number="31">
<![CDATA[			3:]]>
</Line>
<Line Number="32">
<![CDATA[				//Interlayer+A config.]]>
</Line>
<Line Number="33">
<![CDATA[				EM_PAL.iLayerTypeFinder_InterlayerFound := 1;]]>
</Line>
<Line Number="34">
<![CDATA[				]]>
</Line>
<Line Number="35">
<![CDATA[			4:]]>
</Line>
<Line Number="36">
<![CDATA[				//Interlayer+B config.]]>
</Line>
<Line Number="37">
<![CDATA[				EM_PAL.iLayerTypeFinder_InterlayerFound := 1;]]>
</Line>
<Line Number="38">
<![CDATA[				]]>
</Line>
<Line Number="39">
<![CDATA[			5:]]>
</Line>
<Line Number="40">
<![CDATA[				//Glue+A config.]]>
</Line>
<Line Number="41">
<![CDATA[				EM_PAL.iLayerTypeFinder_GlueFound := 1;]]>
</Line>
<Line Number="42">
<![CDATA[				]]>
</Line>
<Line Number="43">
<![CDATA[			6:]]>
</Line>
<Line Number="44">
<![CDATA[				//Glue+B config.]]>
</Line>
<Line Number="45">
<![CDATA[				EM_PAL.iLayerTypeFinder_GlueFound := 1;]]>
</Line>
<Line Number="46">
<![CDATA[				]]>
</Line>
<Line Number="47">
<![CDATA[		END_CASE;]]>
</Line>
<Line Number="48">
<![CDATA[			]]>
</Line>
<Line Number="49">
<![CDATA[	ELSE]]>
</Line>
<Line Number="50">
<![CDATA[		]]>
</Line>
<Line Number="51">
<![CDATA[		EM_PAL.iLayerTypeFinder_Index := EM_PAL.iLayerTypeFinder_ElementToEndSearch;]]>
</Line>
<Line Number="52">
<![CDATA[	]]>
</Line>
<Line Number="53">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="54">
<![CDATA[	]]>
</Line>
<Line Number="55">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="CM_PAL_Mot_SamplingOutfeed" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MOT_SAMPLING_RUN]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL.xRQ_MOT_SAMPLING_ON)XIO(EM_PAL.xRQ_MOT_REWORK_ON)[OTL(EM_PAL.xMOT_SAMPLING_RUN) ,OTU(EM_PAL.xRQ_MOT_SAMPLING_ON) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(EM_PAL.xRQ_MOT_SAMPLING_OFF)[OTU(EM_PAL.xMOT_SAMPLING_RUN) ,OTU(EM_PAL.xRQ_MOT_SAMPLING_OFF) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Cmd motore sampling per sampling]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL.xMOT_SAMPLING_RUN)XIO(EM_PAL.xMOT_REWORK_RUN)XIC(IN.K7430_01)OTE(OUT.K7430_01_BWD);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[MOT_REWORK_RUN]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL.xRQ_MOT_REWORK_ON)XIO(EM_PAL.xRQ_MOT_SAMPLING_ON)[OTL(EM_PAL.xMOT_REWORK_RUN) ,OTU(EM_PAL.xRQ_MOT_REWORK_ON) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(EM_PAL.xRQ_MOT_REWORK_OFF)[OTU(EM_PAL.xMOT_REWORK_RUN) ,OTU(EM_PAL.xRQ_MOT_REWORK_OFF) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Cmd motore sampling per reintroduzione]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL.xMOT_REWORK_RUN)XIO(EM_PAL.xMOT_SAMPLING_RUN)XIC(IN.K7430_01)OTE(OUT.K7430_01_FWD);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Alarm: Protezione motore uscita pallet zona pallettizzazione]]>
</Comment>
<Text>
<![CDATA[XIO(IN.K7430_01)OTE(ALRM[346]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
