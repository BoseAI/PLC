</DefaultData>
</Parameter>
<Parameter Name="O_State_CheckOn" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="O_State_CheckOff" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="O_CheckOn_Ons" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="O_CheckOff_Ons" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="CalcPos" DataType="REAL" Radix="Float" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_EdgeBit_CheckOn" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_EdgeBit_CheckOff" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(O_State)OTU(O_State_CheckOn)OTU(O_CheckOn_Ons)OTU(O_State_CheckOff)OTU(O_CheckOff_Ons);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQ(I_OnValue,I_OffValue)JMP(L_Exit);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[DIV(I_SpeedDegreeSec,1000,CalcPos) ,MUL(I_Advance,CalcPos,CalcPos) ,ADD(I_ActPos,CalcPos,CalcPos) ,GE(CalcPos,I_PosUnwind) SUB(CalcPos,I_PosUnwind,CalcPos) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[LT(I_OnValue,I_OffValue) GE(CalcPos,I_OnValue) LE(CalcPos,I_OffValue) ,GT(I_OnValue,I_OffValue) [GE(CalcPos,I_OnValue) ,LE(CalcPos,I_OffValue) ] ]OTL(O_State);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQ(I_OnCheckValue,I_OffCheckValue)OTU(O_State_CheckOn)OTU(O_CheckOn_Ons)OTU(O_State_CheckOff)OTU(O_CheckOff_Ons)JMP(L_Exit);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[LT(I_OnCheckValue,I_OffValue) GE(CalcPos,I_OnCheckValue) LE(CalcPos,I_OffValue) ,GT(I_OnCheckValue,I_OffValue) [GE(CalcPos,I_OnCheckValue) ,LE(CalcPos,I_OffValue) ] ]XIC(O_State)OTL(O_State_CheckOn);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(O_State_CheckOn)ONS(L_EdgeBit_CheckOn)OTL(O_CheckOn_Ons);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[LT(I_OffCheckValue,I_OnValue) GE(CalcPos,I_OffCheckValue) LE(CalcPos,I_OnValue) ,GT(I_OffCheckValue,I_OnValue) [GE(CalcPos,I_OffCheckValue) ,LE(CalcPos,I_OnValue) ] ]XIO(O_State)OTL(O_State_CheckOff);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(O_State_CheckOff)ONS(L_EdgeBit_CheckOff)OTL(O_CheckOff_Ons);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[LBL(L_Exit)TND();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Teleservice" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2025-10-02T09:37:40.405Z" CreatedBy="DESKTOP-I4HL37F\admin" EditedDate="2025-10-02T10:16:03.575Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v32.01"
>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="q_xActive" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="q_xStCmd" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="iq_xRqCmd" TagType="Base" DataType="BOOL" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="iq_xWrng" TagType="Base" DataType="BOOL" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="iq_xMsgFunctionNotAllowed" TagType="Base" DataType="BOOL" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="i_xInhibit" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_xFeedback" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="xState" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[if iq_xRqCmd and i_xInhibit then]]>
</Line>
<Line Number="2">
<![CDATA[	iq_xRqCmd:= 0;]]>
</Line>
<Line Number="3">
<![CDATA[	iq_xMsgFunctionNotAllowed := 1;]]>
</Line>
<Line Number="4">
<![CDATA[elsif iq_xRqCmd and not xState then]]>
</Line>
<Line Number="5">
<![CDATA[	if not q_xStCmd then]]>
</Line>
<Line Number="6">
<![CDATA[		xState := 1;]]>
</Line>
<Line Number="7">
<![CDATA[		iq_xRqCmd := 0;]]>
</Line>
<Line Number="8">
<![CDATA[	else]]>
</Line>
<Line Number="9">
<![CDATA[		iq_xMsgFunctionNotAllowed := 1;]]>
</Line>
<Line Number="10">
<![CDATA[		iq_xRqCmd := 0;]]>
</Line>
<Line Number="11">
<![CDATA[	end_if;]]>
</Line>
<Line Number="12">
<![CDATA[elsif iq_xRqCmd and xState and q_xStCmd then]]>
</Line>
<Line Number="13">
<![CDATA[	xState := 0;]]>
</Line>
<Line Number="14">
<![CDATA[	iq_xRqCmd := 0;]]>
</Line>
<Line Number="15">
<![CDATA[end_if;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[if i_xFeedback then]]>
</Line>
<Line Number="18">
<![CDATA[	iq_xWrng := 1;]]>
</Line>
<Line Number="19">
<![CDATA[end_if;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[q_xStCmd := i_xFeedback;]]>
</Line>
<Line Number="22">
<![CDATA[q_xActive := xState;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="UpdateNrPick" Class="Standard" Revision="0.1" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-12-04T13:57:04.300Z" CreatedBy="ds-PC\ds" EditedDate="2025-09-11T13:35:44.816Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v36.00"
>
<Description>
<![CDATA[v0.1	    : 11.09.2023
Author      : Ing.Utili Nicola
Comment: Start from 8379 ]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="i_iTypeOfLayer" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_iNrReleaseForLayerA" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_iNrReleaseForLayerB" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_iNrPalletLayer" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="iq_iCurrentLayerNr" TagType="Base" DataType="INT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[-]]>
</Description>
</Parameter>
<Parameter Name="iq_iCurrentReleaseNr" TagType="Base" DataType="INT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[-]]>
</Description>
</Parameter>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// Increase the number of pickup cases]]>
</Line>
<Line Number="4">
<![CDATA[iq_iCurrentReleaseNr := iq_iCurrentReleaseNr + 1;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[// Verify type layer (A o B)]]>
</Line>
<Line Number="7">
<![CDATA[CASE i_iTypeOfLayer OF]]>
</Line>
<Line Number="8">
<![CDATA[    1,3,5:  // Layer A]]>
</Line>
<Line Number="9">
<![CDATA[        IF iq_iCurrentReleaseNr <= i_iNrReleaseForLayerA THEN]]>
</Line>
<Line Number="10">
<![CDATA[            // The layer is not finished]]>
</Line>
<Line Number="11">
<![CDATA[            // No action, we're leaving]]>
</Line>
<Line Number="12">
<![CDATA[        ELSE]]>
</Line>
<Line Number="13">
<![CDATA[            // The layer is finished]]>
</Line>
<Line Number="14">
<![CDATA[            iq_iCurrentReleaseNr := 1;]]>
</Line>
<Line Number="15">
<![CDATA[            iq_iCurrentLayerNr := iq_iCurrentLayerNr + 1;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[            IF iq_iCurrentLayerNr > i_iNrPalletLayer THEN]]>
</Line>
<Line Number="18">
<![CDATA[                iq_iCurrentLayerNr := 1;]]>
</Line>
<Line Number="19">
<![CDATA[            END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[    2,4,6:  // Layer B]]>
</Line>
<Line Number="23">
<![CDATA[        IF iq_iCurrentReleaseNr <= i_iNrReleaseForLayerB THEN]]>
</Line>
<Line Number="24">
<![CDATA[            // The layer is not finished]]>
</Line>
<Line Number="25">
<![CDATA[            // No action, we're leaving]]>
</Line>
<Line Number="26">
<![CDATA[        ELSE]]>
</Line>
<Line Number="27">
<![CDATA[            // The layer is finished]]>
</Line>
<Line Number="28">
<![CDATA[            iq_iCurrentReleaseNr := 1;]]>
</Line>
<Line Number="29">
<![CDATA[            iq_iCurrentLayerNr := iq_iCurrentLayerNr + 1;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[            IF iq_iCurrentLayerNr > i_iNrPalletLayer THEN]]>
</Line>
<Line Number="32">
<![CDATA[                iq_iCurrentLayerNr := 1;]]>
</Line>
<Line Number="33">
<![CDATA[            END_IF;]]>
</Line>
<Line Number="34">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="35">
<![CDATA[END_CASE;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
<Tags>
