<Line Number="392">
<![CDATA[]]>
</Line>
<Line Number="393">
<![CDATA[// LABELLER IN STANDBY]]>
</Line>
<Line Number="394">
<![CDATA[xLabelerStateInStandBy := LabelerDataReceived.usiLabelerInternalState.0 AND NOT LabelerDataReceived.usiLabelerInternalState.2;]]>
</Line>
<Line Number="395">
<![CDATA[]]>
</Line>
<Line Number="396">
<![CDATA[// LABELLER IN IDLE]]>
</Line>
<Line Number="397">
<![CDATA[xLabelerStateInIdle := LabelerDataReceived.usiLabelerInternalState.4 AND NOT LabelerDataReceived.usiLabelerInternalState.5;]]>
</Line>
<Line Number="398">
<![CDATA[]]>
</Line>
<Line Number="399">
