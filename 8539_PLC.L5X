<Routine Name="MessageManagement" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(UM_Config.Core.Enable_HMI_SE) JMP(ME) ,XIC(UM_Config.Core.Enable_HMI_SE) JMP(SE) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[SE]]>
</Comment>
<Text>
<![CDATA[LBL(SE)NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB.FirstScan)MOVE(0,i)MOVE(0,n);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[LBL(CYCLE)[XIC(MSG[i]) OTL(Core_HMI.Interface.iMessageDisplayed[i]) ,XIO(MSG[i]) OTU(Core_HMI.Interface.iMessageDisplayed[i]) ]ADD(i,1,i)[LT(i,160) JMP(CYCLE) ,GE(i,160) MOVE(0,i) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(MSG[n]) XIO(UM_Machine.TON_ServiceMessageDisplay.DN) [OTL(xMsgFinded) ,MOVE(n,diMsgFindBit) ] ,XIO(MSG[n]) [LT(n,160) ADD(n,1,n) ,GE(n,160) MOVE(0,n) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(xMsgFinded)[TON(UM_Machine.TON_ServiceMessageDisplay,?,?) ,XIC(UM_Machine.TON_ServiceMessageDisplay.DN) [OTU(xMsgFinded) ,OTU(MSG[diMsgFindBit]) ,[LT(n,160) ADD(n,1,n) ,GE(n,160) MOVE(0,n) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ME]]>
</Comment>
<Text>
<![CDATA[LBL(ME)NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[GT(diMsgBitPoint,159) ,XIC(BB.FirstScan) ]CLR(diMsgBitPoint);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[XIC(MSG[diMsgBitPoint]) XIO(UM_Machine.TON_ServiceMessageDisplay.DN) [OTL(xMsgFinded) ,MOVE(diMsgBitPoint,diMsgFindBit) ] ,XIO(MSG[diMsgBitPoint]) ADD(diMsgBitPoint,1,diMsgBitPoint) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(xMsgFinded)[MOVE(diMsgFindBit,Core_HMI.Interface.St_iMessageDisplayed) ,TON(UM_Machine.TON_ServiceMessageDisplay,?,?) ,XIC(UM_Machine.TON_ServiceMessageDisplay.DN) [OTU(xMsgFinded) ,GT(diMsgBitPoint,159) CLR(diMsgBitPoint) ,OTU(MSG[diMsgBitPoint]) ,ADD(diMsgBitPoint,1,diMsgBitPoint) ,CLR(Core_HMI.Interface.St_iMessageDisplayed) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
