<Routine Name="Main_OM_ShiftPalChange_T2" Type="RLL">
<Description>
<![CDATA[v0.2        : 26.05.2026
Author      : Boselli Mattia

v0.1        : 21.02.2023
Author      : Ing.Utili Nicola
Comment: Startup from 7995_Roche and Base CPH2 V140]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Emergency pallet changeover cycle with immediate stop]]>
</Comment>
<Text>
<![CDATA[[XIC(OM_ShiftPalChange.xRq_ImmediateStop) ,XIC(BB.St_Emergency_ImmediateStop) ,XIC(BB.St_Emergency_PhaseStop) XIC(OM_ShiftPalChange.xSt_ImmediateStop) ,XIC(BB.Rq_EmergencyPhaseStop) ][OTE(OM_ShiftPalChange.xSt_ImmediateStop) ,OTU(OM_ShiftPalChange.xRq_ImmediateStop) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Pallet magazine automatic cycle]]>
</Comment>
<Text>
<![CDATA[XIC(BB.Automatic_CycleActive)XIO(OM_ShiftPalChange.xSt_ImmediateStop)XIC(DB_Pal_RobotIO.DO.x70)OTE(OM_ShiftPalChange.xRqAutoCycle);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Pallet changeover cycle request]]>
</Comment>
<Text>
<![CDATA[[XIC(OM_ShiftPalChange.xRqAutoCycle) ,XIC(OM_ShiftPalChange.xRqManualCycle) ]OTE(OM_ShiftPalChange.xRqChangeoverPalletCycle);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Last confirm done from hmi]]>
</Comment>
<Text>
<![CDATA[[XIC(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletTransit_FWD) ,XIC(OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_xPalletTransit_FWD) ,XIC(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletTransit_FWD) ,XIC(OM_ShiftPalChange_HMI.Pos4_Palletizing.St_xPalletTransit_FWD) ,XIC(OM_ShiftPalChange_HMI.Pos5_Outfeed_Wait.St_xPalletTransit_FWD) ,XIC(OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_xPalletTransit_FWD) ,XIC(OM_ShiftPalChange_HMI.Pos7_Outfeed_Exit.St_xPalletTransit_FWD) ]OTE(OM_ShiftPalChange.xPalletMoving);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PalChangeShift_Status" Type="RLL">
<Description>
<![CDATA[v0.1        : 21.02.2023
Author      : Ing.Utili Nicola
Comment: Startup from 7995_Roche and Base CPH2 V140]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////
RESET OS MAGAZINE
///////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(0,OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_iPallet_Hmi);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletPresence)[XIC(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletTransit_FWD) MOVE(2,OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_iPallet_Hmi) ,XIC(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletTransit_BWD) MOVE(3,OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_iPallet_Hmi) ,XIO(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletTransit_FWD) XIO(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletTransit_BWD) MOVE(1,OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_iPallet_Hmi) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////
POS INFEED WAIT TRANSFER ZONE
///////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MOVE(0,OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_iPallet_Hmi);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_xPalletPresence)[XIC(OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_xPalletTransit_FWD) MOVE(2,OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_iPallet_Hmi) ,XIC(OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_xPalletTransit_BWD) MOVE(3,OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_iPallet_Hmi) ,XIO(OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_xPalletTransit_FWD) XIO(OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_xPalletTransit_BWD) MOVE(1,OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_iPallet_Hmi) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////
POS TRANSFER ZONE
///////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[MOVE(0,OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_iPallet_Hmi);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletPresence)[XIC(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletTransit_FWD) MOVE(2,OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_iPallet_Hmi) ,XIC(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletTransit_BWD) MOVE(3,OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_iPallet_Hmi) ,XIO(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletTransit_FWD) XIO(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletTransit_BWD) MOVE(1,OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_iPallet_Hmi) ];]]>
