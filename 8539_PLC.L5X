<Routines>
<Routine Name="Calc_PreStacker_WithBundleTransfer" Type="ST">
<Description>
<![CDATA[-]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// v0.1        : 07.05.2026]]>
</Line>
<Line Number="1">
<![CDATA[// Author      : Boselli Mattia]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// SYS.N[4]  --> Stacker: distance between traps (pre-stacker)]]>
</Line>
<Line Number="4">
<![CDATA[// SYS.N[5]  --> Stacker: Lower traps height (pre-stacker)]]>
</Line>
<Line Number="5">
<![CDATA[// SYS.N[6]  --> Stacker: Distance for prestacker with bundle pneum elevator]]>
</Line>
<Line Number="6">
<![CDATA[// SYS.N[42] --> Stacker: Middle Position]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[EM_Infeed.rDimProdForCalcLayerInPrestacker := OM_Interface.Machine_rProdHeight;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[EM_Infeed.Stacker_xPreStackerExclusion := OM_Interface.Machine_rProdHeight >= SYS.N[5]; ]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[EM_Infeed.Stacker_iLayersIndTrans_WithCompBund := (SYS.N[4] / EM_Infeed.rDimProdForCalcLayerInPrestacker); ]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[IF UM_Config.CP.EnablePneumSingleElevatorBundle ]]>
</Line>
<Line Number="15">
<![CDATA[THEN]]>
</Line>
<Line Number="16">
<![CDATA[	IF (OM_Interface.BundleTransfer_xUpperLifterPos OR OM_Interface.BundleTransfer_xInForwardPos)]]>
</Line>
<Line Number="17">
<![CDATA[	THEN]]>
</Line>
<Line Number="18">
<![CDATA[		EM_Infeed.Stacker_iLayersIndTrans_WithoutCompBund :=]]>
</Line>
<Line Number="19">
<![CDATA[			( SYS.N[6] + SYS.N[4] - ( SYS.N[42] / 10 - SYS.N[5] ) ) / EM_Infeed.rDimProdForCalcLayerInPrestacker;]]>
</Line>
<Line Number="20">
<![CDATA[	ELSE]]>
</Line>
<Line Number="21">
<![CDATA[		EM_Infeed.Stacker_iLayersIndTrans_WithoutCompBund :=]]>
</Line>
<Line Number="22">
<![CDATA[			( SYS.N[4] - ( SYS.N[42] / 10 - SYS.N[5] ) ) / EM_Infeed.rDimProdForCalcLayerInPrestacker;]]>
</Line>
<Line Number="23">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="24">
<![CDATA[ELSE]]>
</Line>
<Line Number="25">
<![CDATA[	EM_Infeed.Stacker_iLayersIndTrans_WithoutCompBund :=]]>
</Line>
<Line Number="26">
<![CDATA[		( SYS.N[4] - ( SYS.N[42] / 10 - SYS.N[5] ) ) / EM_Infeed.rDimProdForCalcLayerInPrestacker;]]>
</Line>
<Line Number="27">
<![CDATA[END_IF;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[EM_Infeed.Stacker_iActualPosWithProd := EM_Infeed.rDimProdForCalcLayerInPrestacker + EM_Infeed.CM_Stacker.AxisOUT_rActualPos;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[IF EM_Infeed.Stacker_xLayersCompleted]]>
</Line>
<Line Number="32">
<![CDATA[THEN]]>
</Line>
<Line Number="33">
<![CDATA[	EM_Infeed.Stacker_xPreStackerCycleInhibit := EM_Infeed.Stacker_iLayersIndTrans_WithCompBund <= UM_HMI.MachineWorkData.St_iActualLayerNumber;]]>
</Line>
<Line Number="34">
<![CDATA[ELSE ]]>
</Line>
<Line Number="35">
<![CDATA[	EM_Infeed.Stacker_xPreStackerCycleInhibit := EM_Infeed.Stacker_iLayersIndTrans_WithoutCompBund <= UM_HMI.MachineWorkData.St_iActualLayerNumber;]]>
</Line>
<Line Number="36">
<![CDATA[END_IF;]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Calc_Stacker_WithBundleTransfer" Type="ST">
<Description>
<![CDATA[-]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[IF EM_Infeed.Stacker_xRqCounterLayerIncrease ]]>
</Line>
<Line Number="2">
<![CDATA[THEN]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[	UM_HMI.MachineWorkData.St_iActualLayerNumber 	:= UM_HMI.MachineWorkData.St_iActualLayerNumber + 1;]]>
</Line>
<Line Number="5">
<![CDATA[	EM_Infeed.Stacker_xRqCounterLayerIncrease		:= 0;]]>
</Line>
<Line Number="6">
<![CDATA[	]]>
</Line>
<Line Number="7">
<![CDATA[END_IF;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[IF (EM_Infeed.Stacker_xRqCounterLayerReset OR EM_Infeed.Stacker_xRqManualReset) ]]>
</Line>
<Line Number="10">
<![CDATA[THEN]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[	UM_HMI.MachineWorkData.St_iActualLayerNumber	:= 0;]]>
</Line>
<Line Number="13">
<![CDATA[	EM_Infeed.Stacker_xRqCounterLayerReset			:= 0;]]>
</Line>
<Line Number="14">
<![CDATA[	]]>
</Line>
<Line Number="15">
<![CDATA[END_IF;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[EM_Infeed.Stacker_xLayersCompleted		:= (SizeWork.Stacker.LayersNumber <= UM_HMI.MachineWorkData.St_iActualLayerNumber);]]>
</Line>
<Line Number="18">
<![CDATA[EM_Infeed.Stacker_xLastLayerInProgress	:= (SizeWork.Stacker.LayersNumber - UM_HMI.MachineWorkData.St_iActualLayerNumber) <= 1;]]>
</Line>
<Line Number="19">
<![CDATA[		]]>
</Line>
<Line Number="20">
<![CDATA[IF	BB.Count_EnableCheckOfResetCounts AND]]>
</Line>
<Line Number="21">
<![CDATA[	(UM_HMI.MachineWorkData.St_iActualLayerNumber <> 0]]>
</Line>
<Line Number="22">
<![CDATA[		OR EM_Infeed.Stacker_iSeqChange <> 0)]]>
</Line>
<Line Number="23">
<![CDATA[THEN]]>
</Line>
<Line Number="24">
<![CDATA[	BB.Count_GrtZero := 1;]]>
</Line>
<Line Number="25">
<![CDATA[END_IF;		]]>
</Line>
<Line Number="26">
<![CDATA[	]]>
</Line>
<Line Number="27">
<![CDATA[	]]>
</Line>
<Line Number="28">
<![CDATA[IF UM_Config.CP.EnablePneumSingleElevatorBundle ]]>
</Line>
<Line Number="29">
<![CDATA[THEN]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[	OM_Interface.Infeed_iLayersAboveTopTrap := SYS.N[6] / OM_Interface.Machine_rProdHeight;]]>
</Line>
<Line Number="32">
<![CDATA[		]]>
</Line>
<Line Number="33">
<![CDATA[	IF OM_Interface.Infeed_iLayersAboveTopTrap >= 1 ]]>
</Line>
<Line Number="34">
<![CDATA[	THEN]]>
</Line>
<Line Number="35">
<![CDATA[		OM_Interface.Infeed_xEnabled_ElevatorTransferUP := 1;]]>
</Line>
<Line Number="36">
<![CDATA[	ELSE]]>
</Line>
<Line Number="37">
<![CDATA[	   	OM_Interface.Infeed_xEnabled_ElevatorTransferUP := 0;]]>
</Line>
<Line Number="38">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="39">
<![CDATA[ELSE]]>
</Line>
<Line Number="40">
<![CDATA[	OM_Interface.Infeed_xEnabled_ElevatorTransferUP := 0;]]>
</Line>
<Line Number="41">
<![CDATA[	OM_Interface.Infeed_iLayersAboveTopTrap := 0;	]]>
</Line>
<Line Number="42">
<![CDATA[	]]>
</Line>
<Line Number="43">
<![CDATA[END_IF;	]]>
</Line>
<Line Number="44">
<![CDATA[	]]>
</Line>
</STContent>
</Routine>
<Routine Name="CM_Axis_Stacker" Type="RLL">
<Description>
<![CDATA[v0.1 : 20.07.2022
Author: Ing.Utili Nicola
Comment : Startup TraversingBar_Data
from 7903_CPV20 And BaseCph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************************************************************************************************************************************************************************************************************************************************************************
CALL AXIS MANAGEMENT
******************************************************************************************************************************************************************************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[MOVE(SYS.N[86],EM_Infeed_HMI_PB.St_iHomeAxisPosition_Stacker) ,MOVE(402,EM_Infeed.CM_Stacker.HmiIN_iPageToDisplayHomeAbs) ,MOVE(EM_Infeed.CM_Stacker.AxisIN_POS_arTargetPos[1],EM_Infeed.CM_Stacker.AxisIN_HOME_rTargetPos) ]MOVE(0.0,EM_Infeed.CM_Stacker.rPeriode)MOVE(Timers.N[55].PRE,EM_Infeed.TON_DelayTimeStartStacker.PRE)[MOVE(1.0,EM_Infeed.CM_Stacker.AxisIN_POS_rDeltaOn) ,MOVE(1.0,EM_Infeed.CM_Stacker.AxisIN_POS_rDeltaOff) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[NE(EM_Infeed_HMI_PB.Rq_iManual_Stacker_CmdPos,0)OTL(EM_Infeed.Stacker_xManualCtrlEnabling);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
