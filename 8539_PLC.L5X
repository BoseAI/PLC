<![CDATA[JSR(CM_Motor_StackerBelt,0);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[JSR(CM_YV_Hopper,0);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[JSR(CM_YV_ProductGate,0);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[JSR(CM_YV_ProductStop,0);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
