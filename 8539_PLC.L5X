<Routine Name="CM_OpenFlapcheck" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// da CM_OutfeedOpenFlapcheck TIA17 v63]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[IF BB.FirstScan]]>
</Line>
<Line Number="3">
<![CDATA[THEN]]>
</Line>
<Line Number="4">
<![CDATA[    EM_PAL_Infeed_HMI_PB .St_xOptGr_OpenFlapsCheckEnabling := 1;]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[IF  EM_PAL_Infeed_HMI_PB .Rq_xOptGr_OpenFlapsCheckEnabling]]>
</Line>
<Line Number="8">
<![CDATA[THEN]]>
</Line>
<Line Number="9">
<![CDATA[    IF  BB .Automatic_CycleActive]]>
</Line>
<Line Number="10">
<![CDATA[    THEN]]>
</Line>
<Line Number="11">
<![CDATA[         MSG[12] := 1;]]>
</Line>
<Line Number="12">
<![CDATA[         EM_PAL_Infeed_HMI_PB .Rq_xOptGr_OpenFlapsCheckEnabling := 0;]]>
</Line>
<Line Number="13">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="14">
<![CDATA[    IF NOT  EM_PAL_Infeed_HMI_PB .St_xOptGr_OpenFlapsCheckEnabling]]>
</Line>
<Line Number="15">
<![CDATA[        AND   EM_PAL_Infeed_HMI_PB .Rq_xOptGr_OpenFlapsCheckEnabling]]>
</Line>
<Line Number="16">
<![CDATA[    THEN]]>
</Line>
<Line Number="17">
<![CDATA[         EM_PAL_Infeed_HMI_PB .St_xOptGr_OpenFlapsCheckEnabling := 1;]]>
</Line>
<Line Number="18">
<![CDATA[         EM_PAL_Infeed_HMI_PB .Rq_xOptGr_OpenFlapsCheckEnabling := 0;]]>
</Line>
<Line Number="19">
<![CDATA[    ELSIF  EM_PAL_Infeed_HMI_PB .St_xOptGr_OpenFlapsCheckEnabling]]>
</Line>
<Line Number="20">
<![CDATA[        AND  EM_PAL_Infeed_HMI_PB .Rq_xOptGr_OpenFlapsCheckEnabling]]>
</Line>
<Line Number="21">
<![CDATA[    THEN]]>
</Line>
<Line Number="22">
<![CDATA[         EM_PAL_Infeed_HMI_PB .St_xOptGr_OpenFlapsCheckEnabling := 0;]]>
</Line>
<Line Number="23">
<![CDATA[         EM_PAL_Infeed_HMI_PB .Rq_xOptGr_OpenFlapsCheckEnabling := 0;]]>
</Line>
<Line Number="24">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="25">
<![CDATA[END_IF;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[IF NOT  EM_PAL_Infeed_HMI_PB .St_xOptGr_OpenFlapsCheckEnabling]]>
</Line>
<Line Number="28">
<![CDATA[    //AND  BB .Automatic_CycleActive]]>
</Line>
<Line Number="29">
<![CDATA[    AND NOT  BB .NoLoadRun_Enable]]>
</Line>
<Line Number="30">
<![CDATA[THEN]]>
</Line>
<Line Number="31">
<![CDATA[     WRNG[45] := 1;]]>
</Line>
<Line Number="32">
<![CDATA[END_IF;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[ ALRM[246] := 0;]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[IF NOT  BB .FirstScan]]>
</Line>
<Line Number="37">
<![CDATA[    AND NOT  BB .Rq_AlrmGuard]]>
</Line>
<Line Number="38">
<![CDATA[    AND NOT  BB .NoLoadRun_Enable]]>
</Line>
<Line Number="39">
<![CDATA[    AND  EM_PAL_Infeed_HMI_PB .St_xOptGr_OpenFlapsCheckEnabling]]>
</Line>
<Line Number="40">
<![CDATA[THEN]]>
</Line>
<Line Number="41">
<![CDATA[    IF NOT  IN.B3800_01]]>
</Line>
<Line Number="42">
<![CDATA[        OR NOT  IN.B3800_02]]>
</Line>
<Line Number="43">
<![CDATA[    THEN]]>
</Line>
<Line Number="44">
<![CDATA[        IF  OM_ShiftCases_HMI .Pos2_Closing.St_xCasePresence]]>
</Line>
<Line Number="45">
<![CDATA[        THEN]]>
</Line>
<Line Number="46">
<![CDATA[             OM_ShiftCases_HMI .Pos2_Closing.St_xCaseOpenFlap := 0;   //bad pos]]>
</Line>
<Line Number="47">
<![CDATA[        ELSIF  OM_ShiftCases_HMI .Pos3_Outfeed.St_xCasePresence]]>
</Line>
<Line Number="48">
<![CDATA[        THEN]]>
</Line>
<Line Number="49">
<![CDATA[             OM_ShiftCases_HMI .Pos3_Outfeed.St_xCaseOpenFlap := 0;   //bad pos]]>
</Line>
<Line Number="50">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="51">
<![CDATA[    //     ALRM .N[246] := 1;   //alarm]]>
</Line>
<Line Number="52">
<![CDATA[    //     EM_Outfeed .xExitMotorEnable := 0;   //immediate stop of outfeed belts]]>
</Line>
<Line Number="53">
<![CDATA[     END_IF;]]>
</Line>
<Line Number="54">
<![CDATA[     ]]>
</Line>
<Line Number="55">
<![CDATA[     IF  NOT IN.B3800_01]]>
</Line>
<Line Number="56">
<![CDATA[        OR  NOT IN.B3800_02]]>
</Line>
<Line Number="57">
<![CDATA[        OR]]>
</Line>
<Line Number="58">
<![CDATA[         OM_ShiftCases_HMI.Pos2_Closing.St_xCaseOpenFlap]]>
</Line>
<Line Number="59">
<![CDATA[        OR]]>
</Line>
<Line Number="60">
<![CDATA[         OM_ShiftCases_HMI.Pos3_Outfeed.St_xCaseOpenFlap]]>
</Line>
<Line Number="61">
<![CDATA[     THEN]]>
</Line>
<Line Number="62">
<![CDATA[         ALRM[246] := 1;   //alarm]]>
</Line>
<Line Number="63">
<![CDATA[         EM_PAL_Infeed .xCaseTransportMotorEnable := 0;]]>
</Line>
<Line Number="64">
<![CDATA[     END_IF;]]>
</Line>
<Line Number="65">
<![CDATA[     ]]>
</Line>
<Line Number="66">
<![CDATA[END_IF;]]>
</Line>
<Line Number="67">
<![CDATA[]]>
</Line>
<Line Number="68">
<![CDATA[IF NOT  EM_PAL_Infeed_HMI_PB .St_xOptGr_OpenFlapsCheckEnabling]]>
</Line>
<Line Number="69">
<![CDATA[THEN]]>
</Line>
<Line Number="70">
<![CDATA[     BB.Safe_RqFixedOrangeLamp := 1;]]>
</Line>
<Line Number="71">
<![CDATA[END_IF;]]>
</Line>
<Line Number="72">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
