<![CDATA[[XIC(BB_CRS.Timer_SaveInProgress) NE(Core_HMI_CRS.Interface.iPageDisplayed,Core_HMI_CRS.Interface.iSavingPageNumber) ,XIC(BB_CRS.FirstScan) ]OTU(BB_CRS.Timer_SaveInProgress);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
