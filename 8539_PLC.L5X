<Comment>
<![CDATA[Richiesta ciclo manuale cambio pallet]]>
</Comment>
<Text>
<![CDATA[[XIC(BB.Automatic_CycleActive) ,XIC(OM_ShiftPalChange.xSt_ImmediateStop) ][OTU(OM_ShiftPalChange.xRqManualCycle) ,OTU(OM_Interface.PalChange_xRqManual_WitPalletInPalZone) ,OTU(EM_PalChange_Hmi_PB.Rq_xManual_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Richiesta ciclo manuale cambio pallet]]>
</Comment>
<Text>
<![CDATA[XIC(OM_ShiftPalChange.xRqManualCycle)[XIO(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletPresence) ,XIC(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletPresence) ]XIO(OM_Interface.PalOutfeed_xChain1_Moving)XIO(OM_Interface.PalOutfeed_xChain2_Moving)XIO(OM_Interface.PalMag_xPalletConvMotorInPalletArea)XIO(OM_Interface.PalMag_xMagazineMoving)XIO(OM_Interface.PalChange_xTransferPalletMoving)XIO(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletTransit_FWD)XIO(OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_xPalletTransit_FWD)XIO(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletTransit_FWD)XIO(OM_ShiftPalChange_HMI.Pos4_Palletizing.St_xPalletTransit_FWD)XIO(OM_ShiftPalChange_HMI.Pos5_Outfeed_Wait.St_xPalletTransit_FWD)XIO(OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_xPalletTransit_FWD)[TON(EM_PalChange.TON_DelayCtrlPalletPresence,?,?) ,XIC(EM_PalChange.TON_DelayCtrlPalletPresence.DN) OTU(OM_ShiftPalChange.xRqManualCycle) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(OM_ShiftPalChange.xRqManualCycle)OTE(EM_PalChange_Hmi_PB.St_xManual_CycleInProgress);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB.FirstScan)FLL(0,EM_PalChange,1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Config,0);]]>
