<![CDATA[[[XIC(BB.WrngRq_Horn) ,XIC(BB.Key_LampTest) ,XIO(UM_Config.Core.Enable_SAFE_LampsType) XIC(BB.WrngRq_PackingMatOutCondition) XIC(BB.Automatic_CycleActive) XIO(Core_HMI.PB.St_xSirenMuting) XIC(UM_Config.Core.Enable_AcousticAlarm) ] XIC(BB.Clock_1000ms) ,XIC(UM_Config.Core.Enable_SAFE_LampsType) [XIC(BB.WrngRq_PackingMatOutCondition) ,XIC(BB.Safe_RqBuzzerForWrngStopProduction) ] XIC(BB.Automatic_CycleActive) XIO(TimeIF_WarningHorn.Q_xSensor) ]XIC(DB_Force.Bit[5])OTE(OUT.P0500_01_HORN);]]>
