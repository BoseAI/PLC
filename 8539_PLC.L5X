<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(1000,Ton_DelayStartTestPneum1.PRE)MOVE(1000,Ton_DelayStartTestPneum2.PRE)MOVE(1000,Ton_DelayStartTestElectric.PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(iq_xRqTest)XIC(i_xDisableTestCond)[OTU(iq_xRqTest) ,OTU(iq_xActive) ,OTL(iq_Msg_IllegalFunction) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)XIC(i_xDisableTestCond)OTU(iq_xActive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)OTL(iq_xRqInibitAllMov);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(iq_xRqTest)XIO(iq_xActive)[OTL(iq_xActive) ,OTU(iq_xRqTest) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(iq_xRqTest)XIC(iq_xActive)[OTU(iq_xActive) ,OTU(iq_xRqTest) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(iq_xActive)[MOVE(0,diBrakeStep) ,OTL(q_x1stPneumBrake) ,OTL(q_x2ndPneumBrake) ,OTU(q_xElectricBrakeUnlockRq) ,OTU(xRqIncBrakeStep) ,OTU(xActiveCheckTollerancePos) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NE(diBrakeStep,0)OTE(q_xTestInProgress);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Disable Axis1
]]>
</Comment>
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,0)[MOVE(0,q_Word_ElectricalTest) ,MOVE(0,q_Word_1stPneumTest) ,MOVE(0,q_Word_2ndPneumTest) ,XIO(IO_Axis1.DriveEnableStatus) [XIO(IO_Axis2.DriveEnableStatus) ,LE(I_NrOfAxis,1) ] OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Disable Cpu Mayr
]]>
</Comment>
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,1)[OTU(q_x1stPneumBrake) ,OTU(q_x2ndPneumBrake) ,OTU(q_xElectricBrakeUnlockRq) ,OTU(xActiveCheckTollerancePos) ,XIO(i_xAirPressureSwitch) XIO(xUnbrakeDone) OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,2)[OTL(q_xElectricBrakeUnlockRq) ,OTL(q_x2ndPneumBrake) ,OTL(xActiveCheckTollerancePos) ,MOVE(1,q_Word_1stPneumTest) ,XIC(Ifb_DelayCheckDeltaPos.Q_xSensor) [MOVE(2,q_Word_1stPneumTest) ,OTL(xRqIncBrakeStep) ] ,XIC(xDeltaPosAlrm) [MOVE(3,q_Word_1stPneumTest) ,MOVE(100,diBrakeStep) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,3)[OTU(q_x1stPneumBrake) ,OTU(q_x2ndPneumBrake) ,OTU(q_xElectricBrakeUnlockRq) ,OTU(xActiveCheckTollerancePos) ,XIO(Ifb_DelayCheckDeltaPos.Q_xSensor) OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,4)[OTL(q_x1stPneumBrake) ,OTL(q_xElectricBrakeUnlockRq) ,OTL(xActiveCheckTollerancePos) ,MOVE(1,q_Word_2ndPneumTest) ,XIC(Ifb_DelayCheckDeltaPos.Q_xSensor) [MOVE(2,q_Word_2ndPneumTest) ,OTL(xRqIncBrakeStep) ] ,XIC(xDeltaPosAlrm) [MOVE(3,q_Word_2ndPneumTest) ,MOVE(100,diBrakeStep) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,5)[OTU(q_xElectricBrakeUnlockRq) ,OTU(q_x1stPneumBrake) ,OTU(q_x2ndPneumBrake) ,OTU(xActiveCheckTollerancePos) ,XIO(Ifb_DelayCheckDeltaPos.Q_xSensor) OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,6)[OTL(q_x1stPneumBrake) ,OTL(q_x2ndPneumBrake) ,OTL(xActiveCheckTollerancePos) ,MOVE(1,q_Word_ElectricalTest) ,XIC(Ifb_DelayCheckDeltaPos.Q_xSensor) [MOVE(2,q_Word_ElectricalTest) ,OTL(xRqIncBrakeStep) ] ,XIC(xDeltaPosAlrm) [MOVE(3,q_Word_ElectricalTest) ,MOVE(100,diBrakeStep) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,7)[OTU(q_xElectricBrakeUnlockRq) ,OTU(q_x1stPneumBrake) ,OTU(q_x2ndPneumBrake) ,OTU(xActiveCheckTollerancePos) ,XIO(Ifb_DelayCheckDeltaPos.Q_xSensor) OTU(iq_xActive) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,100)[OTU(q_xElectricBrakeUnlockRq) ,OTU(q_x1stPneumBrake) ,OTU(q_x2ndPneumBrake) ,OTU(xActiveCheckTollerancePos) ,XIO(Ifb_DelayCheckDeltaPos.Q_xSensor) OTU(iq_xActive) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(xRqIncBrakeStep)[ADD(diBrakeStep,1,diBrakeStep) ,OTU(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////////////////////////////
CMD UNBRAKE
//////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIO(IO_Axis1.DriveEnableStatus)XIC(IO_Axis1.MechanicalBrakeOutputStatus)[XIO(IO_Axis2.DriveEnableStatus) XIC(IO_Axis2.MechanicalBrakeOutputStatus) ,LE(I_NrOfAxis,1) ]OTE(xUnbrakeDone);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////////////////////////////
CHECK MAX DEVIATION
//////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(q_xTestInProgress)ONS(axPTrig[4])[CLR(q_rMaxDeviationAx1) CLR(q_rMaxDeviationAx2) ,CLR(rCheckPosAx1) CLR(rCheckPosAx2) ,MOVE(IO_Axis1.ActualPosition,rBackUpPositionAx1) ,GT(I_NrOfAxis,1) MOVE(IO_Axis2.ActualPosition,rBackUpPositionAx2) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(q_xTestInProgress)[[XIC(xUnbrakeDone) ,XIC(q_x1stPneumBrake) ,XIC(q_x2ndPneumBrake) ] [SUB(IO_Axis1.ActualPosition,rBackUpPositionAx1,rCheckPosAx1) ABS(rCheckPosAx1,rCheckPosAx1) ,GT(I_NrOfAxis,1) SUB(IO_Axis2.ActualPosition,rBackUpPositionAx2,rCheckPosAx2) ABS(rCheckPosAx2,rCheckPosAx2) ] ,GT(rCheckPosAx1,q_rMaxDeviationAx1) MOVE(rCheckPosAx1,q_rMaxDeviationAx1) ,GT(I_NrOfAxis,1) GT(rCheckPosAx2,q_rMaxDeviationAx2) MOVE(rCheckPosAx2,q_rMaxDeviationAx2) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(q_xTestInProgress)[XIC(xActiveCheckTollerancePos) ,XIC(xUnbrakeDone) ,XIC(q_x1stPneumBrake) ,XIC(q_x2ndPneumBrake) ]OTE(Ifb_DelayCheckDeltaPos.I_xSensor);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[InputFilter(Ifb_DelayCheckDeltaPos,i_iDelayCheckDeltaPos,1000);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(q_xTestInProgress)[GT(rCheckPosAx1,i_rTollerance) ,GT(I_NrOfAxis,1) GT(rCheckPosAx2,i_rTollerance) ]OTE(xDeltaPosAlrm);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
