<![CDATA[[XIC(xAtLeastOneWarningActive) XIC(BB_CRS.Clock_500ms) ,XIC(BB_CRS.Manual_CmdEnable) ,XIC(BB_CRS.Key_LampTest) ]OTE(OUT_CRS.P9480_01_3_OG);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[OTU(xAtLeastOneWarningActive)OTU(xAtLeastOneMessageActive);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
