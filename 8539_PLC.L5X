<![CDATA[[XIO(iq_CIP_Axis.StdBits.O_DriveEnable) ,XIC(i_EM_xStStopImmediate) ,XIO(iq_BB.SetSize) ,XIC(iq_CIP_Axis.StdBits.I_AxisAlarm) ,XIC(iq_Axis.AxisIN_xRqStop) ,XIC(iq_Axis.AxisIN_JOG_xJogActive) ,XIC(iq_Axis.AxisIN_ENDLESS_xRqStart) ,XIC(iq_Hmi_xStManualBrakeTest) ,XIC(iq_Hmi_xStManualUnBrake) ][OTU(iq_Axis.AxisIN_CAM_xRqSynchro) ,OTU(xEnableMoveTo_NextPeriod) ,OTU(xRephasing_OutOfCamProfile) ,CLR(iq_CIP_Axis.diRephasingPointer) ];]]>
