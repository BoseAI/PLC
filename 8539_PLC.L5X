<Text>
<![CDATA[XIC(UM_Config.PAL.PneumCirucitMagazinePal)OTE(DB_Pal_AirGroupPalletMag.i_xEnableTypeCAT3);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(IN.K1440_01_Delay)XIC(IN.B7801_01)XIC(BB.EPN_ON)OTE(EM_PalMag.xAirPressureCondition);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
