<Routines>
<Routine Name="Calc_BackLimitEnable_CaseF" Type="ST">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// v0.1        : 07.05.2026]]>
</Line>
<Line Number="1">
<![CDATA[// Author      : Boselli Mattia]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// SYS.N[63] --> Pusher: Pos for return hopper]]>
</Line>
<Line Number="4">
<![CDATA[// SYS.N[218] --> Hopper: ForwardPosition]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[// EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[3] --> stroke in case]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[EM_CaseF.Hopper_iBackLimitEnable :=  EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[3] -  SYS.N[63] +  SizeWork.Pusher.Pusher_Hopper_ReturnAdvance;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[IF  SYS.N[63] >=  SizeWork.Pusher.Pusher_Hopper_ReturnAdvance THEN]]>
</Line>
<Line Number="11">
<![CDATA[    EM_CaseF.Pusher_iBackLimitEnable :=  SYS.N[218] + 10;]]>
</Line>
<Line Number="12">
<![CDATA[ELSE]]>
</Line>
<Line Number="13">
<![CDATA[    EM_CaseF.Pusher_iBackLimitEnable := (SYS.N[218] / 10) +  SYS.N[63] -  SizeWork.Pusher.Pusher_Hopper_ReturnAdvance;]]>
</Line>
<Line Number="14">
<![CDATA[END_IF;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[IF  EM_CaseF.CM_Pusher.AxisOUT_rActualPos <=  EM_CaseF.Hopper_iBackLimitEnable]]>
</Line>
<Line Number="17">
<![CDATA[THEN]]>
</Line>
<Line Number="18">
<![CDATA[    EM_CaseF.Hopper_xEnableMoveBackward := 1;]]>
</Line>
<Line Number="19">
<![CDATA[ELSE]]>
</Line>
<Line Number="20">
<![CDATA[    EM_CaseF.Hopper_xEnableMoveBackward := 0;]]>
</Line>
<Line Number="21">
<![CDATA[END_IF;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[IF  EM_CaseF.CM_Hopper.AxisOUT_rActualPos <=  EM_CaseF.Pusher_iBackLimitEnable]]>
</Line>
<Line Number="24">
<![CDATA[THEN]]>
</Line>
<Line Number="25">
<![CDATA[    EM_CaseF.xPusher_EnableMoveBackward := 1;]]>
</Line>
<Line Number="26">
<![CDATA[ELSE]]>
</Line>
<Line Number="27">
<![CDATA[    EM_CaseF.xPusher_EnableMoveBackward := 0;]]>
</Line>
<Line Number="28">
<![CDATA[END_IF;]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Calc_CountProd_CaseF" Type="ST">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// v0.1        : 07.05.2026]]>
</Line>
<Line Number="1">
<![CDATA[// Author      : Boselli Mattia]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[IF EM_CaseF.xRqCounterRowIncrease ]]>
</Line>
<Line Number="4">
<![CDATA[THEN]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[     UM_HMI.MachineWorkData.St_iActualRowsNumber := UM_HMI .MachineWorkData.St_iActualRowsNumber + 1;]]>
</Line>
<Line Number="7">
<![CDATA[     EM_CaseF .xRqCounterRowIncrease := 0;]]>
</Line>
<Line Number="8">
<![CDATA[	 ]]>
</Line>
<Line Number="9">
<![CDATA[ELSIF  EM_CaseF .xRqCountRowsReset OR  EM_CaseF .xRqRowsManualReset ]]>
</Line>
<Line Number="10">
<![CDATA[THEN]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[     UM_HMI .MachineWorkData.St_iActualRowsNumber := 0;]]>
</Line>
<Line Number="13">
<![CDATA[     EM_CaseF .xRqCountRowsReset := 0;]]>
</Line>
<Line Number="14">
<![CDATA[	 ]]>
</Line>
<Line Number="15">
<![CDATA[END_IF;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[EM_CaseF .xLastRowMem := (SizeWork.Pusher.RowsNr - UM_HMI .MachineWorkData.St_iActualRowsNumber) <= 1;]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[IF  BB .Count_EnableCheckOfResetCounts AND]]>
</Line>
<Line Number="20">
<![CDATA[    ( UM_HMI .MachineWorkData.St_iActualRowsNumber <> 0]]>
</Line>
<Line Number="21">
<![CDATA[    OR  EM_CaseF .iFilling_SeqChange <> 0) THEN]]>
</Line>
<Line Number="22">
<![CDATA[     BB .Count_GrtZero := 1;]]>
</Line>
<Line Number="23">
<![CDATA[END_IF;]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[OM_Interface.CaseF_xLastRow :=  EM_CaseF.xLastRowMem;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Calc_Pos_CaseF" Type="ST">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// v0.1        : 07.05.2026]]>
</Line>
<Line Number="1">
<![CDATA[// Author      : Boselli Mattia]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// SYS.N[3]  --> Pusher: Distance between PosInfeed - PosPartial]]>
</Line>
<Line Number="4">
<![CDATA[// SYS.N[33] --> Pusher: Distance between zero pos and infeed row]]>
</Line>
<Line Number="5">
<![CDATA[// SYS.N[34] --> Pusher: Distance for product waiting]]>
</Line>
<Line Number="6">
<![CDATA[// SYS.N[35] --> Pusher: Distance pos zero and pos case]]>
</Line>
<Line Number="7">
<![CDATA[// SYS.N[38] --> Pusher: Distance between infeed  Pos and Hopper Pos for camera]]>
</Line>
<Line Number="8">
<![CDATA[// SYS.N[39] --> Pusher: Distance for pos for photo]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[// EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[1] --> ]]>
</Line>
<Line Number="11">
<![CDATA[// EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[2] --> partial stroke]]>
</Line>
<Line Number="12">
<![CDATA[// EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[3] --> stroke in case]]>
</Line>
<Line Number="13">
<![CDATA[// EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[4] --> partial stroke for hopper]]>
</Line>
<Line Number="14">
<![CDATA[// EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[5] --> partial stroke for photo]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[IF BB.SetSize THEN]]>
</Line>
<Line Number="17">
<![CDATA[    EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[1] := SYS.N[33] - OM_Interface.Machine_rProdWidth - SYS.N[34];]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[    EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[2] := SYS.N[33] + SYS.N[3] ;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[    EM_CaseF.CM_Pusher.AxisIN_POS_arTargetPos[3] := SYS.N[35];]]>
</Line>
<Line Number="22">
