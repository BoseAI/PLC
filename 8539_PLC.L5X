<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[COP(iq_LayerSequence.R276, LayerSequence[1],48);]]>
</Line>
<Line Number="1">
<![CDATA[COP(iq_DepositSequence_LayerTypeA.R400, PlaceSequence_LayerTypeA[1], 60);]]>
</Line>
<Line Number="2">
<![CDATA[COP(iq_DepositSequence_LayerTypeB.R600, PlaceSequence_LayerTypeB[1], 60);]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[// I calculate the index to access the layer type]]>
</Line>
<Line Number="5">
<![CDATA[q_iCurrentLayerType :=LayerSequence[i_iCurrentPickLayerNr];]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[// I check the layer type and assign the release type]]>
</Line>
<Line Number="9">
<![CDATA[CASE q_iCurrentLayerType OF]]>
</Line>
<Line Number="10">
<![CDATA[    1,3,5: // Layer A (A o A+Intl)]]>
</Line>
<Line Number="11">
<![CDATA[        // Offset = (i_iCurrentPickReleaseNr - 1) * 16 + 202]]>
</Line>
<Line Number="12">
<![CDATA[        q_iCurrentReleaseType := PlaceSequence_LayerTypeA[i_iCurrentPickReleaseNr];]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[    2,4,6: // Layer B (B o B+Intl)]]>
</Line>
<Line Number="15">
<![CDATA[        // Offset = (i_iCurrentPickReleaseNr - 1) * 16 + 442]]>
</Line>
<Line Number="16">
<![CDATA[        q_iCurrentReleaseType := PlaceSequence_LayerTypeB[i_iCurrentPickReleaseNr];]]>
</Line>
<Line Number="17">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="F_2Chars_To_Byte" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2024-11-19T10:03:20.212Z" CreatedBy="DESKTOP-I4HL37F\admin" EditedDate="2025-12-03T13:47:22.830Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v36.00"
>
<Description>
<![CDATA[Funzione che converte i primi due caratteri della stringa di ingresso, caratteri da "0" a "9", da "A" a "F" e da "a" a "f", nel corrispettivo valore numerico esadecimale (es. "0"->0, "5"->5, "A"->0A, "D"->0D etc..) e salvato nel byte di output (conversione 1° carattere nei primi 4 bit, conversione 2° carattere nei secondi 4bit).
I caratteri lettera minuscoli da "a" a "f" vengono convertiti nel valore numerico esadecimale del corrispondente carattere lettera maiuscolo (es. "a"->"A"->0A, "c"->"C"->0C etc...)]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="I_sStringWithCharsToConvert" TagType="Base" DataType="STRING" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Q_usiByteWithCharsConvertedNumericalValu" TagType="Base" DataType="USINT" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="USINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="sCharToConvert" DataType="STRING" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[[0,'$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00$00']]]>
</DefaultData>
<DefaultData Format="String" Length="0">
<![CDATA['']]>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Funzione che converte i primi due caratteri della stringa di ingresso, caratteri da "0" a "9", da "A" a "F" e da "a" a "f", nel corrispettivo valore numerico esadecimale (es. "0"->0, "5"->5, "A"->0A, "D"->0D etc..) e salvato nel byte di output (conversione 1° carattere nei primi 4 bit, conversione 2° carattere nei secondi 4bit).
I caratteri lettera minuscoli da "a" a "f" vengono convertiti nel valore numerico esadecimale del corrispondente carattere lettera maiuscolo (es. "a"->"A"->0A, "c"->"C"->0C etc...)]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[(*]]>
</Line>
<Line Number="1">
<![CDATA[Funzione che converte i primi due caratteri della stringa di ingresso nei corrispondenti valori numerici esadecimali.]]>
</Line>
<Line Number="2">
<![CDATA[I caratteri e la conversione effettuata è come segue]]>
</Line>
<Line Number="3">
<![CDATA[Carattere			Valore numerico esadecimale				Valore numerico decimale]]>
</Line>
<Line Number="4">
<![CDATA["0"								00										0]]>
</Line>
<Line Number="5">
<![CDATA["1"								01										1]]>
</Line>
<Line Number="6">
<![CDATA["2"								02										2]]>
</Line>
<Line Number="7">
<![CDATA["3"								03										3]]>
</Line>
<Line Number="8">
<![CDATA["4"								04										4]]>
</Line>
<Line Number="9">
<![CDATA["5"								05										5]]>
</Line>
<Line Number="10">
<![CDATA["6"								06										6]]>
</Line>
<Line Number="11">
<![CDATA["7"								07										7										]]>
</Line>
<Line Number="12">
<![CDATA["8"								08										8]]>
</Line>
<Line Number="13">
<![CDATA["9"								09										9]]>
</Line>
<Line Number="14">
<![CDATA["A" o "a"						0A										10]]>
</Line>
<Line Number="15">
<![CDATA["B" o "b"						0B										11]]>
</Line>
<Line Number="16">
<![CDATA["C" o "c"						0C										12]]>
</Line>
<Line Number="17">
<![CDATA["D" o "d"						0D										13]]>
</Line>
<Line Number="18">
<![CDATA["E" o "e"						0E										14]]>
</Line>
<Line Number="19">
<![CDATA["F" o "f"						0F										15]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[Poichè ciascun carattere occupa 8bit mentre la sua conversione in valore numerico esadecimale da 0 a 0F (da 0 a 15 in valore decimale)]]>
</Line>
<Line Number="23">
<![CDATA[occupa 4 bit (poichè sono 16 informazioni diverse), i due valori numerici (4 bit + 4 bit) corrispondenti ai primi due caratteri della stringa,]]>
</Line>
<Line Number="24">
<![CDATA[vengono salvati negli 8 bit del byte di uscita (USINT). In particolare:]]>
</Line>
<Line Number="25">
<![CDATA[- Il valore numerico corrispondente al primo carattere della stringa viene salvato nei bit 4,5,6,7 del byte di uscita (USINT)]]>
</Line>
<Line Number="26">
<![CDATA[- Il valore numerico corrispondente al secondo carattere della stringa viene salvato nei bit 0,1,2,3 del byte di uscita (USINT)]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[Come si vede nella tabella sopra, i caratteri lettera minuscoli da "a" a "f" vengono convertiti nel valore numerico esadecimale]]>
</Line>
<Line Number="29">
<![CDATA[del corrispondente carattere lettera maiuscolo (es. "a"->"A"->0A, "c"->"C"->0C etc...)]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[*)]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[Q_usiByteWithCharsConvertedNumericalValu := 0;]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[//Estrapolo il primo carattere della stringa e scrivo il corrispondente valore binario nei bit 4,5,6,7]]>
</Line>
<Line Number="38">
<![CDATA[//del byte (USINT) di uscita]]>
</Line>
<Line Number="39">
<![CDATA[sCharToConvert := '';]]>
</Line>
<Line Number="40">
<![CDATA[MID(I_sStringWithCharsToConvert, 1, 1, sCharToConvert);]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[if sCharToConvert = '1' then]]>
</Line>
<Line Number="43">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.4 := 1;]]>
</Line>
<Line Number="44">
<![CDATA[	]]>
</Line>
<Line Number="45">
<![CDATA[elsif sCharToConvert = '2' then]]>
</Line>
<Line Number="46">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.5 := 1;]]>
</Line>
<Line Number="47">
<![CDATA[	]]>
</Line>
<Line Number="48">
<![CDATA[elsif sCharToConvert = '3' then]]>
</Line>
<Line Number="49">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.4 := 1;]]>
</Line>
<Line Number="50">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.5 := 1;]]>
</Line>
<Line Number="51">
<![CDATA[	]]>
</Line>
<Line Number="52">
<![CDATA[elsif sCharToConvert = '4' then]]>
</Line>
<Line Number="53">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.6 := 1;]]>
</Line>
<Line Number="54">
<![CDATA[	]]>
</Line>
<Line Number="55">
<![CDATA[elsif sCharToConvert = '5' then]]>
</Line>
<Line Number="56">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.4 := 1;]]>
</Line>
<Line Number="57">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.6 := 1;]]>
</Line>
<Line Number="58">
<![CDATA[	]]>
</Line>
<Line Number="59">
<![CDATA[elsif sCharToConvert = '6' then]]>
</Line>
<Line Number="60">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.5 := 1;]]>
</Line>
<Line Number="61">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.6 := 1;]]>
</Line>
<Line Number="62">
<![CDATA[	]]>
</Line>
<Line Number="63">
<![CDATA[elsif sCharToConvert = '7' then]]>
</Line>
<Line Number="64">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.4 := 1;]]>
</Line>
<Line Number="65">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.5 := 1;]]>
</Line>
<Line Number="66">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.6 := 1;]]>
</Line>
<Line Number="67">
<![CDATA[	]]>
</Line>
<Line Number="68">
<![CDATA[elsif sCharToConvert = '8' then]]>
</Line>
<Line Number="69">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.7:= 1;]]>
</Line>
<Line Number="70">
<![CDATA[	]]>
</Line>
<Line Number="71">
<![CDATA[elsif sCharToConvert = '9' then]]>
</Line>
<Line Number="72">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.4 := 1;]]>
</Line>
<Line Number="73">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.7 := 1;]]>
</Line>
<Line Number="74">
<![CDATA[	]]>
</Line>
<Line Number="75">
<![CDATA[elsif sCharToConvert = 'A' OR sCharToConvert = 'a' then]]>
</Line>
<Line Number="76">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.5 := 1;]]>
</Line>
<Line Number="77">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.7 := 1;]]>
</Line>
<Line Number="78">
<![CDATA[	]]>
</Line>
<Line Number="79">
<![CDATA[elsif sCharToConvert = 'B' OR sCharToConvert = 'b' then]]>
</Line>
<Line Number="80">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.4 := 1;]]>
</Line>
<Line Number="81">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.5 := 1;]]>
</Line>
<Line Number="82">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.7 := 1;]]>
</Line>
<Line Number="83">
<![CDATA[	]]>
</Line>
<Line Number="84">
<![CDATA[elsif sCharToConvert = 'C' OR sCharToConvert = 'c' then]]>
</Line>
<Line Number="85">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.6 := 1;]]>
</Line>
<Line Number="86">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.7 := 1;]]>
</Line>
<Line Number="87">
<![CDATA[	]]>
</Line>
<Line Number="88">
<![CDATA[elsif sCharToConvert = 'D' OR sCharToConvert = 'd' then]]>
</Line>
<Line Number="89">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.4 := 1;]]>
</Line>
<Line Number="90">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.6 := 1;]]>
</Line>
<Line Number="91">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.7 := 1;]]>
</Line>
<Line Number="92">
<![CDATA[	]]>
</Line>
<Line Number="93">
<![CDATA[elsif sCharToConvert = 'E' OR sCharToConvert = 'e' then]]>
</Line>
<Line Number="94">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.5 := 1;]]>
</Line>
<Line Number="95">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.6 := 1;]]>
</Line>
<Line Number="96">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.7 := 1;]]>
</Line>
<Line Number="97">
<![CDATA[	]]>
</Line>
<Line Number="98">
<![CDATA[elsif sCharToConvert = 'F' OR sCharToConvert = 'f' then]]>
</Line>
<Line Number="99">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.4 := 1;]]>
</Line>
<Line Number="100">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.5 := 1;]]>
</Line>
<Line Number="101">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.6 := 1;]]>
</Line>
<Line Number="102">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.7 := 1;	]]>
</Line>
<Line Number="103">
<![CDATA[	]]>
</Line>
<Line Number="104">
<![CDATA[end_if;]]>
</Line>
<Line Number="105">
<![CDATA[]]>
</Line>
<Line Number="106">
<![CDATA[]]>
</Line>
<Line Number="107">
<![CDATA[//Estrapolo il secondo carattere della stringa e scrivo il corrispondente valore binario nei bit 0,1,2,3]]>
</Line>
<Line Number="108">
<![CDATA[//del byte (USINT) di uscita]]>
</Line>
<Line Number="109">
<![CDATA[sCharToConvert := '';]]>
</Line>
<Line Number="110">
<![CDATA[MID(I_sStringWithCharsToConvert, 1, 2, sCharToConvert);]]>
</Line>
<Line Number="111">
<![CDATA[]]>
</Line>
<Line Number="112">
<![CDATA[if sCharToConvert = '1' then]]>
</Line>
<Line Number="113">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.0 := 1;]]>
</Line>
<Line Number="114">
<![CDATA[	]]>
</Line>
<Line Number="115">
<![CDATA[elsif sCharToConvert = '2' then]]>
</Line>
<Line Number="116">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.1 := 1;]]>
</Line>
<Line Number="117">
<![CDATA[	]]>
</Line>
<Line Number="118">
<![CDATA[elsif sCharToConvert = '3' then]]>
</Line>
<Line Number="119">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.0 := 1;]]>
</Line>
<Line Number="120">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.1 := 1;]]>
</Line>
<Line Number="121">
<![CDATA[	]]>
</Line>
<Line Number="122">
<![CDATA[elsif sCharToConvert = '4' then]]>
</Line>
<Line Number="123">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.2 := 1;]]>
</Line>
<Line Number="124">
<![CDATA[	]]>
</Line>
<Line Number="125">
<![CDATA[elsif sCharToConvert = '5' then]]>
</Line>
<Line Number="126">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.0 := 1;]]>
</Line>
<Line Number="127">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.2 := 1;]]>
</Line>
<Line Number="128">
<![CDATA[	]]>
</Line>
<Line Number="129">
<![CDATA[elsif sCharToConvert = '6' then]]>
</Line>
<Line Number="130">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.1 := 1;]]>
</Line>
<Line Number="131">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.2 := 1;]]>
</Line>
<Line Number="132">
<![CDATA[	]]>
</Line>
<Line Number="133">
<![CDATA[elsif sCharToConvert = '7' then]]>
</Line>
<Line Number="134">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.0 := 1;]]>
</Line>
<Line Number="135">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.1 := 1;]]>
</Line>
<Line Number="136">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.2 := 1;]]>
</Line>
<Line Number="137">
<![CDATA[	]]>
</Line>
<Line Number="138">
<![CDATA[elsif sCharToConvert = '8' then]]>
</Line>
<Line Number="139">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.3:= 1;]]>
</Line>
<Line Number="140">
<![CDATA[	]]>
</Line>
<Line Number="141">
<![CDATA[elsif sCharToConvert = '9' then]]>
</Line>
<Line Number="142">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.0 := 1;]]>
</Line>
<Line Number="143">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.3 := 1;]]>
</Line>
<Line Number="144">
<![CDATA[	]]>
</Line>
<Line Number="145">
<![CDATA[elsif sCharToConvert = 'A' OR sCharToConvert = 'a' then]]>
</Line>
<Line Number="146">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.1 := 1;]]>
</Line>
<Line Number="147">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.3 := 1;]]>
</Line>
<Line Number="148">
<![CDATA[	]]>
</Line>
<Line Number="149">
<![CDATA[elsif sCharToConvert = 'B' OR sCharToConvert = 'b' then]]>
</Line>
<Line Number="150">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.0 := 1;]]>
</Line>
<Line Number="151">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.1 := 1;]]>
</Line>
<Line Number="152">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.3 := 1;]]>
</Line>
<Line Number="153">
<![CDATA[	]]>
</Line>
<Line Number="154">
<![CDATA[elsif sCharToConvert = 'C' OR sCharToConvert = 'c' then]]>
</Line>
<Line Number="155">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.2 := 1;]]>
</Line>
<Line Number="156">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.3 := 1;]]>
</Line>
<Line Number="157">
<![CDATA[	]]>
</Line>
<Line Number="158">
<![CDATA[elsif sCharToConvert = 'D' OR sCharToConvert = 'd' then]]>
</Line>
<Line Number="159">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.0 := 1;]]>
</Line>
<Line Number="160">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.2 := 1;]]>
</Line>
<Line Number="161">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.3 := 1;]]>
</Line>
<Line Number="162">
<![CDATA[	]]>
</Line>
<Line Number="163">
<![CDATA[elsif sCharToConvert = 'E' OR sCharToConvert = 'e' then]]>
</Line>
<Line Number="164">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.1 := 1;]]>
</Line>
<Line Number="165">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.2 := 1;]]>
</Line>
<Line Number="166">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.3 := 1;]]>
</Line>
<Line Number="167">
<![CDATA[	]]>
</Line>
<Line Number="168">
<![CDATA[elsif sCharToConvert = 'F' OR sCharToConvert = 'f' then]]>
</Line>
<Line Number="169">
<![CDATA[	Q_usiByteWithCharsConvertedNumericalValu.0 := 1;]]>
