</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Manual_CmdEnable)[XIC(EM_Infeed_HMI_PB_CRS.Rq_xManual_Pusher_ON) [XIC(YV_Hopper.i_xSensorON) [OTL(EM_Infeed_HMI_PB_CRS.St_xManual_Pusher_ON) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Pusher_ON) ] ,XIO(YV_Hopper.i_xSensorON) [OTL(MSG_CRS[12]) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Pusher_ON) ] ] ,XIC(EM_Infeed_HMI_PB_CRS.Rq_xManual_Pusher_OFF) [OTL(EM_Infeed_HMI_PB_CRS.St_xManual_Pusher_OFF) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Pusher_OFF) ] ];]]>
