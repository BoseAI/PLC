<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTE(EN);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[ABS(i_Axis.CommandVelocity,rAuxReal)MUL(rAuxReal,i_rMotionResolution,rAuxReal)MUL(rAuxReal,60,rActSpeed);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[GT(rActSpeed,rRpmSpeedBackup)MOVE(rActSpeed,rRpmSpeedBackup);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(rRpmSpeedBackup,q_rSpeedReached);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[GT(rActSpeed,i_diLimitSpeedRPM) ,XIC(FLT) ]OTE(xLimitReached);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(xLimitReached) OTL(FLT) ,XIC(i_xReset) XIC(FLT) [OTU(FLT) ,CLR(rRpmSpeedBackup) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
