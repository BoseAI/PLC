<Routine Name="Config" Type="ST">
<Description>
<![CDATA[v0.1        : 21.02.2023
Author      : Ing.Utili Nicola
Comment: Startup from base cph2 V142]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[//Hardware configuration]]>
</Line>
<Line Number="2">
<![CDATA[UM_Config.PAL.DZP := 0;// Palletization area double Flex]]>
</Line>
<Line Number="3">
<![CDATA[UM_Config.PAL.UAP := 1;// Pallet automatic outfeed Flex]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[//Option]]>
</Line>
<Line Number="6">
<![CDATA[UM_Config.PAL.RU2 := 1;// Enable second station of exit pallet]]>
</Line>
<Line Number="7">
<![CDATA[UM_Config.PAL.RU3 := 0;// Enable third station of exit pallet]]>
</Line>
<Line Number="8">
<![CDATA[UM_Config.PAL.DisableButtonExitPallet:=1;]]>
</Line>
</STContent>
</Routine>
