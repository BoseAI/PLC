<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(O_xAxisCamGearTransfStatus)OTU(O_xAxisStopped)OTU(O_xAxisHomeOK)OTU(O_xAxisEnable)OTU(O_xAxisEnableInProgress);]]>
