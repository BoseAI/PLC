Calc rMasterSinchro Pos
******************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(iq_CIP_Axis.StdBits.O_SynchroInProgress)EQ(iq_CIP_Axis.diRephasingPointer,1)SUB(iq_Axis.rMasterPos,iq_CIP_Axis.rMasterOffset,rMasterPos_Shifted)FC_rMod(Module_FC[0],rMasterPos_Shifted,rMasterPos_Shifted,iq_Axis.rMasterPeriode)[EQ(iq_CIP_Axis.iTabUtilization,0) [MOVE(rMasterPos_Shifted,rMasterSynchroPos) ,MOVE(rMasterPos_Shifted,rRephasingMasterPos) ] ,EQ(iq_CIP_Axis.iTabUtilization,1) [GE(rMasterPos_Shifted,iq_CIP_Axis.iMasterStart_SynchroPos) LE(rMasterPos_Shifted,iq_CIP_Axis.iMasterEnd_SynchroPos) [MOVE(rMasterPos_Shifted,rMasterSynchroPos) ,MOVE(rMasterPos_Shifted,rRephasingMasterPos) ] ,LE(rMasterPos_Shifted,iq_CIP_Axis.iMasterStart_SynchroPos) LE(rMasterPos_Shifted,iq_CIP_Axis.iMasterEnd_SynchroPos) [[MOVE(iq_CIP_Axis.iMasterStart_SynchroPos,rMasterSynchroPos) ,MOVE(iq_CIP_Axis.iMasterStart_SynchroPos,rRephasingMasterPos) ] ,OTL(xRephasing_OutOfCamProfile) ] ,GE(rMasterPos_Shifted,iq_CIP_Axis.iMasterStart_SynchroPos) GE(rMasterPos_Shifted,iq_CIP_Axis.iMasterEnd_SynchroPos) [[MOVE(iq_CIP_Axis.iMasterStart_SynchroPos,rMasterSynchroPos) ,MOVE(iq_CIP_Axis.iMasterEnd_SynchroPos,rRephasingMasterPos) ] ,OTL(xRephasing_OutOfCamProfile) ] ] ]MOVE(2,iq_CIP_Axis.diRephasingPointer);]]>
