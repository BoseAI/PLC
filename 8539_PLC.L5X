</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Check Cycle WRNG]]>
</Comment>
<Text>
<![CDATA[LBL(CYCLE)[XIC(WRNG[i]) OTL(Core_HMI.Interface.iWarningDisplayed[i]) ,XIO(WRNG[i]) OTU(Core_HMI.Interface.iWarningDisplayed[i]) ]ADD(i,1,i)[LT(i,160) JMP(CYCLE) ,GE(i,160) MOVE(0,i) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(WRNG[c]) XIO(UM_Machine.TON_WrngMessageDisplay.DN) [OTL(xWarnFinded) ,MOVE(c,diWarnFindBit) ] ,XIO(WRNG[c]) [LT(c,160) ADD(c,1,c) ,GE(c,160) MOVE(0,c) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(xWarnFinded)[TON(UM_Machine.TON_WrngMessageDisplay,?,?) ,XIC(UM_Machine.TON_WrngMessageDisplay.DN) [OTU(xWarnFinded) ,OTU(WRNG[diWarnFindBit]) ,[LT(c,160) ADD(c,1,c) ,GE(c,160) MOVE(0,c) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[ME]]>
</Comment>
<Text>
<![CDATA[LBL(ME)NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[GT(diWarnBitPoint,159) ,XIC(BB.FirstScan) ]CLR(diWarnBitPoint);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[XIC(WRNG[diWarnBitPoint]) XIO(UM_Machine.TON_WrngMessageDisplay.DN) [OTL(xWarnFinded) ,MOVE(diWarnBitPoint,diWarnFindBit) ] ,XIO(WRNG[diWarnBitPoint]) ADD(diWarnBitPoint,1,diWarnBitPoint) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(xWarnFinded)[MOVE(diWarnFindBit,Core_HMI.Interface.St_iWarningDisplayed) ,TON(UM_Machine.TON_WrngMessageDisplay,?,?) ,XIC(UM_Machine.TON_WrngMessageDisplay.DN) [OTU(xWarnFinded) ,GT(diWarnBitPoint,159) CLR(diWarnBitPoint) ,OTU(WRNG[diWarnBitPoint]) ,ADD(diWarnBitPoint,1,diWarnBitPoint) ,CLR(Core_HMI.Interface.St_iWarningDisplayed) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="WorkPage" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB.FirstScan)[MOVE(0,Core_HMI.Interface.iPageToDisplay) ,OTU(BB.St_WorkPageRecall) ,RET() ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB.Rq_WorkPageRecall)[OTL(BB.St_WorkPageRecall) ,OTU(BB.Rq_WorkPageRecall) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(BB.St_WorkPageRecall)RET();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQ(Core_HMI.Interface.iPageDisplayed,DataDefined.PageWorkData)[MOVE(0,Core_HMI.Interface.iPageToDisplay) ,OTU(BB.St_WorkPageRecall) ,RET() ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(BB.AlwaysOFF)MOVE(DataDefined.PageWorkData,Core_HMI.Interface.iPageToDisplay);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
