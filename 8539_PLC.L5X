</Comment>
<Text>
<![CDATA[XIO(IN.B7931_01)XIO(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletPresenceUnderMag)XIO(OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_xPalletPresence)XIO(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletPresence)XIO(OM_Interface.PalMag_xRqPalletPreparationAtMagazine)OTL(OM_Interface.PalMag_xRqPalletPreparationAtMagazine);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(OM_ShiftPalChange.xRqChangeoverPalletCycle)XIO(OM_TeT.OUT_Pal.xAccessInibitPalletA)OTE(EM_PalMag.CM_MultiPalletsMagazine.IN_xRqEnableCycle);]]>
