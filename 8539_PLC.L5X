</Line>
<Line Number="117">
<![CDATA[			]]>
</Line>
<Line Number="118">
<![CDATA[			COP(iq_HW_READ_Anybus.Data[1+diStartByte_Read+diCountByte_Read], iq_aCOMM[diNode].PARAMETER_i_InPoS_TargetTolerance, 1);]]>
</Line>
<Line Number="119">
<![CDATA[			]]>
</Line>
<Line Number="120">
<![CDATA[			///////////////////////////////////////////]]>
</Line>
<Line Number="121">
<![CDATA[			//di_quotA_Position	: ]]>
</Line>
<Line Number="122">
<![CDATA[			//Start adr=12 => REGISTER => 24 byte ]]>
</Line>
<Line Number="123">
<![CDATA[			//N bytes=4 o 2 register ]]>
</Line>
<Line Number="124">
<![CDATA[			///////////////////////////////////////////]]>
</Line>
<Line Number="125">
<![CDATA[			]]>
</Line>
<Line Number="126">
<![CDATA[			COP(iq_HW_READ_Anybus.Data[3+diStartByte_Read+diCountByte_Read], iq_aCOMM[diNode].PARAMETER_di_quotA_Position, 1);]]>
</Line>
<Line Number="127">
<![CDATA[			]]>
</Line>
<Line Number="128">
<![CDATA[			/////////////////////////////////////////////////]]>
</Line>
<Line Number="129">
<![CDATA[			//InPoS_TargetPos	: ]]>
</Line>
<Line Number="130">
<![CDATA[			//Start adr=14 => REGISTER => 28 byte ]]>
</Line>
<Line Number="131">
<![CDATA[			//N bytes=4 o 2 register]]>
</Line>
<Line Number="132">
<![CDATA[			/////////////////////////////////////////////////]]>
</Line>
<Line Number="133">
<![CDATA[			]]>
</Line>
<Line Number="134">
<![CDATA[			COP(iq_HW_READ_Anybus.Data[7+diStartByte_Read+diCountByte_Read], iq_aCOMM[diNode].PARAMETER_di_tGt_Target, 1);]]>
</Line>
<Line Number="135">
<![CDATA[			]]>
</Line>
<Line Number="136">
<![CDATA[			////////INTERFACE TO PROGRAM //////////////////////]]>
</Line>
<Line Number="137">
<![CDATA[			iq_aCOMM[diNode].OUT_diActualPos:=iq_aCOMM[diNode].PARAMETER_di_quotA_Position;]]>
</Line>
<Line Number="138">
<![CDATA[			iq_aCOMM[diNode].OUT_diTargetPos:=iq_aCOMM[diNode].PARAMETER_di_tGt_Target;]]>
</Line>
<Line Number="139">
<![CDATA[			iq_aCOMM[diNode].OUT_iTollerancePos:=iq_aCOMM[diNode].PARAMETER_i_InPoS_TargetTolerance;	]]>
</Line>
<Line Number="140">
<![CDATA[			]]>
</Line>
<Line Number="141">
<![CDATA[			]]>
</Line>
<Line Number="142">
<![CDATA[			//////// WRITE NODE]]>
</Line>
<Line Number="143">
<![CDATA[			diDiffActualPos_TargetPos:=iq_aCOMM[diNode].OUT_diActualPos-iq_aCOMM[diNode].OUT_diTargetPos;]]>
</Line>
<Line Number="144">
<![CDATA[			diABS_DiffActualPos_TargetPos:=ABS(diDiffActualPos_TargetPos);]]>
</Line>
<Line Number="145">
<![CDATA[		]]>
</Line>
<Line Number="146">
<![CDATA[			IF diABS_DiffActualPos_TargetPos>iq_aCOMM[diNode].OUT_iTollerancePos]]>
</Line>
<Line Number="147">
<![CDATA[			then]]>
</Line>
<Line Number="148">
<![CDATA[				iq_aCOMM[diNode].OUT_xOutOfRange:=1;]]>
</Line>
<Line Number="149">
<![CDATA[			ELSE]]>
</Line>
<Line Number="150">
<![CDATA[				iq_aCOMM[diNode].OUT_xOutOfRange:=0;]]>
</Line>
<Line Number="151">
<![CDATA[			end_if;]]>
</Line>
<Line Number="152">
<![CDATA[				]]>
</Line>
<Line Number="153">
<![CDATA[			//Check condition for write on bus]]>
</Line>
<Line Number="154">
<![CDATA[			///////////////////////////////////////////////]]>
</Line>
<Line Number="155">
<![CDATA[			//InPoS_TargetPos:]]>
</Line>
<Line Number="156">
<![CDATA[			//N bytes 4 => 2 register]]>
</Line>
<Line Number="157">
<![CDATA[			//////////////////////////////////]]>
</Line>
<Line Number="158">
<![CDATA[			IF iq_aCOMM[diNode].OUT_diTargetPos<>iq_aCOMM[diNode].IN_diNewTarget]]>
</Line>
<Line Number="159">
<![CDATA[			then]]>
</Line>
<Line Number="160">
<![CDATA[				iq_aCOMM[diNode].xWrite:=1;]]>
</Line>
<Line Number="161">
<![CDATA[				COP(iq_aCOMM[diNode].IN_diNewTarget, iq_HW_WRITE_Anybus.Data[diStartByte_Write+diCountByte_Write], 4);]]>
</Line>
<Line Number="162">
<![CDATA[			else]]>
</Line>
<Line Number="163">
<![CDATA[				iq_aCOMM[diNode].xWrite:=0;]]>
</Line>
<Line Number="164">
<![CDATA[			end_if;]]>
</Line>
<Line Number="165">
<![CDATA[]]>
</Line>
<Line Number="166">
<![CDATA[			]]>
</Line>
<Line Number="167">
<![CDATA[		ELSE]]>
</Line>
<Line Number="168">
<![CDATA[			iq_aCOMM[diNode].OUT_diActualPos:=0;]]>
</Line>
<Line Number="169">
<![CDATA[			iq_aCOMM[diNode].OUT_diTargetPos:=0;]]>
</Line>
<Line Number="170">
<![CDATA[			iq_aCOMM[diNode].OUT_iTollerancePos:=0;]]>
</Line>
<Line Number="171">
<![CDATA[			iq_aCOMM[diNode].OUT_xOutOfRange:=1;]]>
</Line>
<Line Number="172">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="173">
<![CDATA[	end_if;	]]>
</Line>
<Line Number="174">
<![CDATA[	//Write OUT	]]>
</Line>
<Line Number="175">
<![CDATA[	]]>
</Line>
<Line Number="176">
<![CDATA[		]]>
</Line>
<Line Number="177">
<![CDATA[		]]>
</Line>
<Line Number="178">
<![CDATA[	diNode:=diNode + 1;]]>
</Line>
<Line Number="179">
<![CDATA[		]]>
</Line>
<Line Number="180">
<![CDATA[	]]>
</Line>
<Line Number="181">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
