<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[(*]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[       		 : HALSTRUP WALCHER Motor Management]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[v0.0         : Initial creation]]>
</Line>
<Line Number="6">
<![CDATA[v1.0 Michael : Parametrization routine correction, data management, alarm diagnostics]]>
</Line>
<Line Number="7">
<![CDATA[v1.1 Michael : Added parametrization at Connection startup, management of first connection acknowledge, logic and variables clean-up]]>
</Line>
<Line Number="8">
<![CDATA[v1.2 Michael : Added fault identification for all AOI routines, before only the MC_Error could give us a description of the fault, step cycles for the move routine]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[********************************************************************]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[*)]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[(*]]>
</Line>
<Line Number="15">
<![CDATA[############################]]>
</Line>
<Line Number="16">
<![CDATA[Logic]]>
</Line>
<Line Number="17">
<![CDATA[############################]]>
</Line>
<Line Number="18">
<![CDATA[*)]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[//Status word bits]]>
</Line>
<Line Number="21">
<![CDATA[xStatusWord_TargetPositionReached 			:= i_iStatus_Word.0;]]>
</Line>
<Line Number="22">
<![CDATA[xStatusWord_DragError 						:= i_iStatus_Word.1;]]>
</Line>
<Line Number="23">
<![CDATA[xStatusWord_ReverseJogKeyActive 			:= i_iStatus_Word.2;]]>
</Line>
<Line Number="24">
<![CDATA[xStatusWord_ForwardJogKeyActive 			:= i_iStatus_Word.3;]]>
</Line>
<Line Number="25">
<![CDATA[xStatusWord_MotorPowerPresent 				:= i_iStatus_Word.4;]]>
</Line>
<Line Number="26">
<![CDATA[xStatusWord_PositioningRunAborted 			:= i_iStatus_Word.5;]]>
</Line>
<Line Number="27">
<![CDATA[xStatusWord_DriveRunning 					:= i_iStatus_Word.6;]]>
</Line>
<Line Number="28">
<![CDATA[xStatusWord_TemperatureExceeded 			:= i_iStatus_Word.7;]]>
</Line>
<Line Number="29">
<![CDATA[xStatus_WordMovOppositeLoopDirection 		:= i_iStatus_Word.8;]]>
</Line>
<Line Number="30">
<![CDATA[xStatusWord_Error 							:= i_iStatus_Word.9;]]>
</Line>
<Line Number="31">
<![CDATA[xStatusWord_PositioningError 				:= i_iStatus_Word.10;]]>
</Line>
<Line Number="32">
<![CDATA[xStatusWord_ManualDisplacement 				:= i_iStatus_Word.11;]]>
