<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(BB_CRS.Manual_CmdEnable)[[XIC(EM_Infeed_HMI_PB_CRS.Rq_xManual_Pusher_ON) ,XIC(EM_Infeed_HMI_PB_CRS.Rq_xManual_Pusher_OFF) ] OTL(MSG_CRS[18]) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Pusher_ON) OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Pusher_OFF) ,OTU(EM_Infeed_HMI_PB_CRS.St_xManual_Pusher_ON) OTU(EM_Infeed_HMI_PB_CRS.St_xManual_Pusher_OFF) ];]]>
