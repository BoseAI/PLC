<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(1000,Ton_DelayStartTestPneum1.PRE)MOVE(1000,Ton_DelayStartTestElectric.PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(iq_xRqTest)XIC(i_xDisableTestCond)[OTU(iq_xRqTest) ,OTU(iq_xActive) ,OTU(iq_Msg_IllegalFunction) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)XIC(i_xDisableTestCond)OTU(iq_xActive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(iq_xActive)OTL(iq_xRqInibitAllMov);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(iq_xRqTest)XIO(iq_xActive)[OTL(iq_xActive) ,OTU(iq_xRqTest) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(iq_xRqTest)XIC(iq_xActive)[OTU(iq_xActive) ,OTU(iq_xRqTest) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(iq_xActive)[MOVE(0,diBrakeStep) ,OTL(q_xElectricBrake) ,OTL(q_x1stPneumBrake) ,OTU(xRqIncBrakeStep) ,OTU(xActiveCheckTollerancePos) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NE(diBrakeStep,0)OTE(q_xTestInProgress);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Disable Axis1
]]>
</Comment>
<Text>
<![CDATA[XIC(iq_xActive)EQ(diBrakeStep,0)[MOVE(0,q_Word_ElectricalTest) ,MOVE(0,q_Word_1stPneumTest) ,XIO(IO_Axis1.DriveEnableStatus) OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Disable Axis2
]]>
</Comment>
<Text>
<![CDATA[EQ(diBrakeStep,1)[LE(I_NrOfAxis,1) OTL(xRqIncBrakeStep) ,GT(I_NrOfAxis,1) XIO(IO_Axis2.DriveEnableStatus) OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Disable Cpu Mayr
]]>
</Comment>
<Text>
<![CDATA[EQ(diBrakeStep,2)[OTU(q_x1stPneumBrake) ,OTU(q_xElectricBrake) ,XIO(i_xAirPressureSwitch) OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Rq Manual Mode Electrical brake Axis1 ]]>
</Comment>
<Text>
<![CDATA[EQ(diBrakeStep,3)[MOVE(1,diBrakeState) SSV(Axis,IO_Axis1,MechanicalBrakeControl,diBrakeState) ,XIO(IO_Axis1.DriveEnableStatus) XIC(IO_Axis1.MechanicalBrakeOutputStatus) OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Rq Manual Mode Electrical brake Axis2
]]>
</Comment>
<Text>
<![CDATA[EQ(diBrakeStep,4)[LE(I_NrOfAxis,1) OTL(xRqIncBrakeStep) ,GT(I_NrOfAxis,1) [MOVE(1,diBrakeState) SSV(Axis,IO_Axis2,MechanicalBrakeControl,diBrakeState) ,XIO(IO_Axis2.DriveEnableStatus) XIC(IO_Axis2.MechanicalBrakeOutputStatus) OTL(xRqIncBrakeStep) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[EQ(diBrakeStep,5)[XIC(Ton_DelayStartTestPneum1.DN) [OTL(q_xElectricBrake) ,OTL(xActiveCheckTollerancePos) ,MOVE(1,q_Word_1stPneumTest) ,XIC(Ifb_DelayCheckDeltaPos.Q_xSensor) [MOVE(2,q_Word_1stPneumTest) ,OTL(xRqIncBrakeStep) ] ,XIC(xTestFault) [MOVE(3,q_Word_1stPneumTest) ,OTU(iq_xActive) ] ] ,TON(Ton_DelayStartTestPneum1,?,?) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[EQ(diBrakeStep,6)[OTU(q_x1stPneumBrake) ,OTU(q_xElectricBrake) ,OTU(xActiveCheckTollerancePos) ,XIO(Ifb_DelayCheckDeltaPos.Q_xSensor) OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[EQ(diBrakeStep,7)[XIC(Ton_DelayStartTestElectric.DN) [OTL(q_x1stPneumBrake) ,OTL(xActiveCheckTollerancePos) ,MOVE(1,q_Word_ElectricalTest) ,XIC(Ifb_DelayCheckDeltaPos.Q_xSensor) [MOVE(2,q_Word_ElectricalTest) ,OTL(xRqIncBrakeStep) ] ,XIC(xTestFault) [MOVE(3,q_Word_ElectricalTest) ,OTU(iq_xActive) ] ] ,TON(Ton_DelayStartTestElectric,?,?) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[EQ(diBrakeStep,8)[OTU(q_xElectricBrake) ,OTU(q_x1stPneumBrake) ,OTU(xActiveCheckTollerancePos) ,XIO(Ifb_DelayCheckDeltaPos.Q_xSensor) OTL(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[EQ(diBrakeStep,9)OTU(iq_xActive);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(xRqIncBrakeStep)[ADD(diBrakeStep,1,diBrakeStep) ,OTU(xRqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////////////////////////////
CHECK MAX DEVIATION
//////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(q_xTestInProgress)ONS(axPTrig[4])[CLR(q_rMaxDeviationAx1) CLR(q_rMaxDeviationAx2) ,CLR(rCheckPosAx1) CLR(rCheckPosAx2) ,MOVE(IO_Axis1.ActualPosition,rBackUpPositionAx1) ,GT(I_NrOfAxis,1) MOVE(IO_Axis2.ActualPosition,rBackUpPositionAx2) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(q_xTestInProgress)[[XIC(q_xElectricBrake) ,XIC(q_x1stPneumBrake) ] [SUB(IO_Axis1.ActualPosition,rBackUpPositionAx1,rCheckPosAx1) ABS(rCheckPosAx1,rCheckPosAx1) ,GT(I_NrOfAxis,1) SUB(IO_Axis2.ActualPosition,rBackUpPositionAx2,rCheckPosAx2) ABS(rCheckPosAx2,rCheckPosAx2) ] ,GT(rCheckPosAx1,q_rMaxDeviationAx1) MOVE(rCheckPosAx1,q_rMaxDeviationAx1) ,GT(I_NrOfAxis,1) GT(rCheckPosAx2,q_rMaxDeviationAx2) MOVE(rCheckPosAx2,q_rMaxDeviationAx2) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(q_xTestInProgress)XIC(xActiveCheckTollerancePos)OTE(Ifb_DelayCheckDeltaPos.I_xSensor);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[InputFilter(Ifb_DelayCheckDeltaPos,i_iDelayCheckDeltaPos,1000);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(q_xTestInProgress)[GT(rCheckPosAx1,i_rTollerance) ,GT(I_NrOfAxis,1) GT(rCheckPosAx2,i_rTollerance) ][CLR(diBrakeState) SSV(Axis,IO_Axis1,MechanicalBrakeControl,diBrakeState) ,GT(I_NrOfAxis,1) SSV(Axis,IO_Axis2,MechanicalBrakeControl,diBrakeState) ,OTE(xTestFault) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////////////////////////////
RQ AUTO MODE BRAKE AXIS
//////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[EQ(diBrakeStep,0)ONS(axPTrig[3])[CLR(diBrakeState) SSV(Axis,IO_Axis1,MechanicalBrakeControl,diBrakeState) ,GT(I_NrOfAxis,1) SSV(Axis,IO_Axis2,MechanicalBrakeControl,diBrakeState) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
