<![CDATA[XIC(xWarningFound)[MOVE(diWarnFindBit,Core_HMI_CRS.Interface.St_iWarningDisplayed) ,TON(UM_Machine_CRS.TON_WrngMessageDisplay,?,?) ,XIC(UM_Machine_CRS.TON_WrngMessageDisplay.DN) [OTU(xWarningFound) ,OTU(WRNG_CRS[diWarnBitPoint]) ,ADD(diWarnBitPoint,1,diWarnBitPoint) ,CLR(Core_HMI_CRS.Interface.St_iWarningDisplayed) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
