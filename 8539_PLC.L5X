<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Core_HMI_CRS.PB.Rq_xTimer_ScrollUp)ONS(UM_Machine_CRS.axPTrig[12])[ADD(iAux[1],1,iAux[1]) ,GE(iAux[1],DataDefined_CRS.TimerNoMax) MOVE(0,iAux[1]) ,LT(iAux[1],0) CPT(iAux[1],DataDefined_CRS.TimerNoMax-1) ,MOVE(iAux[1],Timers_CRS.No) ,OTU(Core_HMI_CRS.PB.Rq_xTimer_ScrollUp) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Core_HMI_CRS.PB.Rq_xTimer_ScrollDown)ONS(UM_Machine_CRS.axPTrig[13])[SUB(iAux[1],1,iAux[1]) ,GE(iAux[1],DataDefined_CRS.TimerNoMax) MOVE(0,iAux[1]) ,LT(iAux[1],0) CPT(iAux[1],DataDefined_CRS.TimerNoMax-1) ,MOVE(iAux[1],Timers_CRS.No) ,OTU(Core_HMI_CRS.PB.Rq_xTimer_ScrollDown) ];]]>
</Text>
