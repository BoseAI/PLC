<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(xCmdEnable)[XIC(iq_CM_Inverter.InverterIN_xForward_Rq) XIO(iq_CM_Inverter.InverterOUT_xInForwardPos) ,XIC(iq_CM_Inverter.InverterIN_xBackward_Rq) XIO(iq_CM_Inverter.InverterOUT_xInBackwardPos) ,XIC(iq_CM_Inverter.InverterIN_xJogForward_Rq) ,XIC(iq_CM_Inverter.InverterIN_xJogBackward_Rq) ]OTE(iq_CM_Inverter.Inverter_xCommand);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(xCmdEnable)[[XIC(iq_CM_Inverter.InverterIN_xBackward_Rq) ,XIC(iq_CM_Inverter.InverterIN_xJogBackward_Rq) ] OTE(iq_CM_Inverter.Inverter_xReverseDirection) ,XIC(iq_CM_Inverter.InverterOUT_xInForwardPos) OTU(iq_CM_Inverter.InverterIN_xForward_Rq) ,XIC(iq_CM_Inverter.InverterOUT_xInBackwardPos) OTU(iq_CM_Inverter.InverterIN_xBackward_Rq) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(iq_CM_Inverter.Inverter_xCommand) [GE(iq_CM_Encoder.lrActualPos,lrForwardPosSlowdwn) ,XIC(iq_CM_Inverter.Inverter_xReverseDirection) LE(iq_CM_Encoder.lrActualPos,lrBackwarPosSlowdwn) ] ,XIC(iq_CM_Inverter.InverterIN_xJogForward_Rq) XIO(iq_CM_Inverter.InverterOUT_xInForwardPos) ,XIC(iq_CM_Inverter.InverterIN_xJogBackward_Rq) XIO(iq_CM_Inverter.InverterOUT_xInBackwardPos) ]OTE(xRqSlowdownSpeed);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIO(xRqSlowdownSpeed) MOVE(i_iSpeed,iq_CM_Inverter.InverterIN_diWorkSpeed) ,XIC(xRqSlowdownSpeed) MOVE(i_iSlowdownSpeed,iq_CM_Inverter.InverterIN_diWorkSpeed) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(iq_CM_Inverter.Inverter_xCommand)XIC(iq_CM_Inverter.Inverter_xReverseDirection)XIO(IEC_TimerDelayCmdForward.DN)[OTE(iq_CM_Inverter.InverterOUT_xMoveToBackward) ,TOF(IEC_TimerDelayCmdBackward,?,?) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(iq_CM_Inverter.Inverter_xCommand)XIO(iq_CM_Inverter.Inverter_xReverseDirection)XIO(IEC_TimerDelayCmdBackward.DN)[OTE(iq_CM_Inverter.InverterOUT_xMoveToForward) ,TOF(IEC_TimerDelayCmdForward,?,?) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
