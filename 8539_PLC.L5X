<![CDATA[LBL(CYCLE)[XIC(WRNG_CRS[i]) OTL(Core_HMI_CRS.Interface.iWarningDisplayed[i]) ,XIO(WRNG_CRS[i]) OTU(Core_HMI_CRS.Interface.iWarningDisplayed[i]) ]ADD(i,1,i)[LT(i,160) JMP(CYCLE) ,GE(i,160) MOVE(0,i) ];]]>
