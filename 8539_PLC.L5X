<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(O_xAxisCamGearTransfStatus)OTU(O_xAxisStopped)OTU(O_xAxisHomeOK)OTU(O_xAxisEnable)OTU(O_xAxisEnableInProgress);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(IO_Axis.ServoActionStatus)OTL(O_xAxisEnable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(IO_Axis.AxisHomedStatus)XIC(I_xHomeSequenceDone)OTL(O_xAxisHomeOK);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[ABS(IO_Axis.CommandVelocity,AxisSpeed)LT(AxisSpeed,2)OTL(O_xAxisStopped);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(IO_Axis.PositionCamStatus) ,XIC(IO_Axis.GearingStatus) ,XIC(IO_Axis.TransformStateStatus) ]OTL(O_xAxisCamGearTransfStatus);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQ(IO_Axis.AxisFault,0)XIO(IO_Axis.ShutdownStatus)OTE(NoFaultAxis);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(I_xRqResetDrive)ONS(ResetDriveEdge)[CLR(IO_MotionControl_MASR.FLAGS) ,CLR(IO_MotionControl_MAFR.FLAGS) ,CLR(IO_MotionControlImmStop_MAS.FLAGS) ,CLR(IO_MotionControlPhaseStop_MAS.FLAGS) ,CLR(Step) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[EQ(Step,0)[XIC(IO_Axis.ShutdownStatus) MASR(IO_Axis,IO_MotionControl_MASR) ,XIO(IO_Axis.ShutdownStatus) ]ADD(Step,1,Step);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQ(Step,1)[XIC(NoFaultAxis) ADD(Step,1,Step) ,XIO(NoFaultAxis) MAFR(IO_Axis,IO_MotionControl_MAFR) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQ(Step,2)XIC(NoFaultAxis)[XIC(IO_Axis.ServoActionStatus) ADD(Step,1,Step) ,OTL(O_xAxisEnableInProgress) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQ(Step,3)[XIC(O_xAxisEnable) OTU(IO_xRqEnableDrive) ,XIC(NoFaultAxis) XIO(IO_Axis.ServoActionStatus) CLR(Step) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIO(IO_xRqEnableDrive)OTU(O_xAxisEnableInProgress);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(IO_xRqImmedyateStop)OTU(IO_xRqEnableDrive);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIO(O_xAxisCamGearTransfStatus) ,XIC(O_xAxisCamGearTransfStatus) XIC(I_xMasterStopped) ]XIC(O_xAxisEnable)XIC(IO_xRqImmedyateStop)XIO(IO_MotionControlImmStop_MAS.EN)XIO(IO_MotionControlImmStop_MAS.IP)XIO(IO_MotionControlPhaseStop_MAS.IP)MAS(IO_Axis,IO_MotionControlImmStop_MAS,All,Yes,I_DecRateImmStop,% of Maximum,Yes,100.0,% of Time);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
UTILI:
STOP CMD MACHINE
]]>
</Comment>
<Text>
<![CDATA[[[XIO(O_xAxisCamGearTransfStatus) ,XIC(O_xAxisCamGearTransfStatus) XIC(I_xMasterStopped) ] XIC(IO_xRqPhaseStop) ,XIC(IO_xRqStopAxis) ]XIC(O_xAxisEnable)XIO(IO_MotionControlPhaseStop_MAS.EN)XIO(IO_MotionControlImmStop_MAS.IP)XIO(IO_MotionControlPhaseStop_MAS.IP)[ONS(Ons.0) CLR(IO_MotionControlPhaseStop_MAS.FLAGS) ,MAS(IO_Axis,IO_MotionControlPhaseStop_MAS,All,Yes,I_DecRatePhaseStop,% of Maximum,Yes,100.0,% of Time) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIO(IO_Axis.AxisHomedStatus) MOVE(999999,O_rAxisCommandPosition) ,XIC(IO_Axis.AxisHomedStatus) MOVE(IO_Axis.CommandPosition,O_rAxisCommandPosition) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[MOVE(IO_Axis.CommandVelocity,O_rAxisCommandlvelocity);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[[XIC(IO_MotionControlPhaseStop_MAS.PC) ,XIC(IO_xRqImmedyateStop) ] [OTU(IO_xRqStopAxis) ,OTU(IO_xRqPhaseStop) ] ,OTU(IO_xRqImmedyateStop) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIC(IO_MotionControl_MASR.ER) ,XIC(IO_MotionControl_MAFR.ER) ,XIC(IO_MotionControlImmStop_MAS.ER) ,XIC(IO_MotionControlPhaseStop_MAS.ER) ]OTL(IO_xMotionInstructionError);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="SSV_CIP_VirtualAxis" Class="Standard" Revision="0.1" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2022-07-26T10:20:13.020Z" CreatedBy="DESKTOP-I4HL37F\admin" EditedDate="2022-08-04T09:36:22.210Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v32.01"
>
