<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//	This AOI uses Linear, Cubic, 5th, 7th, or 9th order polynomial interpolation ]]>
</Line>
<Line Number="1">
<![CDATA[//  as well as Elliptical which Simple Harmonic is a special case, ]]>
</Line>
<Line Number="2">
<![CDATA[//  Epicyclic which Cycloidal is a special case, ]]>
</Line>
<Line Number="3">
<![CDATA[//  Double Harmonic, Modified Sine, or Modified Trapezoid,]]>
</Line>
<Line Number="4">
<![CDATA[//  to calculate slave positions as a function of equally spaced master positions.]]>
</Line>
<Line Number="5">
<![CDATA[//	This AOI allows user to select the number of interpolation positions between via points.	]]>
</Line>
<Line Number="6">
<![CDATA[//  The result of this AOI is a CAM, its Length, Start Slope and End Slope ready to be used as inputs to a MCCP instruction.]]>
</Line>
<Line Number="7">
<![CDATA[//]]>
</Line>
<Line Number="8">
<![CDATA[// Copyright Timothy Philipp 2016]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[SIZE(My_CAM,0,Cam_Size);]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[//  Count the number of interpolation segments in data array]]>
</Line>
<Line Number="14">
<![CDATA[SIZE(Interpolation_ViaPoint,0,Index);]]>
</Line>
<Line Number="15">
<![CDATA[Last_Segment:=1;]]>
</Line>
<Line Number="16">
<![CDATA[FOR Segment := 1 TO (Index-1) BY 1 DO]]>
</Line>
<Line Number="17">
<![CDATA[	IF Interpolation_ViaPoint[Segment].Master_Position > 0 THEN]]>
</Line>
<Line Number="18">
<![CDATA[		Last_Segment := Segment;]]>
</Line>
<Line Number="19">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[// Calculate Step i.e. the master position increment to fill up the cam table]]>
</Line>
<Line Number="23">
<![CDATA[Master_Cycle := Interpolation_ViaPoint[Last_Segment].Master_Position;]]>
</Line>
<Line Number="24">
<![CDATA[Slave_Cycle := Interpolation_ViaPoint[Last_Segment].Slave_Position;]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[Index := 0;]]>
</Line>
<Line Number="27">
<![CDATA[FOR Segment := 1 TO Last_Segment BY 1 DO]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[	i:= Segment-1;]]>
</Line>
<Line Number="30">
<![CDATA[	f := Segment;]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[	Mi := Interpolation_ViaPoint[i].Master_Position;]]>
</Line>
<Line Number="33">
<![CDATA[	Mf := Interpolation_ViaPoint[f].Master_Position;]]>
</Line>
<Line Number="34">
<![CDATA[	Si := Interpolation_ViaPoint[i].Slave_Position;]]>
</Line>
<Line Number="35">
<![CDATA[	Vi := Interpolation_ViaPoint[i].Slave_Velocity;]]>
</Line>
<Line Number="36">
<![CDATA[	Ai := Interpolation_ViaPoint[i].Slave_Acceleration;]]>
</Line>
<Line Number="37">
<![CDATA[	Ji := Interpolation_ViaPoint[i].Slave_Jerk;]]>
</Line>
<Line Number="38">
<![CDATA[	ni := Interpolation_ViaPoint[i].Slave_Snap;]]>
</Line>
<Line Number="39">
<![CDATA[	Sf := Interpolation_ViaPoint[f].Slave_Position;]]>
</Line>
<Line Number="40">
<![CDATA[	Vf := Interpolation_ViaPoint[f].Slave_Velocity;]]>
</Line>
<Line Number="41">
<![CDATA[	Af := Interpolation_ViaPoint[f].Slave_Acceleration;]]>
</Line>
<Line Number="42">
<![CDATA[	Jf := Interpolation_ViaPoint[f].Slave_Jerk;]]>
</Line>
<Line Number="43">
<![CDATA[	nf := Interpolation_ViaPoint[f].Slave_Snap;]]>
</Line>
<Line Number="44">
<![CDATA[	]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[	CASE Interpolation_ViaPoint[i].SegmentType OF]]>
</Line>
<Line Number="48">
<![CDATA[		// Linear]]>
</Line>
<Line Number="49">
<![CDATA[		0: ]]>
</Line>
<Line Number="50">
<![CDATA[			a0 := Si;]]>
</Line>
<Line Number="51">
<![CDATA[			IF Interpolation_ViaPoint[i].Steps > 1 THEN  // Override User Velocity Entry]]>
</Line>
<Line Number="52">
<![CDATA[				Vi := (Sf-Si)/(Mf-Mi);]]>
</Line>
<Line Number="53">
<![CDATA[				Interpolation_ViaPoint[i].Slave_Velocity := Vi;]]>
</Line>
<Line Number="54">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="55">
<![CDATA[			a1 := Vi;]]>
</Line>
<Line Number="56">
<![CDATA[			a2 := 0;]]>
</Line>
<Line Number="57">
<![CDATA[			a3 := 0;]]>
</Line>
<Line Number="58">
<![CDATA[			a4 := 0;]]>
</Line>
<Line Number="59">
<![CDATA[			a5 := 0;]]>
</Line>
<Line Number="60">
<![CDATA[			a6 := 0;]]>
</Line>
<Line Number="61">
<![CDATA[			a7 := 0;]]>
</Line>
<Line Number="62">
<![CDATA[			a8 := 0;]]>
</Line>
<Line Number="63">
<![CDATA[			a9 := 0;]]>
</Line>
<Line Number="64">
<![CDATA[			SegmentType := 0; //Linear]]>
</Line>
<Line Number="65">
<![CDATA[]]>
</Line>
<Line Number="66">
<![CDATA[		// Cubic]]>
</Line>
<Line Number="67">
<![CDATA[		1: ]]>
</Line>
<Line Number="68">
<![CDATA[			a0 := Si;]]>
</Line>
<Line Number="69">
<![CDATA[			a1 := Vi;]]>
</Line>
<Line Number="70">
<![CDATA[			a2 := 0;]]>
</Line>
<Line Number="71">
<![CDATA[			a3 := 0;]]>
</Line>
<Line Number="72">
<![CDATA[			a4 := 0;]]>
</Line>
<Line Number="73">
<![CDATA[			a5 := 0;]]>
</Line>
<Line Number="74">
<![CDATA[			a6 := 0;]]>
</Line>
<Line Number="75">
<![CDATA[			a7 := 0;]]>
</Line>
<Line Number="76">
<![CDATA[			a8 := 0;]]>
</Line>
<Line Number="77">
<![CDATA[			a9 := 0;]]>
</Line>
<Line Number="78">
<![CDATA[			SegmentType := 1;  //Cubic]]>
</Line>
<Line Number="79">
<![CDATA[]]>
</Line>
<Line Number="80">
<![CDATA[		// 5th 0rder]]>
</Line>
<Line Number="81">
<![CDATA[		2: ]]>
</Line>
<Line Number="82">
<![CDATA[			a0 := Si;]]>
</Line>
<Line Number="83">
<![CDATA[			a1 := Vi;]]>
</Line>
<Line Number="84">
<![CDATA[			a2 := Ai/2;]]>
</Line>
<Line Number="85">
<![CDATA[			a3 := (20.0 * (Sf - Si) - (8.0 * Vf + 12.0 * Vi) * (Mf - Mi) - (3.0 * Ai - Af) * (Mf - Mi) ** 2.0) / (2.0 * (Mf - Mi) ** 3.0);]]>
</Line>
<Line Number="86">
<![CDATA[			a4 := (30.0 * (Si - Sf) + (14.0 * Vf + 16.0 * Vi) * (Mf - Mi) + (3.0 * Ai - 2.0 * Af) * (Mf - Mi) ** 2.0) / (2.0 * (Mf - Mi) ** 4.0);]]>
</Line>
<Line Number="87">
<![CDATA[			a5 := (12.0 * (Sf - Si) - 6.0 * (Vf + Vi) * (Mf - Mi) - (Ai - Af) * (Mf - Mi) ** 2.0) / (2.0 * (Mf - Mi) ** 5.0);]]>
</Line>
<Line Number="88">
<![CDATA[			a6 := 0;]]>
</Line>
<Line Number="89">
<![CDATA[			a7 := 0;]]>
</Line>
<Line Number="90">
<![CDATA[			a8 := 0;]]>
</Line>
<Line Number="91">
<![CDATA[			a9 := 0;]]>
</Line>
<Line Number="92">
<![CDATA[			SegmentType := 1;  //Cubic]]>
</Line>
<Line Number="93">
<![CDATA[]]>
</Line>
<Line Number="94">
<![CDATA[		// 7th 0rder]]>
</Line>
<Line Number="95">
<![CDATA[		3: ]]>
</Line>
<Line Number="96">
<![CDATA[			a0 := Si;]]>
</Line>
<Line Number="97">
<![CDATA[			a1 := Vi;]]>
</Line>
<Line Number="98">
<![CDATA[			a2 := Ai/2;]]>
</Line>
<Line Number="99">
<![CDATA[			a3 := Ji/6;]]>
</Line>
<Line Number="100">
<![CDATA[			 M := Mf-Mi;]]>
</Line>
<Line Number="101">
<![CDATA[			K0 := Sf - a0 - a1*M - a2*M**2 - a3*M**3 ;]]>
</Line>
<Line Number="102">
<![CDATA[			K1 := Vf - a1 - 2*a2*M - 3*a3*M**2;]]>
</Line>
<Line Number="103">
<![CDATA[			K2 := Af - 2*a2 - 6*a3*M;]]>
</Line>
<Line Number="104">
<![CDATA[			K3 := Jf -6*a3;]]>
</Line>
<Line Number="105">
<![CDATA[			a4 := 35*K0/M**4 - 15*K1/M**3 + (5*K2/2)/M**2 - (K3/6)/M;]]>
</Line>
<Line Number="106">
<![CDATA[			a5 := -84*K0/M**5 + 39*K1/M**4 - 7*K2/M**3 + (K3/2)/M**2 ;]]>
</Line>
<Line Number="107">
<![CDATA[			a6 := 70*K0/M**6 - 34*K1/M**5 + (13*K2/2)/M**4 - (K3/2)/M**3;]]>
</Line>
<Line Number="108">
<![CDATA[			a7 := -20*K0/M**7 + 10*K1/M**6 - 2*K2/M**5 + (1/6)*K3/M**4;]]>
</Line>
<Line Number="109">
<![CDATA[			a8 := 0;]]>
</Line>
<Line Number="110">
<![CDATA[			a9 := 0;]]>
</Line>
<Line Number="111">
<![CDATA[			SegmentType := 1;  //Cubic]]>
</Line>
<Line Number="112">
<![CDATA[]]>
</Line>
<Line Number="113">
<![CDATA[		// 9th 0rder]]>
</Line>
<Line Number="114">
<![CDATA[		4:]]>
</Line>
<Line Number="115">
<![CDATA[			a0 := Si;]]>
</Line>
<Line Number="116">
<![CDATA[			a1 := Vi;]]>
</Line>
<Line Number="117">
<![CDATA[			a2 := Ai/2;]]>
</Line>
<Line Number="118">
<![CDATA[			a3 := Ji/6;]]>
</Line>
<Line Number="119">
<![CDATA[			a4 := ni/24;]]>
</Line>
<Line Number="120">
<![CDATA[			 M := Mf-Mi;]]>
</Line>
<Line Number="121">
<![CDATA[			K0 := Sf - a0 - a1*M - a2*M**2 - a3*M**3 - a4*M**4 ;]]>
</Line>
<Line Number="122">
<![CDATA[			K1 := Vf - a1 - 2*a2*M - 3*a3*M**2 - 4*a4*M**3;]]>
</Line>
<Line Number="123">
<![CDATA[			K2 := Af - 2*a2 - 6*a3*M - 12*a4*M**2;]]>
</Line>
<Line Number="124">
<![CDATA[			K3 := Jf - 6*a3 - 24*a4*M ;]]>
</Line>
<Line Number="125">
<![CDATA[			K4 := nf - 24*a4 ;]]>
</Line>
<Line Number="126">
<![CDATA[			a5 := 126*K0/M**5 -56*K1/M**4 +(21*K2/2)/M**3 - K3/M**2 +(K4/24)/M ;]]>
</Line>
<Line Number="127">
<![CDATA[			a6 := -420*K0/M**6 +196*K1/M**5 -(77*K2/2)/M**4 +(23*K3/6)/M**3 -(K4/6)/M**2;]]>
</Line>
<Line Number="128">
<![CDATA[			a7 := 540*K0/M**7 -260*K1/M**6 +53*K2/M**5 -(11*K3/2)/M**4 +(K4/4)/M**3;]]>
</Line>
<Line Number="129">
<![CDATA[			a8 := -315*K0/M**8 +155*K1/M**7 -(65*K2/2)/M**6 +(7*K3/2)/M**5 -(K4/6)/M**4;]]>
</Line>
<Line Number="130">
<![CDATA[			a9 := 70*K0/M**9 -35*K1/M**8 +(15*K2/2)/M**7 -(5*K3/6)/M**6 +(K4/24)/M**5;]]>
</Line>
<Line Number="131">
<![CDATA[			SegmentType := 1; //Cubic]]>
</Line>
<Line Number="132">
<![CDATA[]]>
</Line>
<Line Number="133">
<![CDATA[		// Simple Harmonic and Elliptical when Cycles <> 0]]>
</Line>
<Line Number="134">
<![CDATA[		5:			]]>
</Line>
<Line Number="135">
<![CDATA[			a0 := 0;]]>
</Line>
<Line Number="136">
<![CDATA[			a1 := 0;]]>
</Line>
<Line Number="137">
<![CDATA[			a2 := 0;]]>
</Line>
<Line Number="138">
<![CDATA[			a3 := 0;]]>
</Line>
<Line Number="139">
<![CDATA[			a4 := 0;]]>
</Line>
<Line Number="140">
<![CDATA[			a5 := 0;]]>
</Line>
<Line Number="141">
<![CDATA[			a6 := 0;]]>
</Line>
<Line Number="142">
<![CDATA[			a7 := 0;]]>
</Line>
<Line Number="143">
<![CDATA[			a8 := 0;]]>
</Line>
<Line Number="144">
<![CDATA[			a9 := 0;]]>
</Line>
<Line Number="145">
<![CDATA[			IF Interpolation_ViaPoint[i].Cycles >= 1 THEN]]>
</Line>
<Line Number="146">
<![CDATA[				Interpolation_ViaPoint[i].Cycles := 0.9990;]]>
</Line>
<Line Number="147">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="148">
<![CDATA[			Cycles := Interpolation_ViaPoint[i].Cycles;]]>
</Line>
<Line Number="149">
<![CDATA[			SegmentType := 1;  //Cubic]]>
</Line>
<Line Number="150">
<![CDATA[		]]>
</Line>
<Line Number="151">
<![CDATA[		// Epicylic]]>
</Line>
<Line Number="152">
<![CDATA[		6:]]>
</Line>
<Line Number="153">
<![CDATA[			a0 := 0;]]>
</Line>
<Line Number="154">
<![CDATA[			a1 := 0;]]>
</Line>
<Line Number="155">
<![CDATA[			a2 := 0;]]>
</Line>
<Line Number="156">
<![CDATA[			a3 := 0;]]>
</Line>
<Line Number="157">
<![CDATA[			a4 := 0;]]>
</Line>
<Line Number="158">
<![CDATA[			a5 := 0;]]>
</Line>
<Line Number="159">
<![CDATA[			a6 := 0;]]>
</Line>
<Line Number="160">
<![CDATA[			a7 := 0;]]>
</Line>
<Line Number="161">
<![CDATA[			a8 := 0;]]>
</Line>
<Line Number="162">
<![CDATA[			a9 := 0;]]>
</Line>
<Line Number="163">
<![CDATA[			Cycles := Interpolation_ViaPoint[i].Cycles;]]>
</Line>
<Line Number="164">
<![CDATA[			IF Cycles <= 0 THEN  // Avoid Divide by Zero]]>
</Line>
<Line Number="165">
<![CDATA[				Cycles :=1;]]>
</Line>
<Line Number="166">
<![CDATA[				Interpolation_ViaPoint[i].Cycles := Cycles;]]>
</Line>
<Line Number="167">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="168">
<![CDATA[			SegmentType := 1;  //Cubic]]>
</Line>
<Line Number="169">
<![CDATA[]]>
</Line>
<Line Number="170">
<![CDATA[		// Double Harmonic, Modified Sine, Modified Trapezoid]]>
</Line>
<Line Number="171">
<![CDATA[		7,8,9:			]]>
</Line>
<Line Number="172">
<![CDATA[			a0 := 0;]]>
</Line>
<Line Number="173">
<![CDATA[			a1 := 0;]]>
</Line>
<Line Number="174">
<![CDATA[			a2 := 0;]]>
</Line>
<Line Number="175">
<![CDATA[			a3 := 0;]]>
</Line>
<Line Number="176">
<![CDATA[			a4 := 0;]]>
</Line>
<Line Number="177">
<![CDATA[			a5 := 0;]]>
</Line>
<Line Number="178">
<![CDATA[			a6 := 0;]]>
</Line>
<Line Number="179">
<![CDATA[			a7 := 0;]]>
</Line>
<Line Number="180">
<![CDATA[			a8 := 0;]]>
</Line>
<Line Number="181">
<![CDATA[			a9 := 0;]]>
</Line>
<Line Number="182">
<![CDATA[			SegmentType := 1;  //Cubic]]>
</Line>
<Line Number="183">
<![CDATA[]]>
</Line>
<Line Number="184">
<![CDATA[	ELSE]]>
</Line>
<Line Number="185">
<![CDATA[		// Default to Linear]]>
</Line>
<Line Number="186">
<![CDATA[			a0 := Si;]]>
</Line>
<Line Number="187">
<![CDATA[			a1 := Vi;]]>
</Line>
<Line Number="188">
<![CDATA[			a2 := 0;]]>
</Line>
<Line Number="189">
<![CDATA[			a3 := 0;]]>
</Line>
<Line Number="190">
<![CDATA[			a4 := 0;]]>
</Line>
<Line Number="191">
<![CDATA[			a5 := 0;]]>
</Line>
<Line Number="192">
<![CDATA[			a6 := 0;]]>
</Line>
<Line Number="193">
<![CDATA[			a7 := 0;]]>
</Line>
<Line Number="194">
<![CDATA[			a8 := 0;]]>
</Line>
<Line Number="195">
<![CDATA[			a9 := 0;]]>
</Line>
<Line Number="196">
<![CDATA[			SegmentType := 0;  //Linear]]>
</Line>
<Line Number="197">
<![CDATA[			Interpolation_ViaPoint[i].SegmentType := SegmentType;]]>
</Line>
<Line Number="198">
<![CDATA[	END_CASE;]]>
</Line>
<Line Number="199">
<![CDATA[]]>
</Line>
<Line Number="200">
<![CDATA[	IF Interpolation_ViaPoint[i].Steps < 1 THEN  // Check for Divide by 0 and no negative numbers]]>
</Line>
<Line Number="201">
<![CDATA[		Interpolation_ViaPoint[i].Steps := 1;]]>
</Line>
<Line Number="202">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="203">
<![CDATA[]]>
</Line>
<Line Number="204">
<![CDATA[	Step:=(Mf - Mi)/Interpolation_ViaPoint[i].Steps;]]>
</Line>
<Line Number="205">
<![CDATA[	MP := Mi; ]]>
</Line>
<Line Number="206">
<![CDATA[	SP := Si;]]>
</Line>
<Line Number="207">
<![CDATA[]]>
</Line>
<Line Number="208">
<![CDATA[	WHILE MP < (Mf-0.001*Step) DO  // Sometimes there is round off]]>
</Line>
<Line Number="209">
<![CDATA[]]>
</Line>
<Line Number="210">
<![CDATA[		CASE Interpolation_ViaPoint[i].SegmentType OF]]>
</Line>
<Line Number="211">
<![CDATA[       		0,1,2,3,4:	 // Interpolating Polynomial]]>
</Line>
<Line Number="212">
<![CDATA[			SP := a0 + a1*(MP-Mi) + a2*(MP-Mi)** 2.0 + a3*(MP-Mi)**3.0 + a4*(MP-Mi)**4.0 + a5*(MP-Mi)**5.0 + a6*(MP-Mi)**6.0 + a7*(MP-Mi)**7.0 + a8*(MP-Mi)**8.0 + a9*(MP-Mi)**9.0 ;]]>
</Line>
<Line Number="213">
<![CDATA[]]>
</Line>
<Line Number="214">
<![CDATA[			5:			 // Elliptical and Simple Harmonic Equation (SHM when Cycles = 0)  Here Cycles is the Width to Height relationship of the Elipse.  ]]>
</Line>
<Line Number="215">
<![CDATA[			SP := (Sf+Si)/2 - (Sf-Si)/2*Cos(3.14159265*(MP-Mi)/(Mf-Mi))/(1-Cycles*(Sin(3.14159265*(MP-Mi)/(Mf-Mi)))**2)**0.5;]]>
</Line>
<Line Number="216">
<![CDATA[]]>
</Line>
<Line Number="217">
<![CDATA[			6:			// Epicyclic    Here Cycles means number of pattern repeats]]>
</Line>
<Line Number="218">
<![CDATA[ 			SP := Si+(Sf-Si)/(Mf-Mi)*((MP-Mi)-(1-Vi*(Mf-Mi)/(Sf-Si))/(2*3.14159265*Cycles/(Mf-Mi))*sin(2*3.14159265*Cycles/(Mf-Mi)*(MP-Mi)));]]>
</Line>
<Line Number="219">
<![CDATA[			]]>
</Line>
<Line Number="220">
<![CDATA[			7:			// Double Harmonic]]>
</Line>
<Line Number="221">
<![CDATA[			SP := Si+((Sf-Si)/2)*(1 - Cos(3.14159265*(MP-Mi)/(Mf-Mi))- 0.25 *(1 - Cos(2*3.14159265*(MP-Mi)/(Mf-Mi))));]]>
</Line>
<Line Number="222">
<![CDATA[]]>
</Line>
<Line Number="223">
<![CDATA[			8:  		// Modified Sine]]>
</Line>
<Line Number="224">
<![CDATA[			IF (MP-Mi)<=(Mf-Mi)/8 THEN]]>
</Line>
<Line Number="225">
<![CDATA[				SP := Si+(Sf-Si)*(0.43990085*(MP-Mi)/(Mf-Mi) - 0.0350062*Sin(4*3.14159265*(MP-Mi)/(Mf-Mi)));]]>
</Line>
<Line Number="226">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="227">
<![CDATA[			IF (MP-Mi)>(Mf-Mi)/8  AND (MP-Mi)<= (7*(Mf-Mi)/8) THEN]]>
</Line>
<Line Number="228">
<![CDATA[				SP := Si+(Sf-Si)*(0.28004957+0.43990085*(MP-Mi)/(Mf-Mi) -0.31505577*Cos(4*3.14159265*(MP-Mi)/(Mf-Mi)/3-3.14159265/6));]]>
</Line>
<Line Number="229">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="230">
<![CDATA[			IF (MP-Mi)>(7*(Mf-Mi)/8) THEN]]>
</Line>
<Line Number="231">
<![CDATA[                SP := Si+(Sf-Si)*(0.56009915 + 0.43990085*(MP-Mi)/(Mf-Mi) -0.0350062*SIN(2*3.14159265*(2*(MP-Mi)/(Mf-Mi)-1)));]]>
</Line>
<Line Number="232">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="233">
<![CDATA[]]>
</Line>
<Line Number="234">
<![CDATA[			9:  		// Modified Trapezoid]]>
</Line>
<Line Number="235">
<![CDATA[			IF (MP-Mi)<=(Mf-Mi)/8 THEN]]>
</Line>
<Line Number="236">
<![CDATA[				SP := Si+ 0.09724613*(Sf-Si)*(4*(MP-Mi)/(Mf-Mi) - Sin(4*3.14159265*(MP-Mi)/(Mf-Mi))/3.14159265);]]>
</Line>
<Line Number="237">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="238">
<![CDATA[			IF (MP-Mi)>(Mf-Mi)/8  AND (MP-Mi)<= 3*(Mf-Mi)/8 THEN]]>
</Line>
<Line Number="239">
<![CDATA[				SP := Si+ (Sf-Si)*(2.444016188*((MP-Mi)/(Mf-Mi))**2 - 0.22203094*(MP-Mi)/(Mf-Mi) + 0.00723406);]]>
</Line>
<Line Number="240">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="241">
<![CDATA[			IF (MP-Mi)>3*(Mf-Mi)/8  AND (MP-Mi)<= 5*(Mf-Mi)/8 THEN]]>
</Line>
<Line Number="242">
<![CDATA[				SP := Si+ (Sf-Si)*(1.6110155*(MP-Mi)/(Mf-Mi) + 0.0309544*Sin(4*3.14159265*(MP-Mi)/(Mf-Mi))- 0.3055077);]]>
</Line>
<Line Number="243">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="244">
<![CDATA[			IF (MP-Mi)>5*(Mf-Mi)/8  AND (MP-Mi)<= 7*(Mf-Mi)/8 THEN]]>
</Line>
<Line Number="245">
<![CDATA[				SP := Si+ (Sf-Si)*(4.6660917*(MP-Mi)/(Mf-Mi)-2.44406188*((MP-Mi)/(Mf-Mi))**2 -1.2292650);]]>
</Line>
<Line Number="246">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="247">
<![CDATA[			IF (MP-Mi)>(7*(Mf-Mi)/8) THEN]]>
</Line>
<Line Number="248">
<![CDATA[                SP := Si+ (Sf-Si)*(0.6110155 + 0.3889845*(MP-Mi)/(Mf-Mi) - 0.0309544*SIN(4*3.14159265*(MP-Mi)/(Mf-Mi)));]]>
</Line>
<Line Number="249">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="250">
<![CDATA[]]>
</Line>
<Line Number="251">
<![CDATA[]]>
</Line>
<Line Number="252">
<![CDATA[		END_CASE;]]>
</Line>
<Line Number="253">
<![CDATA[]]>
</Line>
<Line Number="254">
<![CDATA[         //Populate CAM]]>
</Line>
<Line Number="255">
<![CDATA[		My_CAM[Index].Master := MP;]]>
</Line>
<Line Number="256">
<![CDATA[		My_CAM[Index].Slave := SP;]]>
</Line>
<Line Number="257">
<![CDATA[		My_CAM[Index].SegmentType := SegmentType;]]>
</Line>
<Line Number="258">
<![CDATA[]]>
</Line>
<Line Number="259">
<![CDATA[        // Increment to next position]]>
</Line>
<Line Number="260">
<![CDATA[		MP := MP+Step;]]>
</Line>
<Line Number="261">
<![CDATA[		Index := Index + 1;]]>
</Line>
<Line Number="262">
<![CDATA[	END_WHILE;]]>
</Line>
<Line Number="263">
<![CDATA[]]>
</Line>
<Line Number="264">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="265">
<![CDATA[]]>
</Line>
<Line Number="266">
<![CDATA[// First and Last CAM entry forced to avoid negative numbers and round off errors on the cam boundaries]]>
</Line>
<Line Number="267">
<![CDATA[My_CAM[Index].Master := Master_Cycle;]]>
</Line>
<Line Number="268">
<![CDATA[My_CAM[Index].Slave := Slave_Cycle;]]>
</Line>
<Line Number="269">
<![CDATA[My_CAM[0].Slave := Interpolation_ViaPoint[0].Slave_Position;]]>
</Line>
<Line Number="270">
<![CDATA[]]>
</Line>
<Line Number="271">
<![CDATA[]]>
</Line>
<Line Number="272">
<![CDATA[IF Interpolation_ViaPoint[f].SegmentType < 1 THEN]]>
</Line>
<Line Number="273">
<![CDATA[	My_CAM[Index].SegmentType := 0;  //Linear]]>
</Line>
<Line Number="274">
<![CDATA[ELSE]]>
</Line>
<Line Number="275">
<![CDATA[	My_CAM[Index].SegmentType := 1;  //Cubic]]>
</Line>
<Line Number="276">
<![CDATA[END_IF;]]>
</Line>
<Line Number="277">
<![CDATA[]]>
</Line>
<Line Number="278">
<![CDATA[Index := Index + 1;]]>
</Line>
<Line Number="279">
<![CDATA[]]>
</Line>
<Line Number="280">
<![CDATA[Length := Index;	// Set for MCCP instruction]]>
</Line>
<Line Number="281">
<![CDATA[]]>
</Line>
<Line Number="282">
<![CDATA[WHILE Index < Cam_Size DO   // Zero out the rest of the CAM]]>
</Line>
<Line Number="283">
<![CDATA[	My_CAM[Index].Master :=0.0;]]>
</Line>
<Line Number="284">
<![CDATA[	My_CAM[Index].Slave := 0.0;]]>
</Line>
<Line Number="285">
<![CDATA[	My_CAM[Index].SegmentType := 0;]]>
</Line>
<Line Number="286">
<![CDATA[	Index := Index +1;]]>
</Line>
<Line Number="287">
<![CDATA[END_WHILE;]]>
</Line>
<Line Number="288">
<![CDATA[]]>
</Line>
<Line Number="289">
<![CDATA[Start_Slope := Interpolation_ViaPoint[0].Slave_Velocity;  			// Set for MCCP instruction]]>
</Line>
<Line Number="290">
<![CDATA[End_Slope := Interpolation_ViaPoint[Last_Segment].Slave_Velocity;  	// Set for MCCP instruction]]>
</Line>
<Line Number="291">
<![CDATA[]]>
</Line>
<Line Number="292">
<![CDATA[// OFFSET]]>
</Line>
<Line Number="293">
<![CDATA[]]>
</Line>
<Line Number="294">
<![CDATA[]]>
</Line>
<Line Number="295">
<![CDATA[IF Offset <> 0]]>
</Line>
<Line Number="296">
<![CDATA[	THEN]]>
</Line>
<Line Number="297">
<![CDATA[		StartValue	:=		 0;]]>
</Line>
<Line Number="298">
<![CDATA[		Max			:=		Length;		// Lunghezza della camma]]>
</Line>
<Line Number="299">
<![CDATA[		Increment	:=	   	 1;]]>
</Line>
<Line Number="300">
<![CDATA[]]>
</Line>
<Line Number="301">
<![CDATA[		FOR LocalIndex := StartValue TO Max	BY Increment]]>
</Line>
<Line Number="302">
<![CDATA[			DO]]>
</Line>
<Line Number="303">
<![CDATA[]]>
</Line>
<Line Number="304">
<![CDATA[				My_CAM[LocalIndex].Slave	:=	My_CAM[LocalIndex].Slave + Offset;]]>
</Line>
<Line Number="305">
<![CDATA[								]]>
</Line>
<Line Number="306">
<![CDATA[		END_FOR;]]>
</Line>
<Line Number="307">
<![CDATA[]]>
</Line>
<Line Number="308">
<![CDATA[		END_IF;	]]>
</Line>
<Line Number="309">
<![CDATA[]]>
</Line>
<Line Number="310">
<![CDATA[]]>
</Line>
<Line Number="311">
<![CDATA[																	//	VALore := VALoreTOT MOD 360;]]>
</Line>
<Line Number="312">
<![CDATA[]]>
</Line>
<Line Number="313">
<![CDATA[]]>
</Line>
<Line Number="314">
<![CDATA[// END OF PROGRAM]]>
</Line>
<Line Number="315">
<![CDATA[]]>
</Line>
<Line Number="316">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
