</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Manual_CmdEnable)[XIC(EM_Infeed_HMI_PB_CRS.Rq_xManual_Trap_ON) [OTL(EM_Infeed_HMI_PB_CRS.St_xManual_Trap_ON) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Trap_ON) ] ,XIC(EM_Infeed_HMI_PB_CRS.Rq_xManual_Trap_OFF) [OTL(EM_Infeed_HMI_PB_CRS.St_xManual_Trap_OFF) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Trap_OFF) ] ];]]>
