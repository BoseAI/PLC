</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Network 21]]>
</Comment>
<Text>
<![CDATA[XIC(BB.Machine_Ready)XIC(EM_PAL_Infeed.xPos4_CycleInProgress)XIC(EM_PAL_Infeed.xCaseTransportMotorEnable)[EQ(EM_PAL_Infeed.iPos4_SeqChange,6) XIO(EM_PAL_Infeed.TON_PresenceCaseForStartCycle_Pos4.DN) ,EQ(EM_PAL_Infeed.iPos4_SeqChange,1) ][MOVE(Timers.N[118].PRE,EM_PAL_Infeed.TimeOut_DelayCaseTransportGoodProd.PRE) ,TON(EM_PAL_Infeed.TON_DelayExitGoodProdTO,?,?) ];]]>
