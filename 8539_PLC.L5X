<LocalTag Name="PAUSED" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[80]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="80"/>
</DefaultData>
</LocalTag>
<LocalTag Name="IDLE" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="HOLDING" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[90]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="90"/>
</DefaultData>
</LocalTag>
<LocalTag Name="HMI_RETVAL_COMPLETED_WITH_ERRORS" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[12]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="12"/>
</DefaultData>
</LocalTag>
<LocalTag Name="HMI_RETVAL_COMPLETED_SUCCESSFULLY" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[4]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="4"/>
</DefaultData>
</LocalTag>
<LocalTag Name="HELD" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[100]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="100"/>
</DefaultData>
</LocalTag>
<LocalTag Name="FALSE" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="COMPLETING" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[30]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="30"/>
</DefaultData>
</LocalTag>
<LocalTag Name="COMPLETE" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[40]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="40"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ABORTING" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[199]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="199"/>
</DefaultData>
</LocalTag>
<LocalTag Name="ABORTED" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[200]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="200"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[ISA88 batch management]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[ //FSM ISA - S88]]>
</Line>
<Line Number="1">
<![CDATA[    //]]>
</Line>
<Line Number="2">
<![CDATA[    //00 - IDLE: The equipment is waiting for a "START" command from the MES]]>
</Line>
<Line Number="3">
<![CDATA[    //      --"Start"--> STARTING]]>
</Line>
<Line Number="4">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="5">
<![CDATA[    //]]>
</Line>
<Line Number="6">
<![CDATA[    //10 - STARTING: The equipment is waiting for the HMI to complete the Format Change and to open the Batch ]]>
</Line>
<Line Number="7">
<![CDATA[    //      --"BatchOpened"--> RUNNING]]>
</Line>
<Line Number="8">
<![CDATA[    //      --"Time Out" OR "Error_FormatChange" OR "Error_BatchOpen"--> ABORTING]]>
</Line>
<Line Number="9">
<![CDATA[    //      ]]>
</Line>
<Line Number="10">
<![CDATA[    //20 - RUNNING: The equipment is in normal operation state (the machine can produce) ]]>
</Line>
<Line Number="11">
<![CDATA[    //      --"Stop"--> STOPPING]]>
</Line>
<Line Number="12">
<![CDATA[    //      --"Hold"--> HOLDING]]>
</Line>
<Line Number="13">
<![CDATA[    //      --"Pause"--> PAUSING]]>
</Line>
<Line Number="14">
<![CDATA[    //      --"BatchStop"--> COMPLETING]]>
</Line>
<Line Number="15">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="16">
<![CDATA[    //      ]]>
</Line>
<Line Number="17">
<![CDATA[    //30 - COMPLETING:]]>
</Line>
<Line Number="18">
<![CDATA[    //		--"Batch Closed" AND "ReportName <> ''" --> COMPLETED]]>
</Line>
<Line Number="19">
<![CDATA[    //		--"Time Out" OR "Error_BatchClosing" --> ABORTING]]>
</Line>
<Line Number="20">
<![CDATA[    //]]>
</Line>
<Line Number="21">
<![CDATA[ 	//40 - COMPLETED:]]>
</Line>
<Line Number="22">
<![CDATA[ 	//		--"ResetFromComplete" --> IDLE]]>
</Line>
<Line Number="23">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="24">
<![CDATA[ 	//]]>
</Line>
<Line Number="25">
<![CDATA[ 	//50 - STOPPING:]]>
</Line>
<Line Number="26">
<![CDATA[  	//		--"Time Out Stopping" --> STOPPED]]>
</Line>
<Line Number="27">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="28">
<![CDATA[ 	//]]>
</Line>
<Line Number="29">
<![CDATA[	//60 - STOPPED:]]>
</Line>
<Line Number="30">
<![CDATA[  	//		--"Reset" --> IDLE]]>
</Line>
<Line Number="31">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="32">
<![CDATA[ 	//]]>
</Line>
<Line Number="33">
<![CDATA[ 	//70 - PAUSING:]]>
</Line>
<Line Number="34">
<![CDATA[  	//		--"Time Out Pausing" --> PAUSED]]>
</Line>
<Line Number="35">
<![CDATA[    //      --"Stop"--> STOPPING]]>
</Line>
<Line Number="36">
<![CDATA[    //      --"Hold"--> HOLDING]]>
</Line>
<Line Number="37">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="38">
<![CDATA[ 	//]]>
</Line>
<Line Number="39">
<![CDATA[ 	//80 - PAUSED:]]>
</Line>
<Line Number="40">
<![CDATA[  	//		--"Resume" --> RUNNING]]>
</Line>
<Line Number="41">
<![CDATA[    //      --"Stop"--> STOPPING]]>
</Line>
<Line Number="42">
<![CDATA[    //      --"Hold"--> HOLDING]]>
</Line>
<Line Number="43">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="44">
<![CDATA[ 	//]]>
</Line>
<Line Number="45">
<![CDATA[ 	//90 - HOLDING:]]>
</Line>
<Line Number="46">
<![CDATA[  	//		--"Time Out Holding" --> HELD]]>
</Line>
<Line Number="47">
<![CDATA[    //      --"Stop"--> STOPPING]]>
</Line>
<Line Number="48">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="49">
<![CDATA[ 	//]]>
</Line>
<Line Number="50">
<![CDATA[ 	//100 - HELD:]]>
</Line>
<Line Number="51">
<![CDATA[  	//		--"Restart" --> RESTARTING]]>
</Line>
<Line Number="52">
<![CDATA[    //      --"Stop"--> STOPPING]]>
</Line>
<Line Number="53">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="54">
<![CDATA[ 	//]]>
</Line>
<Line Number="55">
<![CDATA[ 	//110 - RESTARTING:]]>
</Line>
<Line Number="56">
<![CDATA[  	//		--"Time out Restarting" --> RUNNING]]>
</Line>
<Line Number="57">
<![CDATA[    //      --"Stop"--> STOPPING]]>
</Line>
<Line Number="58">
<![CDATA[    //      --"Hold"--> HOLDING]]>
</Line>
<Line Number="59">
<![CDATA[    //      --"Abort"--> ABORTING]]>
</Line>
<Line Number="60">
<![CDATA[ ]]>
</Line>
<Line Number="61">
<![CDATA[    ]]>
</Line>
<Line Number="62">
<![CDATA[    ]]>
</Line>
<Line Number="63">
<![CDATA[    ]]>
</Line>
<Line Number="64">
<![CDATA[    Q_St_iFSM_PreviousState := St_iFSM_PreviousState;]]>
</Line>
<Line Number="65">
<![CDATA[    Q_St_iFSM_ActualState   := St_iFSM_ActualState;]]>
</Line>
<Line Number="66">
<![CDATA[    ]]>
</Line>
<Line Number="67">
<![CDATA[]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[    IF NOT I_Rq_xScada_Start AND St_xHMI_Scada_BatchStart THEN]]>
</Line>
<Line Number="70">
<![CDATA[        St_xHMI_Scada_BatchStart := FALSE;]]>
</Line>
<Line Number="71">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="72">
<![CDATA[    ]]>
</Line>
<Line Number="73">
<![CDATA[    ]]>
</Line>
<Line Number="74">
<![CDATA[    // Su fronte positivo della modalità remota, qualunque sia lo stato, se lotto aperto -> chiudere e pulire dati]]>
</Line>
<Line Number="75">
<![CDATA[    ]]>
</Line>
<Line Number="76">
<![CDATA[    // From Remote mode to Local Mode]]>
</Line>
<Line Number="77">
<![CDATA[    IF I_St_xHMI_RemoteMode AND NOT St_xHMI_RemoteMode_Old THEN]]>
</Line>
<Line Number="78">
<![CDATA[        St_xHMI_RemoteMode_Old := TRUE;]]>
</Line>
<Line Number="79">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="80">
<![CDATA[        ]]>
</Line>
<Line Number="81">
<![CDATA[        ]]>
</Line>
<Line Number="82">
<![CDATA[    //Alarm reset]]>
</Line>
<Line Number="83">
<![CDATA[    Q_St_xALRM_FormatFromRemoteNotOK := FALSE;]]>
</Line>
<Line Number="84">
<![CDATA[    Q_St_xALRM_VariableDataFromRemoteNotOK := FALSE;]]>
</Line>
<Line Number="85">
<![CDATA[    Q_St_xALRM_AbortFromRemote := FALSE;]]>
</Line>
<Line Number="86">
<![CDATA[    ]]>
</Line>
<Line Number="87">
<![CDATA[    ]]>
</Line>
<Line Number="88">
<![CDATA[    //Waiting for the HMI answer]]>
</Line>
<Line Number="89">
<![CDATA[    //Used also for some state transitions (from the ING states to the "finite" states)]]>
</Line>
<Line Number="90">
<![CDATA[	]]>
</Line>
<Line Number="91">
<![CDATA[(*]]>
</Line>
<Line Number="92">
<![CDATA[    TON_BatchStarting_Timeout      (IN := St_iFSM_ActualState = STARTING,]]>
</Line>
<Line Number="93">
<![CDATA[                                        PT := T10m);]]>
</Line>
<Line Number="94">
<![CDATA[    TON_BatchCompliting_Timeout    (IN := St_iFSM_ActualState = COMPLETING,]]>
</Line>
<Line Number="95">
<![CDATA[                                      	PT := T2m);]]>
</Line>
<Line Number="96">
<![CDATA[    TON_Stopping_Timeout           (IN := St_iFSM_ActualState = STOPPING,]]>
</Line>
<Line Number="97">
<![CDATA[	                         			PT := T2m);]]>
</Line>
<Line Number="98">
<![CDATA[*)]]>
</Line>
<Line Number="99">
<![CDATA[	]]>
</Line>
<Line Number="100">
<![CDATA[	TON_BatchStarting_Timeout.PRE := 600000; //10 min]]>
</Line>
<Line Number="101">
<![CDATA[	TON_BatchStarting_Timeout.TimerEnable := (St_iFSM_ActualState = STARTING);]]>
</Line>
<Line Number="102">
<![CDATA[	TONR(TON_BatchStarting_Timeout);]]>
</Line>
<Line Number="103">
<![CDATA[	]]>
</Line>
<Line Number="104">
<![CDATA[	TON_BatchCompliting_Timeout.PRE := 120000; //2 min]]>
</Line>
<Line Number="105">
<![CDATA[	TON_BatchCompliting_Timeout.TimerEnable := (St_iFSM_ActualState = COMPLETING);]]>
</Line>
<Line Number="106">
<![CDATA[	TONR(TON_BatchCompliting_Timeout);]]>
</Line>
<Line Number="107">
<![CDATA[	]]>
</Line>
<Line Number="108">
<![CDATA[	TON_Stopping_Timeout.PRE := 120000; //2 min]]>
</Line>
<Line Number="109">
<![CDATA[	TON_Stopping_Timeout.TimerEnable := (St_iFSM_ActualState = STOPPING);]]>
</Line>
<Line Number="110">
<![CDATA[	TONR(TON_Stopping_Timeout);]]>
</Line>
<Line Number="111">
<![CDATA[	]]>
</Line>
<Line Number="112">
<![CDATA[	TON_Pausing_Timeout.PRE := 60000; //1 min]]>
</Line>
<Line Number="113">
<![CDATA[	TON_Pausing_Timeout.TimerEnable := (St_iFSM_ActualState = PAUSING);]]>
</Line>
<Line Number="114">
<![CDATA[	TONR(TON_Pausing_Timeout);]]>
</Line>
<Line Number="115">
<![CDATA[]]>
</Line>
<Line Number="116">
<![CDATA[	TON_Holding_Timeout.PRE := 60000; //1 min]]>
</Line>
<Line Number="117">
<![CDATA[	TON_Holding_Timeout.TimerEnable := (St_iFSM_ActualState = HOLDING);]]>
</Line>
<Line Number="118">
<![CDATA[	TONR(TON_Holding_Timeout);]]>
</Line>
<Line Number="119">
<![CDATA[	]]>
</Line>
<Line Number="120">
<![CDATA[	TON_Restarting_Timeout.PRE := 60000; //1 min]]>
</Line>
<Line Number="121">
<![CDATA[	TON_Restarting_Timeout.TimerEnable := (St_iFSM_ActualState = RESTARTING);]]>
</Line>
<Line Number="122">
<![CDATA[	TONR(TON_Restarting_Timeout);]]>
</Line>
<Line Number="123">
<![CDATA[       ]]>
</Line>
<Line Number="124">
<![CDATA[       ]]>
</Line>
<Line Number="125">
<![CDATA[    IF I_St_xHMI_BatchManagementActive THEN]]>
</Line>
<Line Number="126">
<![CDATA[        CASE St_iFSM_ActualState OF]]>
</Line>
<Line Number="127">
<![CDATA[]]>
</Line>
<Line Number="128">
<![CDATA[         	0:		//IDLE]]>
</Line>
<Line Number="129">
<![CDATA[              IF I_St_xHMI_RemoteMode THEN]]>
</Line>
<Line Number="130">
<![CDATA[                    //Trigger for the starting of the procedure of batch opening]]>
</Line>
<Line Number="131">
<![CDATA[                    IF ((I_Rq_xScada_Start AND I_Rq_xScada_Start_SignalEnable) AND]]>
</Line>
<Line Number="132">
<![CDATA[                        NOT St_xHMI_Scada_BatchStart) THEN]]>
</Line>
<Line Number="133">
<![CDATA[                        St_xHMI_Scada_BatchStart := TRUE;]]>
</Line>
<Line Number="134">
<![CDATA[                        //Batch data freezing]]>
</Line>
<Line Number="135">
<![CDATA[                        //Done in order to give the possibility to HMI to perform all the checks]]>
</Line>
<Line Number="136">
<![CDATA[                        //on a stable data values]]>
</Line>
<Line Number="137">
<![CDATA[                        //IQ_strBatchData_ToBeSet_HMI := IQ_strBatchData_ToBeSet;]]>
</Line>
<Line Number="138">
<![CDATA[						CPS(IQ_strBatchData_ToBeSet, IQ_strBatchData_ToBeSet_HMI, 1);]]>
</Line>
<Line Number="139">
<![CDATA[                        IQ_St_xHMI_BatchStart_Button_Enable := TRUE;]]>
</Line>
<Line Number="140">
<![CDATA[                        ]]>
</Line>
<Line Number="141">
<![CDATA[                    ELSIF (NOT I_Rq_xScada_Start AND I_Rq_xScada_Start_SignalEnable) AND NOT St_xHMI_Scada_BatchStart THEN]]>
</Line>
<Line Number="142">
<![CDATA[                        IQ_St_xHMI_BatchStart_Button_Enable := FALSE;]]>
</Line>
<Line Number="143">
<![CDATA[                        ]]>
</Line>
<Line Number="144">
<![CDATA[                    ELSIF NOT I_Rq_xScada_Start_SignalEnable THEN]]>
</Line>
<Line Number="145">
<![CDATA[                        St_xHMI_Scada_BatchStart := TRUE;]]>
</Line>
<Line Number="146">
<![CDATA[                        //IQ_strBatchData_ToBeSet_HMI := IQ_strBatchData_ToBeSet;]]>
</Line>
<Line Number="147">
<![CDATA[						CPS(IQ_strBatchData_ToBeSet, IQ_strBatchData_ToBeSet_HMI, 1);]]>
</Line>
<Line Number="148">
<![CDATA[                        IQ_St_xHMI_BatchStart_Button_Enable := TRUE;]]>
</Line>
<Line Number="149">
<![CDATA[                    END_IF;]]>
</Line>
<Line Number="150">
<![CDATA[                    ]]>
</Line>
<Line Number="151">
<![CDATA[                    IF I_Rq_xScada_Start_SignalEnable THEN]]>
</Line>
<Line Number="152">
<![CDATA[                        IQ_St_MSG_BatchOpeningProcedure := IQ_St_xHMI_BatchStart_Button_Enable;]]>
</Line>
<Line Number="153">
<![CDATA[                    END_IF;]]>
</Line>
<Line Number="154">
<![CDATA[                        ]]>
</Line>
<Line Number="155">
<![CDATA[                        ]]>
</Line>
<Line Number="156">
<![CDATA[                    //ABORT MANAGEMENT]]>
</Line>
<Line Number="157">
<![CDATA[                    //Allow the batch closing procedure]]>
</Line>
<Line Number="158">
<![CDATA[                    IF (I_Rq_xScada_Abort_SignalEnable AND I_Rq_xScada_Abort) THEN]]>
</Line>
<Line Number="159">
<![CDATA[                        IQ_St_xHMI_BatchStart_Button_Enable := FALSE;]]>
</Line>
<Line Number="160">
<![CDATA[                        St_xHMI_Scada_BatchStart := FALSE;]]>
</Line>
<Line Number="161">
<![CDATA[                        St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="162">
<![CDATA[                        St_iFSM_ActualState := ABORTING;]]>
</Line>
<Line Number="163">
<![CDATA[                    END_IF;]]>
</Line>
<Line Number="164">
<![CDATA[                    ]]>
</Line>
<Line Number="165">
<![CDATA[                ELSE]]>
</Line>
<Line Number="166">
<![CDATA[                    //Reset all the remote ToBeSet variables on the HMI]]>
</Line>
<Line Number="167">
<![CDATA[                    IF St_xHMI_RemoteMode_Old THEN]]>
</Line>
<Line Number="168">
<![CDATA[                        St_xHMI_RemoteMode_Old := FALSE;]]>
</Line>
<Line Number="169">
<![CDATA[                        //IQ_strBatchData_ToBeSet_HMI := strBatchData_Clear;]]>
</Line>
<Line Number="170">
<![CDATA[						CPS(strBatchData_Clear, IQ_strBatchData_ToBeSet_HMI, 1);]]>
</Line>
<Line Number="171">
<![CDATA[                    END_IF;]]>
</Line>
<Line Number="172">
<![CDATA[                    St_xHMI_Scada_BatchStart := FALSE;]]>
</Line>
<Line Number="173">
<![CDATA[                    IQ_St_xHMI_BatchStart_Button_Enable := TRUE;]]>
</Line>
<Line Number="174">
<![CDATA[                END_IF;]]>
</Line>
<Line Number="175">
<![CDATA[                ]]>
</Line>
<Line Number="176">
<![CDATA[				IQ_St_xHMI_BatchStop_Button_Enable := FALSE;]]>
</Line>
<Line Number="177">
<![CDATA[				]]>
</Line>
<Line Number="178">
<![CDATA[                //Waiting for the HMI answer]]>
</Line>
<Line Number="179">
<![CDATA[                IF IQ_St_iHMI_FormatCheck_RetVal = HMI_RETVAL_COMPLETED_SUCCESSFULLY THEN]]>
</Line>
<Line Number="180">
<![CDATA[                    IQ_St_xHMI_BatchStart_Button_Enable := FALSE;]]>
</Line>
<Line Number="181">
<![CDATA[                    ]]>
</Line>
<Line Number="182">
<![CDATA[                    IQ_St_xHMI_BatchStart_NotOk := FALSE;]]>
</Line>
<Line Number="183">
<![CDATA[                    IQ_St_xHMI_BatchStop_NotOk := FALSE;]]>
</Line>
<Line Number="184">
<![CDATA[                    ]]>
</Line>
<Line Number="185">
<![CDATA[                    IQ_Rq_xFormatChange := TRUE;]]>
</Line>
<Line Number="186">
<![CDATA[                    ]]>
</Line>
<Line Number="187">
<![CDATA[                    St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="188">
<![CDATA[                    IQ_St_iHMI_FormatCheck_RetVal := 0;]]>
</Line>
<Line Number="189">
<![CDATA[                    St_iFSM_ActualState := STARTING;]]>
</Line>
<Line Number="190">
<![CDATA[                    ]]>
</Line>
<Line Number="191">
<![CDATA[                ELSIF IQ_St_iHMI_FormatCheck_RetVal = HMI_RETVAL_COMPLETED_WITH_ERRORS THEN]]>
</Line>
<Line Number="192">
<![CDATA[                    IF I_St_xHMI_RemoteMode THEN]]>
</Line>
<Line Number="193">
<![CDATA[                        Q_St_xALRM_FormatFromRemoteNotOK := TRUE;]]>
</Line>
<Line Number="194">
<![CDATA[                    END_IF;]]>
</Line>
<Line Number="195">
<![CDATA[                    St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="196">
<![CDATA[                    IQ_St_iHMI_FormatCheck_RetVal := 0;]]>
</Line>
<Line Number="197">
<![CDATA[                    St_iFSM_ActualState := ABORTING;]]>
</Line>
<Line Number="198">
<![CDATA[                END_IF;]]>
</Line>
<Line Number="199">
<![CDATA[                ]]>
</Line>
<Line Number="200">
<![CDATA[                ]]>
</Line>
<Line Number="201">
<![CDATA[            10:  	//STARTING]]>
</Line>
<Line Number="202">
<![CDATA[                IF IQ_St_xPLC_FormatChange_Ok AND IQ_St_xHMI_BatchStart_Ok THEN]]>
</Line>
<Line Number="203">
<![CDATA[                    St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="204">
<![CDATA[					IQ_St_sHMI_BachReportName := '';]]>
</Line>
<Line Number="205">
<![CDATA[                    St_iFSM_ActualState := RUNNING;]]>
</Line>
<Line Number="206">
<![CDATA[                    ]]>
</Line>
<Line Number="207">
<![CDATA[                ELSIF IQ_St_xHMI_FormatChange_NotOk OR IQ_St_xPLC_FormatChange_NotOk THEN]]>
</Line>
<Line Number="208">
<![CDATA[                    St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="209">
<![CDATA[                    //Alrm 25 already set to TRUE by FC26]]>
</Line>
<Line Number="210">
<![CDATA[                    St_iFSM_ActualState := ABORTING;]]>
</Line>
<Line Number="211">
<![CDATA[                    ]]>
</Line>
<Line Number="212">
<![CDATA[                ELSIF IQ_St_xHMI_BatchStart_NotOk OR TON_BatchStarting_Timeout.DN THEN]]>
</Line>
<Line Number="213">
<![CDATA[                    IQ_St_xHMI_BatchStart_NotOk := FALSE;]]>
</Line>
<Line Number="214">
<![CDATA[                    IF I_St_xHMI_RemoteMode THEN]]>
</Line>
<Line Number="215">
<![CDATA[                        Q_St_xALRM_VariableDataFromRemoteNotOK := TRUE;]]>
</Line>
<Line Number="216">
<![CDATA[                    END_IF;]]>
</Line>
<Line Number="217">
<![CDATA[                    St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="218">
<![CDATA[                    St_iFSM_ActualState := ABORTING;]]>
</Line>
<Line Number="219">
<![CDATA[                    ]]>
</Line>
<Line Number="220">
<![CDATA[                ELSIF IQ_Rq_xHMI_AbortFormatChange THEN]]>
</Line>
<Line Number="221">
