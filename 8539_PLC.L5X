<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(i_xEnable)XIC(i_xMot_Safety)[XIC(i_xDelayEmergency) OTE(xCmdEnable) ,XIO(i_xDelayEmergency) [OTU(iq_CM_Inverter.InverterIN_xForward_Rq) ,OTU(iq_CM_Inverter.InverterIN_xBackward_Rq) ] ];]]>
</Text>
