</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(iq_Active)[MOVE(0,BrakeStep) ,OTL(q_CmdAux_ElectricBrake) ,OTL(q_CmdAux_PneumBrake) ,OTU(q_CmdUnbrake) ,OTU(q_CmdAux_ReleaseBrake) ,OTU(RqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(iq_Active)EQ(BrakeStep,0)[MOVE(0,q_Word_ElectricalTest) ,MOVE(0,q_Word_PneumTest) ,OTL(q_CmdUnbrake) ,XIC(i_RqOpenCircuitBrake) OTL(RqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(iq_Active)EQ(BrakeStep,1)[XIC(i_RqOpenCircuitBrake) [OTU(q_CmdAux_ElectricBrake) ,OTU(q_CmdAux_PneumBrake) ,XIO(i_AirPressureSwitch) OTL(q_CmdAux_ReleaseBrake) ] ,XIC(i_UnbrakeDone) OTL(RqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(iq_Active)EQ(BrakeStep,2)[OTL(q_CmdAux_ElectricBrake) ,MOVE(1,q_Word_PneumTest) ,XIC(Ifb_DelayCheckDeltaPos.Q_xSensor) [MOVE(2,q_Word_PneumTest) ,OTL(RqIncBrakeStep) ] ,XIC(i_DeltaPosAlrm) [MOVE(3,q_Word_PneumTest) ,OTU(iq_Active) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(iq_Active)EQ(BrakeStep,3)[OTU(q_CmdAux_ElectricBrake) ,XIO(Ifb_DelayCheckDeltaPos.Q_xSensor) OTL(RqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(iq_Active)EQ(BrakeStep,4)[OTL(q_CmdAux_PneumBrake) ,MOVE(1,q_Word_ElectricalTest) ,XIC(Ifb_DelayCheckDeltaPos.Q_xSensor) [MOVE(2,q_Word_ElectricalTest) ,OTL(RqIncBrakeStep) ] ,XIC(i_DeltaPosAlrm) [MOVE(3,q_Word_ElectricalTest) ,OTU(iq_Active) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(iq_Active)EQ(BrakeStep,5)[OTU(q_CmdAux_PneumBrake) ,XIO(Ifb_DelayCheckDeltaPos.Q_xSensor) OTL(RqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(iq_Active)EQ(BrakeStep,6)[[XIO(i_UnbrakeDone) ,XIC(i_DriveEnabled) ] OTU(iq_Active) ,OTU(q_CmdUnbrake) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(RqIncBrakeStep)[ADD(BrakeStep,1,BrakeStep) ,OTU(RqIncBrakeStep) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIO(i_DeltaPosAlrm)[EQ(BrakeStep,2) ,EQ(BrakeStep,4) ]OTE(Ifb_DelayCheckDeltaPos.I_xSensor);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[InputFilter(Ifb_DelayCheckDeltaPos,i_DelayCheckDeltaPos,1000);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="BrakeTest_2AxisMayr" Class="Standard" Revision="2.1" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2008-01-15T10:31:04.156Z" CreatedBy="Not Available" EditedDate="2026-01-21T10:55:43.444Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v36.00"
>
