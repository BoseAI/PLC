</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Step 7:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],7)[EQ(UM_Machine.iDevice_Bad,0) [OTL(BB.SizeChange_PointerIncreaseRq) ,OTL(UM_HMI.Machine.St_xSizeChange) ] ,NE(UM_Machine.iDevice_Bad,0) MOVE(102,SizeAux[2]) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Step 8:]]>
