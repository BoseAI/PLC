<Routines>
<Routine Name="Calc_Pallet" Type="RLL">
<Description>
<![CDATA[v0.1        : 23.03.2023
Author      : Ing.Utili Nicola
Comment: Start program from 8191 
                and  Base CPH2-TIA
]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[Calc_LayerCasesCounter(Calc_LayerCasesCounter_Set,PAL_SizeWork.Palletizer.Generals.R106,PAL_SizeWork.Palletizer.Generals.R123,PAL_SizeWork.Palletizer.Generals.R134,PAL_SizeWork.Palletizer.Generals.R135,PAL_SizeWork.Palletizer.Generals.R133,PAL_SizeWork.Palletizer.Generals.R113,PAL_SizeWork.Palletizer.Generals.R112,PAL_SizeWork.Palletizer.Generals.R110,DB_Pal_RobotIO.GO.i04,PAL_SizeWork.Palletizer.Generals,PAL_SizeWork.Palletizer.DepositTypeLayerA,PAL_SizeWork.Palletizer.DepositTypeLayerB,DB_Pal_InterfaceDataHmi.CasesPerLayerPalletSet,NumberProd_A,NumberProd_B);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[Calc_LayerCasesCounter(Calc_LayerCasesCounter_Actual,PAL_SizeWork.Palletizer.Generals.R106,PAL_SizeWork.Palletizer.Generals.R123,PAL_SizeWork.Palletizer.Generals.R134,PAL_SizeWork.Palletizer.Generals.R135,PAL_SizeWork.Palletizer.Generals.R113,PAL_SizeWork.Palletizer.Generals.R133,PAL_SizeWork.Palletizer.Generals.R112,DB_Pal_RobotIO.GO.i03,DB_Pal_RobotIO.GO.i04,PAL_SizeWork.Palletizer.Generals,PAL_SizeWork.Palletizer.DepositTypeLayerA,PAL_SizeWork.Palletizer.DepositTypeLayerB,UM_HMI.PalWorkData.St_iActualCasesPerLayer,EM_PAL.iActualCases_chA,EM_PAL.iActualCases_chB);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[MOVE(DB_Pal_RobotIO.GO.i04,UM_HMI.PalWorkData.St_iActualLayersPerPallet) ,MOVE(EM_PAL.iActualCases_chA,OM_Interface.Pal_iActualCases_chA) ,MOVE(EM_PAL.iActualCases_chB,OM_Interface.Pal_iActualCases_chB) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CM_InputPbus" Type="RLL">
<Description>
<![CDATA[v0.1        : Initial creation
Author      : Ing.Utili Nicola
Comment: Note software
Last Change : 02.10.2020]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[v0.1        : Initial creation
Author      : Ing.Utili Nicola
Comment: Note software
Last Change : 02.10.2020]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(200,TON_StopCom.PRE);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[REMOTE I/O ETHERNET CHECK]]>
</Comment>
<Text>
<![CDATA[[GSV(Module,A7600_01_Pal,EntryStatus,diRobot_EthStatus) ,MEQ(diRobot_EthStatus,61440,16384) OTE(xRobotEthStatusOK) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(xRobotEthStatusOK)TON(TON_StopCom,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(TON_StopCom.DN)XIO(EM_Pal_HMI_PB.St_xFnct_Robot_Disabling)[OTE(ALRM[620]) ,OTL(BB.Rq_EmergencyImmediateStop) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[CPS(A7600_01_Pal:I.Data[0],DB_Pal_RobotIO.DO,4);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[BTD(A7600_01_Pal:I.Data[3],16,DB_Pal_RobotIO.GO.i01,0,16) ,CPS(A7600_01_Pal:I.Data[4],DB_Pal_RobotIO.GO.i02,24) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Ausiliario per reset posizioni]]>
</Comment>
<Text>
<![CDATA[MOVE(0,wFillValue);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Check if work or not!
If not we need a structure like DO with only 0 to fullfill the DO structure]]>
</Comment>
<Text>
<![CDATA[XIC(ALRM[620])FLL(wFillValue,DB_Pal_RobotIO.DO,7);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Rq Continuos Interlayer]]>
</Comment>
<Text>
<![CDATA[XIC(BB.NoLoadRun_Enable)OTE(DB_Pal_RobotIO.DI.x58);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[VS10 Fanuc Robot channel A suction check]]>
</Comment>
<Text>
<![CDATA[[XIC(DB_Pal_RobotIO.DO.x71) ,XIC(BB.NoLoadRun_Enable) XIO(YV_AspA.q_xCmdOFF) ]OTE(EM_PAL.xVS10Robot_ChannelA_SuctionCheck);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[VS11 Fanuc Robot channel B suction check]]>
</Comment>
<Text>
<![CDATA[[XIC(DB_Pal_RobotIO.DO.x72) ,XIC(BB.NoLoadRun_Enable) XIO(YV_AspB.q_xCmdOFF) ]OTE(EM_PAL.xVS10Robot_ChannelB_SuctionCheck);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CM_ManRobot" Type="RLL">
<Description>
<![CDATA[v0.1        : Initial creation
Author      : Ing.Utili Nicola
Comment: Note software
Last Change : 02.10.2020]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(Timers.N[230].PRE,EM_PAL.TON_BufferResetTimeout.PRE);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Service message: Manual functions off]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Pal_HMI_PB.Rq_xManual_Robot_HomePos)XIO(BB.Manual_CmdEnable)[OTL(MSG[18]) ,OTU(EM_Pal_HMI_PB.Rq_xManual_Robot_HomePos) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Service message: Inserire almeno un pallet]]>
</Comment>
<Text>
