<Text>
<![CDATA[XIC(BB_CRS.Outfeed_Inhibition)XIO(BB_CRS.NoLoadRun_Enable)TON(Timers_CRS.N[23],?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Timers_CRS.N[23].DN)OTL(BB_CRS.UpstreamMachine_StopRq);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Config" Type="ST">
<Description>
<![CDATA[v01: 06/09/2021
Author :Utili Nicola
Comment: Startup 
from Hywrap base 
TIA15.1-BaseCPH2 Studio5000]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[//Machine configuration]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// Enable lock carter]]>
</Line>
<Line Number="4">
<![CDATA[UM_Config_CRS.Core.Enable_LockGuard := 1;]]>
</Line>
<Line Number="5">
<![CDATA[// UM_Config.Core]]>
</Line>
<Line Number="6">
<![CDATA[UM_Config_CRS.Core.Enable_PneumCat3_SafetyCircuit :=0;]]>
</Line>
<Line Number="7">
<![CDATA[// T&T Enabling]]>
</Line>
<Line Number="8">
<![CDATA[UM_Config_CRS.Core.Enable_TeT :=0;]]>
</Line>
<Line Number="9">
<![CDATA[UM_Config_CRS.CP.TeT_BoxChecking:=0; ]]>
</Line>
<Line Number="10">
<![CDATA[// SCADA presence always with CPU434Lean       ]]>
</Line>
<Line Number="11">
<![CDATA[UM_Config_CRS.Core.Enable_SCADA_DataExchange :=0;]]>
</Line>
<Line Number="12">
<![CDATA[//Pc Panel  presence]]>
</Line>
<Line Number="13">
<![CDATA[UM_Config_CRS.Core.Enable_PanelPc := 1;]]>
</Line>
<Line Number="14">
<![CDATA[//Enable teleassistance]]>
</Line>
<Line Number="15">
<![CDATA[UM_Config_CRS.Core.Enable_RemoteAssistance :=1;]]>
</Line>
<Line Number="16">
<![CDATA[//Remote format change enabling]]>
</Line>
<Line Number="17">
<![CDATA[UM_Config_CRS.Core.Enable_SCADA_RemoteSizeChange :=0;]]>
</Line>
<Line Number="18">
<![CDATA[// CFR21 enabling]]>
</Line>
<Line Number="19">
<![CDATA[UM_Config_CRS.Core.Enable_CFR21 := 1;]]>
</Line>
<Line Number="20">
<![CDATA[// UPS enabling]]>
</Line>
<Line Number="21">
<![CDATA[UM_Config_CRS.Core.Enable_UPS := 1;]]>
</Line>
<Line Number="22">
<![CDATA[// Warning silencing management enabling]]>
</Line>
<Line Number="23">
<![CDATA[UM_Config_CRS.Core.Enable_AcousticAlarm:= not UM_Config_CRS.Core.Enable_SAFE_LampsType and 1;]]>
</Line>
<Line Number="24">
<![CDATA[// Enable ctrl axis]]>
</Line>
<Line Number="25">
<![CDATA[UM_Config_CRS.Core.Enable_SchneiderAxis :=0;]]>
</Line>
<Line Number="26">
<![CDATA[//DownStreamMachine enable]]>
</Line>
<Line Number="27">
<![CDATA[UM_Config_CRS.Core.Enable_DownStreamMachine :=1;]]>
</Line>
<Line Number="28">
<![CDATA[//Config status guard signal]]>
</Line>
<Line Number="29">
<![CDATA[UM_Config_CRS.Core.Enable_GuardSignalInverse :=0;]]>
</Line>
<Line Number="30">
<![CDATA[//Config max load at outfeed]]>
</Line>
<Line Number="31">
<![CDATA[UM_Config_CRS.Core.Enable_SensorMaxLoad := 1;]]>
</Line>
<Line Number="32">
<![CDATA[//Safe Standard for Machine Lamp Enabling]]>
</Line>
<Line Number="33">
<![CDATA[UM_Config_CRS.Core.Enable_SAFE_LampsType:=0;]]>
</Line>
<Line Number="34">
<![CDATA[//HMI Synoptic Enabling]]>
</Line>
<Line Number="35">
<![CDATA[UM_Config_CRS.Core.Enable_Synoptic:=1;]]>
</Line>
<Line Number="36">
<![CDATA[//AutoSize change motor]]>
</Line>
<Line Number="37">
<![CDATA[UM_Config_CRS.Core.Enable_AutoSizeChangeMotor :=0;]]>
</Line>
<Line Number="38">
<![CDATA[//ACK ALARM Management]]>
</Line>
<Line Number="39">
<![CDATA[UM_Config_CRS.Core.Enable_AlarmACK :=1;   ]]>
</Line>
<Line Number="40">
<![CDATA[UM_Config_CRS.Core.Enable_PasswordState_FromHMI:=0;   ]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
