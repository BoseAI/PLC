<![CDATA[XIC(Core_HMI.PB.Rq_xSysData_ScrollUp)ONS(UM_Machine.axPTrig[15])[ADD(iAux[2],1,iAux[2]) ,GE(iAux[2],DataDefined.SysDataNoMax) MOVE(0,iAux[2]) ,LT(iAux[2],0) CPT(iAux[2],DataDefined.SysDataNoMax-1) ,MOVE(iAux[2],SYS.SelSys) ];]]>
