<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Write Delta_IN and Delta_OUT for scale function]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(i_iVal_IN,diVal_IN);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(i_iLowerLimit_IN,diLowerLimit_IN)MOVE(i_iUpperLimit_IN,diUpperLimit_IN);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(i_iLowerLimit_OUT,diLowerLimit_OUT)MOVE(i_iUpperLimit_OUT,diUpperLimit_OUT);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[SUB(diUpperLimit_IN,diLowerLimit_IN,diRange_IN);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[SUB(diUpperLimit_OUT,diLowerLimit_OUT,diRange_OUT);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[LE(diRange_IN,0) ,LE(diRange_OUT,0) ][MOVE(0,q_iVal) ,OTE(q_xError) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[SCALE FUNCTION]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[SUB(diVal_IN,diLowerLimit_IN,diDeltaVal_IN)MUL(diDeltaVal_IN,diRange_OUT,diDeltaVal_IN_AUX)DIV(diDeltaVal_IN_AUX,diRange_IN,diDeltaVal_OUT);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(i_xInversion)ADD(diLowerLimit_OUT,diDeltaVal_OUT,diVal_OUT);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(i_xInversion)SUB(diUpperLimit_OUT,diDeltaVal_OUT,diVal_OUT);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[MOVE(diVal_OUT,q_iVal);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
