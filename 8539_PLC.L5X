<Routines>
<Routine Name="HMI_GMP_Management" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[IF BB.FirstScan THEN]]>
</Line>
<Line Number="1">
<![CDATA[	//Reset the pointers variables to the value 0 and correspondingly update the interface on used by the HMI]]>
</Line>
<Line Number="2">
<![CDATA[	Core_HMI.PB.Rq_iGMPAlarmsInterfacePointer := 0;]]>
</Line>
<Line Number="3">
<![CDATA[	Core_HMI.PB.St_iGMPAlarmsInterfacePointer := 0;]]>
</Line>
<Line Number="4">
<![CDATA[	L_Rq_xUpdateHMIInterface := TRUE;]]>
</Line>
<Line Number="5">
<![CDATA[(*	FOR iCounter := 0 TO 1023 BY 1 DO]]>
</Line>
<Line Number="6">
<![CDATA[		IF GMP_ALRM_Configuration[iCounter] THEN]]>
</Line>
<Line Number="7">
<![CDATA[			SEVERITY_Alarm_Configuration[iCounter] := 900;]]>
</Line>
<Line Number="8">
<![CDATA[		ELSE]]>
</Line>
<Line Number="9">
<![CDATA[			SEVERITY_Alarm_Configuration[iCounter] := 800;]]>
</Line>
<Line Number="10">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="11">
<![CDATA[	END_FOR;*)]]>
</Line>
<Line Number="12">
<![CDATA[	iCounter := 0;]]>
</Line>
<Line Number="13">
<![CDATA[END_IF;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[//Check if the pointers are in the correct window. It is very important to not go further in the arrays. This can produce a fault of the CPU.]]>
</Line>
<Line Number="16">
<![CDATA[IF Core_HMI.PB.Rq_iGMPAlarmsInterfacePointer < 0 THEN]]>
</Line>
<Line Number="17">
<![CDATA[	Core_HMI.PB.Rq_iGMPAlarmsInterfacePointer := 0;]]>
</Line>
<Line Number="18">
<![CDATA[ELSIF Core_HMI.PB.Rq_iGMPAlarmsInterfacePointer > 63 THEN]]>
</Line>
<Line Number="19">
<![CDATA[	Core_HMI.PB.Rq_iGMPAlarmsInterfacePointer := 63;]]>
</Line>
<Line Number="20">
<![CDATA[END_IF;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[//If the pointer value used in the HMI is changed, ask for an update of the common interface]]>
</Line>
<Line Number="23">
<![CDATA[IF Core_HMI.PB.Rq_iGMPAlarmsInterfacePointer <> Core_HMI.PB.St_iGMPAlarmsInterfacePointer THEN]]>
</Line>
<Line Number="24">
<![CDATA[	L_Rq_xUpdateHMIInterface := TRUE;]]>
</Line>
<Line Number="25">
<![CDATA[	Core_HMI.PB.St_iGMPAlarmsInterfacePointer := Core_HMI.PB.Rq_iGMPAlarmsInterfacePointer;]]>
</Line>
<Line Number="26">
<![CDATA[END_IF;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[//Update of the visualization interface starting from the values recorded on the PLC]]>
</Line>
<Line Number="29">
<![CDATA[IF L_Rq_xUpdateHMIInterface THEN]]>
</Line>
<Line Number="30">
<![CDATA[	L_Rq_xUpdateHMIInterface := FALSE;]]>
</Line>
<Line Number="31">
<![CDATA[	FOR iCounter := 0 TO 15 BY 1 DO]]>
</Line>
<Line Number="32">
<![CDATA[		Core_HMI.Interface.arrGMPAlarmsInterface[iCounter] := GMP_ALRM_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16) + iCounter];]]>
</Line>
<Line Number="33">
<![CDATA[		Core_HMI.Interface.arrSEVERITYAlarmsInterface[iCounter] := SEVERITY_Alarm_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16) + iCounter];]]>
</Line>
<Line Number="34">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="35">
<![CDATA[END_IF;]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[FOR iCounter := 0 TO 15 BY 1 DO]]>
</Line>
<Line Number="38">
<![CDATA[    IF NOT Core_HMI.Interface.arrGMPAlarmsInterface[iCounter] THEN]]>
</Line>
<Line Number="39">
<![CDATA[        IF ((Core_HMI.Interface.arrSEVERITYAlarmsInterface[iCounter] < 801) OR]]>
</Line>
<Line Number="40">
<![CDATA[            (Core_HMI.Interface.arrSEVERITYAlarmsInterface[iCounter] > 899)) THEN]]>
</Line>
<Line Number="41">
<![CDATA[            Core_HMI.Interface.arrSEVERITYAlarmsInterface[iCounter] := 801;]]>
</Line>
<Line Number="42">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="43">
<![CDATA[    ELSE]]>
</Line>
<Line Number="44">
<![CDATA[        // TRUE → deve stare tra 901 e 999]]>
</Line>
<Line Number="45">
<![CDATA[        IF ((Core_HMI.Interface.arrSEVERITYAlarmsInterface[iCounter] < 901) OR]]>
</Line>
<Line Number="46">
<![CDATA[            (Core_HMI.Interface.arrSEVERITYAlarmsInterface[iCounter] > 999)) THEN]]>
</Line>
<Line Number="47">
<![CDATA[            Core_HMI.Interface.arrSEVERITYAlarmsInterface[iCounter] := 901;]]>
</Line>
<Line Number="48">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="49">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="50">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[//Update the values recorded on the PLC after the modification performed on the HMI.]]>
</Line>
<Line Number="56">
<![CDATA[IF Core_HMI.PB.Rq_xGMPAlarmsInterface_Update THEN]]>
</Line>
<Line Number="57">
<![CDATA[	Core_HMI.PB.Rq_xGMPAlarmsInterface_Update := FALSE;]]>
</Line>
<Line Number="58">
<![CDATA[	For iCounter := 0 TO 15 BY 1 DO]]>
</Line>
<Line Number="59">
<![CDATA[		GMP_ALRM_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] := Core_HMI.Interface.arrGMPAlarmsInterface[iCounter];]]>
</Line>
<Line Number="60">
<![CDATA[		SEVERITY_Alarm_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] := Core_HMI.Interface.arrSEVERITYAlarmsInterface[iCounter];]]>
</Line>
<Line Number="61">
<![CDATA[(*		IF GMP_ALRM_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] THEN]]>
</Line>
<Line Number="62">
<![CDATA[			SEVERITY_Alarm_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] := 900;]]>
</Line>
<Line Number="63">
<![CDATA[		ELSE]]>
</Line>
<Line Number="64">
<![CDATA[			SEVERITY_Alarm_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] := 800;]]>
</Line>
<Line Number="65">
<![CDATA[		END_IF;*)]]>
</Line>
<Line Number="66">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="67">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="HMI_MachineStateVisualization" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//NOT READY]]>
</Line>
<Line Number="1">
<![CDATA[Core_HMI.Interface.St_iMachineStatus := 6;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// RESET STATE]]>
</Line>
<Line Number="4">
<![CDATA[If OM_Interface.xHmi_WrngRq_MachineResetAlarms then]]>
</Line>
<Line Number="5">
<![CDATA[	Core_HMI.Interface.St_iMachineStatus := 5;]]>
</Line>
<Line Number="6">
<![CDATA[end_if;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[// ALARM STATE]]>
</Line>
<Line Number="9">
<![CDATA[If OM_Interface.xHmi_WrngRq_MachineAlarms then]]>
</Line>
<Line Number="10">
<![CDATA[	Core_HMI.Interface.St_iMachineStatus := 0;]]>
</Line>
<Line Number="11">
<![CDATA[end_if;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[// READY STATE]]>
</Line>
<Line Number="14">
<![CDATA[If OM_Interface.xHmi_WrngRq_MachineReadyForAuto AND NOT OM_Interface.xHmi_WrngRq_MachineAutoCycle AND NOT BB.Manual_CmdEnable then]]>
</Line>
<Line Number="15">
<![CDATA[	Core_HMI.Interface.St_iMachineStatus := 1;]]>
</Line>
<Line Number="16">
<![CDATA[end_if;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[// AUTOMATIC STATE]]>
</Line>
<Line Number="19">
<![CDATA[If OM_Interface.xHmi_WrngRq_MachineReadyForAuto AND OM_Interface.xHmi_WrngRq_MachineAutoCycle AND OM_Interface.xHmi_WrngRq_MachineRunning AND NOT BB.Manual_CmdEnable then]]>
</Line>
<Line Number="20">
<![CDATA[	Core_HMI.Interface.St_iMachineStatus := 2;]]>
</Line>
<Line Number="21">
<![CDATA[end_if;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[// STANDBY - WAITING FOR PRODUCT STATE]]>
</Line>
<Line Number="24">
<![CDATA[If OM_Interface.xHmi_WrngRq_MachineReadyForAuto AND OM_Interface.xHmi_WrngRq_MachineAutoCycle AND NOT OM_Interface.xHmi_WrngRq_MachineRunning AND NOT BB.Manual_CmdEnable then]]>
</Line>
<Line Number="25">
<![CDATA[	Core_HMI.Interface.St_iMachineStatus := 3;]]>
</Line>
<Line Number="26">
<![CDATA[end_if;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[// MANUAL STATE]]>
</Line>
<Line Number="29">
<![CDATA[If BB.Manual_CmdEnable then]]>
</Line>
<Line Number="30">
<![CDATA[	Core_HMI.Interface.St_iMachineStatus := 4;]]>
</Line>
<Line Number="31">
<![CDATA[end_if;]]>
</Line>
</STContent>
</Routine>
<Routine Name="HMI_VitalityCheck" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[IF BB.FirstScan THEN]]>
</Line>
<Line Number="2">
<![CDATA[	Core_HMI.Interface.St_xHMI_Connected := FALSE;]]>
</Line>
<Line Number="3">
<![CDATA[	Core_HMI.Interface.St_iHMI_VitalityCheck := 0;]]>
</Line>
<Line Number="4">
<![CDATA[	//Core_HMI.Interface.sCurrentUserLogged := '';]]>
</Line>
<Line Number="5">
<![CDATA[	L_axPulse[1] := FALSE;]]>
</Line>
<Line Number="6">
<![CDATA[	Core_HMI.Interface.Rq_xHMI_RunInit := TRUE;]]>
</Line>
<Line Number="7">
<![CDATA[ELSE]]>
</Line>
<Line Number="8">
<![CDATA[	IF BB.Clock_1000ms AND NOT L_axPulse[1] THEN]]>
</Line>
<Line Number="9">
<![CDATA[		L_axPulse[1] := TRUE;]]>
</Line>
<Line Number="10">
<![CDATA[		Core_HMI.Interface.St_iHMI_VitalityCheck := Core_HMI.Interface.St_iHMI_VitalityCheck + 1;	]]>
</Line>
<Line Number="11">
<![CDATA[        // Disconnected logic]]>
</Line>
<Line Number="12">
<![CDATA[        IF (Core_HMI.Interface.St_iHMI_VitalityCheck > HMI_NoConnectionThreshold) THEN]]>
</Line>
<Line Number="13">
<![CDATA[			Core_HMI.Interface.St_xHMI_Connected := FALSE;]]>
</Line>
<Line Number="14">
<![CDATA[            //Core_HMI.Interface.sCurrentUserLogged := '';			]]>
</Line>
<Line Number="15">
<![CDATA[          //  Core_HMI.Interface.Rq_xHMI_RunInit := (Core_HMI.Interface.St_iHMI_VitalityCheck MOD 10) = 0;]]>
</Line>
<Line Number="16">
<![CDATA[		ELSE]]>
</Line>
<Line Number="17">
<![CDATA[			]]>
</Line>
<Line Number="18">
<![CDATA[        	Core_HMI.Interface.Rq_xHMI_RunInit := FALSE;]]>
</Line>
<Line Number="19">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[		]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[        // Overflow protection]]>
</Line>
<Line Number="23">
<![CDATA[        IF Core_HMI.Interface.St_iHMI_VitalityCheck > 32760 THEN]]>
</Line>
<Line Number="24">
<![CDATA[            Core_HMI.Interface.St_iHMI_VitalityCheck := HMI_NoConnectionThreshold + 1;]]>
</Line>
<Line Number="25">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="26">
<![CDATA[	ELSIF NOT BB.Clock_1000ms AND L_axPulse[1] THEN]]>
</Line>
<Line Number="27">
<![CDATA[		L_axPulse[1] := FALSE;]]>
</Line>
<Line Number="28">
<![CDATA[	END_IF;		]]>
</Line>
<Line Number="29">
<![CDATA[			]]>
</Line>
<Line Number="30">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Interface_HMI" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//CASEPACKER CONFIGURATION (Visibility)]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[//Infeed Configuration]]>
</Line>
<Line Number="3">
<![CDATA[   UM_HMI_Vis.xCp_InfeedFlatRotationZ_Presence              := UM_Config.CP.EnableBundleZRot;]]>
</Line>
<Line Number="4">
<![CDATA[   UM_HMI_Vis.xCp_InfeedBelt1_Presence    					:= UM_Config.CP.EnableInfeed_ControlledBelt1;]]>
</Line>
<Line Number="5">
<![CDATA[   UM_HMI_Vis.xCp_InfeedBelt2_Presence 						:= UM_Config.CP.EnableInfeed_ControlledBelt2;]]>
</Line>
<Line Number="6">
<![CDATA[   UM_HMI_Vis.xCp_InfeedBelt3_Presence 						:= UM_Config.CP.EnableInfeed_ControlledBelt3;]]>
</Line>
<Line Number="7">
<![CDATA[   ]]>
</Line>
<Line Number="8">
<![CDATA[   //Add side belt + rotation prod]]>
</Line>
<Line Number="9">
<![CDATA[   UM_HMI_Vis.xCp_DosingBelt_Presence               		:= UM_Config.CP.EnableInfeedDosingBelt;]]>
</Line>
<Line Number="10">
<![CDATA[   UM_HMI_Vis.xCp_ProductRotation_Presence          		:= UM_Config.CP.EnableInfeedYRot;]]>
</Line>
<Line Number="11">
<![CDATA[   ]]>
</Line>
<Line Number="12">
<![CDATA[   UM_HMI_Vis.xCp_ElectronicStacker_Presence        		:= UM_Config.CP.EnableElectronicStacker;]]>
</Line>
<Line Number="13">
<![CDATA[   UM_HMI_Vis.xCp_Stacker_VariableMiddlePosition 			:= UM_Config.CP.EnableStackerVariableMiddlePosition;]]>
</Line>
<Line Number="14">
<![CDATA[   ]]>
</Line>
<Line Number="15">
<![CDATA[    UM_HMI_Vis.xCp_LayerCheck_Presence                		:= UM_Config.CP.BarrierCheckLayer;]]>
</Line>
<Line Number="16">
<![CDATA[    UM_HMI_Vis.xCp_BundleTransfer_Presence            		:= UM_Config.CP.EnableBundleTransfer;]]>
</Line>
<Line Number="17">
<![CDATA[    UM_HMI_Vis.xCp_BundleRotation_Presence            		:= UM_Config.CP.BundleTransfer_EnableBundleRot ;]]>
</Line>
<Line Number="18">
<![CDATA[    UM_HMI_Vis.xCp_EnableFifthFlap 							:= UM_Config.CP.EnableFifthFlap;]]>
</Line>
<Line Number="19">
<![CDATA[    ]]>
</Line>
<Line Number="20">
<![CDATA[    UM_HMI_Vis.xCp_AdditionalInfeedBelt1_Presence:=  UM_Config.CP.EnableInfeed_ControlledAdditionalBelt1;]]>
</Line>
<Line Number="21">
<![CDATA[    UM_HMI_Vis.xCp_AdditionalInfeedBelt2_Presence := UM_Config.CP.EnableInfeed_ControlledAdditionalBelt2;]]>
</Line>
<Line Number="22">
<![CDATA[    UM_HMI_Vis.xCp_AdditionalInfeedBelt3_Presence := UM_Config.CP.EnableInfeed_ControlledAdditionalBelt3;]]>
</Line>
<Line Number="23">
<![CDATA[    ]]>
</Line>
<Line Number="24">
<![CDATA[//Case Filling Configuration    ]]>
</Line>
<Line Number="25">
<![CDATA[    UM_HMI_Vis.xCp_Lifter_Presence                    := UM_Config.CP.EnablePusherDriveLifting ;]]>
</Line>
<Line Number="26">
<![CDATA[ ]]>
</Line>
<Line Number="27">
<![CDATA[    ]]>
</Line>
<Line Number="28">
<![CDATA[    UM_HMI_Vis.xCp_ElectronicHopper_Presence          := UM_Config.CP.Hopper_Motor;]]>
</Line>
<Line Number="29">
<![CDATA[    UM_HMI_Vis.xCp_ExtraStrokeHopper_Presence         := UM_Config.CP.HopperExtraStroke;]]>
</Line>
<Line Number="30">
<![CDATA[    UM_HMI_Vis.xCp_Counterstacker_Presence            := UM_Config.CP.EnablePneumCounterStacker;]]>
</Line>
<Line Number="31">
<![CDATA[    UM_HMI_Vis.xCp_PresenceSideWall                  := UM_Config.CP.PresenceSideWall;]]>
</Line>
<Line Number="32">
<![CDATA[    ]]>
</Line>
<Line Number="33">
<![CDATA[//Case Transfer Configuration]]>
</Line>
<Line Number="34">
<![CDATA[    UM_HMI_Vis.xCp_CaseTransferInverter_Presence      := UM_Config.CP.EnableTransferCaseWithInverter;]]>
</Line>
<Line Number="35">
<![CDATA[   ]]>
</Line>
<Line Number="36">
<![CDATA[//Glue Enabling    ]]>
</Line>
<Line Number="37">
<![CDATA[    UM_HMI_Vis.xCp_GlueGroup_Presence                 := UM_Config.CP.EnableGlue;]]>
</Line>
<Line Number="38">
<![CDATA[    UM_HMI_Vis.xCp_GluePurge_Presence                 := UM_Config.CP.EnableGluePurge;]]>
</Line>
<Line Number="39">
<![CDATA[    ]]>
</Line>
<Line Number="40">
<![CDATA[    UM_HMI_Vis.xCp_GlueGun1_Presence                   := UM_Config.CP.EnableGlue;]]>
</Line>
<Line Number="41">
<![CDATA[    UM_HMI_Vis.xCp_GlueGun2_Presence                   := UM_Config.CP.EnableGlue;]]>
</Line>
<Line Number="42">
<![CDATA[    UM_HMI_Vis.xCp_GlueGun3_Presence                   := FALSE;]]>
</Line>
<Line Number="43">
<![CDATA[    UM_HMI_Vis.xCp_GlueGun4_Presence                   := FALSE;]]>
</Line>
<Line Number="44">
<![CDATA[    ]]>
</Line>
<Line Number="45">
<![CDATA[//Outfeed Configuration]]>
</Line>
<Line Number="46">
<![CDATA[    UM_HMI_Vis.xCp_OpenFlapsCheck_Presence            := UM_Config.CP.OpenFlapsCheck;]]>
</Line>
<Line Number="47">
<![CDATA[    ]]>
</Line>
<Line Number="48">
<![CDATA[    UM_HMI_Vis.xCp_OptGr_Labeller1_Presence           := UM_Config.CP.EnableLabeller AND]]>
</Line>
<Line Number="49">
<![CDATA[                                                         (OM_TeT_HMI_PB.iSelSerializationMode = 0);]]>
</Line>
<Line Number="50">
<![CDATA[    UM_HMI_Vis.xCp_OptGr_LabelCheck1_Presence         := UM_Config.CP.ZoneCheckLabel AND]]>
</Line>
<Line Number="51">
<![CDATA[                                                         (OM_TeT_HMI_PB.iSelSerializationMode = 0);]]>
</Line>
<Line Number="52">
<![CDATA[    ]]>
</Line>
<Line Number="53">
<![CDATA[    UM_HMI_Vis.xCp_Labeller1_Presence                 := UM_Config.CP.EnableLabeller;]]>
</Line>
<Line Number="54">
<![CDATA[    UM_HMI_Vis.xCp_LabelCheck1_Presence               := UM_Config.CP.ZoneCheckLabel;]]>
</Line>
<Line Number="55">
