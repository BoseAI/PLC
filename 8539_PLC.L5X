<Rung Number="36" Type="N">
<Text>
<![CDATA[XIO(ALRM[750])XIC(IN.T0130_02_24V)XIC(sDCS.DelayedCircuit_ACTIVATION.FP)[OTE(ALRM[777]) ,OTL(xRq_AlrmDCS) ];]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIO(ALRM[750])XIC(IN.T0130_02_24V)XIC(sDCS.K6340_04.DCS.FP)[OTE(ALRM[778]) ,OTL(xRq_AlrmDCS) ];]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIO(ALRM[750])XIC(IN.T0130_02_24V)XIC(sDCS.BRAKE_ACTIVATION_STACKER.FP)[OTE(ALRM[779]) ,OTL(xRq_AlrmDCS) ];]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[XIO(ALRM[750])XIC(IN.T0130_02_24V)XIC(sDCS.BRAKE_ACTIVATION_LIFTER.FP)[OTE(ALRM[780]) ,OTL(xRq_AlrmDCS) ];]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIO(ALRM[750])XIC(IN.T0130_02_24V)[XIO(K5605_01:7:I.Pt06Status) XIO(K5605_01:7:I.Pt07Status) ,[XIO(SafetyOUT.K7050_01) XIO(SafetyIN.B7050_01_CH0) ,XIO(SafetyOUT.K7050_02) XIO(SafetyIN.B7050_02_CH1) ] [,TON(xAlarm781_TON,?,?) ] XIC(xAlarm781_TON.DN) ][OTE(ALRM[781]) ,OTL(xRq_AlrmDCS) ];]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[XIO(ALRM[750])XIC(IN.T0130_02_24V)[XIO(K0605_01:8:I.Pt05Status) ,[XIO(SafetyOUT.K1440_01) XIO(SafetyOUT.K1440_02) XIO(SafetyIN.K1440_01_FBK) ,XIC(SafetyOUT.K1440_01) XIC(SafetyOUT.K1440_02) XIC(SafetyIN.K1440_01_FBK) ] [,TON(xAlarm782_TON,?,?) ] XIC(xAlarm782_TON.DN) ][OTE(ALRM[782]) ,OTL(xRq_AlrmDCS) ];]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[XIO(ALRM[750])XIC(IN.T0130_02_24V)[XIO(K5605_01:8:I.Pt04Status) ,[XIO(SafetyOUT.K6440_01) XIO(SafetyOUT.K6440_02) XIO(SafetyIN.K6440_01_FBK) ,XIC(SafetyOUT.K6440_01) XIC(SafetyOUT.K6440_02) XIC(SafetyIN.K6440_01_FBK) ] [,TON(xAlarm783_TON,?,?) ] XIC(xAlarm783_TON.DN) ][OTE(ALRM[783]) ,OTL(xRq_AlrmDCS) ];]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[XIO(ALRM[750])XIC(IN.T0130_02_24V)[XIO(K5605_01:8:I.Pt05Status) ,[XIO(SafetyOUT.K6440_03) XIO(SafetyOUT.K6440_04) XIO(SafetyIN.K6440_03_FBK) ,XIC(SafetyOUT.K6440_03) XIC(SafetyOUT.K6440_04) XIC(SafetyIN.K6440_03_FBK) ] [,TON(xAlarm784_TON,?,?) ] XIC(xAlarm784_TON.DN) ][OTE(ALRM[784]) ,OTL(xRq_AlrmDCS) ];]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Text>
<![CDATA[XIO(ALRM[750])XIC(IN.T0130_02_24V)[XIO(K5605_01:8:I.Pt06Status) ,[XIO(SafetyOUT.K7802_01) XIO(SafetyOUT.K7802_02) XIO(SafetyIN.K7802_01_FBK) ,XIC(SafetyOUT.K7802_01) XIC(SafetyOUT.K7802_02) XIC(SafetyIN.K7802_01_FBK) ] [,TON(xAlarm785_TON,?,?) ] XIC(xAlarm785_TON.DN) ][OTE(ALRM[785]) ,OTL(xRq_AlrmDCS) ];]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Text>
<![CDATA[XIC(xRq_AlrmDCS)OTL(BB.Rq_EmergencyImmediateStop);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="FaultManagement_SE" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[SIZE(Core_HMI.Interface.iFaultDisplayed[0], 0, L_St_iArraySize);]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[#REGION First scan clear]]>
</Line>
<Line Number="3">
<![CDATA[IF BB.FirstScan THEN]]>
</Line>
<Line Number="4">
<![CDATA[	FOR k:=0 TO L_St_iArraySize-1 BY 1 DO]]>
</Line>
<Line Number="5">
<![CDATA[		Core_HMI.Interface.iFaultDisplayed[k] := 0;]]>
</Line>
<Line Number="6">
<![CDATA[		Core_HMI.Interface.Rq_arrAckFromPLC[k] := 0;]]>
</Line>
<Line Number="7">
<![CDATA[		Core_HMI.Interface.Rq_arrAckFromPLC[k] := 0;]]>
</Line>
<Line Number="8">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="9">
<![CDATA[END_IF;]]>
</Line>
<Line Number="10">
<![CDATA[#ENDREGION]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[j := 0;]]>
</Line>
<Line Number="13">
<![CDATA[L_iCounter := 0;]]>
</Line>
<Line Number="14">
<![CDATA[L_St_diCountAlarmGMPGroups := 0;]]>
</Line>
<Line Number="15">
<![CDATA[L_St_diCountAlarmGMP_NotAcknowledged := 0;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[FOR k := 0 TO ((L_St_iArraySize-1)*2) BY 2 DO]]>
</Line>
<Line Number="18">
<![CDATA[	//j := j + 1;]]>
</Line>
<Line Number="19">
<![CDATA[	//L_iCounter := (j - 1) * 16;]]>
</Line>
<Line Number="20">
<![CDATA[	L_iCounter := j * 16;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[    //Get current alarms status from the ALRM array, 16 by 16.]]>
</Line>
<Line Number="23">
<![CDATA[    //Byte are splitted in order to mantain the older config at the HMI side]]>
</Line>
<Line Number="24">
<![CDATA[	L_St_iAlarmDataTemp.0	:= 	ALRM[L_iCounter + 0];]]>
</Line>
<Line Number="25">
<![CDATA[	L_St_iAlarmDataTemp.1  	:= 	ALRM[L_iCounter + 1];]]>
</Line>
<Line Number="26">
<![CDATA[	L_St_iAlarmDataTemp.2  	:= 	ALRM[L_iCounter + 2];]]>
</Line>
<Line Number="27">
<![CDATA[	L_St_iAlarmDataTemp.3  	:= 	ALRM[L_iCounter + 3];]]>
</Line>
<Line Number="28">
<![CDATA[	L_St_iAlarmDataTemp.4  	:= 	ALRM[L_iCounter + 4];]]>
</Line>
<Line Number="29">
<![CDATA[	L_St_iAlarmDataTemp.5  	:= 	ALRM[L_iCounter + 5];]]>
</Line>
<Line Number="30">
<![CDATA[	L_St_iAlarmDataTemp.6  	:= 	ALRM[L_iCounter + 6];]]>
</Line>
<Line Number="31">
<![CDATA[	L_St_iAlarmDataTemp.7  	:= 	ALRM[L_iCounter + 7];]]>
</Line>
<Line Number="32">
<![CDATA[	L_St_iAlarmDataTemp.8  	:= 	ALRM[L_iCounter + 8];]]>
</Line>
<Line Number="33">
<![CDATA[	L_St_iAlarmDataTemp.9  	:= 	ALRM[L_iCounter + 9];]]>
</Line>
<Line Number="34">
<![CDATA[	L_St_iAlarmDataTemp.10 	:= 	ALRM[L_iCounter + 10];]]>
</Line>
<Line Number="35">
<![CDATA[	L_St_iAlarmDataTemp.11 	:= 	ALRM[L_iCounter + 11];]]>
</Line>
<Line Number="36">
<![CDATA[	L_St_iAlarmDataTemp.12 	:=	ALRM[L_iCounter + 12];]]>
</Line>
<Line Number="37">
<![CDATA[	L_St_iAlarmDataTemp.13 	:=	ALRM[L_iCounter + 13];]]>
</Line>
<Line Number="38">
<![CDATA[	L_St_iAlarmDataTemp.14 	:=	ALRM[L_iCounter + 14];]]>
</Line>
<Line Number="39">
<![CDATA[	L_St_iAlarmDataTemp.15 	:=	ALRM[L_iCounter + 15];]]>
</Line>
<Line Number="40">
<![CDATA[	]]>
</Line>
<Line Number="41">
<![CDATA[	]]>
</Line>
<Line Number="42">
<![CDATA[	//Check the machine configuration: the Alarm Acknowledge is an option to be enabled in OB1]]>
</Line>
<Line Number="43">
<![CDATA[#REGION No ACK]]>
</Line>
<Line Number="44">
<![CDATA[	IF NOT UM_Config.Core.Enable_AlarmACK THEN]]>
</Line>
<Line Number="45">
<![CDATA[		]]>
</Line>
<Line Number="46">
<![CDATA[		//To introduce the Alarms Ack, we need to change the Alarm Class on the HMI and define a newer one that]]>
</Line>
<Line Number="47">
<![CDATA[        //supports the Ack. If the ""UM_Config".CORE.Enable_AlarmACK_FromHMI" is not enabled, once an alarm is recorded,]]>
</Line>
<Line Number="48">
<![CDATA[        //it will be immediately acknowledged by the PLC]]>
</Line>
<Line Number="49">
<![CDATA[		]]>
</Line>
<Line Number="50">
<![CDATA[		//Configuration necessary to determine if the operator needs to be logged to reset the machine]]>
</Line>
<Line Number="51">
<![CDATA[		IF (Core_HMI.Interface.iPasswordState > 0 OR NOT UM_Config.Core.Enable_PasswordState_FromHMI) THEN]]>
</Line>
<Line Number="52">
<![CDATA[            Core_HMI.Interface.Rq_arrAckFromPLC[j] := Core_HMI.Interface.iFaultDisplayed[j];]]>
</Line>
<Line Number="53">
<![CDATA[        ELSE]]>
</Line>
<Line Number="54">
<![CDATA[            Core_HMI.Interface.Rq_arrAckFromPLC[j] := 0;]]>
</Line>
<Line Number="55">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="56">
<![CDATA[		]]>
</Line>
<Line Number="57">
<![CDATA[		//**********************	DA VERIFICARE BB.Alarm_ResetRqPulse (potrebbe essere bb.Alarm_ResetDelayed_pulse)	**********************//]]>
</Line>
<Line Number="58">
<![CDATA[		IF ((BB.Alarm_ResetRqPulse AND (Core_HMI.Interface.Rq_arrAckFromPLC[j] = Core_HMI.Interface.iFaultDisplayed[j])) OR]]>
</Line>
<Line Number="59">
<![CDATA[			BB.FirstScan) THEN]]>
</Line>
<Line Number="60">
<![CDATA[			Core_HMI.Interface.iFaultDisplayed[j] := L_St_iAlarmDataTemp;]]>
</Line>
<Line Number="61">
<![CDATA[			Core_HMI.Interface.Rq_arrAckFromPLC[j] := 0;]]>
</Line>
<Line Number="62">
<![CDATA[		ELSE]]>
</Line>
<Line Number="63">
<![CDATA[			Core_HMI.Interface.iFaultDisplayed[j] := Core_HMI.Interface.iFaultDisplayed[j] OR L_St_iAlarmDataTemp;]]>
</Line>
<Line Number="64">
<![CDATA[            //IF L_St_iAlarmDataTemp <> 0 THEN]]>
</Line>
<Line Number="65">
<![CDATA[            //    BB.Rq_EmergencyPhaseStop := TRUE;]]>
</Line>
<Line Number="66">
<![CDATA[            //END_IF;]]>
</Line>
<Line Number="67">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="68">
<![CDATA[		]]>
</Line>
<Line Number="69">
<![CDATA[		L_St_iAlarmACK_Result := Core_HMI.Interface.Rq_arrAckFromPLC[j];]]>
</Line>
<Line Number="70">
<![CDATA[		]]>
</Line>
<Line Number="71">
<![CDATA[		IF Core_HMI.Interface.iFaultDisplayed[j] <> L_St_iAlarmACK_Result OR]]>
</Line>
<Line Number="72">
<![CDATA[			(Core_HMI.Interface.iFaultDisplayed[j] <> 0 AND (Core_HMI.Interface.iPasswordState <= 0) AND UM_Config.Core.Enable_PasswordState_FromHMI) OR]]>
</Line>
<Line Number="73">
<![CDATA[			(L_St_iAlarmDataTemp <> 0) THEN]]>
</Line>
<Line Number="74">
<![CDATA[			L_St_diCountAlarmGMPGroups := L_St_diCountAlarmGMPGroups + 1;]]>
</Line>
<Line Number="75">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="76">
<![CDATA[#ENDREGION]]>
</Line>
<Line Number="77">
<![CDATA[]]>
</Line>
<Line Number="78">
<![CDATA[#REGION ACK]]>
</Line>
<Line Number="79">
<![CDATA[	ELSE]]>
</Line>
<Line Number="80">
<![CDATA[		//Alarms ACK from HMI enabled]]>
</Line>
<Line Number="81">
<![CDATA[        //Get the 16 GMP relevant alarms from the configuration array]]>
</Line>
<Line Number="82">
<![CDATA[        L_St_iGMPAlarmDataTemp.0 	:= GMP_ALRM_Configuration[L_iCounter +0];]]>
</Line>
<Line Number="83">
<![CDATA[		L_St_iGMPAlarmDataTemp.1	:= GMP_ALRM_Configuration[L_iCounter + 1];]]>
</Line>
<Line Number="84">
<![CDATA[		L_St_iGMPAlarmDataTemp.2 	:= GMP_ALRM_Configuration[L_iCounter + 2];]]>
</Line>
<Line Number="85">
<![CDATA[		L_St_iGMPAlarmDataTemp.3 	:= GMP_ALRM_Configuration[L_iCounter + 3];]]>
</Line>
<Line Number="86">
<![CDATA[		L_St_iGMPAlarmDataTemp.4 	:= GMP_ALRM_Configuration[L_iCounter + 4];]]>
</Line>
<Line Number="87">
<![CDATA[		L_St_iGMPAlarmDataTemp.5 	:= GMP_ALRM_Configuration[L_iCounter + 5];]]>
</Line>
<Line Number="88">
<![CDATA[		L_St_iGMPAlarmDataTemp.6 	:= GMP_ALRM_Configuration[L_iCounter + 6];]]>
</Line>
<Line Number="89">
<![CDATA[		L_St_iGMPAlarmDataTemp.7 	:= GMP_ALRM_Configuration[L_iCounter + 7];]]>
</Line>
<Line Number="90">
<![CDATA[		L_St_iGMPAlarmDataTemp.8 	:= GMP_ALRM_Configuration[L_iCounter + 8];]]>
</Line>
<Line Number="91">
<![CDATA[		L_St_iGMPAlarmDataTemp.9	:= GMP_ALRM_Configuration[L_iCounter + 9];]]>
</Line>
<Line Number="92">
<![CDATA[		L_St_iGMPAlarmDataTemp.10 	:= GMP_ALRM_Configuration[L_iCounter + 10];]]>
</Line>
<Line Number="93">
<![CDATA[		L_St_iGMPAlarmDataTemp.11 	:= GMP_ALRM_Configuration[L_iCounter + 11];]]>
</Line>
<Line Number="94">
<![CDATA[		L_St_iGMPAlarmDataTemp.12 	:= GMP_ALRM_Configuration[L_iCounter + 12];]]>
</Line>
<Line Number="95">
<![CDATA[		L_St_iGMPAlarmDataTemp.13	:= GMP_ALRM_Configuration[L_iCounter + 13];]]>
</Line>
<Line Number="96">
<![CDATA[		L_St_iGMPAlarmDataTemp.14 	:= GMP_ALRM_Configuration[L_iCounter + 14];]]>
</Line>
<Line Number="97">
<![CDATA[		L_St_iGMPAlarmDataTemp.15 	:= GMP_ALRM_Configuration[L_iCounter + 15];]]>
</Line>
<Line Number="98">
<![CDATA[		]]>
</Line>
<Line Number="99">
<![CDATA[		//Once a not GMP critical alarm is triggered, we need to immediately ACK it by means of the PLC.]]>
</Line>
<Line Number="100">
<![CDATA[        //In order to get NOT crtical alarms we perform the word AND operation between currently visualized alarms and the NOT GMPs.]]>
</Line>
<Line Number="101">
<![CDATA[        //At this point we are able to acknowledge the necessary visualized alarms]]>
</Line>
<Line Number="102">
<![CDATA[		]]>
</Line>
<Line Number="103">
<![CDATA[		L_St_iGMP_Relevant_Alarms := Core_HMI.Interface.iFaultDisplayed[j] AND L_St_iGMPAlarmDataTemp;			//Present alarm and GMP relevant]]>
</Line>
<Line Number="104">
<![CDATA[		L_St_iNOT_GMP_Relevant_Alarms := Core_HMI.Interface.iFaultDisplayed[j] AND NOT L_St_iGMPAlarmDataTemp;	//Present alarm and NOT GMP relevant]]>
</Line>
<Line Number="105">
<![CDATA[		]]>
</Line>
<Line Number="106">
<![CDATA[        //Perform immediately the ACK from PLC of the NOT GMP alarms]]>
</Line>
<Line Number="107">
<![CDATA[        Core_HMI.Interface.Rq_arrAckFromPLC[j] := L_St_iNOT_GMP_Relevant_Alarms;]]>
</Line>
<Line Number="108">
<![CDATA[		]]>
</Line>
<Line Number="109">
<![CDATA[		//Record of the alarms acknowledged by the terminal operator on the HMI]]>
</Line>
<Line Number="110">
<![CDATA[		//The masking opertion is needed, on Siemens HMI, because also the loop in alarm event generates the ACK -> To be checked on Rockwell system]]>
</Line>
<Line Number="111">
<![CDATA[		Core_HMI.Interface.Rq_arrAckFromHMI[j] := Core_HMI.Interface.Rq_arrAckFromHMI[j] AND L_St_iGMP_Relevant_Alarms;		]]>
</Line>
<Line Number="112">
<![CDATA[		]]>
</Line>
<Line Number="113">
<![CDATA[		IF (L_St_iGMP_Relevant_Alarms <> 0) AND (Core_HMI.Interface.Rq_arrAckFromHMI[j] <> L_St_iGMP_Relevant_Alarms) THEN]]>
</Line>
<Line Number="114">
<![CDATA[			L_St_diCountAlarmGMP_NotAcknowledged := L_St_diCountAlarmGMP_NotAcknowledged + 1;]]>
</Line>
<Line Number="115">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="116">
<![CDATA[		]]>
</Line>
<Line Number="117">
<![CDATA[		//**********************	DA VERIFICARE BB.Alarm_ResetRqPulse (potrebbe essere bb.Alarm_ResetDelayed_pulse)	**********************//]]>
</Line>
<Line Number="118">
<![CDATA[		IF ((BB.Alarm_ResetRqPulse OR BB.FirstScan) AND]]>
</Line>
<Line Number="119">
<![CDATA[			(Core_HMI.Interface.iPasswordState > 0 OR NOT UM_Config.Core.Enable_PasswordState_FromHMI)) THEN		]]>
</Line>
<Line Number="120">
<![CDATA[            //Once the operator has pressed the "RESET" push buton, we need to check if we have GMP relevant alarms among the visualized.]]>
</Line>
<Line Number="121">
<![CDATA[            //If NO, then we can proceed with the "cleaning" procedure by assingning to the visualized alarms array,]]>
</Line>
<Line Number="122">
<![CDATA[            //only the ones that are really present at this PLC cyle]]>
</Line>
<Line Number="123">
<![CDATA[            //If YES, then we need to verify that all the needed ACK has been performed]]>
</Line>
<Line Number="124">
<![CDATA[			]]>
</Line>
<Line Number="125">
<![CDATA[			IF L_St_iGMP_Relevant_Alarms <> 0 THEN]]>
</Line>
<Line Number="126">
<![CDATA[				IF L_St_iGMP_Relevant_Alarms = Core_HMI.Interface.Rq_arrAckFromHMI[j] THEN]]>
</Line>
<Line Number="127">
<![CDATA[					//The Operator has done the necessary ACK on the HMI, we can reset the HMI Alarm Point]]>
</Line>
<Line Number="128">
<![CDATA[					Core_HMI.Interface.iFaultDisplayed[j] := L_St_iAlarmDataTemp;]]>
</Line>
<Line Number="129">
<![CDATA[					IF L_St_iAlarmDataTemp = 0 THEN]]>
</Line>
<Line Number="130">
<![CDATA[						Core_HMI.Interface.Rq_arrAckFromHMI[j] := 0;]]>
</Line>
<Line Number="131">
<![CDATA[						Core_HMI.Interface.Rq_arrAckFromPLC[j] := 0;]]>
</Line>
<Line Number="132">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="133">
<![CDATA[				ELSE]]>
</Line>
<Line Number="134">
<![CDATA[					Core_HMI.Interface.iFaultDisplayed[j] := ((Core_HMI.Interface.iFaultDisplayed[j] AND L_St_iGMP_Relevant_Alarms)]]>
</Line>
<Line Number="135">
<![CDATA[																	XOR Core_HMI.Interface.Rq_arrAckFromHMI[j]) OR]]>
</Line>
<Line Number="136">
<![CDATA[																	L_St_iAlarmDataTemp;]]>
</Line>
<Line Number="137">
<![CDATA[					Core_HMI.Interface.Rq_arrAckFromPLC[j] := 0;]]>
</Line>
<Line Number="138">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="139">
<![CDATA[			ELSE]]>
</Line>
<Line Number="140">
<![CDATA[				//NO GMP relevant alarms in this word]]>
</Line>
<Line Number="141">
<![CDATA[                Core_HMI.Interface.iFaultDisplayed[j] := L_St_iAlarmDataTemp;]]>
</Line>
<Line Number="142">
<![CDATA[				Core_HMI.Interface.Rq_arrAckFromHMI[j] := 0;]]>
</Line>
<Line Number="143">
<![CDATA[				Core_HMI.Interface.Rq_arrAckFromPLC[j] := 0;]]>
</Line>
<Line Number="144">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="145">
<![CDATA[		ELSE]]>
</Line>
<Line Number="146">
<![CDATA[			Core_HMI.Interface.iFaultDisplayed[j] := Core_HMI.Interface.iFaultDisplayed[j] OR L_St_iAlarmDataTemp;]]>
</Line>
<Line Number="147">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="148">
<![CDATA[		L_St_iAlarmACK_Result := Core_HMI.Interface.Rq_arrAckFromHMI[j] OR Core_HMI.Interface.Rq_arrAckFromPLC[j];]]>
</Line>
<Line Number="149">
<![CDATA[		]]>
</Line>
<Line Number="150">
<![CDATA[		IF (Core_HMI.Interface.iFaultDisplayed[j] <> L_St_iAlarmACK_Result) OR]]>
</Line>
<Line Number="151">
<![CDATA[			(Core_HMI.Interface.iFaultDisplayed[j] <> 0 AND (Core_HMI.Interface.iPasswordState <= 0 AND UM_Config.Core.Enable_PasswordState_FromHMI)) OR]]>
</Line>
<Line Number="152">
<![CDATA[			(L_St_iAlarmDataTemp <> 0) THEN]]>
</Line>
<Line Number="153">
<![CDATA[			L_St_diCountAlarmGMPGroups := L_St_diCountAlarmGMPGroups + 1;]]>
</Line>
<Line Number="154">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="155">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="156">
<![CDATA[#ENDREGION	]]>
</Line>
<Line Number="157">
<![CDATA[	 //"DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms := "DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms + CORE_HMI.Interface.St_arrFaultDisplayed[j];]]>
</Line>
<Line Number="158">
<![CDATA[	j := j + 1;]]>
</Line>
<Line Number="159">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="160">
<![CDATA[]]>
</Line>
<Line Number="161">
<![CDATA[]]>
</Line>
<Line Number="162">
<![CDATA[]]>
</Line>
<Line Number="163">
<![CDATA[]]>
</Line>
<Line Number="164">
<![CDATA[/*]]>
</Line>
<Line Number="165">
<![CDATA[// HMI Banner Visualization]]>
</Line>
<Line Number="166">
<![CDATA[IF ("DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms <> "DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms_Old)]]>
</Line>
<Line Number="167">
<![CDATA[    AND ("DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms <> 0)]]>
</Line>
<Line Number="168">
<![CDATA[    //AND NOT ("CORE_HMI_SystemForcing".St_xEnableForcing)]]>
</Line>
<Line Number="169">
<![CDATA[    //AND NOT ("DB_AreaHmiData".Rq_xInhibition_AlarmsPopUp_Visualization)]]>
</Line>
<Line Number="170">
<![CDATA[THEN]]>
</Line>
<Line Number="171">
<![CDATA[    "DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms_Old := "DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms;]]>
</Line>
<Line Number="172">
<![CDATA[    "DB_AreaHmiData".Varie_HMI.St_iAlarmsBanner_Open := 1;]]>
</Line>
<Line Number="173">
<![CDATA[ELSIF "DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms = 0]]>
</Line>
<Line Number="174">
<![CDATA[THEN]]>
</Line>
<Line Number="175">
<![CDATA[    "DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms_Old := 0;]]>
</Line>
<Line Number="176">
<![CDATA[    "DB_AreaHmiData".Varie_HMI.St_iAlarmsBanner_Open := -1;]]>
</Line>
<Line Number="177">
<![CDATA[END_IF;]]>
</Line>
<Line Number="178">
<![CDATA[]]>
</Line>
<Line Number="179">
<![CDATA["DB_AreaHmiData".Varie_HMI.St_diMachine_ActiveAlarms := 0;]]>
</Line>
<Line Number="180">
<![CDATA[]]>
</Line>
<Line Number="181">
<![CDATA[]]>
</Line>
<Line Number="182">
<![CDATA[IF L_St_diCountAlarmGMP_NotAcknowledged <> 0 THEN]]>
</Line>
<Line Number="183">
<![CDATA[    "DB_AreaHmiData".VisuHMI.xMachine_AlarmBanner_ACKButton_Presence := TRUE;]]>
</Line>
<Line Number="184">
<![CDATA[ELSE]]>
</Line>
<Line Number="185">
<![CDATA[    "DB_AreaHmiData".VisuHMI.xMachine_AlarmBanner_ACKButton_Presence := FALSE;]]>
</Line>
<Line Number="186">
<![CDATA[END_IF;]]>
</Line>
<Line Number="187">
<![CDATA[]]>
</Line>
<Line Number="188">
<![CDATA[*/]]>
</Line>
<Line Number="189">
<![CDATA[IF L_St_diCountAlarmGMPGroups <> 0 THEN]]>
</Line>
<Line Number="190">
<![CDATA[    BB.Rq_EmergencyPhaseStop := TRUE;]]>
</Line>
<Line Number="191">
<![CDATA[END_IF;]]>
</Line>
<Line Number="192">
<![CDATA[]]>
</Line>
<Line Number="193">
<![CDATA[TonrReset.Reset := NOT BB.Alarm_ResetRqPulse; TONR(TonrReset);]]>
</Line>
<Line Number="194">
<![CDATA[TonrReset.TimerEnable := BB.Alarm_ResetRqPulse;]]>
</Line>
<Line Number="195">
<![CDATA[TonrReset.PRE := 500;]]>
</Line>
<Line Number="196">
<![CDATA[IF TonrReset.DN then]]>
</Line>
<Line Number="197">
<![CDATA[	BB.Alarm_ResetRqPulse :=FALSE;]]>
</Line>
<Line Number="198">
<![CDATA[END_IF;]]>
</Line>
<Line Number="199">
<![CDATA[BB.Alarm_ResetRisingEdge := FALSE;]]>
</Line>
<Line Number="200">
<![CDATA[BB.Alarm_ResetDelayed_pulse := FALSE;]]>
</Line>
<Line Number="201">
<![CDATA[]]>
</Line>
<Line Number="202">
<![CDATA[#REGION Reset pulse management]]>
</Line>
<Line Number="203">
<![CDATA[IF NOT IN.S1100_04 AND NOT UM_Machine.axPTrig[37] THEN]]>
</Line>
<Line Number="204">
<![CDATA[//	UM_Machine.axPTrig[37] := IN.S6100_03;]]>
</Line>
<Line Number="205">
<![CDATA[	UM_Machine.axPTrig[37] := TRUE;]]>
</Line>
<Line Number="206">
<![CDATA[	BB.Alarm_ResetRqPulse :=TRUE;]]>
</Line>
<Line Number="207">
<![CDATA[	IF UM_Config.Core.Enable_PasswordState_FromHMI AND Core_HMI.Interface.iPasswordState <= 0 THEN ]]>
</Line>
<Line Number="208">
<![CDATA[		MSG[24] := TRUE;]]>
</Line>
<Line Number="209">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="210">
<![CDATA[ELSIF IN.S1100_04 AND UM_Machine.axPTrig[37] THEN]]>
</Line>
<Line Number="211">
<![CDATA[	UM_Machine.axPTrig[37] := FALSE;]]>
</Line>
<Line Number="212">
<![CDATA[END_IF;]]>
</Line>
<Line Number="213">
<![CDATA[]]>
</Line>
<Line Number="214">
<![CDATA[IF BB.Alarm_ResetRqPulse AND NOT BB.Alarm_ResetInhibition THEN]]>
</Line>
<Line Number="215">
<![CDATA[	BB.Alarm_ResetRisingEdge := TRUE;]]>
</Line>
<Line Number="216">
<![CDATA[	BB.Alarm_ResetDelayed_pulse := TRUE;]]>
</Line>
<Line Number="217">
<![CDATA[END_IF;]]>
</Line>
<Line Number="218">
<![CDATA[]]>
</Line>
<Line Number="219">
<![CDATA[IF BB.Alarm_ResetInhibition THEN]]>
</Line>
<Line Number="220">
<![CDATA[	BB.Alarm_ResetInhibition := FALSE;]]>
</Line>
<Line Number="221">
<![CDATA[END_IF;]]>
</Line>
<Line Number="222">
<![CDATA[#ENDREGION]]>
</Line>
</STContent>
</Routine>
