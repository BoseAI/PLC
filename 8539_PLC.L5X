<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[v0.13- 18/12/2019
autore- Utili
      Nuova FB per TAI15.1]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(0,wFill_value);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(i_xWorkSizePresent)[XIO(iq_Robot_DO.x08) ,XIC(xCF_InProg) ]ADD(iq_iCountDevTot,1,iq_iCountDevTot);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[ritardo ripartenza cambio formato Fanuc]]>
</Comment>
<Text>
<![CDATA[[XIO(xRqCF) OTE(Ifb_RitRestartCF.I_xSensor) ,InputFilter(Ifb_RitRestartCF,i_tTRestartCF,0) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Ifb_RitRestartCF.Q_xSensor)OTE(xRitRestartCF);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Fanuc Robot size change sequence in progress]]>
</Comment>
<Text>
<![CDATA[XIC(i_xDeviceSizeChangeRq)XIO(iq_Robot_DO.x08)XIO(xCF_InProg)[OTL(xCF_InProg) ,OTU(xCF_Done) ,MOVE(wFill_value,iCF_Error) ,MOVE(wFill_value,iCF_Step) ,MOVE(wFill_value,iCF_StepNext) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(xCF_InProg)MOVE(wFill_value,iCF_Step);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Rq abort program Fanuc]]>
</Comment>
<Text>
<![CDATA[CFormFanuc_Aux(F_Act_CFormFanuc_Aux,i_xPrgAbort,xRitRestartCF,i_xWorkSizePresent,iq_PAL_Size_Robot,iq_PeP_Size_Robot,iq_Sys_Robot,iq_xRqAbort,xCF_InProg,xRqCF,xCF_Done,iCF_Step,iq_iCountDevOk,iq_Robot_DI,iq_Robot_DO,iq_Robot_GI,iq_Robot_GO);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[ACK main programme selected robot RSR007]]>
</Comment>
<Text>
<![CDATA[XIC(xRqCF)OTE(iq_Robot_DI.x12);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(xCF_InProg) EQ(iCF_Step,iCF_StepBackUP) XIO(xCF_Done) OTE(Ifb_RitChkCF.I_xSensor) ,InputFilter(Ifb_RitChkCF,i_tTChkCF,0) ,XIC(Ifb_RitChkCF.Q_xSensor) OTE(xTxErr) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(xCF_InProg)MOVE(iCF_Step,iCF_StepBackUP);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Size change fanuc Request]]>
</Comment>
<Text>
<![CDATA[XIC(xCF_InProg)XIC(xTxErr)XIO(q_xAlrmTx)[ADD(iCF_Error,1,iCF_Error) ,LE(iCF_Error,3) [MOVE(wFill_value,iCF_Step) ,MOVE(-1,iCF_StepBackUP) ,OTU(xRqCF) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Alarm Tx size data]]>
</Comment>
<Text>
<![CDATA[XIC(xCF_InProg)GT(iCF_Error,3)[OTE(q_xAlrmTx) ,XIC(i_xWorkSizePresent) ADD(iq_iCountDevBad,1,iq_iCountDevBad) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Size change Fanuc in progess]]>
</Comment>
<Text>
<![CDATA[XIO(i_xWorkSizePresent)[OTU(xCF_InProg) ,OTU(xRqCF) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
