<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(1000,OM_EthernetCom_CRS.TON_Cip_Drive_network_waiting_time.PRE)MOVE(1000,OM_EthernetCom_CRS.TON_Drive_first_automatic_reset.PRE)MOVE(500,OM_EthernetCom_CRS.TON_Dosing_stack_completed_delay.PRE)MOVE(1000,OM_EthernetCom_CRS.TON_Read_temperature_motor_clock.PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(TaskMotion.GroupSynced)XIO(TaskMotion.ModuleFault)[[EQ(TaskMotion.GroupFault,0) EQ(TaskMotion.AxisFault,0) ,XIC(OM_EthernetCom_CRS.xCipDrive_NetworkReady) ] TON(OM_EthernetCom_CRS.TON_Cip_Drive_network_waiting_time,?,?) ,XIC(OM_EthernetCom_CRS.TON_Cip_Drive_network_waiting_time.DN) OTE(OM_EthernetCom_CRS.xCipDrive_NetworkReady) ,XIO(OM_EthernetCom_CRS.xCipDrive_NetworkReady) CLR(OM_EthernetCom_CRS.diAuxCheckMotorTemp_NrOfTotalAxis) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(OM_EthernetCom_CRS.TON_Drive_first_automatic_reset.DN)[TON(OM_EthernetCom_CRS.TON_Drive_first_automatic_reset,?,?) ,XIO(OM_EthernetCom_CRS.TON_Drive_first_automatic_reset.DN) OTE(BB_CRS.AxisResetFromFirstPowerOn) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(OM_EthernetCom_CRS.TON_Cip_Drive_network_waiting_time.DN)OTL(BB_CRS.SizeChange_Inhibition);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(AxisFault_CRS.MotionInstructionAlarmRequest) [OTE(ALRM_CRS[832]) ,OTL(BB_CRS.Rq_EmergencyImmediateStop) ,OTU(AxisFault_CRS.MotionInstructionAlarmRequest) ] ,XIC(BB_CRS.Alarm_ResetRisingEdge) [CLR(AxisFault_CRS.NrInstructionError) ,CLR(AxisFault_CRS.NrAxisMotionInstructionError) ,CLR(AxisFault_CRS.NrErrorNumber) ,CLR(AxisFault_CRS.NrExtendedErrorNumber) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(BB_CRS.St_Emergency_ImmediateStop)XIC(BB_CRS.EMF_ON)XIC(BB_CRS.EPN_ON)[TON(OM_EthernetCom_CRS.TON_Dosing_stack_completed_delay,?,?) ,XIC(OM_EthernetCom_CRS.TON_Dosing_stack_completed_delay.DN) OTE(OM_EthernetCom_CRS.xReadyDelayedForEnableDriver) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIO(OM_EthernetCom_CRS.TON_Read_temperature_motor_clock.DN) TON(OM_EthernetCom_CRS.TON_Read_temperature_motor_clock,?,?) ,XIC(OM_EthernetCom_CRS.TON_Read_temperature_motor_clock.DN) ONS(OM_EthernetCom_CRS.axPTrig[1]) ADD(OM_EthernetCom_CRS.diAuxCheckMotorTemp,1,OM_EthernetCom_CRS.diAuxCheckMotorTemp) GT(OM_EthernetCom_CRS.diAuxCheckMotorTemp,OM_EthernetCom_CRS.diAuxCheckMotorTemp_NrOfTotalAxis) CLR(OM_EthernetCom_CRS.diAuxCheckMotorTemp) ];]]>
</Text>
</Rung>
