<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[MOVE(In_FaultClass,L_FaultClass) MOVE(In_FaultBitIndex,L_FaultBitIndex) ,LIMIT(64,L_FaultBitIndex,-1) CLR(L_FaultBitIndex) ,LIMIT(8,L_FaultClass,-1) CLR(L_FaultClass) ,MOVE(L_FaultClass,Out_AxisFaultCode) ,CPS(L_AxisFaultText.FaultClass[L_FaultClass],InOut_AxisFaultClass,1) ,EQ(L_FaultClass,0) CPS(L_AxisFaultText.PhysicalAxisFault[L_FaultBitIndex],InOut_AxisFaultText,1) ,EQ(L_FaultClass,1) CPS(L_AxisFaultText.ModuleFault[L_FaultBitIndex],InOut_AxisFaultText,1) ,EQ(L_FaultClass,2) CPS(L_AxisFaultText.ConfigurationFault[L_FaultBitIndex],InOut_AxisFaultText,1) ,EQ(L_FaultClass,3) CPS(L_AxisFaultText.GroupFault[L_FaultBitIndex],InOut_AxisFaultText,1) ,EQ(L_FaultClass,4) CPS(L_AxisFaultText.MotionFault[L_FaultBitIndex],InOut_AxisFaultText,1) ,EQ(L_FaultClass,5) CPS(L_AxisFaultText.GuardFault[L_FaultBitIndex],InOut_AxisFaultText,1) ,EQ(L_FaultClass,6) CPS(L_AxisFaultText.InitializationFault[L_FaultBitIndex],InOut_AxisFaultText,1) ,EQ(L_FaultClass,7) CPS(L_AxisFaultText.APRFault[L_FaultBitIndex],InOut_AxisFaultText,1) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(InOut_RqRefreshText)[MOVE('0 Physical Axis Fault',L_AxisFaultText.FaultClass[0]) ,MOVE('1 Module Fault',L_AxisFaultText.FaultClass[1]) ,MOVE('2 Configuration Fault',L_AxisFaultText.FaultClass[2]) ,MOVE('3 Group Fault',L_AxisFaultText.FaultClass[3]) ,MOVE('4 Motion Fault',L_AxisFaultText.FaultClass[4]) ,MOVE('5 Guard Fault',L_AxisFaultText.FaultClass[5]) ,MOVE('6 Initialization Fault',L_AxisFaultText.FaultClass[6]) ,MOVE('7 APR Fault',L_AxisFaultText.FaultClass[7]) ,MOVE('8 User Fault',L_AxisFaultText.FaultClass[8]) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
