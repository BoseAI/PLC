<Routine Name="HMI_Management_Batch" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Batch open sequence:]]>
</Line>
<Line Number="1">
<![CDATA[// 1. From the HMI, the operator gives the confirmation to start the format change procedure (at this stage, if we have enabled the remote mode, the ToBeSet from remote will be freezed and passed to ToBeSet of the HMI structure)]]>
</Line>
<Line Number="2">
<![CDATA[// 2. On the HMI, will appear a banner to identify the fact that the system is changing format]]>
</Line>
<Line Number="3">
<![CDATA[// 3. On the PLC the ISA S88 Status passes from IDLE to STARTING waiting for the result of the format change and the result of the batch opening procedure]]>
</Line>
<Line Number="4">
<![CDATA[// 4. The PLC and all the devices perform the format change]]>
</Line>
<Line Number="5">
<![CDATA[// 5. On the HMI the a banner containing the ToBeSet batch info will appear waiting for the result of the check operations on the PLC]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[/*]]>
</Line>
<Line Number="8">
<![CDATA[UM_Config_CRS.Core.Enable_CFR21 := TRUE;]]>
</Line>
<Line Number="9">
<![CDATA[IF UM_Config_CRS.Core.Enable_CFR21 THEN]]>
</Line>
<Line Number="10">
<![CDATA[	]]>
</Line>
<Line Number="11">
<![CDATA[	]]>
</Line>
<Line Number="12">
<![CDATA[	]]>
</Line>
<Line Number="13">
<![CDATA[	// Batch management option --> Disabling]]>
</Line>
<Line Number="14">
<![CDATA[	IF Core_HMI_CRS.PB.Rq_xOptGr_BatchManagementEnabling AND Core_HMI_CRS.PB.St_xOptGr_BatchManagementEnabling THEN]]>
</Line>
<Line Number="15">
<![CDATA[		IF Core_HMI_CRS.PB.St_xBatch_StartEnabling THEN]]>
</Line>
<Line Number="16">
<![CDATA[			MSG_CRS[12] := TRUE;]]>
</Line>
<Line Number="17">
<![CDATA[		ELSE]]>
</Line>
<Line Number="18">
<![CDATA[			Core_HMI_CRS.PB.St_xOptGr_BatchManagementEnabling := FALSE;]]>
</Line>
<Line Number="19">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[		Core_HMI_CRS.PB.Rq_xOptGr_BatchManagementEnabling := FALSE;]]>
</Line>
<Line Number="21">
<![CDATA[	END_If;]]>
</Line>
<Line Number="22">
<![CDATA[	]]>
</Line>
<Line Number="23">
<![CDATA[	// Batch management option --> Enabling]]>
</Line>
<Line Number="24">
<![CDATA[	IF Core_HMI_CRS.PB.Rq_xOptGr_BatchManagementEnabling AND (NOT Core_HMI_CRS.PB.St_xOptGr_BatchManagementEnabling) THEN]]>
</Line>
<Line Number="25">
<![CDATA[		IF BB_CRS.Automatic_CycleActive THEN]]>
</Line>
<Line Number="26">
<![CDATA[			MSG_CRS[12] := TRUE;]]>
</Line>
<Line Number="27">
<![CDATA[		ELSE]]>
</Line>
<Line Number="28">
<![CDATA[			Core_HMI_CRS.PB.St_xOptGr_BatchManagementEnabling := TRUE;]]>
</Line>
<Line Number="29">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="30">
<![CDATA[		Core_HMI_CRS.PB.Rq_xOptGr_BatchManagementEnabling := FALSE;]]>
</Line>
<Line Number="31">
<![CDATA[	END_If;]]>
</Line>
<Line Number="32">
<![CDATA[		]]>
</Line>
<Line Number="33">
<![CDATA[	]]>
</Line>
<Line Number="34">
<![CDATA[	]]>
</Line>
<Line Number="35">
<![CDATA[	// Format change inhibition if batch management active and batch started]]>
</Line>
<Line Number="36">
<![CDATA[	IF Core_HMI_CRS.PB.St_xOptGr_BatchManagementEnabling AND Core_HMI_CRS.PB.St_xBatch_StartEnabling THEN]]>
</Line>
<Line Number="37">
<![CDATA[		BB_CRS.SizeChange_Inhibition := TRUE;]]>
</Line>
<Line Number="38">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[	]]>
</Line>
<Line Number="41">
<![CDATA[	]]>
</Line>
<Line Number="42">
<![CDATA[	// Machine cycle inhibition]]>
</Line>
<Line Number="43">
<![CDATA[	// Message 25: batch not started ]]>
</Line>
<Line Number="44">
<![CDATA[	IF Core_HMI_CRS.PB.St_xOptGr_BatchManagementEnabling AND NOT Core_HMI_CRS.PB.St_xBatch_StartEnabling THEN]]>
</Line>
<Line Number="45">
<![CDATA[		MSG_CRS[25] := TRUE;]]>
</Line>
<Line Number="46">
<![CDATA[		BB_CRS.Automatic_CycleInhibition := TRUE;]]>
</Line>
<Line Number="47">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="48">
<![CDATA[	]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[	IF OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status = 12 OR OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status = 13 THEN]]>
</Line>
<Line Number="52">
<![CDATA[		OM_HMI_BatchManagement_CRS.St_xBatchStart_NOT_OK := TRUE;]]>
</Line>
<Line Number="53">
<![CDATA[		OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 0;]]>
</Line>
<Line Number="54">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="55">
<![CDATA[	]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[	]]>
</Line>
<Line Number="58">
<![CDATA[	// Remote Mode option --> Disabling]]>
</Line>
<Line Number="59">
<![CDATA[	IF Core_HMI_CRS.PB.Rq_xOptGr_RemoteSizeChangeEnabling AND Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling THEN]]>
</Line>
<Line Number="60">
<![CDATA[		IF BB_CRS.Automatic_CycleActive THEN]]>
</Line>
<Line Number="61">
<![CDATA[			MSG_CRS[12] := TRUE;]]>
</Line>
<Line Number="62">
<![CDATA[		ELSE]]>
</Line>
<Line Number="63">
<![CDATA[			Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling := FALSE;]]>
</Line>
<Line Number="64">
<![CDATA[			]]>
</Line>
<Line Number="65">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sLotNumber 		:= 'N/A';]]>
</Line>
<Line Number="66">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sExpirationDate 	:= 'N/A';]]>
</Line>
<Line Number="67">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sManufacturingDate := 'N/A';]]>
</Line>
<Line Number="68">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sProcessOrder		:= 'N/A';]]>
</Line>
<Line Number="69">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sLabelGMID			:= 'N/A';]]>
</Line>
<Line Number="70">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="71">
<![CDATA[		]]>
</Line>
<Line Number="72">
<![CDATA[		Core_HMI_CRS.PB.Rq_xOptGr_RemoteSizeChangeEnabling := FALSE;]]>
</Line>
<Line Number="73">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="74">
<![CDATA[	]]>
</Line>
<Line Number="75">
<![CDATA[	// Remote Mode option --> Enabling]]>
</Line>
<Line Number="76">
<![CDATA[	IF Core_HMI_CRS.PB.Rq_xOptGr_RemoteSizeChangeEnabling AND (NOT Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling) THEN]]>
</Line>
<Line Number="77">
<![CDATA[		IF BB_CRS.Automatic_CycleActive OR Core_HMI_CRS.PB.St_xBatch_StartEnabling THEN]]>
</Line>
<Line Number="78">
<![CDATA[			MSG_CRS[12] := TRUE;]]>
</Line>
<Line Number="79">
<![CDATA[		ELSE]]>
</Line>
<Line Number="80">
<![CDATA[			Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling := TRUE;]]>
</Line>
<Line Number="81">
<![CDATA[			]]>
</Line>
<Line Number="82">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sLotNumber 		:= '';]]>
</Line>
<Line Number="83">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sExpirationDate 	:= '';]]>
</Line>
<Line Number="84">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sManufacturingDate := '';]]>
</Line>
<Line Number="85">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sProcessOrder		:= '';]]>
</Line>
<Line Number="86">
<![CDATA[			OM_HMI_BatchManagement_CRS.St_strDataToCheck.sLabelGMID			:= '';]]>
</Line>
<Line Number="87">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="88">
<![CDATA[		Core_HMI_CRS.PB.Rq_xOptGr_RemoteSizeChangeEnabling := FALSE;]]>
</Line>
<Line Number="89">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="90">
<![CDATA[]]>
</Line>
<Line Number="91">
<![CDATA[]]>
</Line>
<Line Number="92">
<![CDATA[	]]>
</Line>
<Line Number="93">
<![CDATA[//	Ready for batch button - EliLilly USA customization	]]>
</Line>
<Line Number="94">
<![CDATA[	IF Core_HMI_CRS.PB.Rq_xBatch_ReadyEnabling AND Core_HMI_CRS.PB.St_xBatch_ReadyEnabling THEN]]>
</Line>
<Line Number="95">
<![CDATA[	//	Disabling]]>
</Line>
<Line Number="96">
<![CDATA[		Core_HMI_CRS.PB.St_xBatch_ReadyEnabling := FALSE;]]>
</Line>
<Line Number="97">
<![CDATA[		Core_HMI_CRS.PB.Rq_xBatch_ReadyEnabling := FALSE;			]]>
</Line>
<Line Number="98">
<![CDATA[	ELSIF Core_HMI_CRS.PB.Rq_xBatch_ReadyEnabling AND NOT Core_HMI_CRS.PB.St_xBatch_ReadyEnabling THEN]]>
</Line>
<Line Number="99">
<![CDATA[	//	Enabling]]>
</Line>
<Line Number="100">
<![CDATA[		Core_HMI_CRS.PB.St_xBatch_ReadyEnabling := TRUE;]]>
</Line>
<Line Number="101">
<![CDATA[		Core_HMI_CRS.PB.Rq_xBatch_ReadyEnabling := FALSE;]]>
</Line>
<Line Number="102">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="103">
<![CDATA[]]>
</Line>
<Line Number="104">
<![CDATA[	]]>
</Line>
<Line Number="105">
<![CDATA[	]]>
</Line>
<Line Number="106">
<![CDATA[	OM_HMI_BatchManagement_CRS.St_xVariableDataMod_Enable := (OM_HMI_BatchManagement_CRS.St_xStartButton_Enable AND NOT Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling);]]>
</Line>
<Line Number="107">
<![CDATA[	]]>
</Line>
<Line Number="108">
<![CDATA[	IF Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling THEN]]>
</Line>
<Line Number="109">
<![CDATA[]]>
</Line>
<Line Number="110">
<![CDATA[		L_osfiBatchActive.InputBit := PK8CP_from_SCADA.BatchActive;]]>
</Line>
<Line Number="111">
<![CDATA[		OSFI(L_osfiBatchActive);]]>
</Line>
<Line Number="112">
<![CDATA[		]]>
</Line>
<Line Number="113">
<![CDATA[		L_osfiBatchEnabled.InputBit := PK8CP_from_SCADA.BatchEnabled;]]>
</Line>
<Line Number="114">
<![CDATA[		OSFI(L_osfiBatchEnabled);]]>
</Line>
<Line Number="115">
<![CDATA[]]>
</Line>
<Line Number="116">
<![CDATA[		IF 	(	OM_HMI_BatchManagement.St_iIsa88 = 20 AND]]>
</Line>
<Line Number="117">
<![CDATA[				PK8CP_from_SCADA.BatchActive AND]]>
</Line>
<Line Number="118">
<![CDATA[				L_osfiBatchEnabled.OutputBit]]>
</Line>
<Line Number="119">
<![CDATA[			) THEN]]>
</Line>
<Line Number="120">
<![CDATA[			L_xCompleteSignalFromSCADA := 	TRUE;]]>
</Line>
<Line Number="121">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="122">
<![CDATA[		]]>
</Line>
<Line Number="123">
<![CDATA[		IF 	(	OM_HMI_BatchManagement.St_iIsa88 = 20 AND]]>
</Line>
<Line Number="124">
<![CDATA[				NOT PK8CP_from_SCADA.BatchEnabled AND]]>
</Line>
<Line Number="125">
<![CDATA[				L_osfiBatchActive.OutputBit]]>
</Line>
<Line Number="126">
<![CDATA[			) THEN]]>
</Line>
<Line Number="127">
<![CDATA[			L_xAbortSignalFromSCADA := 	TRUE;]]>
</Line>
<Line Number="128">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="129">
<![CDATA[	ELSE]]>
</Line>
<Line Number="130">
<![CDATA[		L_xCompleteSignalFromSCADA :=	FALSE;]]>
</Line>
<Line Number="131">
<![CDATA[		L_xAbortSignalFromSCADA :=		FALSE;		]]>
</Line>
<Line Number="132">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="133">
<![CDATA[]]>
</Line>
<Line Number="134">
<![CDATA[]]>
</Line>
<Line Number="135">
<![CDATA[]]>
</Line>
<Line Number="136">
<![CDATA[	BatchManagement(	AOI_BatchManagement_Instance,]]>
</Line>
<Line Number="137">
<![CDATA[						TRUE,	L_xAbortSignalFromSCADA,]]>
</Line>
<Line Number="138">
<![CDATA[						FALSE,	AOI_BatchManagement_Instance.I_Rq_xScada_ResetFromAbort,]]>
</Line>
<Line Number="139">
<![CDATA[						FALSE,	AOI_BatchManagement_Instance.I_Rq_xScada_Start,]]>
</Line>
<Line Number="140">
<![CDATA[						TRUE,	PK8CP_from_SCADA.BatchParamReadRq,]]>
</Line>
<Line Number="141">
<![CDATA[						TRUE,	L_xCompleteSignalFromSCADA,]]>
</Line>
<Line Number="142">
<![CDATA[						FALSE,	AOI_BatchManagement_Instance.I_Rq_xScada_ResetFromComplete,]]>
</Line>
<Line Number="143">
<![CDATA[						FALSE,	AOI_BatchManagement_Instance.I_Rq_xScada_Pause,]]>
</Line>
<Line Number="144">
<![CDATA[						FALSE,	AOI_BatchManagement_Instance.I_Rq_xScada_Hold,]]>
</Line>
<Line Number="145">
<![CDATA[						FALSE,	AOI_BatchManagement_Instance.I_Rq_xScada_Resume,]]>
</Line>
<Line Number="146">
<![CDATA[						FALSE,	AOI_BatchManagement_Instance.I_Rq_xScada_ResetFromStop,]]>
</Line>
<Line Number="147">
<![CDATA[						FALSE,	AOI_BatchManagement_Instance.I_Rq_xScada_Stop,]]>
</Line>
<Line Number="148">
<![CDATA[						Core_HMI_CRS.PB.Rq_xBatch_StopEnabling,]]>
</Line>
<Line Number="149">
<![CDATA[						Core_HMI_CRS.PB.St_xOptGr_BatchManagementEnabling,]]>
</Line>
<Line Number="150">
<![CDATA[						Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling,]]>
</Line>
<Line Number="151">
<![CDATA[						OM_Config_HMI_CRS.Enable_XLR,	// XLR enable from config]]>
</Line>
<Line Number="152">
<![CDATA[						TRUE,						// SizeChangeRqFromBatch]]>
</Line>
<Line Number="153">
<![CDATA[						ALRM_CRS[321], ALRM_CRS[322], ALRM_CRS[323],]]>
</Line>
<Line Number="154">
<![CDATA[						AOI_BatchManagement_Instance.Q_St_iFSM_ActualState,]]>
</Line>
<Line Number="155">
<![CDATA[						AOI_BatchManagement_Instance.Q_St_iFSM_PreviousState,]]>
</Line>
<Line Number="156">
<![CDATA[						UM_HMI_CRS.Machine.St_iActualWorkingSize_Number,]]>
</Line>
<Line Number="157">
<![CDATA[						UM_HMI_CRS.Machine.St_sActualWorkingSize_Name,]]>
</Line>
<Line Number="158">
<![CDATA[						OM_DataExchange_BatchVariableData_CRS.ToBeSet, 	OM_HMI_BatchManagement_CRS.St_strDataToBeSet,]]>
</Line>
<Line Number="159">
<![CDATA[						OM_DataExchange_BatchVariableData_CRS.ToCheck,	OM_HMI_BatchManagement_CRS.St_strDataToCheck,]]>
</Line>
<Line Number="160">
<![CDATA[						OM_DataExchange_BatchVariableData_CRS.Current,	OM_HMI_BatchManagement_CRS.St_strDataCurrent, ]]>
</Line>
<Line Number="161">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_xStartButton_Enable,]]>
</Line>
<Line Number="162">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_xStopButton_Enable, ]]>
</Line>
<Line Number="163">
<![CDATA[						Core_HMI_CRS.PB.St_xBatch_StartEnabling,]]>
</Line>
<Line Number="164">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_xBatchStart_NOT_OK,]]>
</Line>
<Line Number="165">
<![CDATA[						Core_HMI_CRS.PB.St_xBatch_StopEnabling,]]>
</Line>
<Line Number="166">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_xBatchStop_NOT_OK,]]>
</Line>
<Line Number="167">
<![CDATA[						UM_HMI_CRS.Machine.Rq_xConfirmSizeChange,]]>
</Line>
<Line Number="168">
<![CDATA[						OM_HMI_BatchManagement_CRS.Rq_xAbortFormatChange,]]>
</Line>
<Line Number="169">
<![CDATA[						UM_HMI_CRS.Machine.FormatChange_OK,]]>
</Line>
<Line Number="170">
<![CDATA[						UM_HMI_CRS.Machine.FormatChange_NOT_OK,]]>
</Line>
<Line Number="171">
<![CDATA[						UM_HMI_CRS.Machine.FormatChange_OK,		// BB.SetSize,]]>
</Line>
<Line Number="172">
<![CDATA[						UM_HMI_CRS.Machine.FormatChange_NOT_OK,	// BB.SizeChange_Errors,]]>
</Line>
<Line Number="173">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal,]]>
</Line>
<Line Number="174">
<![CDATA[						MSG_CRS[87], MSG_CRS[88], MSG_CRS[89], MSG_CRS[90],]]>
</Line>
<Line Number="175">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_sBatchReportName,]]>
</Line>
<Line Number="176">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_xReportCorrectlyGenerated]]>
</Line>
<Line Number="177">
<![CDATA[					);]]>
</Line>
<Line Number="178">
<![CDATA[	]]>
</Line>
<Line Number="179">
<![CDATA[	]]>
</Line>
<Line Number="180">
<![CDATA[	OM_HMI_BatchManagement_CRS.St_iIsa88 := AOI_BatchManagement_Instance.Q_St_iFSM_ActualState;]]>
</Line>
<Line Number="181">
<![CDATA[	]]>
</Line>
<Line Number="182">
<![CDATA[	]]>
</Line>
<Line Number="183">
<![CDATA[	L_xBatchVariableDataOK := 	OM_HMI_BatchManagement_CRS.St_strDataToBeSet.sLotNumber 		<> '';]]>
</Line>
<Line Number="184">
<![CDATA[							(*	OM_HMI_BatchManagement_CRS.St_strDataToBeSet.sExpirationDate 	<> '' AND]]>
</Line>
<Line Number="185">
<![CDATA[								OM_HMI_BatchManagement_CRS.St_strDataToBeSet.sManufacturingDate <> '' AND]]>
</Line>
<Line Number="186">
<![CDATA[								OM_HMI_BatchManagement_CRS.St_strDataToBeSet.sProcessOrder		<> '' AND]]>
</Line>
<Line Number="187">
<![CDATA[								OM_HMI_BatchManagement_CRS.St_strDataToBeSet.sLabelGMID			<> '';]]>
</Line>
<Line Number="188">
<![CDATA[							*)]]>
</Line>
<Line Number="189">
<![CDATA[									]]>
</Line>
<Line Number="190">
<![CDATA[	#REGION EliLilly USA customization: clear counters procedure							]]>
</Line>
<Line Number="191">
<![CDATA[	L_xCountersCleared :=	UM_HMI_CRS.Production.diPartialCounterCycles 			= 0 AND]]>
</Line>
<Line Number="192">
<![CDATA[							UM_HMI_CRS.Production.diPartialCounterSeconds 			= 0 AND]]>
</Line>
<Line Number="193">
<![CDATA[							UM_HMI_CRS.Production.diPartialCounterMin 				= 0 AND]]>
</Line>
<Line Number="194">
<![CDATA[							UM_HMI_CRS.Production.diPartialCounterHours 			= 0 AND]]>
</Line>
<Line Number="195">
<![CDATA[							UM_HMI_CRS.Production.diPartialCounterProductsEntered 	= 0 AND]]>
</Line>
<Line Number="196">
<![CDATA[							UM_HMI_CRS.Production.diPartialCounterProductsReworked 	= 0;							]]>
</Line>
<Line Number="197">
<![CDATA[	]]>
</Line>
<Line Number="198">
<![CDATA[]]>
</Line>
<Line Number="199">
<![CDATA[	IF PK8CP_from_SCADA.BatchCountersClearRq THEN]]>
</Line>
<Line Number="200">
<![CDATA[	//	Clear counters signal received]]>
</Line>
<Line Number="201">
<![CDATA[		OM_Interface_CRS.xRq_ResetCounters_BatchManagement_CRS := TRUE;]]>
</Line>
<Line Number="202">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="203">
<![CDATA[	]]>
</Line>
<Line Number="204">
<![CDATA[	IF L_xCountersCleared THEN]]>
</Line>
<Line Number="205">
<![CDATA[		CRS_to_SCADA.BatchCountersClearDone := TRUE;				]]>
</Line>
<Line Number="206">
<![CDATA[	END_IF;	]]>
</Line>
<Line Number="207">
<![CDATA[	]]>
</Line>
<Line Number="208">
<![CDATA[	IF PK8CP_to_SCADA.BatchCountersClearDone AND NOT PK8CP_from_SCADA.BatchCountersClearRq THEN]]>
</Line>
<Line Number="209">
<![CDATA[	//	Counters verified by MES]]>
</Line>
<Line Number="210">
<![CDATA[		CRS_to_SCADA.BatchCountersClearDone := FALSE;				]]>
</Line>
<Line Number="211">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="212">
<![CDATA[	]]>
</Line>
<Line Number="213">
<![CDATA[]]>
</Line>
<Line Number="214">
<![CDATA[	#ENDREGION]]>
</Line>
<Line Number="215">
<![CDATA[	]]>
</Line>
<Line Number="216">
<![CDATA[//]]>
</Line>
<Line Number="217">
<![CDATA[//	BATCH PROCEDURE]]>
</Line>
<Line Number="218">
<![CDATA[//]]>
</Line>
<Line Number="219">
<![CDATA[	IF Core_HMI_CRS.PB.St_xOptGr_BatchManagementEnabling THEN]]>
</Line>
<Line Number="220">
<![CDATA[		]]>
</Line>
<Line Number="221">
<![CDATA[		L_iSizeDimension := 63;]]>
</Line>
<Line Number="222">
<![CDATA[		CASE L_St_iHmiBatch_State OF]]>
</Line>
<Line Number="223">
<![CDATA[			]]>
</Line>
<Line Number="224">
<![CDATA[			0: 	(*	IDLE]]>
</Line>
<Line Number="225">
<![CDATA[					Batch not open.]]>
</Line>
<Line Number="226">
<![CDATA[					]]>
</Line>
<Line Number="227">
<![CDATA[					EliLilly USA customization:]]>
</Line>
<Line Number="228">
<![CDATA[					-	if it's a remote batch, we're waiting for the signal]]>
</Line>
<Line Number="229">
<![CDATA[						to read the batch parameters sent by the MES. Then,]]>
</Line>
<Line Number="230">
<![CDATA[						we go to the CHECKING state.]]>
</Line>
<Line Number="231">
<![CDATA[					-	if it's a local batch, we're waiting for the request]]>
</Line>
<Line Number="232">
<![CDATA[						to start from the HMI. Then, we need to check if the]]>
</Line>
<Line Number="233">
<![CDATA[						selected size is present. If it's ok, we can go to]]>
</Line>
<Line Number="234">
<![CDATA[						the STARTING state as usual.]]>
</Line>
<Line Number="235">
<![CDATA[				*)					]]>
</Line>
<Line Number="236">
<![CDATA[				IF  Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling THEN]]>
</Line>
<Line Number="237">
<![CDATA[				//	Remote]]>
</Line>
<Line Number="238">
<![CDATA[]]>
</Line>
<Line Number="239">
<![CDATA[					IF Core_HMI_CRS.PB.Rq_xBatch_StartEnabling THEN			//EliLilly USA customization ]]>
</Line>
<Line Number="240">
<![CDATA[						Core_HMI_CRS.PB.Rq_xBatch_StartEnabling := FALSE;	//EliLilly USA customization ]]>
</Line>
<Line Number="241">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status := 0;]]>
</Line>
<Line Number="242">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 2;]]>
</Line>
<Line Number="243">
<![CDATA[						]]>
</Line>
<Line Number="244">
<![CDATA[						L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="245">
<![CDATA[						L_St_iHmiBatch_State := 5;]]>
</Line>
<Line Number="246">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="247">
<![CDATA[				ELSE]]>
</Line>
<Line Number="248">
<![CDATA[				//	Local]]>
</Line>
<Line Number="249">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_strDataToBeSet.iRecipeNumber := 0; // Setting pointer to 0 for a neutral list in "size selected from remote"]]>
</Line>
<Line Number="250">
<![CDATA[					IF NOT Core_HMI_CRS.PB.St_xBatch_StartEnabling AND Core_HMI_CRS.PB.Rq_xBatch_StartEnabling THEN]]>
</Line>
<Line Number="251">
<![CDATA[						Core_HMI_CRS.PB.Rq_xBatch_StartEnabling := FALSE;]]>
</Line>
<Line Number="252">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status := 0;]]>
</Line>
<Line Number="253">
<![CDATA[						IF L_xBatchVariableDataOK THEN]]>
</Line>
<Line Number="254">
<![CDATA[							OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 4;]]>
</Line>
<Line Number="255">
<![CDATA[							]]>
</Line>
<Line Number="256">
<![CDATA[							L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="257">
<![CDATA[							L_St_iHmiBatch_State := 10;]]>
</Line>
<Line Number="258">
<![CDATA[						ELSE]]>
</Line>
<Line Number="259">
<![CDATA[							OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 0;]]>
</Line>
<Line Number="260">
<![CDATA[						END_IF;]]>
</Line>
<Line Number="261">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="262">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="263">
<![CDATA[				]]>
</Line>
<Line Number="264">
<![CDATA[		]]>
</Line>
<Line Number="265">
<![CDATA[			5:	(* 	CHECKING]]>
</Line>
<Line Number="266">
<![CDATA[					Batch not open.]]>
</Line>
<Line Number="267">
<![CDATA[					We need to check if the	requested size exists (number/name).]]>
</Line>
<Line Number="268">
<![CDATA[					]]>
</Line>
<Line Number="269">
<![CDATA[					In this step we answer to the MES request:]]>
</Line>
<Line Number="270">
<![CDATA[					-	if the size check is good, we copy the "ToBeSet" data]]>
</Line>
<Line Number="271">
<![CDATA[						set to the "ToCheck" one. Then we wait for the batch]]>
</Line>
<Line Number="272">
<![CDATA[						start signal from the MES to enter in the STARTING state.]]>
</Line>
<Line Number="273">
<![CDATA[					-	if the selected size doesn't exists or it's not in scope,]]>
</Line>
<Line Number="274">
<![CDATA[						we set the failed download bit to 1 and enter in the]]>
</Line>
<Line Number="275">
<![CDATA[						ABORTING state to reset the procedure.]]>
</Line>
<Line Number="276">
<![CDATA[				*)]]>
</Line>
<Line Number="277">
<![CDATA[				]]>
</Line>
<Line Number="278">
<![CDATA[				IF TRUE THEN]]>
</Line>
<Line Number="279">
<![CDATA[				//	Selection by number]]>
</Line>
<Line Number="280">
<![CDATA[					IF OM_DataExchange_BatchVariableData_CRS.ToBeSet.iRecipeNumber > 0 AND OM_DataExchange_BatchVariableData_CRS.ToBeSet.iRecipeNumber < 64 then]]>
</Line>
<Line Number="281">
<![CDATA[						COP(Size_CRS[OM_DataExchange_BatchVariableData_CRS.ToBeSet.iRecipeNumber].Name, L_sSize_ProgramName, 1);]]>
</Line>
<Line Number="282">
<![CDATA[						IF L_sSize_ProgramName <> '' then]]>
</Line>
<Line Number="283">
<![CDATA[						// 	Size exists, we can preset it on the HMI]]>
</Line>
<Line Number="284">
<![CDATA[							UM_HMI_CRS.Machine.St_iActualWorkingSize_Number := OM_DataExchange_BatchVariableData_CRS.ToBeSet.iRecipeNumber;]]>
</Line>
<Line Number="285">
<![CDATA[							OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 4;]]>
</Line>
<Line Number="286">
<![CDATA[							]]>
</Line>
<Line Number="287">
<![CDATA[							// If ME panel force the page to display to size change popup]]>
</Line>
<Line Number="288">
<![CDATA[							]]>
</Line>
<Line Number="289">
<![CDATA[						ELSE]]>
</Line>
<Line Number="290">
<![CDATA[						// 	Error: size doesn't exists]]>
</Line>
<Line Number="291">
<![CDATA[							OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 12;]]>
</Line>
<Line Number="292">
<![CDATA[						END_IF;]]>
</Line>
<Line Number="293">
<![CDATA[					ELSE]]>
</Line>
<Line Number="294">
<![CDATA[					// 	Error: size is not in scope]]>
</Line>
<Line Number="295">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 12;]]>
</Line>
<Line Number="296">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="297">
<![CDATA[				ELSE]]>
</Line>
<Line Number="298">
<![CDATA[				//	Selection by name]]>
</Line>
<Line Number="299">
<![CDATA[					FOR L_iCount := 1 TO L_iSizeDimension DO]]>
</Line>
<Line Number="300">
<![CDATA[						COP(Size_CRS[L_iCount].Name, L_sSize_ProgramName, 1);]]>
</Line>
<Line Number="301">
<![CDATA[						IF L_sSize_ProgramName = OM_DataExchange_BatchVariableData_CRS.ToBeSet.sRecipeName THEN]]>
</Line>
<Line Number="302">
<![CDATA[						// 	Size exists, we can preset it on the HMI]]>
</Line>
<Line Number="303">
<![CDATA[							UM_HMI_CRS.Machine.St_iActualWorkingSize_Number := L_iCount;]]>
</Line>
<Line Number="304">
<![CDATA[							OM_DataExchange_BatchVariableData_CRS.ToBeSet.iRecipeNumber := L_iCount;]]>
</Line>
<Line Number="305">
<![CDATA[							OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 4;]]>
</Line>
<Line Number="306">
<![CDATA[							EXIT;]]>
</Line>
<Line Number="307">
<![CDATA[						END_IF;]]>
</Line>
<Line Number="308">
<![CDATA[					END_FOR;]]>
</Line>
<Line Number="309">
<![CDATA[					IF OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal <> 4 THEN]]>
</Line>
<Line Number="310">
<![CDATA[					// 	Error: size doesn't exists]]>
</Line>
<Line Number="311">
<![CDATA[						OM_DataExchange_BatchVariableData_CRS.ToBeSet.iRecipeNumber := 0;]]>
</Line>
<Line Number="312">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 12;]]>
</Line>
<Line Number="313">
<![CDATA[					ELSE]]>
</Line>
<Line Number="314">
<![CDATA[							// If ME panel force the page to display to size change popup]]>
</Line>
<Line Number="315">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="316">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="317">
<![CDATA[				]]>
</Line>
<Line Number="318">
<![CDATA[				IF OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal = 4 THEN]]>
</Line>
<Line Number="319">
<![CDATA[					CRS_to_SCADA.BatchParamReadDone 	:= TRUE;]]>
</Line>
<Line Number="320">
<![CDATA[					]]>
</Line>
<Line Number="321">
<![CDATA[					IF NOT PK8CP_from_SCADA.BatchParamReadRq THEN]]>
</Line>
<Line Number="322">
<![CDATA[						CRS_to_SCADA.DownloadFailed 		:= FALSE;]]>
</Line>
<Line Number="323">
<![CDATA[						CRS_to_SCADA.BatchParamReadDone 	:= FALSE;]]>
</Line>
<Line Number="324">
<![CDATA[]]>
</Line>
<Line Number="325">
<![CDATA[						L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="326">
<![CDATA[						L_St_iHmiBatch_State := 10;]]>
</Line>
<Line Number="327">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="328">
<![CDATA[					]]>
</Line>
<Line Number="329">
<![CDATA[				//	L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;	EliLilly USA customization]]>
</Line>
<Line Number="330">
<![CDATA[				//	L_St_iHmiBatch_State := 10;								EliLilly USA customization]]>
</Line>
<Line Number="331">
<![CDATA[				ELSE]]>
</Line>
<Line Number="332">
<![CDATA[				//	Error: size not existing or not in scope.]]>
</Line>
<Line Number="333">
<![CDATA[					CRS_to_SCADA.DownloadFailed := TRUE;]]>
</Line>
<Line Number="334">
<![CDATA[					]]>
</Line>
<Line Number="335">
<![CDATA[					IF NOT PK8CP_from_SCADA.BatchParamReadRq THEN]]>
</Line>
<Line Number="336">
<![CDATA[						CRS_to_SCADA.DownloadFailed 		:= FALSE;]]>
</Line>
<Line Number="337">
<![CDATA[						CRS_to_SCADA.BatchParamReadDone 	:= FALSE;]]>
</Line>
<Line Number="338">
<![CDATA[]]>
</Line>
<Line Number="339">
<![CDATA[						L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;					]]>
</Line>
<Line Number="340">
<![CDATA[						L_St_iHmiBatch_State := 99;]]>
</Line>
<Line Number="341">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="342">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="343">
<![CDATA[				]]>
</Line>
<Line Number="344">
<![CDATA[				]]>
</Line>
<Line Number="345">
<![CDATA[			10:	(*	STARTING]]>
</Line>
<Line Number="346">
<![CDATA[					Opening batch procedure.]]>
</Line>
<Line Number="347">
<![CDATA[					]]>
</Line>
<Line Number="348">
<![CDATA[					If:]]>
</Line>
<Line Number="349">
<![CDATA[					- 	the batch variable data are not empty]]>
</Line>
<Line Number="350">
<![CDATA[					-	the batch management addon is in STARTING status]]>
</Line>
<Line Number="351">
<![CDATA[					-	the size has been changed succesfully]]>
</Line>
<Line Number="352">
<![CDATA[					Then we can copy the "ToBeSet" data to the "Current" ones]]>
</Line>
<Line Number="353">
<![CDATA[					and go to the RUNNING state.]]>
</Line>
<Line Number="354">
<![CDATA[				*)]]>
</Line>
<Line Number="355">
<![CDATA[				IF L_xBatchVariableDataOK AND (OM_HMI_BatchManagement_CRS.St_iIsa88 = 10) AND UM_HMI_CRS.Machine.FormatChange_OK (* BB.SetSize *) THEN]]>
</Line>
<Line Number="356">
<![CDATA[				//	Copy of the ToBeSet HMI on Current HMI]]>
</Line>
<Line Number="357">
<![CDATA[					CPS(OM_HMI_BatchManagement_CRS.St_strDataToBeSet, OM_HMI_BatchManagement_CRS.St_strDataCurrent, 1);]]>
</Line>
<Line Number="358">
<![CDATA[					Core_HMI_CRS.PB.St_xBatch_StartEnabling := TRUE; ]]>
</Line>
<Line Number="359">
<![CDATA[					Core_HMI_CRS.PB.St_xBatch_StopEnabling := FALSE;]]>
</Line>
<Line Number="360">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_xBatchStop_NOT_OK := FALSE;]]>
</Line>
<Line Number="361">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status := 4;]]>
</Line>
<Line Number="362">
<![CDATA[										]]>
</Line>
<Line Number="363">
<![CDATA[				ELSIF NOT L_xBatchVariableDataOK AND (OM_HMI_BatchManagement_CRS.St_iIsa88 = 10) AND UM_HMI_CRS.Machine.FormatChange_OK (* BB.SetSize *) THEN]]>
</Line>
<Line Number="364">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status := 13;]]>
</Line>
<Line Number="365">
<![CDATA[					Core_HMI_CRS.PB.St_xBatch_StartEnabling := FALSE;]]>
</Line>
<Line Number="366">
<![CDATA[					Core_HMI_CRS.PB.St_xBatch_StopEnabling := FALSE;]]>
</Line>
<Line Number="367">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_xBatchStop_NOT_OK := FALSE;]]>
</Line>
<Line Number="368">
<![CDATA[				]]>
</Line>
<Line Number="369">
<![CDATA[				ELSIF UM_HMI_CRS.Machine.FormatChange_NOT_OK OR OM_HMI_BatchManagement_CRS.Rq_xAbortFormatChange OR (OM_HMI_BatchManagement_CRS.St_iIsa88 = 199) THEN]]>
</Line>
<Line Number="370">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status := 12;]]>
</Line>
<Line Number="371">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="372">
<![CDATA[				]]>
</Line>
<Line Number="373">
<![CDATA[				]]>
</Line>
<Line Number="374">
<![CDATA[				IF OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status = 4 THEN]]>
</Line>
<Line Number="375">
<![CDATA[					IF NOT Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling THEN]]>
</Line>
<Line Number="376">
<![CDATA[						OM_Interface_CRS.xRq_ResetCounters_BatchManagement_CRS := TRUE;]]>
</Line>
<Line Number="377">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="378">
<![CDATA[						]]>
</Line>
<Line Number="379">
<![CDATA[					L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="380">
<![CDATA[					L_St_iHmiBatch_State := 20;]]>
</Line>
<Line Number="381">
<![CDATA[					]]>
</Line>
<Line Number="382">
<![CDATA[				ELSIF OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status = 12 OR OM_HMI_BatchManagement_CRS.St_iFormatChange_BatchOpen_Status = 13 THEN]]>
</Line>
<Line Number="383">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_xBatchStart_NOT_OK := TRUE;]]>
</Line>
<Line Number="384">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_iFormatCheck_RetVal := 0;]]>
</Line>
<Line Number="385">
<![CDATA[					]]>
</Line>
<Line Number="386">
<![CDATA[					L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="387">
<![CDATA[					L_St_iHmiBatch_State := 99;]]>
</Line>
<Line Number="388">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="389">
<![CDATA[			]]>
</Line>
<Line Number="390">
<![CDATA[			]]>
</Line>
<Line Number="391">
<![CDATA[			20:	(*	RUNNING]]>
</Line>
<Line Number="392">
<![CDATA[					Batch is open. 						]]>
</Line>
<Line Number="393">
<![CDATA[]]>
</Line>
<Line Number="394">
<![CDATA[					If we receive the completing signal from the MES or]]>
</Line>
<Line Number="395">
<![CDATA[					from the HMI, we can go to the COMPLETING state.]]>
</Line>
<Line Number="396">
<![CDATA[				*)]]>
</Line>
<Line Number="397">
<![CDATA[				IF Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling THEN]]>
</Line>
<Line Number="398">
<![CDATA[					IF PK8CP_from_SCADA.BatchEnabled THEN]]>
</Line>
<Line Number="399">
<![CDATA[						Core_HMI_CRS.PB.St_xBatch_ReadyEnabling 				:= FALSE;]]>
</Line>
<Line Number="400">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="401">
<![CDATA[					]]>
</Line>
<Line Number="402">
<![CDATA[					IF PK8CP_from_SCADA.BatchActive AND NOT (PK8CP_from_SCADA.BatchEnabled OR L_xCompleteSignalFromSCADA) THEN]]>
</Line>
<Line Number="403">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_xStartButton_Enable 	:= TRUE;]]>
</Line>
<Line Number="404">
<![CDATA[					ELSIF PK8CP_from_SCADA.BatchActive AND (PK8CP_from_SCADA.BatchEnabled OR L_xCompleteSignalFromSCADA) THEN]]>
</Line>
<Line Number="405">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_xStartButton_Enable 	:= FALSE;]]>
</Line>
<Line Number="406">
<![CDATA[					ELSE]]>
</Line>
<Line Number="407">
<![CDATA[						OM_HMI_BatchManagement_CRS.St_xStartButton_Enable 	:= FALSE;						]]>
</Line>
<Line Number="408">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="409">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="410">
<![CDATA[				]]>
</Line>
<Line Number="411">
<![CDATA[				OM_HMI_BatchManagement_CRS.St_xReportNotGenerated := FALSE;]]>
</Line>
<Line Number="412">
<![CDATA[				IF Core_HMI_CRS.PB.St_xBatch_StartEnabling AND Core_HMI_CRS.PB.Rq_xBatch_StopEnabling THEN]]>
</Line>
<Line Number="413">
<![CDATA[					Core_HMI_CRS.PB.Rq_xBatch_StopEnabling := FALSE;]]>
</Line>
<Line Number="414">
<![CDATA[					Core_HMI_CRS.PB.St_xBatch_StartEnabling := FALSE;]]>
</Line>
<Line Number="415">
<![CDATA[					]]>
</Line>
<Line Number="416">
<![CDATA[					IF Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling AND L_xCompleteSignalFromSCADA THEN]]>
</Line>
<Line Number="417">
<![CDATA[						L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="418">
<![CDATA[						L_St_iHmiBatch_State := 30;]]>
</Line>
<Line Number="419">
<![CDATA[					ELSIF Core_HMI_CRS.PB.St_xOptGr_RemoteSizeChangeEnabling AND L_xAbortSignalFromSCADA THEN]]>
</Line>
<Line Number="420">
<![CDATA[						L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="421">
<![CDATA[						L_St_iHmiBatch_State := 99;]]>
</Line>
<Line Number="422">
<![CDATA[					ELSE]]>
</Line>
<Line Number="423">
<![CDATA[						L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="424">
<![CDATA[						L_St_iHmiBatch_State := 30;]]>
</Line>
<Line Number="425">
<![CDATA[					END_IF;]]>
</Line>
<Line Number="426">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="427">
<![CDATA[				]]>
</Line>
<Line Number="428">
<![CDATA[				]]>
</Line>
<Line Number="429">
<![CDATA[			30:	(*	COMPLETING]]>
</Line>
<Line Number="430">
<![CDATA[					Batch is completing.]]>
</Line>
<Line Number="431">
<![CDATA[					]]>
</Line>
<Line Number="432">
<![CDATA[					Completing batch procedure.]]>
</Line>
<Line Number="433">
<![CDATA[					We need to reset the request to complete the batch:]]>
</Line>
<Line Number="434">
<![CDATA[					-	if it's an ME station, we need to wait for the]]>
</Line>
<Line Number="435">
<![CDATA[						generation of 3 CSV files:]]>
</Line>
<Line Number="436">
<![CDATA[						- 	1 for the alarm log]]>
</Line>
<Line Number="437">
<![CDATA[						-	1 for the audit trail log]]>
</Line>
<Line Number="438">
<![CDATA[						-	1 for the diagnostic log]]>
</Line>
<Line Number="439">
<![CDATA[					-	if it's an SE station, this depends on XLR:]]>
</Line>
<Line Number="440">
<![CDATA[						-	if XLR is disabled, we can go ahead directly]]>
</Line>
<Line Number="441">
<![CDATA[							to the COMPLETE state]]>
</Line>
<Line Number="442">
<![CDATA[						-	if XLR is enabled, we need to wait for the]]>
</Line>
<Line Number="443">
<![CDATA[							generation of 1 PDF report file]]>
</Line>
<Line Number="444">
<![CDATA[				*)]]>
</Line>
<Line Number="445">
<![CDATA[				L_xCompleteSignalFromSCADA := FALSE;]]>
</Line>
<Line Number="446">
<![CDATA[				]]>
</Line>
<Line Number="447">
<![CDATA[				IF 	(OM_HMI_BatchManagement_CRS.St_iIsa88 = 40) AND (]]>
</Line>
<Line Number="448">
<![CDATA[					(OM_Config_HMI_CRS.Enable_XLR AND OM_HMI_BatchManagement_CRS.St_xReportCorrectlyGenerated) OR]]>
</Line>
<Line Number="449">
<![CDATA[					(NOT OM_Config_HMI_CRS.Enable_XLR)) THEN ]]>
</Line>
<Line Number="450">
<![CDATA[					Core_HMI_CRS.PB.St_xBatch_StopEnabling := TRUE;]]>
</Line>
<Line Number="451">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_xBatchStop_NOT_OK := FALSE;]]>
</Line>
<Line Number="452">
<![CDATA[					]]>
</Line>
<Line Number="453">
<![CDATA[					L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="454">
<![CDATA[					L_St_iHmiBatch_State := 40;]]>
</Line>
<Line Number="455">
<![CDATA[				]]>
</Line>
<Line Number="456">
<![CDATA[				ELSIF (OM_HMI_BatchManagement_CRS.St_iIsa88 = 199) OR OM_HMI_BatchManagement_CRS.St_xReportNotGenerated THEN ]]>
</Line>
<Line Number="457">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_xReportNotGenerated := FALSE;]]>
</Line>
<Line Number="458">
<![CDATA[					Core_HMI_CRS.PB.St_xBatch_StopEnabling := FALSE;]]>
</Line>
<Line Number="459">
<![CDATA[					OM_HMI_BatchManagement_CRS.St_xBatchStop_NOT_OK := TRUE;]]>
</Line>
<Line Number="460">
<![CDATA[					]]>
</Line>
<Line Number="461">
<![CDATA[					L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="462">
<![CDATA[					L_St_iHmiBatch_State := 99;]]>
</Line>
<Line Number="463">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="464">
<![CDATA[			]]>
</Line>
<Line Number="465">
<![CDATA[			40: (*	COMPLETE]]>
</Line>
<Line Number="466">
<![CDATA[				*)	]]>
</Line>
<Line Number="467">
<![CDATA[				L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="468">
<![CDATA[				L_St_iHmiBatch_State := 0;]]>
</Line>
<Line Number="469">
<![CDATA[				]]>
</Line>
<Line Number="470">
<![CDATA[			99: (*	ABORTING]]>
</Line>
<Line Number="471">
<![CDATA[					Batch is aborting due to an error.]]>
</Line>
<Line Number="472">
<![CDATA[				*)]]>
</Line>
<Line Number="473">
<![CDATA[				L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="474">
<![CDATA[				L_St_iHmiBatch_State := 100;]]>
</Line>
<Line Number="475">
<![CDATA[				]]>
</Line>
<Line Number="476">
<![CDATA[			100: (*	ABORTED]]>
</Line>
<Line Number="477">
<![CDATA[				 *)]]>
</Line>
<Line Number="478">
<![CDATA[				Core_HMI_CRS.PB.St_xBatch_ReadyEnabling := FALSE;]]>
</Line>
<Line Number="479">
<![CDATA[				L_xCompleteSignalFromSCADA 			:= FALSE;]]>
</Line>
<Line Number="480">
<![CDATA[				L_xAbortSignalFromSCADA 			:= FALSE;]]>
</Line>
<Line Number="481">
<![CDATA[			]]>
</Line>
<Line Number="482">
<![CDATA[				L_St_iHmiBatch_State_Previous := L_St_iHmiBatch_State;]]>
</Line>
<Line Number="483">
<![CDATA[				L_St_iHmiBatch_State := 0;]]>
</Line>
<Line Number="484">
<![CDATA[		END_CASE;]]>
</Line>
<Line Number="485">
<![CDATA[		]]>
</Line>
<Line Number="486">
<![CDATA[	ELSE]]>
</Line>
<Line Number="487">
<![CDATA[		]]>
</Line>
<Line Number="488">
<![CDATA[		// DA TESTARE]]>
</Line>
<Line Number="489">
<![CDATA[		L_St_iHmiBatch_State := 0;]]>
</Line>
<Line Number="490">
<![CDATA[		]]>
</Line>
<Line Number="491">
<![CDATA[		Core_HMI_CRS.PB.Rq_xBatch_StartEnabling := FALSE;]]>
</Line>
<Line Number="492">
<![CDATA[		Core_HMI_CRS.PB.St_xBatch_StartEnabling := FALSE;]]>
</Line>
<Line Number="493">
<![CDATA[		]]>
</Line>
<Line Number="494">
<![CDATA[		Core_HMI_CRS.PB.Rq_xBatch_StopEnabling:= FALSE;]]>
</Line>
<Line Number="495">
<![CDATA[		Core_HMI_CRS.PB.St_xBatch_StopEnabling:= FALSE;]]>
</Line>
<Line Number="496">
<![CDATA[		]]>
</Line>
<Line Number="497">
<![CDATA[		Core_HMI_CRS.PB.Rq_xBatch_ReadyEnabling := FALSE;]]>
</Line>
<Line Number="498">
<![CDATA[		Core_HMI_CRS.PB.St_xBatch_ReadyEnabling := FALSE;]]>
</Line>
<Line Number="499">
<![CDATA[		]]>
</Line>
<Line Number="500">
<![CDATA[		OM_HMI_BatchManagement_CRS.St_xBatchStart_NOT_OK := FALSE;]]>
</Line>
<Line Number="501">
<![CDATA[		OM_HMI_BatchManagement_CRS.St_xBatchStop_NOT_OK := FALSE;]]>
</Line>
<Line Number="502">
<![CDATA[		]]>
</Line>
<Line Number="503">
<![CDATA[		OM_HMI_BatchManagement_CRS.St_xReportCorrectlyGenerated := FALSE;]]>
</Line>
<Line Number="504">
<![CDATA[		OM_HMI_BatchManagement_CRS.St_xReportNotGenerated := FALSE;]]>
</Line>
<Line Number="505">
<![CDATA[		]]>
</Line>
<Line Number="506">
<![CDATA[		OM_HMI_BatchManagement_CRS.Rq_xAbortFormatChange := FALSE;]]>
</Line>
<Line Number="507">
<![CDATA[		OM_HMI_BatchManagement_CRS.St_iReportTransferToNetwork :=0;]]>
</Line>
<Line Number="508">
<![CDATA[		]]>
</Line>
<Line Number="509">
<![CDATA[		ALRM_CRS[321] := FALSE;]]>
</Line>
<Line Number="510">
<![CDATA[		ALRM_CRS[322] := FALSE;]]>
</Line>
<Line Number="511">
<![CDATA[		ALRM_CRS[323] := FALSE;]]>
</Line>
<Line Number="512">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="513">
<![CDATA[	(*]]>
</Line>
<Line Number="514">
<![CDATA[	ALRM[980] := (OM_HMI_BatchManagement_CRS.St_iDbAlarms_OccupiedMemory > OM_HMI_BatchManagement_CRS.St_iDbAlarms_AlarmThreashold);]]>
</Line>
<Line Number="515">
<![CDATA[	ALRM[981] := (OM_HMI_BatchManagement_CRS.St_iDbAuditTrail_OccupiedMemory > OM_HMI_BatchManagement_CRS.St_iDbAuditTrail_AlarmThreashold);]]>
</Line>
<Line Number="516">
<![CDATA[	ALRM[982] := (OM_HMI_BatchManagement_CRS.St_iDbStatistics_OccupiedMemory > OM_HMI_BatchManagement_CRS.St_iDbStatistics_AlarmThreashold);]]>
</Line>
<Line Number="517">
<![CDATA[	*)]]>
</Line>
<Line Number="518">
<![CDATA[	]]>
</Line>
<Line Number="519">
<![CDATA[	IF NOT OM_HMI_BatchManagement_CRS.St_xReportCorrectlyGenerated AND NOT L_axPulse[2] THEN]]>
</Line>
<Line Number="520">
<![CDATA[		L_axPulse[2] := TRUE;]]>
</Line>
<Line Number="521">
<![CDATA[		OM_HMI_BatchManagement_CRS.St_iReportTransferToNetwork := 0;]]>
</Line>
<Line Number="522">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="523">
<![CDATA[		]]>
</Line>
<Line Number="524">
<![CDATA[	IF OM_HMI_BatchManagement_CRS.St_xReportCorrectlyGenerated AND L_axPulse[2] THEN]]>
</Line>
<Line Number="525">
<![CDATA[		L_axPulse[2] := FALSE;]]>
</Line>
<Line Number="526">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="527">
<![CDATA[		]]>
</Line>
<Line Number="528">
<![CDATA[		]]>
</Line>
<Line Number="529">
<![CDATA[		]]>
</Line>
<Line Number="530">
<![CDATA[	IF OM_HMI_BatchManagement_CRS.St_xEnableReportTransferToNetwork THEN]]>
</Line>
<Line Number="531">
<![CDATA[		MSG_CRS[91] := (OM_HMI_BatchManagement_CRS.St_iReportTransferToNetwork = 12);]]>
</Line>
<Line Number="532">
<![CDATA[	ELSE]]>
</Line>
<Line Number="533">
<![CDATA[		OM_HMI_BatchManagement_CRS.St_iReportTransferToNetwork :=0;]]>
</Line>
<Line Number="534">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="535">
<![CDATA[]]>
</Line>
<Line Number="536">
<![CDATA[]]>
</Line>
<Line Number="537">
<![CDATA[ELSE]]>
</Line>
<Line Number="538">
<![CDATA[	Core_HMI_CRS.PB.Rq_xBatch_StartEnabling := FALSE;]]>
</Line>
<Line Number="539">
<![CDATA[	Core_HMI_CRS.PB.St_xBatch_StartEnabling := FALSE;]]>
</Line>
<Line Number="540">
<![CDATA[	]]>
</Line>
<Line Number="541">
<![CDATA[	Core_HMI_CRS.PB.Rq_xBatch_StopEnabling:= FALSE;]]>
</Line>
<Line Number="542">
<![CDATA[	Core_HMI_CRS.PB.St_xBatch_StopEnabling:= FALSE;]]>
</Line>
<Line Number="543">
<![CDATA[	]]>
</Line>
<Line Number="544">
<![CDATA[	Core_HMI_CRS.PB.Rq_xOptGr_BatchManagementEnabling := FALSE;]]>
</Line>
<Line Number="545">
<![CDATA[	Core_HMI_CRS.PB.St_xOptGr_BatchManagementEnabling := FALSE;]]>
</Line>
<Line Number="546">
<![CDATA[	]]>
</Line>
<Line Number="547">
<![CDATA[	OM_HMI_BatchManagement_CRS.Rq_xAbortFormatChange := FALSE;]]>
</Line>
<Line Number="548">
<![CDATA[	]]>
</Line>
<Line Number="549">
<![CDATA[	//OM_HMI_BatchManagement.St_xBatchStart_OK := FALSE;]]>
</Line>
<Line Number="550">
<![CDATA[	OM_HMI_BatchManagement_CRS.St_xBatchStart_NOT_OK := FALSE;]]>
</Line>
<Line Number="551">
<![CDATA[	]]>
</Line>
<Line Number="552">
<![CDATA[	//OM_HMI_BatchManagement.xSpr05 := FALSE;]]>
</Line>
<Line Number="553">
<![CDATA[	OM_HMI_BatchManagement_CRS.St_xBatchStop_NOT_OK := FALSE;]]>
</Line>
<Line Number="554">
<![CDATA[	]]>
</Line>
<Line Number="555">
<![CDATA[	OM_HMI_BatchManagement_CRS.St_sBatchReportName := '';]]>
</Line>
<Line Number="556">
<![CDATA[	OM_HMI_BatchManagement_CRS.St_xReportCorrectlyGenerated := FALSE;]]>
</Line>
<Line Number="557">
<![CDATA[	]]>
</Line>
<Line Number="558">
<![CDATA[	OM_Interface_CRS.xRq_ResetCounters_BatchManagement_CRS := FALSE;]]>
</Line>
<Line Number="559">
<![CDATA[	]]>
</Line>
<Line Number="560">
<![CDATA[	MSG_CRS[25] := FALSE;]]>
</Line>
<Line Number="561">
<![CDATA[	MSG_CRS[87] := FALSE;]]>
</Line>
<Line Number="562">
<![CDATA[	MSG_CRS[88] := FALSE;]]>
</Line>
<Line Number="563">
<![CDATA[	MSG_CRS[89] := FALSE;]]>
</Line>
<Line Number="564">
<![CDATA[	MSG_CRS[90] := FALSE;]]>
</Line>
<Line Number="565">
<![CDATA[	]]>
</Line>
<Line Number="566">
<![CDATA[	ALRM_CRS[321] := FALSE;]]>
</Line>
<Line Number="567">
<![CDATA[	ALRM_CRS[322] := FALSE;]]>
</Line>
<Line Number="568">
<![CDATA[	ALRM_CRS[323] := FALSE;]]>
</Line>
<Line Number="569">
<![CDATA[	]]>
</Line>
<Line Number="570">
<![CDATA[	ALRM_CRS[980] := FALSE;]]>
</Line>
<Line Number="571">
<![CDATA[	ALRM_CRS[981] := FALSE;]]>
</Line>
<Line Number="572">
<![CDATA[	ALRM_CRS[982] := FALSE;]]>
</Line>
<Line Number="573">
<![CDATA[END_IF;*/]]>
</Line>
</STContent>
</Routine>
<Routine Name="HMI_Management_GMP" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[IF BB_CRS.FirstScan THEN]]>
</Line>
<Line Number="1">
<![CDATA[	//Reset the pointers variables to the value 0 and correspondingly update the interface on used by the HMI]]>
</Line>
<Line Number="2">
<![CDATA[	Core_HMI_CRS.PB.Rq_iGMPAlarmsInterfacePointer := 0;]]>
</Line>
<Line Number="3">
<![CDATA[	Core_HMI_CRS.PB.St_iGMPAlarmsInterfacePointer := 0;]]>
</Line>
<Line Number="4">
<![CDATA[	L_Rq_xUpdateHMIInterface := TRUE;]]>
</Line>
<Line Number="5">
<![CDATA[(*	FOR iCounter := 0 TO 1023 BY 1 DO]]>
</Line>
<Line Number="6">
<![CDATA[		IF GMP_ALRM_Configuration[iCounter] THEN]]>
</Line>
<Line Number="7">
<![CDATA[			SEVERITY_Alarm_Configuration[iCounter] := 900;]]>
</Line>
<Line Number="8">
<![CDATA[		ELSE]]>
</Line>
<Line Number="9">
<![CDATA[			SEVERITY_Alarm_Configuration[iCounter] := 800;]]>
</Line>
<Line Number="10">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="11">
<![CDATA[	END_FOR;*)]]>
</Line>
<Line Number="12">
<![CDATA[	iCounter := 0;]]>
</Line>
<Line Number="13">
<![CDATA[END_IF;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[//Check if the pointers are in the correct window. It is very important to not go further in the arrays. This can produce a fault of the CPU.]]>
</Line>
<Line Number="16">
<![CDATA[IF Core_HMI_CRS.PB.Rq_iGMPAlarmsInterfacePointer < 0 THEN]]>
</Line>
<Line Number="17">
<![CDATA[	Core_HMI_CRS.PB.Rq_iGMPAlarmsInterfacePointer := 0;]]>
</Line>
<Line Number="18">
<![CDATA[ELSIF Core_HMI_CRS.PB.Rq_iGMPAlarmsInterfacePointer > 62 THEN]]>
</Line>
<Line Number="19">
<![CDATA[	Core_HMI_CRS.PB.Rq_iGMPAlarmsInterfacePointer := 62;]]>
</Line>
<Line Number="20">
<![CDATA[END_IF;]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[//If the pointer value used in the HMI is changed, ask for an update of the common interface]]>
</Line>
<Line Number="23">
<![CDATA[IF Core_HMI_CRS.PB.Rq_iGMPAlarmsInterfacePointer <> Core_HMI_CRS.PB.St_iGMPAlarmsInterfacePointer THEN]]>
</Line>
<Line Number="24">
<![CDATA[	L_Rq_xUpdateHMIInterface := TRUE;]]>
</Line>
<Line Number="25">
<![CDATA[	Core_HMI_CRS.PB.St_iGMPAlarmsInterfacePointer := Core_HMI_CRS.PB.Rq_iGMPAlarmsInterfacePointer;]]>
</Line>
<Line Number="26">
<![CDATA[END_IF;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[//Update of the visualization interface starting from the values recorded on the PLC]]>
</Line>
<Line Number="29">
<![CDATA[IF L_Rq_xUpdateHMIInterface THEN]]>
</Line>
<Line Number="30">
<![CDATA[	L_Rq_xUpdateHMIInterface := FALSE;]]>
</Line>
<Line Number="31">
<![CDATA[	FOR iCounter := 0 TO 15 BY 1 DO]]>
</Line>
<Line Number="32">
<![CDATA[		Core_HMI_CRS.Interface.arrGMPAlarmsInterface[iCounter] := GMP_ALRM_Configuration_CRS[(Core_HMI_CRS.PB.St_iGMPAlarmsInterfacePointer * 16) + iCounter];]]>
</Line>
<Line Number="33">
<![CDATA[		Core_HMI_CRS.Interface.arrSEVERITYAlarmsInterface[iCounter] := SEVERITY_Alarm_Configuration_CRS[(Core_HMI_CRS.PB.St_iGMPAlarmsInterfacePointer * 16) + iCounter];]]>
</Line>
<Line Number="34">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="35">
<![CDATA[END_IF;]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[FOR iCounter := 0 TO 15 BY 1 DO]]>
</Line>
<Line Number="38">
<![CDATA[    IF NOT Core_HMI_CRS.Interface.arrGMPAlarmsInterface[iCounter] THEN]]>
</Line>
<Line Number="39">
<![CDATA[        IF ((Core_HMI_CRS.Interface.arrSEVERITYAlarmsInterface[iCounter] < 801) OR]]>
</Line>
<Line Number="40">
<![CDATA[            (Core_HMI_CRS.Interface.arrSEVERITYAlarmsInterface[iCounter] > 899)) THEN]]>
</Line>
<Line Number="41">
<![CDATA[            Core_HMI_CRS.Interface.arrSEVERITYAlarmsInterface[iCounter] := 801;]]>
</Line>
<Line Number="42">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="43">
<![CDATA[    ELSE]]>
</Line>
<Line Number="44">
<![CDATA[        // TRUE → deve stare tra 901 e 999]]>
</Line>
<Line Number="45">
<![CDATA[        IF ((Core_HMI_CRS.Interface.arrSEVERITYAlarmsInterface[iCounter] < 901) OR]]>
</Line>
<Line Number="46">
<![CDATA[            (Core_HMI_CRS.Interface.arrSEVERITYAlarmsInterface[iCounter] > 999)) THEN]]>
</Line>
<Line Number="47">
<![CDATA[            Core_HMI_CRS.Interface.arrSEVERITYAlarmsInterface[iCounter] := 901;]]>
</Line>
<Line Number="48">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="49">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="50">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[//Update the values recorded on the PLC after the modification performed on the HMI.]]>
</Line>
<Line Number="56">
<![CDATA[IF Core_HMI_CRS.PB.Rq_xGMPAlarmsInterface_Update THEN]]>
</Line>
<Line Number="57">
<![CDATA[	Core_HMI_CRS.PB.Rq_xGMPAlarmsInterface_Update := FALSE;]]>
</Line>
<Line Number="58">
<![CDATA[	For iCounter := 0 TO 15 BY 1 DO]]>
</Line>
<Line Number="59">
<![CDATA[		GMP_ALRM_Configuration_CRS[(Core_HMI_CRS.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] := Core_HMI_CRS.Interface.arrGMPAlarmsInterface[iCounter];]]>
</Line>
<Line Number="60">
<![CDATA[		SEVERITY_Alarm_Configuration_CRS[(Core_HMI_CRS.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] := Core_HMI_CRS.Interface.arrSEVERITYAlarmsInterface[iCounter];]]>
</Line>
<Line Number="61">
<![CDATA[(*		IF GMP_ALRM_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] THEN]]>
</Line>
<Line Number="62">
<![CDATA[			SEVERITY_Alarm_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] := 900;]]>
</Line>
<Line Number="63">
<![CDATA[		ELSE]]>
</Line>
<Line Number="64">
<![CDATA[			SEVERITY_Alarm_Configuration[(Core_HMI.PB.St_iGMPAlarmsInterfacePointer * 16)+iCounter] := 800;]]>
</Line>
<Line Number="65">
<![CDATA[		END_IF;*)]]>
</Line>
<Line Number="66">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="67">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="HMI_Management_UserAutoLogout" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[Buffering_in_Progress:=	IN_CRS.B9691_01 OR IN_CRS.B9691_02;]]>
</Line>
<Line Number="1">
<![CDATA[//{/FTDS_Area::[clogix]Program:CRS_OM_HMI.Buffering_in_Progress}]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[(*]]>
</Line>
<Line Number="5">
<![CDATA[IF Core_HMI.Interface.iPasswordState = 0 OR TON_HMI_UserAutoLogoutRq.TT THEN]]>
</Line>
<Line Number="6">
<![CDATA[	Core_HMI.Interface.Rq_xUserAutoLogout := FALSE;]]>
</Line>
<Line Number="7">
<![CDATA[END_IF;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[//	Timer setup for HMI user auto logout]]>
</Line>
<Line Number="10">
<![CDATA[TON_HMI_UserAutoLogoutRq.EnableIn	:=	NOT BB.AlwaysOFF;]]>
</Line>
<Line Number="11">
<![CDATA[TON_HMI_UserAutoLogoutRq.TimerEnable:=	(Core_HMI.Interface.iPasswordState <> 0) AND NOT(BB.SizeDisplay_ChangePagePulse) AND NOT(Buffering_in_Progress) AND BB.AlwaysOFF;]]>
</Line>
<Line Number="12">
<![CDATA[TON_HMI_UserAutoLogoutRq.PRE 		:=	Timers_CRS.N[44].PRE;]]>
</Line>
<Line Number="13">
<![CDATA[TONR(TON_HMI_UserAutoLogoutRq);]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[IF TON_HMI_UserAutoLogoutRq.DN THEN]]>
</Line>
<Line Number="16">
<![CDATA[	Core_HMI.Interface.Rq_xUserAutoLogout := TRUE;]]>
</Line>
<Line Number="17">
<![CDATA[END_IF;]]>
</Line>
<Line Number="18">
<![CDATA[*)]]>
</Line>
</STContent>
</Routine>
<Routine Name="HMI_Management_VitalityCheck" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[IF BB_CRS.FirstScan THEN]]>
</Line>
<Line Number="1">
<![CDATA[	Core_HMI_CRS.Interface.St_xHMI_Connected := FALSE;]]>
</Line>
<Line Number="2">
<![CDATA[	Core_HMI_CRS.Interface.St_iHMI_VitalityCheck := 0;]]>
</Line>
<Line Number="3">
<![CDATA[	//Core_HMI.Interface.sCurrentUserLogged := '';]]>
</Line>
<Line Number="4">
<![CDATA[	L_axPulse[1] := FALSE;]]>
</Line>
<Line Number="5">
<![CDATA[ELSE]]>
</Line>
<Line Number="6">
<![CDATA[    // Overflow protection]]>
</Line>
<Line Number="7">
<![CDATA[    IF Core_HMI_CRS.Interface.St_iHMI_VitalityCheck > 32760 THEN]]>
</Line>
<Line Number="8">
<![CDATA[        Core_HMI_CRS.Interface.St_iHMI_VitalityCheck := 20 + 1;]]>
</Line>
<Line Number="9">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="10">
<![CDATA[	]]>
</Line>
<Line Number="11">
<![CDATA[	IF BB_CRS.Clock_1000ms AND NOT L_axPulse[1] THEN]]>
</Line>
<Line Number="12">
<![CDATA[		L_axPulse[1] := TRUE;]]>
</Line>
<Line Number="13">
<![CDATA[		Core_HMI_CRS.Interface.St_iHMI_VitalityCheck := Core_HMI_CRS.Interface.St_iHMI_VitalityCheck + 1;	]]>
</Line>
<Line Number="14">
<![CDATA[        // Disconnected logic]]>
</Line>
<Line Number="15">
<![CDATA[        IF (Core_HMI_CRS.Interface.St_iHMI_VitalityCheck > 20) THEN]]>
</Line>
<Line Number="16">
<![CDATA[			Core_HMI_CRS.Interface.St_xHMI_Connected := FALSE;		]]>
</Line>
<Line Number="17">
<![CDATA[        	Core_HMI_CRS.Interface.Rq_xHMI_RunInit := (Core_HMI_CRS.Interface.St_iHMI_VitalityCheck MOD 10) = 0;]]>
</Line>
<Line Number="18">
<![CDATA[		ELSE]]>
</Line>
<Line Number="19">
<![CDATA[        	Core_HMI_CRS.Interface.Rq_xHMI_RunInit := FALSE;]]>
</Line>
<Line Number="20">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="21">
<![CDATA[	ELSIF NOT BB_CRS.Clock_1000ms AND L_axPulse[1] THEN]]>
</Line>
<Line Number="22">
<![CDATA[		L_axPulse[1] := FALSE;]]>
</Line>
<Line Number="23">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="24">
<![CDATA[	]]>
</Line>
<Line Number="25">
<![CDATA[	IF NOT Core_HMI_CRS.Interface.St_xHMI_Connected THEN]]>
</Line>
<Line Number="26">
<![CDATA[		ALRM_CRS[999] := TRUE;]]>
</Line>
<Line Number="27">
<![CDATA[	ELSE]]>
</Line>
<Line Number="28">
<![CDATA[		ALRM_CRS[999] := FALSE;]]>
</Line>
<Line Number="29">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="30">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="HMI_Visualization_MachineState" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//NOT READY]]>
</Line>
<Line Number="1">
<![CDATA[Core_HMI_CRS.Interface.St_iMachineStatus := 6;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// RESET STATE]]>
</Line>
<Line Number="4">
<![CDATA[If OM_Interface_CRS.xHmi_WrngRq_MachineResetAlarms then]]>
</Line>
<Line Number="5">
<![CDATA[	Core_HMI_CRS.Interface.St_iMachineStatus := 5;]]>
</Line>
<Line Number="6">
<![CDATA[end_if;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[// ALARM STATE]]>
</Line>
<Line Number="9">
<![CDATA[If OM_Interface_CRS.xHmi_WrngRq_MachineAlarms then]]>
</Line>
<Line Number="10">
<![CDATA[	Core_HMI_CRS.Interface.St_iMachineStatus := 0;]]>
</Line>
<Line Number="11">
<![CDATA[end_if;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[// READY STATE]]>
</Line>
<Line Number="14">
<![CDATA[If OM_Interface_CRS.xHmi_WrngRq_MachineReadyForAuto AND NOT OM_Interface_CRS.xHmi_WrngRq_MachineAutoCycle AND NOT BB_CRS.Manual_CmdEnable then]]>
</Line>
<Line Number="15">
<![CDATA[	Core_HMI_CRS.Interface.St_iMachineStatus := 1;]]>
</Line>
<Line Number="16">
<![CDATA[end_if;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[// AUTOMATIC STATE]]>
</Line>
<Line Number="19">
<![CDATA[If OM_Interface_CRS.xHmi_WrngRq_MachineReadyForAuto AND OM_Interface_CRS.xHmi_WrngRq_MachineAutoCycle AND OM_Interface_CRS.xHmi_WrngRq_MachineRunning AND NOT BB_CRS.Manual_CmdEnable then]]>
</Line>
<Line Number="20">
<![CDATA[	Core_HMI_CRS.Interface.St_iMachineStatus := 2;]]>
</Line>
<Line Number="21">
<![CDATA[end_if;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[// STANDBY - WAITING FOR PRODUCT STATE]]>
</Line>
<Line Number="24">
<![CDATA[If OM_Interface_CRS.xHmi_WrngRq_MachineReadyForAuto AND OM_Interface_CRS.xHmi_WrngRq_MachineAutoCycle AND NOT OM_Interface_CRS.xHmi_WrngRq_MachineRunning AND NOT BB_CRS.Manual_CmdEnable then]]>
</Line>
<Line Number="25">
<![CDATA[	Core_HMI_CRS.Interface.St_iMachineStatus := 3;]]>
</Line>
<Line Number="26">
<![CDATA[end_if;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[// MANUAL STATE]]>
</Line>
<Line Number="29">
<![CDATA[If BB_CRS.Manual_CmdEnable then]]>
</Line>
<Line Number="30">
<![CDATA[	Core_HMI_CRS.Interface.St_iMachineStatus := 4;]]>
</Line>
<Line Number="31">
<![CDATA[end_if;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
