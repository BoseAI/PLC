<Routine Name="PAL_DataBase_Management" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Pointer HMI position]]>
</Comment>
<Text>
<![CDATA[[XIC(BB.FirstScan) ,EQ(Core_HMI.Interface.iPageDisplayed,10) ONS(UM_Machine.axPTrig[41]) ]MOVE(PAL_WorkingProduct_Number,PAL_diAuxProductNumber);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[UPDATING DATABASE CONTINUOUS]]>
</Comment>
<Text>
<![CDATA[EQ(Core_HMI.Interface.iPageDisplayed,10)[MOVE(PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_CasePacker,SizeNumberCasepacker_select) ,COP(Size[SizeNumberCasepacker_select].Name,PAL_Products_DataBase[PAL_diAuxProductNumber].Name_CasePacker,1) COP(Size[SizeNumberCasepacker_select].WorkingCode,PAL_Products_DataBase[PAL_diAuxProductNumber].Code_CasePacker,1) ,MOVE(PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_Palletizer,SizeNumberPalletizer_select) ,COP(PAL_Size[SizeNumberPalletizer_select].Name,PAL_Products_DataBase[PAL_diAuxProductNumber].Name_Palletizer,1) COP(PAL_Size[SizeNumberPalletizer_select].WorkingCode,PAL_Products_DataBase[PAL_diAuxProductNumber].Code_Palletizer,1) ,MOVE(PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_CasePacker,UM_HMI.Machine.St_iSizeChange_NewSize_Number) ,MOVE(PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_Palletizer,UM_HMI.Pal.St_iSizeChange_NewSize_Number) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[RECALL SELECTED SIZE
STORAGE ON DB[0] THE STRUCTURE TO EDIT]]>
</Comment>
<Text>
<![CDATA[EQ(Core_HMI.Interface.iPageDisplayed,10)[COP(PAL_Products_DataBase[PAL_diAuxProductNumber].Name_Product,PAL_Products_DataBase[0].Name_Product,1) ,MOVE(PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_CasePacker,PAL_Products_DataBase[0].N_Size_CasePacker) MOVE(PAL_Products_DataBase[0].N_Size_CasePacker,SizeNumberCasepacker) ,MOVE(Size[SizeNumberCasepacker].WorkingCode,PAL_Products_DataBase[0].Code_CasePacker) ,MOVE(SizeNumberCasepacker,PAL_Products_DataBase[0].N_Size_CasePacker) ,COP(Size[SizeNumberCasepacker].Name,PAL_Products_DataBase[0].Name_CasePacker,1) ,MOVE(PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_Palletizer,PAL_Products_DataBase[0].N_Size_Palletizer) MOVE(PAL_Products_DataBase[0].N_Size_Palletizer,SizeNumberPalletizer) ,MOVE(PAL_Size[SizeNumberPalletizer].WorkingCode,PAL_Products_DataBase[0].Code_Palletizer) ,MOVE(SizeNumberPalletizer,PAL_Products_DataBase[0].N_Size_Palletizer) ,COP(PAL_Size[SizeNumberPalletizer].Name,PAL_Products_DataBase[0].Name_Palletizer,1) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[STORAGE DB[0] EDITED IN CORRECT POSITION ON DB]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Product.St_xSaveProductEdited)EQ(Core_HMI.Interface.iPageDisplayed,652)[MOVE(PAL_Products_DataBase[0].N_Size_CasePacker,SizeNumberCasepackerDB) MOVE(PAL_Products_DataBase[0].N_Size_Palletizer,SizeNumberPalletizerDB) ,LIMIT(1,PAL_Products_DataBase[0].N_Size_CasePacker,SizeAux[17]) LIMIT(1,PAL_Products_DataBase[0].N_Size_Palletizer,UM_Machine.PAL.iMaxNumberData) NE(Size[SizeNumberCasepackerDB].WorkingCode,L_EMPTYCODE) NE(PAL_Size[SizeNumberPalletizerDB].WorkingCode,L_EMPTYCODE) [COP(PAL_Products_DataBase[0].Name_Product,PAL_Products_DataBase[PAL_diAuxProductNumber].Name_Product,1) ,MOVE(PAL_Products_DataBase[0].N_Size_CasePacker,PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_CasePacker) COP(Size[SizeNumberCasepacker].WorkingCode,PAL_Products_DataBase[PAL_diAuxProductNumber].Code_CasePacker,1) COP(Size[SizeNumberCasepacker].Name,PAL_Products_DataBase[PAL_diAuxProductNumber].Name_CasePacker,1) ,MOVE(PAL_Products_DataBase[0].N_Size_Palletizer,PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_Palletizer) MOVE(PAL_Size[SizeNumberPalletizerDB].WorkingCode,PAL_Products_DataBase[PAL_diAuxProductNumber].Code_Palletizer) COP(PAL_Size[SizeNumberPalletizerDB].Name,PAL_Products_DataBase[PAL_diAuxProductNumber].Name_Palletizer,1) ,MOVE(640,Core_HMI.Interface.iPageToDisplay) ,OTU(UM_HMI.Product.St_xSaveProductEdited) ] ,[LIMIT(1,PAL_Products_DataBase[0].N_Size_CasePacker,SizeAux[17]) EQ(Size[SizeNumberCasepackerDB].WorkingCode,L_EMPTYCODE) ,LIMIT(1,PAL_Products_DataBase[0].N_Size_Palletizer,UM_Machine.PAL.iMaxNumberData) EQ(PAL_Size[SizeNumberPalletizerDB].WorkingCode,L_EMPTYCODE) ,LIMIT(SizeAux[17],PAL_Products_DataBase[0].N_Size_CasePacker,0) ,LIMIT(UM_Machine.PAL.iMaxNumberData,PAL_Products_DataBase[0].N_Size_Palletizer,0) ] OTL(MSG[13]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(UM_HMI.Product.St_xSaveProductEdited)NE(Core_HMI.Interface.iPageDisplayed,652)OTU(UM_HMI.Product.St_xSaveProductEdited);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[//////////////////////////////////////////////////////////////////////////////////////////////////
PRODUCT DELETING FROM DB PRODUCTS
///////////////////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[generate MSG10 Data archive access not allowed]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Product.Rq_xConfirm_SizeDelete)ONS(UM_Machine.axPTrig[42])EQ(Core_HMI.Interface.iPageDisplayed,651)EQ(PAL_diAuxProductNumber,PAL_WorkingProduct_Number)[OTL(MSG[12]) ,OTU(UM_HMI.Product.Rq_xConfirm_SizeDelete) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[PRODUCT DELETING FROM DB PRODUCTS]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Product.Rq_xConfirm_SizeDelete)ONS(UM_Machine.axPTrig[1])EQ(Core_HMI.Interface.iPageDisplayed,651)NE(PAL_diAuxProductNumber,PAL_WorkingProduct_Number)[COP(EmptySpaces,PAL_Products_DataBase[PAL_diAuxProductNumber].Name_Product,1) ,COP(EmptySpaces,PAL_Products_DataBase[PAL_diAuxProductNumber].Name_CasePacker,1) ,COP(EmptySpaces,PAL_Products_DataBase[PAL_diAuxProductNumber].Name_Palletizer,1) ,MOVE(0,PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_CasePacker) ,MOVE(0,PAL_Products_DataBase[PAL_diAuxProductNumber].N_Size_Palletizer) ,MOVE(L_EMPTYCODE,PAL_Products_DataBase[PAL_diAuxProductNumber].Code_CasePacker) ,MOVE(L_EMPTYCODE,PAL_Products_DataBase[PAL_diAuxProductNumber].Code_Palletizer) ,MOVE(640,Core_HMI.Interface.iPageToDisplay) ,OTL(UM_HMI.Product.St_xSizeDelete) ,OTU(UM_HMI.Product.Rq_xConfirm_SizeDelete) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(UM_HMI.Product.St_xSizeDelete)NE(Core_HMI.Interface.iPageDisplayed,651)OTU(UM_HMI.Product.St_xSizeDelete);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[MOVE(PAL_diAuxProductNumber,UM_HMI.Product.St_iActualDisplayedSize_Number) ,COP(PAL_Products_DataBase[PAL_diAuxProductNumber].Name_Product,UM_HMI.Product.St_sActualDisplayedSize_Name,1) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PAL_DataBase_SizeChange" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB.Count_EnableCheckOfResetCounts)XIO(BB.Count_GrtZero)OTU(BB.Count_EnableCheckOfResetCounts);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Size change conditions]]>
</Comment>
<Text>
<![CDATA[GT(PAL_diAuxProductNumber,0)GT(UM_HMI.Machine.St_iSizeChange_NewSize_Number,0)GT(UM_HMI.Pal.St_iSizeChange_NewSize_Number,0)XIO(BB.SizeDisplay_InProgress)XIO(BB.SizeSave_InProgress)XIO(BB.SizeCopy_InProgress)XIO(BB.SizeDelete_InProgress)XIO(BB.SizeChange_Inhibition)OTE(BB.SizeChange_ConditionsOk);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_Inhibition)OTU(BB.SizeChange_Inhibition);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Change size Rq]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Product.Rq_xConfirm_SizeChange)ONS(UM_Machine.axPTrig[24])[XIC(BB.SizeChange_ConditionsOk) OTE(BB.SizeChange_CheckDataRq) ,XIO(BB.SizeChange_ConditionsOk) OTL(MSG[8]) ,OTU(UM_HMI.Product.Rq_xConfirm_SizeChange) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Restore size change sequence]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_RestoreRq)[OTU(BB.SizeChange_InProgress) ,OTU(BB.SizeChange_DeviceSizeChangeRq) ,OTU(BB.SizeChange_RestoreRq) ,OTU(BB.SizeChange_OK) ,MOVE(0,UM_HMI.Machine.St_iSizeChange_NewSize_Number) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Increase pointer size change]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_PointerIncreaseRq)[ADD(1,SizeAux[2],SizeAux[2]) ,OTU(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[check data Rq]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_CheckDataRq)JSR(PAL_DataBase_SizeDataCheck,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(BB.SizeChange_OK) ,XIC(BB.SizeChange_RqAdjustmentDataTable) ]XIO(BB.SizeChange_InProgress)[OTU(BB.SetSize) ,OTL(BB.SizeChange_InProgress) ,OTL(UM_HMI.Machine.St_xSizeChange) ,OTU(BB.SizeChange_RqAdjustmentDataTable) ,[NE(UM_HMI.Machine.St_iSizeChange_NewSize_Number,UM_HMI.Machine.St_iActualWorkingSize_Number) ,NE(UM_HMI.Pal.St_iSizeChange_NewSize_Number,UM_HMI.Pal.St_iActualWorkingSize_Number) ] OTL(BB.Count_EnableCheckOfResetCounts) ,MOVE(1,SizeAux[2]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 1:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],1)OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 2:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],2)OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 3:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],3)MOVE(PAL_diAuxProductNumber,PAL_WorkingProduct_Number)[COP(Size[UM_HMI.Machine.St_iSizeChange_NewSize_Number],SizeWork,1) ,MOVE(SizeWork.WorkingCode,UM_HMI.Machine.St_sActualWorkingSize_Code) ,MOVE(SizeWork.Name,UM_HMI.Machine.St_sActualWorkingSize_Name) ,MOVE(UM_HMI.Machine.St_iSizeChange_NewSize_Number,UM_HMI.Machine.St_iActualWorkingSize_Number) ][COP(PAL_Size[UM_HMI.Pal.St_iSizeChange_NewSize_Number],PAL_SizeWork,1) ,MOVE(PAL_SizeWork.WorkingCode,UM_HMI.Pal.St_sActualWorkingSize_Code) ,MOVE(PAL_SizeWork.Name,UM_HMI.Pal.St_sActualWorkingSize_Name) ,MOVE(UM_HMI.Pal.St_iSizeChange_NewSize_Number,UM_HMI.Pal.St_iActualWorkingSize_Number) ]MOVE(PAL_Products_DataBase[0].Name_Product,UM_HMI.Product.St_sActualWorkingSize_Name)MOVE(PAL_diAuxProductNumber,UM_HMI.Product.St_iActualWorkingSize_Number)OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 4:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],4)[MOVE(0,UM_Machine.iDevice_Total) ,MOVE(0,UM_Machine.iDevice_Ok) ,MOVE(0,UM_Machine.iDevice_Bad) ][OTL(BB.SizeChange_Rq) ,OTL(BB.SizeChange_DeviceSizeChangeRq) ,OTL(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Step 5:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],5)[XIC(BB.SizeChange_DataTransferFromAxisOk) ,XIO(UM_Config.Core.Enable_SchneiderAxis) ]OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Step 6:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],6)CMP(UM_Machine.iDevice_Ok+UM_Machine.iDevice_Bad=UM_Machine.iDevice_Total)[OTU(BB.SizeChange_Rq) ,OTL(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)XIC(BB.SizeChange_Rq)EQ(SizeAux[2],6)[MOVE(0,UM_Machine.iDevice_Total) ,MOVE(0,UM_Machine.iDevice_Ok) ,MOVE(0,UM_Machine.iDevice_Bad) ];]]>
