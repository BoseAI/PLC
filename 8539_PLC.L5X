<![CDATA[XIC(YV_Trap.q_xCmdON)[,TON(TON_DelayTrapActuationON,?,?) ]XIC(TON_DelayTrapActuationON.DN)OTE(YV_Trap.i_xSensorON);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(YV_Trap.q_xCmdOFF)[,TON(TON_DelayTrapActuationOFF,?,?) ]XIC(TON_DelayTrapActuationOFF.DN)OTE(YV_Trap.i_xSensorOFF);]]>
