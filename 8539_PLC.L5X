<![CDATA[					St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="462">
<![CDATA[                    St_iFSM_ActualState := RUNNING;]]>
</Line>
<Line Number="463">
<![CDATA[				END_IF;]]>
</Line>
<Line Number="464">
<![CDATA[				]]>
</Line>
<Line Number="465">
<![CDATA[   				IF IQ_St_xHMI_BatchStart_Ok AND (NOT I_Rq_xScada_Restart) AND]]>
</Line>
<Line Number="466">
<![CDATA[					(I_Rq_xScada_Hold) AND ]]>
</Line>
<Line Number="467">
<![CDATA[                    (NOT I_Rq_xScada_Stop) AND]]>
</Line>
<Line Number="468">
<![CDATA[                    (NOT I_Rq_xScada_Abort) THEN]]>
</Line>
<Line Number="469">
<![CDATA[                    St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="470">
<![CDATA[                    St_iFSM_ActualState := HOLDING;]]>
</Line>
<Line Number="471">
<![CDATA[					]]>
</Line>
<Line Number="472">
<![CDATA[                ELSIF IQ_St_xHMI_BatchStart_Ok AND (NOT I_Rq_xScada_Restart) AND]]>
</Line>
<Line Number="473">
<![CDATA[					(NOT I_Rq_xScada_Hold) AND ]]>
</Line>
<Line Number="474">
<![CDATA[                    (I_Rq_xScada_Stop) AND]]>
</Line>
<Line Number="475">
<![CDATA[                    (NOT I_Rq_xScada_Abort) THEN]]>
</Line>
<Line Number="476">
<![CDATA[                    St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="477">
<![CDATA[                    St_iFSM_ActualState := STOPPING;]]>
</Line>
<Line Number="478">
<![CDATA[                    ]]>
</Line>
<Line Number="479">
<![CDATA[                ELSIF IQ_St_xHMI_BatchStart_Ok AND (NOT I_Rq_xScada_Restart) AND]]>
</Line>
<Line Number="480">
<![CDATA[					(NOT I_Rq_xScada_Hold) AND ]]>
</Line>
<Line Number="481">
<![CDATA[                    (NOT I_Rq_xScada_Stop) AND]]>
</Line>
<Line Number="482">
<![CDATA[                    (I_Rq_xScada_Abort) THEN]]>
</Line>
<Line Number="483">
<![CDATA[                    St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="484">
<![CDATA[                    St_iFSM_ActualState := ABORTING;]]>
</Line>
<Line Number="485">
<![CDATA[                END_IF;]]>
</Line>
<Line Number="486">
<![CDATA[				]]>
</Line>
<Line Number="487">
<![CDATA[				]]>
</Line>
<Line Number="488">
<![CDATA[            199:	//ABORTING]]>
</Line>
<Line Number="489">
<![CDATA[                St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="490">
<![CDATA[                St_iFSM_ActualState := ABORTED;]]>
</Line>
<Line Number="491">
<![CDATA[                ]]>
</Line>
<Line Number="492">
<![CDATA[                ]]>
</Line>
<Line Number="493">
<![CDATA[            200: 	//ABORTED ]]>
</Line>
<Line Number="494">
<![CDATA[                //St_Scada_BatchStart := FALSE;]]>
</Line>
<Line Number="495">
<![CDATA[                //IQ_strBatchData_ToBeSet_HMI := strBatchData_Clear;]]>
</Line>
<Line Number="496">
<![CDATA[                //IQ_strBatchData_Current_HMI := strBatchData_Clear;]]>
</Line>
<Line Number="497">
<![CDATA[                //IQ_strBatchData_Current := IQ_strBatchData_Current_HMI;]]>
</Line>
<Line Number="498">
<![CDATA[				]]>
</Line>
<Line Number="499">
<![CDATA[				CPS(strBatchData_Clear, IQ_strBatchData_ToBeSet_HMI, 1);]]>
</Line>
<Line Number="500">
<![CDATA[				CPS(strBatchData_Clear, IQ_strBatchData_Current_HMI, 1);]]>
</Line>
<Line Number="501">
<![CDATA[				CPS(strBatchData_Clear, IQ_strBatchData_Current, 1);]]>
</Line>
<Line Number="502">
<![CDATA[				]]>
</Line>
<Line Number="503">
<![CDATA[                IF I_Rq_xScada_Abort_SignalEnable AND I_Rq_xScada_Abort THEN]]>
</Line>
<Line Number="504">
<![CDATA[                    Q_St_xALRM_AbortFromRemote := TRUE;]]>
</Line>
<Line Number="505">
<![CDATA[                END_IF;]]>
</Line>
<Line Number="506">
<![CDATA[                ]]>
</Line>
<Line Number="507">
<![CDATA[                IF (I_Rq_xScada_ResetFromAbort AND I_Rq_xScada_ResetFromAbort_SignalEnable) OR]]>
</Line>
<Line Number="508">
<![CDATA[                    NOT I_Rq_xScada_ResetFromAbort_SignalEnable THEN]]>
</Line>
<Line Number="509">
<![CDATA[                    ]]>
</Line>
<Line Number="510">
<![CDATA[                    St_iFSM_PreviousState := St_iFSM_ActualState;]]>
</Line>
<Line Number="511">
<![CDATA[                    St_iFSM_ActualState := IDLE;]]>
</Line>
<Line Number="512">
<![CDATA[                END_IF;]]>
</Line>
<Line Number="513">
<![CDATA[		]]>
</Line>
<Line Number="514">
<![CDATA[		END_CASE;]]>
</Line>
<Line Number="515">
<![CDATA[	]]>
</Line>
<Line Number="516">
<![CDATA[	ELSE]]>
</Line>
<Line Number="517">
<![CDATA[		IF (IQ_St_iHMI_FormatCheck_RetVal = 4) OR]]>
</Line>
<Line Number="518">
<![CDATA[          (IQ_St_iHMI_FormatCheck_RetVal = 12) THEN]]>
</Line>
<Line Number="519">
<![CDATA[         	IQ_St_iHMI_FormatCheck_RetVal := 0;]]>
</Line>
<Line Number="520">
<![CDATA[      	END_IF;]]>
</Line>
<Line Number="521">
<![CDATA[		]]>
</Line>
<Line Number="522">
<![CDATA[    	IF IQ_Rq_xHMI_AbortFormatChange THEN]]>
</Line>
<Line Number="523">
<![CDATA[         	IQ_Rq_xHMI_AbortFormatChange := FALSE;]]>
</Line>
<Line Number="524">
<![CDATA[      	END_IF;]]>
</Line>
<Line Number="525">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="526">
<![CDATA[	]]>
</Line>
<Line Number="527">
<![CDATA[	IQ_strBatchData_Current_HMI.sRecipeName := IQ_strBatchData_Current.sRecipeName;]]>
</Line>
<Line Number="528">
<![CDATA[	]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
