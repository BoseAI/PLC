</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[//Clean up Cam Point Array to prevent error]]>
</Line>
<Line Number="9">
<![CDATA[SIZE(EM_CaseP.CIP_CasePickup.Cam_Data,0,EM_CaseP.CIP_CasePickup.Cam_diArraySize);]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[FOR EM_CaseP.CIP_CasePickup.Cam_index:=0 TO (EM_CaseP.CIP_CasePickup.Cam_diArraySize-1) BY 1 DO]]>
</Line>
<Line Number="12">
<![CDATA[	]]>
</Line>
<Line Number="13">
<![CDATA[	EM_CaseP.CIP_CasePickup.Cam_Data[EM_CaseP.CIP_CasePickup.Cam_index].Master_Position			:=		0;]]>
</Line>
<Line Number="14">
<![CDATA[	EM_CaseP.CIP_CasePickup.Cam_Data[EM_CaseP.CIP_CasePickup.Cam_index].Slave_Position			:=		0;]]>
</Line>
<Line Number="15">
<![CDATA[	EM_CaseP.CIP_CasePickup.Cam_Data[EM_CaseP.CIP_CasePickup.Cam_index].Slave_Velocity			:=		0;									]]>
</Line>
<Line Number="16">
<![CDATA[	EM_CaseP.CIP_CasePickup.Cam_Data[EM_CaseP.CIP_CasePickup.Cam_index].Slave_Acceleration		:=		0;]]>
</Line>
<Line Number="17">
<![CDATA[	EM_CaseP.CIP_CasePickup.Cam_Data[EM_CaseP.CIP_CasePickup.Cam_index].Slave_Jerk				:=		0;]]>
</Line>
<Line Number="18">
<![CDATA[	EM_CaseP.CIP_CasePickup.Cam_Data[EM_CaseP.CIP_CasePickup.Cam_index].SegmentType				:=		0;]]>
</Line>
<Line Number="19">
<![CDATA[	EM_CaseP.CIP_CasePickup.Cam_Data[EM_CaseP.CIP_CasePickup.Cam_index].Steps						:=		0;]]>
</Line>
<Line Number="20">
<![CDATA[	]]>
</Line>
<Line Number="21">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[//]]>
</Line>
<Line Number="24">
<![CDATA[//	SegmentType		0=Linear, 		1=Cubic, 			2=5th Order, 		3=7th Order, 	4=9th Order, 	5=Elliptical and Simple Harmonic, ]]>
</Line>
<Line Number="25">
