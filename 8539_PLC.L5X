<Routine Name="Main_PalChange_T102" Type="RLL">
<Description>
<![CDATA[v0.1        : 21.02.2023
Author      : Ing.Utili Nicola
Comment: Startup from base cph2 V142]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB.FirstScan)FLL(0,EM_PalChange,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(BB.Machine_Ready) ,XIC(EM_PalChange.xEnableWithoutImmediateStop) ]XIO(OM_ShiftPalChange.xSt_ImmediateStop)OTE(EM_PalChange.xEnableWithoutImmediateStop);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Warining message: Restore pallet magazine barrier]]>
</Comment>
<Text>
<![CDATA[XIO(IN.B7810_01)XIC(EM_PalChange_Hmi_PB.Rq_xManual_Cycle)[OTL(WRNG[68]) ,OTU(EM_PalChange_Hmi_PB.Rq_xManual_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Service message: Manual functions off]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PalChange_Hmi_PB.Rq_xManual_Cycle)XIO(BB.Manual_CmdEnable)[OTL(MSG[18]) ,OTU(EM_PalChange_Hmi_PB.Rq_xManual_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Service message: perform Robot Homing]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PalChange_Hmi_PB.Rq_xManual_Cycle)XIC(BB.Manual_CmdEnable)XIO(DB_Pal_RobotIO.DO.x70)[OTL(MSG[77]) ,OTU(EM_PalChange_Hmi_PB.Rq_xManual_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(CM_YV_RolPalLiftingInfeed.q_xOFF)XIC(CM_YV_RolPalLiftingOutfeed.q_xOFF)OTE(OM_Interface.PalChange_xPneumLowPos);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
