<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(iq_DB_Encoder_I.ConnectionFaulted)OTE(q_xAlrmNode);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[// Converto il numero di impulsi => giro encoder => mm
//                           8192          =>       1           =>  1    
// 8192 impulse = 360° = 1 mm
]]>
</Comment>
<Text>
<![CDATA[[GT(iq_DB_Encoder_I.Data[0],83888608) OR(iq_DB_Encoder_I.Data[0],16#FF000000,diEncoderPosImpulse) ,LE(iq_DB_Encoder_I.Data[0],83888608) MOVE(iq_DB_Encoder_I.Data[0],diEncoderPosImpulse) ,OTU(iq_DB_Encoder_C.Direction_Counting_Toggle_12) ,NE(i_rFeedCostant,0) [DIV(diEncoderPosImpulse,i_rFeedCostant,iq_CM_Encoder.lrActualPos) ,DIV(iq_DB_Encoder_I.Data[1],i_rFeedCostant,iq_CM_Encoder.lrActualSpeed) ABS(iq_CM_Encoder.lrActualSpeed,diAbsActualSpeed) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(iq_xRqZeroEnc)[GT(diAbsActualSpeed,i_diDeltaSpeedForResetCount) ,XIC(iq_DB_Encoder_I.ConnectionFaulted) ][OTL(iq_xMsgFunctionNotAllowed) ,OTU(iq_xRqZeroEnc) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[MUL(i_rPresetValueUnit,i_rFeedCostant,diPresetValueAux) ,LT(diPresetValueAux,0) AND(diPresetValueAux,16#7FFFFFF,diPresetValueAux1) ,GE(diPresetValueAux,0) MOVE(diPresetValueAux,diPresetValueAux1) ,MOVE(diPresetValueAux1,iq_CM_Encoder.diEncPresetValue) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(iq_xRqZeroEnc) [MOVE(0,iq_PresetMessage.Flags) MOVE(0,iq_PresetMessage1.Flags) ,MSG(iq_PresetMessage) ,OTU(iq_xRqZeroEnc) ] ,XIC(iq_PresetMessage.DN) ONS(PulseFP[0]) MOVE(64,iq_CM_Encoder.SaveParEnc) MSG(iq_PresetMessage1) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(iq_PresetMessage.ER) ,XIC(iq_PresetMessage1.ER) ][OTE(q_xAlrmEncoder) ,MOVE(0,iq_PresetMessage.Flags) MOVE(0,iq_PresetMessage1.Flags) ,OTU(iq_xRqZeroEnc) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
