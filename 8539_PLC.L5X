<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[MOVE(I_ActualPos,L_ActualPos) ,GE(I_ActualPos,I_PosUnwind) SUB(I_ActualPos,I_PosUnwind,L_ActualPos) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[SUB(I_PositionCam,I_PosRange,L_PosLowLimit) ,ADD(I_PositionCam,I_PosRange,L_PosHighLimit) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[LT(L_PosLowLimit,0)ADD(L_PosLowLimit,I_PosUnwind,L_PosLowLimit);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GE(L_PosHighLimit,I_PosUnwind)SUB(L_PosHighLimit,I_PosUnwind,L_PosHighLimit);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[LT(L_PosLowLimit,L_PosHighLimit) GE(L_ActualPos,L_PosLowLimit) LE(L_ActualPos,L_PosHighLimit) ,GT(L_PosLowLimit,L_PosHighLimit) [GE(L_ActualPos,L_PosLowLimit) ,LE(L_ActualPos,L_PosHighLimit) ] ]OTE(O_PosOk);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AOI_CAMM" Class="Standard" Revision="3.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-07-17T15:04:34.691Z" CreatedBy="Not Available" EditedDate="2022-07-22T12:01:25.348Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v32.01"
>
<Description>
<![CDATA[CAM MultiSelect]]>
</Description>
<RevisionNote>
<![CDATA[2. Added output parameters for MCCP instruction
3. Added Double Harmonic, Modified Sine, Modified Trapazoid, and broaden Simple Harmonic to include Elliptical

v1.0        : 
22.07.2022
Author      : 
Ing.Utili Nicola
Comment : from 7903_CPV20 ]]>
</RevisionNote>
