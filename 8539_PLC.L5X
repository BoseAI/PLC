<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[CALC POS]]>
</Comment>
<Text>
<![CDATA[OTU(x_Bit0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(500,IEC_TimerDelayCmdBck.PRE)MOVE(500,IEC_TimerDelayCmdFwd.PRE)MOVE(i_TON_Timeout,TON_TimeOutMoving.PRE);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(i_xEnable)[XIC(i_xMot_Safety) ,XIC(i_xDisableAlrmSafety) ]XIC(i_xDelayEmergency)OTE(xCmdEnable);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(i_iTargetPosition,lrTargetPosition)MOVE(i_rPosWindow,lrWindowPos)MOVE(i_iTargetPosWindSlowdwn,lrTargetPosWindSlowdwn);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[ADD(lrTargetPosition,lrWindowPos,lrUpperWindow);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[SUB(lrTargetPosition,lrWindowPos,lrLowerWindow);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[SUB(lrTargetPosition,lrTargetPosWindSlowdwn,lrUpperPosSlowdwn);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[ADD(lrTargetPosition,lrTargetPosWindSlowdwn,lrLowerPosSlowdwn);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[LIMIT(lrLowerWindow,iq_CM_Encoder.lrActualPos,lrUpperWindow)OTE(q_xInPosition);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[CMD SIGNAL]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(x_Bit0)[OTU(xCommand) ,OTU(xReverseDir) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(xCmdEnable)XIO(iq_xRqJogFwd)XIO(iq_xRqJogBck)[XIC(iq_xRqStartCommand) XIO(i_xJogEnable) ,XIC(iq_xRqJogInPath) ]XIO(q_xInPosition)[OTL(xCommand) ,GE(iq_CM_Encoder.lrActualPos,lrTargetPosition) OTL(xReverseDir) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(xCmdEnable)[XIC(iq_xRqJogFwd) ,XIC(iq_xRqJogBck) ]OTL(xCommand);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(xCmdEnable)XIC(iq_xRqJogBck)OTL(xReverseDir);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIC(xCommand) [XIO(xReverseDir) GE(iq_CM_Encoder.lrActualPos,lrUpperPosSlowdwn) ,XIC(xReverseDir) LE(iq_CM_Encoder.lrActualPos,lrLowerPosSlowdwn) ] ,XIC(iq_xRqJogInPath) XIO(q_xInPosition) ,XIC(iq_xRqJogFwd) ,XIC(iq_xRqJogBck) ]OTE(xRqSlowdownSpeed);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIO(xRqSlowdownSpeed) MOVE(i_iSpeed,q_iInverterCmdSpeed) ,XIC(xRqSlowdownSpeed) MOVE(i_iSlowdownSpeed,q_iInverterCmdSpeed) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(xCommand)XIO(xReverseDir)XIO(IEC_TimerDelayCmdBck.DN)[OTE(q_xMovingFwd) ,TOF(IEC_TimerDelayCmdFwd,?,?) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(xCommand)XIC(xReverseDir)XIO(IEC_TimerDelayCmdFwd.DN)[OTE(q_xMovingBck) ,TOF(IEC_TimerDelayCmdBck,?,?) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(xCommand)[XIC(q_xMovingFwd) ,XIC(q_xMovingBck) ][LE(iq_CM_Encoder.lrActualPos,i_rUpperLimit) ,XIC(iq_xRqJogBck) ,XIC(q_xMovingBck) ][GE(iq_CM_Encoder.lrActualPos,i_rLowerLimit) ,XIC(iq_xRqJogFwd) ,XIC(q_xMovingFwd) ]OTE(q_xCommand);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(xReverseDir)XIC(q_xMovingBck)OTE(q_xReverseDir);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[ALRM]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIO(i_xMot_Safety)XIO(i_xDisableAlrmSafety)[OTE(q_xSafetyAlrm) ,OTL(iq_xSelStopType) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[MOVE(i_iDeltaError_Speed,lrDeltaError_Speed);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[ABS(iq_CM_Encoder.lrActualSpeed,lrABS_Speed);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[[XIC(q_xMovingFwd) ,XIC(q_xMovingBck) ,XIC(i_xCheckEncMoving) ]LE(lrABS_Speed,lrDeltaError_Speed)XIO(i_xExclusionTimeout)TON(TON_TimeOutMoving,?,?);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(TON_TimeOutMoving.DN)[OTE(q_xTimeOutMovingAlrm) ,OTL(iq_xSelStopType) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIO(x_Bit0)[OTU(iq_xRqJogInPath) ,OTU(iq_xRqJogBck) ,OTU(iq_xRqJogFwd) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
