<Routines>
<Routine Name="CM_PFlex525_LineBelt" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(EM_Outfeed.xAutoCycle) [XIC(IN_CRS.B9680_01) ,XIC(BB_CRS.NoLoadRun_Enable) ,ONS(EM_Outfeed.axPTrig[0]) ] ,EQ(OM_Interface_CRS.Infeed_iDebuffering_SeqChange,60) ,XIO(BB_CRS.Outfeed_Inhibition) [XIO(BB_CRS.NoLoadRun_Enable) XIC(IN_CRS.B9680_01) ,ONS(EM_Outfeed.axPTrig[1]) ] ][MOVE(SizeWork_CRS.Outfeed.LineBeltStopTime,EM_Outfeed.TOF_LineBeltStop.PRE) ,TOF(EM_Outfeed.TOF_LineBeltStop,?,?) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Automatic_CycleActive)XIO(EM_Outfeed.TOF_LineBeltStop.DN)OTL(BB_CRS.WrngRq_PackingMatOutCondition);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(EM_Outfeed.TOF_LineBeltStop.DN) XIO(EM_Outfeed.xSt_ImmediateStop) ,XIC(BB_CRS.NoLoadRun_Enable) XIC(EM_Outfeed.xAutoCycle) XIO(BB_CRS.Manual_CmdEnable) ]OTE(EM_Outfeed.xLinedBelt_AutomaticCycle);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[############################
MANUAL
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Manual_CmdEnable)XIO(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Forward)XIO(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Backward)[XIC(EM_Outfeed_HMI_PB_CRS.Rq_xManual_Belt_Forward) [OTL(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Forward) ,OTU(EM_Outfeed_HMI_PB_CRS.Rq_xManual_Belt_Forward) ] ,XIC(EM_Outfeed_HMI_PB_CRS.Rq_xManual_Belt_Backward) [OTL(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Backward) ,OTU(EM_Outfeed_HMI_PB_CRS.Rq_xManual_Belt_Backward) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(EM_Outfeed_HMI_PB_CRS.Rq_xManual_Belt_Forward) XIC(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Forward) ,XIC(EM_Outfeed_HMI_PB_CRS.Rq_xManual_Belt_Backward) XIC(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Backward) ,XIO(BB_CRS.Manual_CmdEnable) ,XIC(EM_Outfeed_HMI_PB_CRS.St_xManual_Cycle) ,XIC(EM_Outfeed.xSt_ImmediateStop) ,XIC(BB_CRS.Automatic_CycleActive) ][OTU(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Forward) ,OTU(EM_Outfeed_HMI_PB_CRS.Rq_xManual_Belt_Forward) ,OTU(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Backward) ,OTU(EM_Outfeed_HMI_PB_CRS.Rq_xManual_Belt_Backward) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[LINE BELTS START REQUEST
(before reset and after check the condition)]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[GSV(Module,T9680_CRS_LineBelt,EntryStatus,xLineBelt_EntryStatus_PFlex525) MEQ(xLineBelt_EntryStatus_PFlex525,61440,16384) OTE(xLineBelt_Network_OK) ,XIO(BB_CRS.FirstScan) MOVE(Timers_CRS.N[291].PRE,TON_DelayTimeSwitchOn_LineBelt.PRE) TON(TON_DelayTimeSwitchOn_LineBelt,?,?) ,XIC(TON_DelayTimeSwitchOn_LineBelt.DN) XIO(xLineBelt_Network_OK) OTE(ALRM_CRS[282]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[############################
DIRECTION CONFIGURATION
############################]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Backward)OTE(EM_Outfeed.CM_LineBelt.Inverter_xReverseDirection);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[EQ(OM_Interface_CRS.Infeed_iDebuffering_SeqChange,50) ,XIC(EM_Outfeed.xSt_ImmediateStop) XIC(BB_CRS.AlwaysOFF) ,XIO(EM_Outfeed.TOF_LineBeltStop.DN) ,XIC(BB_CRS.Outfeed_Inhibition) XIO(BB_CRS.NoLoadRun_Enable) ]OTL(OM_Interface_CRS.xOutfeed_Inhibition_LineBelt);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(OM_Interface_CRS.xLineBeltInverterIN_xForward_Rq)[OTL(EM_Outfeed.CM_LineBelt.InverterIN_xForward_Rq) ,OTU(OM_Interface_CRS.xLineBeltInverterIN_xForward_Rq) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[############################
START FORWARD REQUEST
- MANUAL -
############################]]>
</Comment>
<Text>
<![CDATA[[XIC(BB_CRS.Automatic_CycleActive) XIO(OM_Interface_CRS.xOutfeed_Inhibition_LineBelt) ,XIC(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Forward) ,XIC(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Backward) ][OTL(EM_Outfeed.CM_LineBelt.Inverter_xCommand) ,OTU(EM_Outfeed.CM_LineBelt.InverterIN_xForward_Rq) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Automatic_CycleActive)TOF(Timers_CRS.N[31],?,?);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[############################
CLEAR
############################]]>
</Comment>
<Text>
<![CDATA[[XIO(Safety_EMERG_Enable_CRS) ,XIC(BB_CRS.Manual_CmdEnable) XIO(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Forward) XIO(EM_Outfeed_HMI_PB_CRS.St_xManual_Belt_Backward) ,XIO(IN_CRS.K9682_01) ,XIO(BB_CRS.Manual_CmdEnable) [XIO(Timers_CRS.N[31].DN) ,XIC(OM_Interface_CRS.xOutfeed_Inhibition_LineBelt) ] ]OTU(EM_Outfeed.CM_LineBelt.Inverter_xCommand);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(IN_CRS.B9680_02)TON(Timers_CRS.N[9],?,?);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[DIV(SYS_CRS.N[303],100,rLineBelt_rSpeedAt50Hz)[LT(OM_Interface_CRS.Infeed_iMachineState,3) MOVE(SizeWork_CRS.Outfeed.LineBeltWorkSpeed,EM_Outfeed.CM_LineBelt.InverterIN_diWorkSpeed) ,EQ(OM_Interface_CRS.Infeed_iMachineState,3) MOVE(SizeWork_CRS.Outfeed.LineBeltWorkSpeedDebuff,EM_Outfeed.CM_LineBelt.InverterIN_diWorkSpeed) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[GT(EM_Outfeed.CM_LineBelt.InverterIN_diWorkSpeed,SizeMax_CRS.Outfeed.LineBeltWorkSpeed) MOVE(SizeMax_CRS.Outfeed.LineBeltWorkSpeed,EM_Outfeed.CM_LineBelt.InverterIN_diWorkSpeed) ,LT(EM_Outfeed.CM_LineBelt.InverterIN_diWorkSpeed,SizeMin_CRS.Outfeed.LineBeltWorkSpeed) MOVE(SizeMin_CRS.Outfeed.LineBeltWorkSpeed,EM_Outfeed.CM_LineBelt.InverterIN_diWorkSpeed) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[! ! ! ! ! ! ! ! ! ATTENTION ! ! ! ! ! ! ! ! !

REMEMBER TO SET THE VALUE OF ACC, DEC, MIN AND MAX OUTPUT FREQUENCY IN THE INVERTER PARAMETERS

! ! ! ! ! ! ! ! ! ATTENTION ! ! ! ! ! ! ! ! !
]]>
</Comment>
<Text>
<![CDATA[PowerFlex525(DB_PFlex525_LineBelt,1,xLineBelt_Network_OK,Timers_CRS.N[12].DN,rLineBelt_rSpeedAt50Hz,BB_CRS.EMF_ON,80,20,EM_Outfeed.CM_LineBelt,BB_CRS,T9680_CRS_LineBelt:I,T9680_CRS_LineBelt:O,SizeMax_CRS.Outfeed.LineBeltWorkSpeed,SizeMin_CRS.Outfeed.LineBeltWorkSpeed,ALRM_CRS[283]);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[MOVE(SizeMin_CRS.Outfeed.LineBeltWorkSpeed,SizeMin_CRS.Outfeed.LineBeltWorkSpeedDebuff)MOVE(SizeMax_CRS.Outfeed.LineBeltWorkSpeed,SizeMax_CRS.Outfeed.LineBeltWorkSpeedDebuff);]]>
</Text>
</Rung>
