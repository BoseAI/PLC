<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(I_Enable)XIC(I_EMF_ON)[TON(Ton_EFM_on,?,?) ,XIC(Ton_EFM_on.DN) ONS(Edge) TOF(Tof_ResetFault,?,?) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CPT(ConversionFactor,(50/I_Speed_50Hz)*100);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MUL(I_Speed_50Hz,2,MaxSpeed);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(iq_CM.InverterIN_diWorkSpeed,iq_CM.PFlex_525.xSpeed);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[LT(iq_CM.PFlex_525.xSpeed,0) MOVE(0,iq_CM.PFlex_525.xSpeed) ,GE(iq_CM.PFlex_525.xSpeed,MaxSpeed) MOVE(MaxSpeed,iq_CM.PFlex_525.xSpeed) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CMD SIGNAL]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(iq_BB.Alarm_ResetRqPulse)OTE(iq_CM.PFlex_525.xReset_Fault);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(iq_CM.Inverter_xCommand)XIO(iq_CM.Inverter_xReverseDirection)[OTL(iq_CM.PFlex_525.xRq_Run) ,OTL(iq_CM.PFlex_525.xDirection) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(iq_CM.Inverter_xCommand)XIC(iq_CM.Inverter_xReverseDirection)[OTL(iq_CM.PFlex_525.xRq_Run) ,OTU(iq_CM.PFlex_525.xDirection) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Speed reference selection]]>
</Comment>
<Text>
<![CDATA[XIC(I_Enable)[XIC(I_EMF_ON) XIC(iq_PFlex525_In.Ready) XIC(I_NetworkOk) OTE(iq_CM.PFlex_525.xReady) ,XIO(iq_PFlex525_In.Ready) OTE(iq_CM.PFlex_525.xAlarm) ,XIC(iq_CM.PFlex_525.xRq_Run) XIC(iq_CM.PFlex_525.xReady) XIO(iq_PFlex525_Out.Stop) OTE(iq_PFlex525_Out.Start) ,XIO(iq_CM.PFlex_525.xRq_Run) OTE(iq_PFlex525_Out.Stop) ,[XIO(iq_CM.PFlex_525.xRq_Run_Backward) XIC(iq_CM.PFlex_525.xRq_Run_Forward) ,XIO(iq_CM.PFlex_525.xRq_Run_Backward) XIO(iq_CM.PFlex_525.xRq_Run_Forward) XIO(iq_CM.PFlex_525.xDirection) ] OTE(iq_PFlex525_Out.Forward) ,XIO(iq_PFlex525_Out.Forward) OTE(iq_PFlex525_Out.Reverse) ,MUL(iq_CM.PFlex_525.xSpeed,ConversionFactor,iq_PFlex525_Out.FreqCommand) ,MUL(i_iMinSpeed_Hz,100,iMinSpeed_Hz) LT(iq_PFlex525_Out.FreqCommand,iMinSpeed_Hz) MOVE(iMinSpeed_Hz,iq_PFlex525_Out.FreqCommand) ,MUL(i_iMaxSpeed_Hz,100,iMaxSpeed_Hz) GT(iq_PFlex525_Out.FreqCommand,iMaxSpeed_Hz) MOVE(iMaxSpeed_Hz,iq_PFlex525_Out.FreqCommand) ,XIC(iq_PFlex525_In.Faulted) XIC(I_EnableCheckFault) XIC(Ton_EFM_on.DN) XIO(Tof_ResetFault.DN) OTE(iq_CM.PFlex_525.xFaults) ,XIC(iq_CM.PFlex_525.xReady) XIC(iq_PFlex525_In.Active) XIC(iq_PFlex525_Out.Start) OTE(iq_CM.PFlex_525.xActive) ,[XIC(iq_CM.PFlex_525.xReset_Fault) ,XIC(Tof_ResetFault.DN) ] XIC(iq_PFlex525_In.Faulted) OTE(iq_PFlex525_Out.ClearFaults) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(iq_CM.PFlex_525.xFaults)OTE(q_xAlrm);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[DIV(iMaxSpeed_Hz,ConversionFactor,q_iMaxSpeedValue);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[DIV(iMinSpeed_Hz,ConversionFactor,q_iMinSpeedValue);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[OTU(iq_CM.PFlex_525.xRq_Run_Forward)OTU(iq_CM.PFlex_525.xRq_Run_Backward)OTU(iq_CM.PFlex_525.xDirection)OTU(iq_CM.PFlex_525.xRq_Run)OTU(iq_CM.PFlex_525.xRun_Inhibition);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
