</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[GE(iq_CM_Encoder.lrActualPos,lrForwardPos_Advance)OTE(iq_CM_Inverter.InverterOUT_xInForwardPos);]]>
