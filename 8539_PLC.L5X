</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[//REMOTE 9 (K9660_04)]]>
</Line>
<Line Number="21">
<![CDATA[IN_CRS.B9687_02			:=	K9605_01:I.Data[9].0;]]>
</Line>
<Line Number="22">
<![CDATA[IN_CRS.B9688_03			:=	K9605_01:I.Data[9].1;]]>
</Line>
<Line Number="23">
<![CDATA[IN_CRS.B9688_02			:=	K9605_01:I.Data[9].2;]]>
</Line>
<Line Number="24">
<![CDATA[IN_CRS.B9688_01			:=	K9605_01:I.Data[9].3;]]>
</Line>
<Line Number="25">
<![CDATA[IN_CRS.B9687_03			:=	K9605_01:I.Data[9].4;]]>
</Line>
<Line Number="26">
<![CDATA[//IN_CRS.B9695_02			:=	K9605_01:I.Data[9].5;]]>
</Line>
<Line Number="27">
<![CDATA[IN_CRS.B9695_03			:=	K9605_01:I.Data[9].6;]]>
</Line>
<Line Number="28">
<![CDATA[IN_CRS.K9690_01			:=	K9605_01:I.Data[9].7;]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[//REMOTE 10 (K9660_05)]]>
</Line>
<Line Number="31">
<![CDATA[IN_CRS.B9680_01			:=	K9605_01:I.Data[10].0;]]>
</Line>
<Line Number="32">
<![CDATA[//IN_CRS.B9684_01			:=	K9605_01:I.Data[10].1;]]>
</Line>
<Line Number="33">
<![CDATA[IN_CRS.B9684_02			:=	K9605_01:I.Data[10].2;]]>
</Line>
<Line Number="34">
<![CDATA[IN_CRS.B9405_01			:=	K9605_01:I.Data[10].3;]]>
</Line>
<Line Number="35">
<![CDATA[IN_CRS.B9680_02			:=	K9605_01:I.Data[10].4;]]>
</Line>
<Line Number="36">
<![CDATA[IN_CRS.B9691_01			:=	K9605_01:I.Data[10].5;]]>
