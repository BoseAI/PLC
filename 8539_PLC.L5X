<Routine Name="PAL_DataBase_SizeChangeWithMotor" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB.Count_EnableCheckOfResetCounts)XIO(BB.Count_GrtZero)OTU(BB.Count_EnableCheckOfResetCounts);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_Inhibition)[OTE(OM_Interface.AutoSizeChange_xInhibition) ,OTU(OM_Interface.AutoSizeChange_xRq) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Check Condition]]>
</Comment>
<Text>
<![CDATA[GT(PAL_diAuxProductNumber,0)GT(UM_HMI.Machine.St_iSizeChange_NewSize_Number,0)GT(UM_HMI.Pal.St_iSizeChange_NewSize_Number,0)XIO(BB.SizeDisplay_InProgress)XIO(BB.SizeSave_InProgress)XIO(BB.SizeCopy_InProgress)XIO(BB.SizeDelete_InProgress)XIO(BB.SizeChange_Inhibition)OTE(BB.SizeChange_ConditionsOk);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_Inhibition)OTU(BB.SizeChange_Inhibition);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Start Procedure change format]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Product.Rq_xConfirm_SizeChange)ONS(UM_Machine.axPTrig[63])[XIC(BB.SizeChange_ConditionsOk) OTE(BB.SizeChange_CheckDataRq) ,XIO(BB.SizeChange_ConditionsOk) OTL(MSG[8]) ,OTU(UM_HMI.Product.Rq_xConfirm_SizeChange) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_RestoreRq)[OTU(BB.SizeChange_InProgress) ,OTU(BB.SizeChange_DeviceSizeChangeRq) ,OTU(BB.SizeChange_RestoreRq) ,OTU(BB.SizeChange_OK) ,MOVE(0,UM_HMI.Machine.St_iSizeChange_NewSize_Number) ,OTU(BB.SizeChange_Rq) ,OTU(BB.SizeChange_WorkSizePresentOnArchive) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Pointer Increase]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_PointerIncreaseRq)[ADD(1,SizeAux[2],SizeAux[2]) ,OTU(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Check data Rq]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_CheckDataRq)JSR(PAL_DataBase_SizeDataCheck,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_OK)XIO(BB.SizeChange_InProgress)[[NE(UM_HMI.Machine.St_iSizeChange_NewSize_Number,UM_HMI.Machine.St_iActualWorkingSize_Number) ,NE(UM_HMI.Pal.St_iSizeChange_NewSize_Number,UM_HMI.Pal.St_iActualWorkingSize_Number) ] [[OTL(BB.Count_EnableCheckOfResetCounts) ,JSR(PAL_CheckPalFromChangeFormat,0) ] ,OTL(OM_TeT.IN_Machine.xFormatChanged) ] ,ONS(UM_Machine.axPTrig[9]) OTL(OM_Interface.AutoSizeChange_xRq) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_OK)XIO(BB.SizeChange_InProgress)XIO(OM_Interface.xAutoSizeChangeMot_ChangeSizeInhibition)[OTU(BB.SetSize) ,OTU(BB.SizeChange_RqAdjustmentDataTable) ,OTL(BB.SizeChange_InProgress) ,MOVE(1,SizeAux[2]) ,OTL(UM_HMI.Product.St_xSizeChange) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 1:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],1)OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
