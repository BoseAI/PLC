<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(500,IEC_TimerDelayCmdForward.PRE)MOVE(500,IEC_TimerDelayCmdBackward.PRE)MOVE(i_TON_Timeout,TON_TimeOutMoving.PRE);]]>
</Text>
