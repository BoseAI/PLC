<AddOnInstructionDefinition Name="FC_rMod" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2017-06-09T12:38:28.573Z" CreatedBy="Costal-PC\Costal" EditedDate="2021-02-10T11:29:39.736Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v32.01"
>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="q_rMod" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_rNumber" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_rDivider" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="rMod" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(*]]>
</Line>
<Line Number="1">
<![CDATA[FUNCTION FC_rMod : REAL]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[DESCRIPTION	]]>
</Line>
<Line Number="4">
<![CDATA[	This Function computes the module - rest - of a division]]>
</Line>
<Line Number="5">
<![CDATA[	]]>
</Line>
<Line Number="6">
<![CDATA[OTHER COMMENTS]]>
</Line>
<Line Number="7">
<![CDATA[	If the divider is zero the function computes a value of zero.]]>
</Line>
<Line Number="8">
<![CDATA[				]]>
</Line>
<Line Number="9">
<![CDATA[EXAMPLES]]>
</Line>
<Line Number="10">
<![CDATA[	400 FC_rMod to 360 => 40]]>
</Line>
<Line Number="11">
<![CDATA[	-10 FC_rMod to 360 => 350]]>
</Line>
<Line Number="12">
<![CDATA[	-400 FC_rMod to 360 => 320]]>
</Line>
<Line Number="13">
<![CDATA[	400 FC_rMod to -360 => -320]]>
</Line>
<Line Number="14">
<![CDATA[	10 FC_rMod to -360 => -350]]>
</Line>
<Line Number="15">
<![CDATA[	-400 FC_rMod to -360 => -40]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[INPUT]]>
</Line>
<Line Number="18">
<![CDATA[	i_rNumber	: REAL:=0.0;		Number to divide]]>
</Line>
<Line Number="19">
<![CDATA[	i_rDivider	: REAL:=0.0;	    Modul]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[OUTPUT ]]>
</Line>
<Line Number="22">
<![CDATA[	o_rReminder	: REAL:=0.0;	    Modul]]>
</Line>
<Line Number="23">
<![CDATA[*)]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[IF i_rDivider<>0 AND i_rNumber<>0 THEN]]>
</Line>
<Line Number="26">
<![CDATA[	IF i_rNumber > 0 THEN]]>
</Line>
<Line Number="27">
<![CDATA[		rMod := i_rNumber - ( (TRUNC(ABS(i_rNumber)/ABS(i_rDivider))) * ABS(i_rDivider) );]]>
</Line>
<Line Number="28">
<![CDATA[	ELSE]]>
</Line>
<Line Number="29">
<![CDATA[		rMod := i_rNumber + ( (TRUNC(ABS(i_rNumber)/ABS(i_rDivider))) * ABS(i_rDivider) );]]>
</Line>
<Line Number="30">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="31">
<![CDATA[	q_rMod := rMod;]]>
</Line>
<Line Number="32">
<![CDATA[	IF i_rDivider > 0 THEN]]>
</Line>
<Line Number="33">
<![CDATA[		IF rMod < 0 THEN]]>
</Line>
<Line Number="34">
<![CDATA[			q_rMod := rMod + i_rDivider;]]>
</Line>
<Line Number="35">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="36">
<![CDATA[	ELSE]]>
</Line>
<Line Number="37">
<![CDATA[		IF q_rMod > 0 THEN]]>
</Line>
<Line Number="38">
<![CDATA[			q_rMod := rMod + i_rDivider;]]>
</Line>
<Line Number="39">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="40">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="41">
<![CDATA[	IF q_rMod = i_rDivider THEN]]>
</Line>
<Line Number="42">
<![CDATA[		q_rMod := 0.0;]]>
</Line>
<Line Number="43">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="44">
<![CDATA[ELSE]]>
</Line>
<Line Number="45">
<![CDATA[	q_rMod :=0.0;]]>
</Line>
<Line Number="46">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="F_AxisCipDriveReal" Class="Standard" Revision="1.5" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2018-10-08T13:46:57.027Z" CreatedBy="DS-PC\ds" EditedDate="2026-06-17T09:39:24.463Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v36.00"
