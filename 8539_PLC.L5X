</Line>
<Line Number="38">
<![CDATA[IN_CRS.B9692_01			:=	K9605_01:I.Data[10].7;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[//REMOTE 11 (K9660_06)]]>
</Line>
<Line Number="41">
<![CDATA[IN_CRS.B9692_02			:=	K9605_01:I.Data[11].0;]]>
</Line>
<Line Number="42">
<![CDATA[IN_CRS.B9688_04			:=	K9605_01:I.Data[11].1;]]>
</Line>
<Line Number="43">
<![CDATA[IN_CRS.UpStream_Consent	:=	K9605_01:I.Data[11].2;]]>
</Line>
<Line Number="44">
<![CDATA[IN_CRS.K9680_01			:=	K9605_01:I.Data[11].3;]]>
</Line>
<Line Number="45">
<![CDATA[IN_CRS._SpareIN1		:=	K9605_01:I.Data[11].4;]]>
</Line>
<Line Number="46">
<![CDATA[IN_CRS._SpareIN1		:=	K9605_01:I.Data[11].5;]]>
</Line>
<Line Number="47">
<![CDATA[IN_CRS._SpareIN1		:=	K9605_01:I.Data[11].6;]]>
</Line>
<Line Number="48">
<![CDATA[IN_CRS._SpareIN1		:=	K9605_01:I.Data[11].7;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[/////////////////////]]>
</Line>
<Line Number="51">
<![CDATA[// SAFETY INPUT]]>
</Line>
<Line Number="52">
<![CDATA[/////////////////////]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[//E-Stop]]>
</Line>
<Line Number="55">
<![CDATA[IN_CRS.S9201_01 := sDCS_CRS.S9201.DCS.O1 AND NOT sDCS_CRS.S9201.DCS.FP; //E-Stop 21]]>
</Line>
<Line Number="56">
<![CDATA[IN_CRS.S9202_01 := sDCS_CRS.S9202.DCS.O1 AND NOT sDCS_CRS.S9202.DCS.FP; //E-Stop 22]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[//IN.SEL := sDCS_CRS.S1200.O1 AND NOT sDCS_CRS.S1200.FP;]]>
