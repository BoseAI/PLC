</DefaultData>
</Parameter>
<Parameter Name="Length" TagType="Base" DataType="INT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[This value is calculated by the AOI to be later used in the Length operand of a MCCP instruction.  It is the number of CAM elements populated in the My_CAM Array by this AOI.]]>
</Description>
</Parameter>
<Parameter Name="Start_Slope" TagType="Base" DataType="REAL" Usage="InOut" Radix="Float" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[This value is calculated by the AOI to be later used in the StartSlope operand of a MCCP instruction.  This is the boundary condition for the initial slope of the profile.]]>
</Description>
</Parameter>
<Parameter Name="End_Slope" TagType="Base" DataType="REAL" Usage="InOut" Radix="Float" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[This value is calculated by the AOI to be later used in the EndSlope operand of a MCCP instruction.  This is the boundary condition for the ending slope of the profile.]]>
</Description>
</Parameter>
<Parameter Name="Max" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
