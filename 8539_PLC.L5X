<![CDATA[XIC(EM_Infeed.xCycleInProgress)EQ(EM_Infeed.Stacker_iSeqChange,1)[XIO(EM_Infeed.Stacker_xPreStackerExclusion) XIO(EM_Infeed.Stacker_xLastLayerInProgress) OTL(EM_Infeed.Stacker_xSeqChangeIncreaseAux) ,[XIC(EM_Infeed.Stacker_xPreStackerExclusion) ,XIC(EM_Infeed.Stacker_xLastLayerInProgress) ] MOVE(3,EM_Infeed.Stacker_iSeqChange) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[m189.5]]>
</Comment>
<Text>
<![CDATA[EQ(EM_Infeed.Stacker_iSeqChange,2)[EQ(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,2) [[XIO(UM_Config.CP.EnableInfeed_EmptySensor) ,XIC(BB.NoLoadRun_Enable) ] MOVE(0,EM_Infeed.Stacker_iSeqChange) ,XIC(OM_Empty.xEnable) MOVE(3,EM_Infeed.Stacker_iSeqChange) ] ,NE(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,2) MOVE(2,EM_Infeed.CM_Stacker.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[m189.3]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)EQ(EM_Infeed.Stacker_iSeqChange,3)XIO(OM_Interface.Infeed_xStackerInhibit)OTL(EM_Infeed.Stacker_xSeqChangeIncreaseAux);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[m160.2]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)EQ(EM_Infeed.Stacker_iSeqChange,4)[EQ(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,3) OTL(EM_Infeed.Stacker_xSeqChangeIncreaseAux) ,NE(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,3) MOVE(3,EM_Infeed.CM_Stacker.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Counter layer reset request]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)EQ(EM_Infeed.Stacker_iSeqChange,5)[[XIO(SizeWork.Stacker.Sel.WaitProductForward) ,EQ(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,4) ] [[XIC(EM_Infeed.Stacker_xLayersCompleted) ,XIC(OM_Empty.xEnable) ] [OTL(EM_Infeed.Stacker_xRqCounterLayerReset) ,[XIC(EM_Infeed.Stacker_xLayersCompleted) OTL(OM_Interface.Infeed_xCompleteProdForBundleTransfer) ,XIO(EM_Infeed.Stacker_xLayersCompleted) OTL(OM_Interface.Infeed_xIncompleteProdForBundleTransfer) ] ,OTL(EM_Infeed.Stacker_xSeqChangeIncreaseAux) ] ,XIO(EM_Infeed.Stacker_xLayersCompleted) XIO(EM_Infeed.Stacker_xRqCounterLayerIncrease) XIO(OM_Empty.xEnable) [XIO(UM_Config.CP.EnableInfeed_EmptySensor) ,XIC(BB.NoLoadRun_Enable) ] MOVE(0,EM_Infeed.Stacker_iSeqChange) ] ,XIC(SizeWork.Stacker.Sel.WaitProductForward) NE(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,4) MOVE(4,EM_Infeed.CM_Stacker.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Auxiliary bundle forward transfer with brushless]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)EQ(EM_Infeed.Stacker_iSeqChange,6)[XIC(SizeWork.Stacker.Sel.WaitProductForward) [XIC(OM_Interface.bundleTransfer_xInForwardPosForCycle) ,EQ(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,1) ] ,XIO(SizeWork.Stacker.Sel.WaitProductForward) ][XIO(UM_Config.CP.EnableInfeed_EmptySensor) ,XIC(BB.NoLoadRun_Enable) ]MOVE(0,EM_Infeed.Stacker_iSeqChange);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Stacking sequence increase auxiliary]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.Stacker_xSeqChangeIncreaseAux)[ADD(EM_Infeed.Stacker_iSeqChange,1,EM_Infeed.Stacker_iSeqChange) OTU(EM_Infeed.Stacker_xSeqChangeIncreaseAux) ,OTL(BB.Machine_Moving) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[m151.1]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.Infeed_xStackerInhibit)OTU(OM_Interface.Infeed_xStackerInhibit);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[*************************
CM Interface
************************]]>
</Comment>
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[XIC(EM_Infeed.Stacker_xPreStackerExclusion) OTE(OM_Interface.Infeed_xPreStackerExclusion) ,XIC(EM_Infeed.Stacker_xLastLayerInProgress) OTE(OM_Interface.Infeed_xStacker_LastLayerinProgress) ,EQ(EM_Infeed.CM_Stacker.AxisIN_POS_iRqPos,3) OTE(OM_Interface.Infeed_xStacker_RqPos3) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
