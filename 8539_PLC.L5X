</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(500,IEC_TimerDelayCmdForward.PRE)MOVE(500,IEC_TimerDelayCmdBackward.PRE);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(i_xEnable)XIC(i_xMot_Safety)[XIC(iq_BB.EMF_ON) OTE(xCmdEnable) ,XIO(iq_BB.EMF_ON) [OTU(iq_Motor.Mot_xRqForward) ,OTU(iq_Motor.Mot_xRqBackward) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(xCmdEnable)XIC(iq_Motor.Mot_xRqForward)XIO(iq_Motor.Mot_xRqBackward)XIO(IEC_TimerDelayCmdForward.DN)[OTE(q_xCmdStart) ,OTU(iq_Motor.Mot_xRqForward) ,TOF(IEC_TimerDelayCmdBackward,?,?) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(xCmdEnable)XIC(iq_Motor.Mot_xRqBackward)XIO(iq_Motor.Mot_xRqForward)XIO(IEC_TimerDelayCmdBackward.DN)[OTE(q_xCmdReverse) ,OTU(iq_Motor.Mot_xRqBackward) ,TOF(IEC_TimerDelayCmdForward,?,?) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[ALRM]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(i_xMot_Safety)[OTE(q_xSafetyAlrm) ,OTL(iq_xSelStopType) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(i_xThermalCutout)OTE(q_xThermalCotoutAlrm);]]>
</Text>
