<Text>
<![CDATA[XIO(ALRM_CRS[750])[XIC(sDCS_CRS.B9404.DCS.FP) ,XIO(sDCS_CRS.B9404.DCS.O1) XIC(ALRM_CRS[761]) ][OTE(ALRM_CRS[761]) ,OTL(BB_CRS.Rq_EmergencyImmediateStop) ];]]>
</Text>
