<Routines>
<Routine Name="EnableInFalse" Type="ST">
<Description>
<![CDATA[EnableInFalse]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[EN:= 0;]]>
</Line>
<Line Number="1">
<![CDATA[O_xAlarm:= 0;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[EN:= EnableIn;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[O_xAlarm:= 0;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[L_iIndexStopValue	:= (I_iArrayDimension-1);]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[FOR O_iPointer:=0 TO L_iIndexStopValue DO]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[	IF IO_aTestArea[O_iPointer].ER then]]>
</Line>
<Line Number="10">
<![CDATA[		IO_iInstructionNumber:=O_iPointer;]]>
</Line>
<Line Number="11">
<![CDATA[		IO_iAxisNumber:=I_iAxisNumber;]]>
</Line>
<Line Number="12">
<![CDATA[		IO_iErrorNumber:=IO_aTestArea[O_iPointer].ERR;]]>
</Line>
<Line Number="13">
<![CDATA[		IO_iExtendedNumber:=IO_aTestArea[O_iPointer].EXERR;]]>
</Line>
<Line Number="14">
<![CDATA[		O_xAlarm:= 1;]]>
</Line>
<Line Number="15">
<![CDATA[		IO_aTestArea[O_iPointer].FLAGS:=0;]]>
</Line>
<Line Number="16">
<![CDATA[		exit;]]>
</Line>
<Line Number="17">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
