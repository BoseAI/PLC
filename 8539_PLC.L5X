<Rung Number="19" Type="N">
<Text>
<![CDATA[[XIC(iq_CM_Inverter.InverterOUT_xMoveToBackward) ,XIC(iq_CM_Inverter.InverterOUT_xMoveToForward) ,XIC(i_xCheckEncMoving) ]LE(iq_CM_Encoder.lrActualSpeed,lrDeltaError_Speed)XIC(i_xExclusionTimeout)TON(TON_TimeOutMoving,?,?);]]>
