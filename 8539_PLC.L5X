<Description>
<![CDATA[unit * 10]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="iq_HW_Axis_Virtual" TagType="Base" DataType="AXIS_VIRTUAL" Usage="InOut" Required="true" Visible="true"/>
<Parameter Name="iq_CIP_Axis_Virtual" TagType="Base" DataType="UDT_CM_AxisCIP_ExchangeData_Virtual" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[-]]>
</Description>
</Parameter>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Virtual Axis ]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[//Init Maximum speed]]>
</Line>
<Line Number="3">
<![CDATA[iq_CIP_Axis_Virtual.rCalcSSV:=i_diMaximumSpeed;]]>
</Line>
<Line Number="4">
<![CDATA[SSV(Axis,iq_HW_Axis_Virtual,MaximumSpeed,iq_CIP_Axis_Virtual.rCalcSSV);]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[//Init MaximumAcceleration]]>
</Line>
<Line Number="7">
<![CDATA[iq_CIP_Axis_Virtual.rCalcSSV:=i_diMaximumAcceleration;]]>
</Line>
<Line Number="8">
<![CDATA[SSV(Axis,iq_HW_Axis_Virtual,MaximumAcceleration,iq_CIP_Axis_Virtual.rCalcSSV);]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[//Init MaximumDeceleration]]>
</Line>
<Line Number="11">
<![CDATA[iq_CIP_Axis_Virtual.rCalcSSV:=i_diMaximumDeceleration;]]>
</Line>
<Line Number="12">
<![CDATA[SSV(Axis,iq_HW_Axis_Virtual,MaximumDeceleration,iq_CIP_Axis_Virtual.rCalcSSV);]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[//Init MaxAccJerk]]>
</Line>
<Line Number="15">
<![CDATA[iq_CIP_Axis_Virtual.rCalcSSV:=(i_diMaximumAcceleration*i_diMaximumAcceleration)/i_diMaximumSpeed;]]>
</Line>
<Line Number="16">
<![CDATA[SSV(Axis,iq_HW_Axis_Virtual,MaximumAccelerationJerk,iq_CIP_Axis_Virtual.rCalcSSV);]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[//Init MaxDecJerk]]>
</Line>
<Line Number="19">
<![CDATA[iq_CIP_Axis_Virtual.rCalcSSV:=(i_diMaximumDeceleration*i_diMaximumDeceleration)/i_diMaximumSpeed;]]>
</Line>
<Line Number="20">
<![CDATA[SSV(Axis,iq_HW_Axis_Virtual,MaximumDecelerationJerk,iq_CIP_Axis_Virtual.rCalcSSV);]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[//Init HomePosition]]>
</Line>
<Line Number="23">
<![CDATA[iq_CIP_Axis_Virtual.rCalcSSV:=i_diHomePosition/10.0;]]>
</Line>
<Line Number="24">
<![CDATA[SSV(Axis,iq_HW_Axis_Virtual,HomePosition,iq_CIP_Axis_Virtual.rCalcSSV);]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[//END]]>
</Line>
<Line Number="27">
<![CDATA[iq_CIP_Axis_Virtual.xRqSSV := 0;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
