</Line>
<Line Number="10">
<![CDATA[Last Change : 29.07.2016]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[********************************************************************]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[This FB counts events occurring and time passing, and calculates instant speed ]]>
</Line>
<Line Number="15">
<![CDATA[and average speed as events/min]]>
</Line>
<Line Number="16">
<![CDATA[Events are counted as rising edge and events quantity: i.e. a rising edge with ]]>
</Line>
<Line Number="17">
<![CDATA[EventsQty=3 means 3 events to count (or products to count)]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[The instant speed is calculated as number of events occurred between 2 last ]]>
</Line>
<Line Number="20">
<![CDATA[events rising edges, divided per time elapsed]]>
</Line>
<Line Number="21">
<![CDATA[The average speed is calculated after a set number of events counted]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[*)]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[if i_xEnable then]]>
</Line>
<Line Number="26">
<![CDATA[	L_diElapsed_ms_dint := i_iLastScanTime;]]>
</Line>
<Line Number="27">
<![CDATA[	if L_diDeltaT < i_diMaxTimeToReset then]]>
</Line>
<Line Number="28">
<![CDATA[		L_diDeltaT 		:= L_diDeltaT + L_diElapsed_ms_dint;]]>
</Line>
<Line Number="29">
<![CDATA[		L_diAvgDeltaT 	:= L_diAvgDeltaT + L_diElapsed_ms_dint;]]>
</Line>
<Line Number="30">
<![CDATA[	end_if;]]>
</Line>
<Line Number="31">
<![CDATA[end_if;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[if (L_diDeltaT < i_diMaxTimeToReset) and i_xOsEvent then]]>
</Line>
<Line Number="34">
<![CDATA[	L_rDeltaT_Real := L_diDeltaT;]]>
</Line>
<Line Number="35">
<![CDATA[	(*]]>
</Line>
<Line Number="36">
<![CDATA[		Calculate instant speed:]]>
</Line>
<Line Number="37">
<![CDATA[		                              EventQty    * 60000[ms/min]]]>
</Line>
<Line Number="38">
<![CDATA[		instant speed [events/min] = -----------------------------]]>
</Line>
<Line Number="39">
<![CDATA[		                                      DeltaT[ms]]]>
</Line>
<Line Number="40">
<![CDATA[	*)]]>
</Line>
<Line Number="41">
<![CDATA[	q_rInstantSpeedReal := ((i_iEventQty * 60000) / L_rDeltaT_Real);]]>
</Line>
<Line Number="42">
<![CDATA[	// Increase events counter for average speed calculation]]>
</Line>
<Line Number="43">
<![CDATA[	L_diAvgEventsCount := L_diAvgEventsCount + i_iEventQty;]]>
</Line>
<Line Number="44">
<![CDATA[end_if;]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[if i_xOsEvent then]]>
</Line>
<Line Number="47">
<![CDATA[	L_diDeltaT := 0;]]>
</Line>
<Line Number="48">
<![CDATA[end_if;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[if not i_xEnable or (L_diDeltaT >= i_diMaxTimeToReset) then]]>
</Line>
<Line Number="51">
<![CDATA[	q_rInstantSpeedReal	:= 0;]]>
</Line>
<Line Number="52">
<![CDATA[	q_rAverageSpeedReal	:= 0;]]>
</Line>
<Line Number="53">
<![CDATA[	L_diAvgEventsCount	:= 0;]]>
</Line>
<Line Number="54">
<![CDATA[	L_diAvgDeltaT		:= 0;]]>
</Line>
<Line Number="55">
<![CDATA[end_if;]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[if (L_diAvgEventsCount >= i_iAvgEventsNr) and i_xOsEvent then]]>
</Line>
<Line Number="58">
<![CDATA[	L_rAvgDeltaT_Real := L_diAvgDeltaT;	//converto il tempo in floating point]]>
</Line>
<Line Number="59">
<![CDATA[	(*]]>
</Line>
<Line Number="60">
<![CDATA[		Calculate instant speed:]]>
</Line>
<Line Number="61">
<![CDATA[		                              EventQty    * 60000[ms/min]]]>
</Line>
<Line Number="62">
<![CDATA[		instant speed [events/min] = -----------------------------]]>
</Line>
<Line Number="63">
<![CDATA[		                                      DeltaT[ms]]]>
</Line>
<Line Number="64">
<![CDATA[	*)]]>
</Line>
<Line Number="65">
<![CDATA[	q_rAverageSpeedReal := (L_diAvgEventsCount * 60000) / L_rAvgDeltaT_Real;]]>
</Line>
<Line Number="66">
<![CDATA[	L_diAvgEventsCount 	:= 0;]]>
</Line>
<Line Number="67">
<![CDATA[	L_diAvgDeltaT		:= 0;]]>
</Line>
<Line Number="68">
<![CDATA[end_if;]]>
</Line>
<Line Number="69">
<![CDATA[]]>
</Line>
<Line Number="70">
<![CDATA[L_rDecimalCorr := 0.0;]]>
</Line>
<Line Number="71">
<![CDATA[case i_iSpeedDecDigits of]]>
</Line>
<Line Number="72">
<![CDATA[	0:]]>
</Line>
<Line Number="73">
<![CDATA[		L_rDecimalCorr := 1.0;]]>
</Line>
<Line Number="74">
<![CDATA[	1:]]>
</Line>
<Line Number="75">
<![CDATA[		L_rDecimalCorr := 10.0;]]>
</Line>
<Line Number="76">
<![CDATA[	2:]]>
</Line>
<Line Number="77">
<![CDATA[		L_rDecimalCorr := 100.0;]]>
</Line>
<Line Number="78">
<![CDATA[	3:]]>
</Line>
<Line Number="79">
<![CDATA[		L_rDecimalCorr := 1000.0;]]>
</Line>
<Line Number="80">
<![CDATA[	4:]]>
</Line>
<Line Number="81">
<![CDATA[		L_rDecimalCorr := 10000.0;]]>
</Line>
<Line Number="82">
<![CDATA[	5:]]>
</Line>
<Line Number="83">
<![CDATA[		L_rDecimalCorr := 100000.0;]]>
</Line>
<Line Number="84">
<![CDATA[end_case;]]>
</Line>
<Line Number="85">
<![CDATA[]]>
</Line>
<Line Number="86">
<![CDATA[q_iInstantSpeedInt := q_rInstantSpeedReal * L_rDecimalCorr;]]>
</Line>
<Line Number="87">
<![CDATA[q_iAverageSpeedInt := q_rAverageSpeedReal * L_rDecimalCorr;]]>
</Line>
<Line Number="88">
<![CDATA[(*]]>
</Line>
<Line Number="89">
<![CDATA[L_rInstSpeedWithCorrection := q_rInstantSpeedReal * L_rDecimalCorr;]]>
</Line>
<Line Number="90">
<![CDATA[if L_rInstSpeedWithCorrection >=  32767 then]]>
</Line>
<Line Number="91">
<![CDATA[	q_iInstantSpeedInt := trunc(L_rInstSpeedWithCorrection);]]>
</Line>
<Line Number="92">
<![CDATA[	L_rAvgSpeedWithCorrection := q_rAverageSpeedReal * L_rDecimalCorr;]]>
</Line>
<Line Number="93">
<![CDATA[	if L_rAvgSpeedWithCorrection >= 32767 then]]>
</Line>
<Line Number="94">
<![CDATA[		q_iAverageSpeedInt := trunc(L_rAvgSpeedWithCorrection);]]>
</Line>
<Line Number="95">
<![CDATA[	end_if;]]>
</Line>
<Line Number="96">
<![CDATA[end_if;*)]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="SpeedCalculation" Class="Standard" Revision="2.0" Vendor="IMA BFB" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2020-07-15T14:50:30.385Z" CreatedBy="DESKTOP-I4HL37F\admin" EditedDate="2021-09-10T07:04:33.770Z" EditedBy="DESKTOP-I4HL37F\admin"
 SoftwareRevision="v32.01">
<Description>
<![CDATA[This FB counts events occurring and time passing, and calculates instant speed 
and average speed as events/min.]]>
</Description>
<RevisionNote>
<![CDATA[v2.0        : New Release containing correct average calculation algorithm:
Modified by : M.Padovani
Last Change : 26.07.2018]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="i_xEnable" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Enable speed calculation]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_xOsEvent" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Raising edge of event to evaluate speed]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_iEventQty" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of events for actual Raising Edge (normally = 1)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[1]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="1"/>
</DefaultData>
</Parameter>
<Parameter Name="i_iLastScanTime" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Elapsed time last OB1 execution [ms]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_iAvgEventsNr" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of samples for average speed calculation]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[1]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="1"/>
</DefaultData>
</Parameter>
<Parameter Name="i_iSpeedDecDigits" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of decimal digits. (0-2; normally = 1, i.e. 12 stands for 1.2)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[1]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="1"/>
</DefaultData>
</Parameter>
<Parameter Name="i_diMaxTimeToReset" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Maximum waiting time to reset counters [ms]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[60000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="60000"/>
</DefaultData>
</Parameter>
<Parameter Name="q_rInstantSpeedReal" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Instant speed [events/min]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="q_iInstantSpeedInt" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Instant speed [0.1 events/min]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="q_rAverageSpeedReal" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Average speed [events/min]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="q_iAverageSpeedInt" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Average speed [0.1 events/min]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="L_diAvgEventsCount" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Events occurred from last average calculation]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_diAvgDeltaT" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Elapsed time from last average calculation [ms]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_diDeltaT" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Elapsed time from last event [ms]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_diElapsed_ms_dint" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_rMachineStatisticSpeed" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_rDecimalCorr" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_rAvgDeltaT_Real" DataType="REAL" Radix="Float" ExternalAccess="None">
<Description>
<![CDATA[Elapsed time from last average calculation[ms]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_rDeltaT_Real" DataType="REAL" Radix="Float" ExternalAccess="None">
<Description>
<![CDATA[Elapsed time from last event [ms]]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_iVELOCITA" DataType="INT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Velocità  macchina]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_iTEMPO" DataType="INT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Elapsed time]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_iT_BIN" DataType="INT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Tempo ciclo macchina rimanente]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_rAvgSpeedWithCorrection" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_rInstSpeedWithCorrection" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[This FB counts events occurring and time passing, and calculates instant speed 
and average speed as events/min
Events are counted as rising edge and events quantity: i.e. a rising edge with 
EventsQty=3 means 3 events to count (or products to count)

The instant speed is calculated as number of events occurred between 2 last 
events rising edges, divided per time elapsed
The average speed is calculated after a set number of events counted]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[(*]]>
</Line>
<Line Number="1">
<![CDATA[]]>
</Line>
<Line Number="2">
<![CDATA[FB          : Speed Calculation]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[v2.0        : New Release containing correct average calculation algorithm:]]>
</Line>
<Line Number="5">
<![CDATA[Modified by : M.Padovani]]>
</Line>
<Line Number="6">
<![CDATA[Last Change : 26.07.2018]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[v1.0        : Initial creation]]>
</Line>
<Line Number="9">
<![CDATA[Author      : M.Padovani]]>
</Line>
<Line Number="10">
<![CDATA[Last Change : 29.07.2016]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[********************************************************************]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[This FB counts events occurring and time passing, and calculates instant speed ]]>
</Line>
<Line Number="15">
<![CDATA[and average speed as events/min]]>
</Line>
<Line Number="16">
<![CDATA[Events are counted as rising edge and events quantity: i.e. a rising edge with ]]>
</Line>
<Line Number="17">
<![CDATA[EventsQty=3 means 3 events to count (or products to count)]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[The instant speed is calculated as number of events occurred between 2 last ]]>
</Line>
<Line Number="20">
<![CDATA[events rising edges, divided per time elapsed]]>
</Line>
<Line Number="21">
<![CDATA[The average speed is calculated after a set number of events counted]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[*)]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[if i_xEnable then]]>
</Line>
<Line Number="26">
<![CDATA[	L_diElapsed_ms_dint := i_iLastScanTime;]]>
</Line>
<Line Number="27">
<![CDATA[	if L_diDeltaT < i_diMaxTimeToReset then]]>
</Line>
<Line Number="28">
<![CDATA[		L_diDeltaT 		:= L_diDeltaT + L_diElapsed_ms_dint;]]>
</Line>
<Line Number="29">
<![CDATA[		L_diAvgDeltaT 	:= L_diAvgDeltaT + L_diElapsed_ms_dint;]]>
</Line>
<Line Number="30">
<![CDATA[	end_if;]]>
</Line>
<Line Number="31">
<![CDATA[end_if;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[if (L_diDeltaT < i_diMaxTimeToReset) and i_xOsEvent then]]>
</Line>
<Line Number="34">
<![CDATA[	L_rDeltaT_Real := L_diDeltaT;]]>
</Line>
<Line Number="35">
<![CDATA[	(*]]>
</Line>
<Line Number="36">
<![CDATA[		Calculate instant speed:]]>
</Line>
<Line Number="37">
<![CDATA[		                              EventQty    * 60000[ms/min]]]>
</Line>
<Line Number="38">
<![CDATA[		instant speed [events/min] = -----------------------------]]>
</Line>
<Line Number="39">
<![CDATA[		                                      DeltaT[ms]]]>
</Line>
<Line Number="40">
<![CDATA[	*)]]>
</Line>
<Line Number="41">
<![CDATA[	q_rInstantSpeedReal := ((i_iEventQty * 60000) / L_rDeltaT_Real);]]>
</Line>
<Line Number="42">
<![CDATA[	// Increase events counter for average speed calculation]]>
</Line>
<Line Number="43">
<![CDATA[	L_diAvgEventsCount := L_diAvgEventsCount + i_iEventQty;]]>
</Line>
<Line Number="44">
<![CDATA[end_if;]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[if i_xOsEvent then]]>
</Line>
<Line Number="47">
<![CDATA[	L_diDeltaT := 0;]]>
</Line>
<Line Number="48">
<![CDATA[end_if;]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[if not i_xEnable or (L_diDeltaT >= i_diMaxTimeToReset) then]]>
</Line>
<Line Number="51">
<![CDATA[	q_rInstantSpeedReal	:= 0;]]>
</Line>
<Line Number="52">
<![CDATA[	q_rAverageSpeedReal	:= 0;]]>
</Line>
<Line Number="53">
<![CDATA[	L_diAvgEventsCount	:= 0;]]>
</Line>
<Line Number="54">
<![CDATA[	L_diAvgDeltaT		:= 0;]]>
</Line>
<Line Number="55">
<![CDATA[end_if;]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[if (L_diAvgEventsCount >= i_iAvgEventsNr) and i_xOsEvent then]]>
</Line>
<Line Number="58">
<![CDATA[	L_rAvgDeltaT_Real := L_diAvgDeltaT;	//converto il tempo in floating point]]>
</Line>
<Line Number="59">
<![CDATA[	(*]]>
</Line>
<Line Number="60">
<![CDATA[		Calculate instant speed:]]>
</Line>
<Line Number="61">
<![CDATA[		                              EventQty    * 60000[ms/min]]]>
</Line>
<Line Number="62">
<![CDATA[		instant speed [events/min] = -----------------------------]]>
</Line>
<Line Number="63">
<![CDATA[		                                      DeltaT[ms]]]>
</Line>
<Line Number="64">
<![CDATA[	*)]]>
</Line>
<Line Number="65">
<![CDATA[	q_rAverageSpeedReal := (L_diAvgEventsCount * 60000) / L_rAvgDeltaT_Real;]]>
</Line>
<Line Number="66">
<![CDATA[	L_diAvgEventsCount 	:= 0;]]>
</Line>
<Line Number="67">
<![CDATA[	L_diAvgDeltaT		:= 0;]]>
</Line>
<Line Number="68">
<![CDATA[end_if;]]>
</Line>
<Line Number="69">
<![CDATA[]]>
</Line>
<Line Number="70">
<![CDATA[L_rDecimalCorr := 0.0;]]>
</Line>
<Line Number="71">
<![CDATA[case i_iSpeedDecDigits of]]>
</Line>
<Line Number="72">
<![CDATA[	0:]]>
</Line>
<Line Number="73">
<![CDATA[		L_rDecimalCorr := 1.0;]]>
</Line>
<Line Number="74">
<![CDATA[	1:]]>
</Line>
<Line Number="75">
<![CDATA[		L_rDecimalCorr := 10.0;]]>
</Line>
<Line Number="76">
<![CDATA[	2:]]>
</Line>
<Line Number="77">
<![CDATA[		L_rDecimalCorr := 100.0;]]>
</Line>
<Line Number="78">
<![CDATA[	3:]]>
</Line>
<Line Number="79">
<![CDATA[		L_rDecimalCorr := 1000.0;]]>
</Line>
<Line Number="80">
<![CDATA[	4:]]>
</Line>
<Line Number="81">
<![CDATA[		L_rDecimalCorr := 10000.0;]]>
</Line>
<Line Number="82">
<![CDATA[	5:]]>
</Line>
<Line Number="83">
<![CDATA[		L_rDecimalCorr := 100000.0;]]>
</Line>
<Line Number="84">
<![CDATA[end_case;]]>
</Line>
<Line Number="85">
<![CDATA[]]>
</Line>
<Line Number="86">
<![CDATA[q_iInstantSpeedInt := q_rInstantSpeedReal * L_rDecimalCorr;]]>
</Line>
<Line Number="87">
<![CDATA[q_iAverageSpeedInt := q_rAverageSpeedReal * L_rDecimalCorr;]]>
</Line>
<Line Number="88">
<![CDATA[(*]]>
</Line>
<Line Number="89">
<![CDATA[L_rInstSpeedWithCorrection := q_rInstantSpeedReal * L_rDecimalCorr;]]>
</Line>
<Line Number="90">
<![CDATA[if L_rInstSpeedWithCorrection >=  32767 then]]>
</Line>
<Line Number="91">
<![CDATA[	q_iInstantSpeedInt := trunc(L_rInstSpeedWithCorrection);]]>
</Line>
<Line Number="92">
<![CDATA[	L_rAvgSpeedWithCorrection := q_rAverageSpeedReal * L_rDecimalCorr;]]>
</Line>
<Line Number="93">
<![CDATA[	if L_rAvgSpeedWithCorrection >= 32767 then]]>
</Line>
<Line Number="94">
<![CDATA[		q_iAverageSpeedInt := trunc(L_rAvgSpeedWithCorrection);]]>
</Line>
<Line Number="95">
<![CDATA[	end_if;]]>
</Line>
<Line Number="96">
<![CDATA[end_if;*)]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="SwitchCam" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2007-10-08T10:13:01.500Z" CreatedBy="IMA\ChiarinL" EditedDate="2022-02-07T13:50:30.009Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v32.01"
>
