<Routine Name="Config" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[//Hardware configuration]]>
</Line>
<Line Number="2">
<![CDATA[UM_Config.CP.EnableBundleTransfer			:= 1;]]>
</Line>
<Line Number="3">
<![CDATA[UM_Config.CP.BundleTransfer_EnableBundleRot	:= 0;]]>
</Line>
<Line Number="4">
<![CDATA[UM_Config.CP.PresenceDeadFloorForBundleTransfer	:= 0;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[//Option]]>
</Line>
<Line Number="7">
<![CDATA[UM_Config.CP.EnablePneumSingleElevatorBundle := 1;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
