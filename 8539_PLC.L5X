<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
Add-on Pneumatic Management v4.0
 ]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[MOVE(i_TON_SensON,L_TON_SensON_Timer.PRE) ,MOVE(i_TOFF_SensON,L_TOFF_SensON_Timer.PRE) ,XIC(i_xSensorON) [TON(L_TON_SensON_Timer,?,?) ,TOF(L_TOFF_SensON_Timer,?,?) ] ,XIC(L_TON_SensON_Timer.DN) OTL(L_DelaySensorON) ,XIO(L_TOFF_SensON_Timer.DN) OTU(L_DelaySensorON) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[MOVE(i_TON_SensOFF,L_TON_SensOFF_Timer.PRE) ,MOVE(i_TOFF_SensOFF,L_TOFF_SensOFF_Timer.PRE) ,XIC(i_xSensorOFF) [TON(L_TON_SensOFF_Timer,?,?) ,TOF(L_TOFF_SensOFF_Timer,?,?) ] ,XIC(L_TON_SensOFF_Timer.DN) OTL(L_DelaySensorOFF) ,XIO(L_TOFF_SensOFF_Timer.DN) OTU(L_DelaySensorOFF) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(q_xAux0)XIO(q_xAux1)[XIC(iq_xRqON) OTL(q_xAux1) ,XIC(iq_xRqOFF) OTU(iq_xRqOFF) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(q_xAux0)XIC(q_xAux1)[XIC(L_DelaySensorON) XIO(L_DelaySensorOFF) [OTL(q_xAux0) ,OTU(iq_xRqON) ] ,XIO(L_DelaySensorON) XIC(iq_xRqOFF) [OTL(q_xAux0) ,OTU(q_xAux1) ,OTU(iq_xRqON) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(q_xAux0)XIC(q_xAux1)[XIC(iq_xRqOFF) OTU(q_xAux1) ,XIC(iq_xRqON) OTU(iq_xRqON) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(q_xAux0)XIO(q_xAux1)[XIC(L_DelaySensorOFF) XIO(L_DelaySensorON) [OTU(q_xAux0) ,OTU(iq_xRqOFF) ] ,XIO(L_DelaySensorOFF) XIC(iq_xRqON) [OTU(q_xAux0) ,OTL(q_xAux1) ,OTU(iq_xRqOFF) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(q_xAux1)OTE(q_xCmdON);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(q_xCmdON)OTE(q_xCmdOFF);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(q_xAux0)XIC(q_xAux1)XIC(L_DelaySensorON)OTE(q_xON);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIO(q_xAux0)XIO(q_xAux1)XIC(L_DelaySensorOFF)OTE(q_xOFF);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[MOVE(i_TimeoutTime,L_Timeout.PRE) ,[XIC(q_xCmdON) XIO(L_DelaySensorON) ,XIC(q_xCmdOFF) XIO(L_DelaySensorOFF) ,XIO(L_DelaySensorON) XIO(L_DelaySensorOFF) ,XIC(L_DelaySensorON) XIC(L_DelaySensorOFF) ] XIC(i_xAirOK) XIO(i_xTimeOutEsclusion) TON(L_Timeout,?,?) ,XIC(L_Timeout.DN) OTE(L_ErrorTimeout) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(q_xAux0) XIC(q_xAux1) XIO(i_xTimeOutEsclusion) ,XIC(iq_xChkON) ][XIO(L_DelaySensorON) ,XIC(L_DelaySensorOFF) ]OTE(L_ErrorPosOn);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIO(q_xAux0) XIO(q_xAux1) XIO(i_xTimeOutEsclusion) ,XIC(iq_xChkOFF) ][XIO(L_DelaySensorOFF) ,XIC(L_DelaySensorON) ]OTE(L_ErrorPosOff);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(L_ErrorPosOn) ,XIC(L_ErrorPosOff) ,XIC(L_ErrorTimeout) ]XIC(i_xAirOK)[OTE(q_xTimeOutAlarm) ,OTL(iq_xEM_StopType) ,XIO(i_xInhibitPneumStop) OTL(iq_xPneumStop) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[OTU(iq_xChkON) ,OTU(iq_xChkOFF) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="F_AxisCipDriveReal_new" Class="Standard" Revision="1.5" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2018-10-08T13:46:57.027Z" CreatedBy="DS-PC\ds" EditedDate="2025-12-03T09:38:37.312Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v36.00"
>
<RevisionNote>
<![CDATA[v1.5        : 01.06.2023
Author      : Ing.Utili Nicola
Comment: "IO_xRqStopAxis", clear filter InCam, because 
			this cmd stop active axis is must same schneider

v1.4        : 02.08.2022
Author      : Ing.Utili Nicola
Comment: Add "IO_Axis.ServoActionStatus" for setup "O_xAxisEnable"
			necessary for problem electrical brake

v1.3
20/02/2020
Aggiunta condizioni per lo stop in fase con il master non solo per gli assi in camma ma anche per quelli in gear o che utilizzano delle trasformate carte]]>
</RevisionNote>
