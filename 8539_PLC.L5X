</Line>
<Line Number="13">
<![CDATA[UM_Config.CP.EnableInfeedDosingBelt				:= 0;]]>
</Line>
<Line Number="14">
<![CDATA[UM_Config.CP.EnableInfeedYRot					:= 0;]]>
</Line>
<Line Number="15">
<![CDATA[UM_Config.CP.EnableBundleZRot					:= 0;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
