<Routine Name="PAL_SizeCopy" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Page save for size copy]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_RqPulse)XIC(UM_Machine.PAL.SizeCopy_ConditionOk)[MOVE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber) ,OTL(UM_Machine.PAL.SizeCopy_FunctionKeyCopyDone) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Function key auxiliary after copy done reset]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_FunctionKeyCopyDone)NE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber)OTU(UM_Machine.PAL.SizeCopy_FunctionKeyCopyDone);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Size copy conditions]]>
</Comment>
<Text>
<![CDATA[GT(UM_HMI.Pal.St_iSizeToDisplay_Number,0)XIO(UM_Machine.PAL.SizeChange_InProgress)XIO(UM_Machine.PAL.SizeDisplay_InProgress)XIO(UM_Machine.PAL.SizeSave_InProgress)XIO(UM_Machine.PAL.SizeDelete_InProgress)OTE(UM_Machine.PAL.SizeCopy_ConditionOk);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Save size rq
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Pal.Rq_xConfirmSizeCopy)ONS(UM_Machine.axPTrig[43])[OTE(UM_Machine.PAL.SizeCopy_RqPulse) ,OTU(UM_HMI.Pal.Rq_xConfirmSizeCopy) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Restore size save sequence
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_SequenceRestoreRq)[OTU(UM_Machine.PAL.SizeCopy_InProgress) ,OTU(UM_Machine.PAL.SizeCopy_SequenceRestoreRq) ,MOVE(0,UM_HMI.Pal.Rq_iSizeCopy_Destination) ,MOVE(0,UM_HMI.Pal.St_iSizeCopy) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Increase pointer size save
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_PointerIncreaseRq)[ADD(1,UM_Machine.PAL.iSequenceCopyData,UM_Machine.PAL.iSequenceCopyData) ,OTU(UM_Machine.PAL.SizeCopy_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Preset size save]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_RqPulse)XIO(UM_Machine.PAL.SizeCopy_InProgress)MOVE(1,UM_Machine.PAL.iSequenceCopyData);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Sequence start size save]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_RqPulse)XIC(UM_Machine.PAL.SizeCopy_ConditionOk)[OTL(UM_Machine.PAL.SizeCopy_InProgress) ,MOVE(2,UM_HMI.Pal.St_iSizeCopy) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 1: Check size number between limits
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_InProgress)EQ(UM_Machine.PAL.iSequenceCopyData,1)[LIMIT(1,UM_HMI.Pal.Rq_iSizeCopy_Destination,UM_Machine.PAL.iMaxNumberData) OTL(UM_Machine.PAL.SizeCopy_PointerIncreaseRq) ,[GT(UM_HMI.Pal.Rq_iSizeCopy_Destination,UM_Machine.PAL.iMaxNumberData) ,LT(UM_HMI.Pal.Rq_iSizeCopy_Destination,1) ] [MOVE(101,UM_Machine.PAL.iSequenceCopyData) ,MOVE(12,UM_HMI.Pal.St_iSizeCopy) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 2: Check existing size (not emty), predisposition]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_InProgress)EQ(UM_Machine.PAL.iSequenceCopyData,2)[NE(PAL_Size[UM_HMI.Pal.St_iSizeToDisplay_Number].WorkingCode,'') OTL(UM_Machine.PAL.SizeCopy_PointerIncreaseRq) ,EQ(PAL_Size[UM_HMI.Pal.St_iSizeToDisplay_Number].WorkingCode,'') [MOVE(101,UM_Machine.PAL.iSequenceCopyData) ,MOVE(12,UM_HMI.Pal.St_iSizeCopy) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 3: Check size data correct, predisposition
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_InProgress)EQ(UM_Machine.PAL.iSequenceCopyData,3)OTL(UM_Machine.PAL.SizeCopy_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 4: Rq. Size copy in progress and on display
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_InProgress)EQ(UM_Machine.PAL.iSequenceCopyData,4)COP(PAL_Size[UM_HMI.Pal.St_iSizeToDisplay_Number],PAL_Size[UM_HMI.Pal.Rq_iSizeCopy_Destination],1)OTL(UM_Machine.PAL.SizeCopy_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Step 5: Size copy ended]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_InProgress)EQ(UM_Machine.PAL.iSequenceCopyData,5)XIO(UM_HMI.Pal.Rq_xConfirmSizeCopy)[TON(Timers.N[303],?,?) ,MOVE(4,UM_HMI.Pal.St_iSizeCopy) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Size copy sequence restore request]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_InProgress)XIC(Timers.N[303].DN)OTL(UM_Machine.PAL.SizeCopy_SequenceRestoreRq);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[generate MSG09 Unvalid size or size not set]]>
</Comment>
<Text>
<![CDATA[EQ(UM_Machine.PAL.iSequenceCopyData,101)XIC(UM_Machine.PAL.SizeCopy_InProgress)[OTL(BB.Alarm_AuxSizeDataWrongOrNotSet) ,OTL(UM_Machine.PAL.SizeCopy_SequenceRestoreRq) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[generate MSG10 Data archive access not allowed]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeCopy_RqPulse)XIO(UM_Machine.PAL.SizeSave_ConditionOk)OTL(MSG[13]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PAL_SizeDelete" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[SAVE PAGE FOR DELETE SIZE]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_RqPulse)XIC(UM_Machine.PAL.SizeDelete_ConditionOkDelete)[MOVE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber) ,OTL(UM_Machine.PAL.SizeDelete_MemDone) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[reset message and selection]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_MemDone)NE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber)OTU(UM_Machine.PAL.SizeDelete_MemDone);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Delete size condition]]>
</Comment>
<Text>
<![CDATA[GT(UM_HMI.Pal.St_iSizeDelete_Number,0)XIO(UM_Machine.PAL.SizeChange_InProgress)XIO(UM_Machine.PAL.SizeDisplay_InProgress)XIO(UM_Machine.PAL.SizeCopy_InProgress)XIO(UM_Machine.PAL.SizeSave_InProgress)OTE(UM_Machine.PAL.SizeDelete_ConditionOkDelete);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Size delete rq
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Pal.Rq_xConfirm_SizeDelete)ONS(UM_Machine.axPTrig[44])[OTE(UM_Machine.PAL.SizeDelete_RqPulse) ,OTU(UM_HMI.Pal.Rq_xConfirm_SizeDelete) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Delete size restore sequence
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_SequenceRestoreRq)[OTU(UM_Machine.PAL.SizeDelete_InProgress) ,OTU(UM_Machine.PAL.SizeDelete_SequenceRestoreRq) ,MOVE(0,UM_HMI.Pal.St_iSizeDelete_Number) ,MOVE(0,UM_HMI.Pal.St_iSizeDelete) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Increase pointer size delete
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_PointerIncreaseRq)[ADD(1,UM_Machine.PAL.iSequenceDeleteData,UM_Machine.PAL.iSequenceDeleteData) ,OTU(UM_Machine.PAL.SizeDelete_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Preset size delete]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_RqPulse)XIO(UM_Machine.PAL.SizeDelete_InProgress)MOVE(1,UM_Machine.PAL.iSequenceDeleteData);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Sequence start size delete]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_RqPulse)XIC(UM_Machine.PAL.SizeDelete_ConditionOkDelete)[OTL(UM_Machine.PAL.SizeDelete_InProgress) ,MOVE(2,UM_HMI.Pal.St_iSizeDelete) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 1: Check size number between limits
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_InProgress)EQ(UM_Machine.PAL.iSequenceDeleteData,1)[LIMIT(1,UM_HMI.Pal.St_iSizeDelete_Number,UM_Machine.PAL.iMaxNumberData) OTL(UM_Machine.PAL.SizeDelete_PointerIncreaseRq) ,[GT(UM_HMI.Pal.St_iSizeDelete_Number,UM_Machine.PAL.iMaxNumberData) ,LT(UM_HMI.Pal.St_iSizeDelete_Number,1) ] [MOVE(101,UM_Machine.PAL.iSequenceDeleteData) ,MOVE(12,UM_HMI.Pal.St_iSizeDelete) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 2: Check existing size (not emty)]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_InProgress)EQ(UM_Machine.PAL.iSequenceDeleteData,2)[NE(PAL_Size[UM_HMI.Pal.St_iSizeDelete_Number].WorkingCode,L_EMPTYCODE) OTL(UM_Machine.PAL.SizeDelete_PointerIncreaseRq) ,EQ(PAL_Size[UM_HMI.Pal.St_iSizeDelete_Number].WorkingCode,L_EMPTYCODE) [MOVE(102,UM_Machine.PAL.iSequenceDeleteData) ,MOVE(12,UM_HMI.Pal.St_iSizeDelete) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 3: Check size data correct
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_InProgress)EQ(UM_Machine.PAL.iSequenceDeleteData,3)[NE(UM_HMI.Pal.St_iSizeDelete_Number,UM_HMI.Pal.St_iActualWorkingSize_Number) OTL(UM_Machine.PAL.SizeDelete_PointerIncreaseRq) ,EQ(UM_HMI.Pal.St_iSizeDelete_Number,UM_HMI.Pal.St_iActualWorkingSize_Number) [MOVE(103,UM_Machine.PAL.iSequenceDeleteData) ,MOVE(12,UM_HMI.Pal.St_iSizeDelete) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 4: Rq. Delete size request
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_InProgress)EQ(UM_Machine.PAL.iSequenceDeleteData,4)COP(PAL_SizeEmpty,PAL_Size[UM_HMI.Pal.St_iSizeDelete_Number],1)OTL(UM_Machine.PAL.SizeDelete_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Step 5: Size delete ended]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_InProgress)EQ(UM_Machine.PAL.iSequenceDeleteData,5)XIO(UM_HMI.Pal.Rq_xConfirm_SizeDelete)[TON(Timers.N[304],?,?) ,MOVE(4,UM_HMI.Pal.St_iSizeDelete) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Size delete sequence restore request]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_InProgress)XIC(Timers.N[304].DN)OTL(UM_Machine.PAL.SizeDelete_SequenceRestoreRq);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[generate MSG09 Unvalid size or size not set]]>
</Comment>
<Text>
<![CDATA[[EQ(UM_Machine.PAL.iSequenceDeleteData,101) ,EQ(UM_Machine.PAL.iSequenceDeleteData,102) ,EQ(UM_Machine.PAL.iSequenceDeleteData,103) ]XIC(UM_Machine.PAL.SizeDelete_InProgress)[OTL(MSG[12]) ,OTL(UM_Machine.PAL.SizeDelete_SequenceRestoreRq) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[generate MSG10 Data archive access not allowed]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDelete_RqPulse)XIO(UM_Machine.PAL.SizeDelete_ConditionOkDelete)OTL(MSG[13]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PAL_SizeDisplay" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Page displayed condition]]>
</Comment>
<Text>
<![CDATA[GT(UM_HMI.Pal.St_iSizeToDisplay_Number,0)XIO(UM_Machine.PAL.SizeChange_InProgress)XIO(UM_Machine.PAL.SizeSave_InProgress)XIO(UM_Machine.PAL.SizeDelete_InProgress)XIO(UM_Machine.PAL.SizeCopy_InProgress)OTE(UM_Machine.PAL.SizeDisplay_ConditionOk);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Size displayed rq
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Pal.Rq_xOpen_SizeArchivePg)ONS(UM_Machine.axPTrig[45])[GE(Core_HMI.Interface.iPasswordState,2) [OTE(UM_Machine.PAL.SizeDisplay_RqPulse) ,MOVE(92,Core_HMI.Interface.iPageToDisplay) ] ,LT(Core_HMI.Interface.iPasswordState,2) OTL(MSG[13]) ,OTU(UM_HMI.Pal.Rq_xOpen_SizeArchivePg) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Restore size displayed sequence
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_RestoreRq)[OTU(UM_Machine.PAL.SizeDisplay_InProgress) ,OTU(UM_Machine.PAL.SizeDisplay_RestoreRq) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Increase pointer size displayed
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_PointerIncreaseRq)[ADD(1,UM_Machine.PAL.iSequenceDisplayData,UM_Machine.PAL.iSequenceDisplayData) ,OTU(UM_Machine.PAL.SizeDisplay_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Preset size displayed]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_RqPulse)XIC(UM_Machine.PAL.SizeDisplay_ConditionOk)XIO(UM_Machine.PAL.SizeDisplay_InProgress)MOVE(1,UM_Machine.PAL.iSequenceDisplayData);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Sequence start size display]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_RqPulse)XIC(UM_Machine.PAL.SizeDisplay_ConditionOk)OTL(UM_Machine.PAL.SizeDisplay_InProgress);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Step 1: Check size number between limits
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_InProgress)EQ(UM_Machine.PAL.iSequenceDisplayData,1)[LIMIT(1,UM_HMI.Pal.St_iSizeToDisplay_Number,UM_Machine.PAL.iMaxNumberData) OTL(UM_Machine.PAL.SizeDisplay_PointerIncreaseRq) ,[GT(UM_HMI.Pal.St_iSizeToDisplay_Number,UM_Machine.PAL.iMaxNumberData) ,LT(UM_HMI.Pal.St_iSizeToDisplay_Number,1) ] MOVE(101,UM_Machine.PAL.iSequenceDisplayData) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Step 2: Check existing size (not emty)]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_InProgress)EQ(UM_Machine.PAL.iSequenceDisplayData,2)OTL(UM_Machine.PAL.SizeDisplay_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 3: Check size data correct
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_InProgress)EQ(UM_Machine.PAL.iSequenceDisplayData,3)OTL(UM_Machine.PAL.SizeDisplay_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 4: Rq. Display size request
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_InProgress)EQ(UM_Machine.PAL.iSequenceDisplayData,4)[COP(PAL_Size[UM_HMI.Pal.St_iSizeToDisplay_Number],PAL_SizeDisplayed,1) ,MOVE(UM_HMI.Pal.St_iSizeToDisplay_Number,UM_HMI.Pal.St_iActualDisplayedSize_Number) MOVE(PAL_SizeDisplayed.WorkingCode,UM_HMI.Pal.St_sActualDisplayedSize_Code) MOVE(PAL_SizeDisplayed.Name,UM_HMI.Pal.St_sActualDisplayedSize_Name) ,MOVE(UM_HMI.Pal.St_iActualDisplayedSize_Number,PAL_SizeDisplayed.General.ProgramNumber) ]OTL(UM_Machine.PAL.SizeDisplay_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 5: Size displyed ended]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_InProgress)EQ(UM_Machine.PAL.iSequenceDisplayData,5)OTL(UM_Machine.PAL.SizeDisplay_RestoreRq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[generate MSG09 Unvalid size or size not set]]>
</Comment>
<Text>
<![CDATA[EQ(UM_Machine.PAL.iSequenceDisplayData,101)XIC(UM_Machine.PAL.SizeDisplay_InProgress)[OTL(MSG[7]) ,OTL(UM_Machine.PAL.SizeDisplay_RestoreRq) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[generate MSG10 Data archive access not allowed]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeDisplay_RqPulse)XIO(UM_Machine.PAL.SizeDisplay_ConditionOk)[OTL(MSG[13]) ,OTL(UM_Machine.PAL.SizeDisplay_RestoreRq) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PAL_SizeMenuNew" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Row pointer menu displayed]]>
</Comment>
<Text>
<![CDATA[EQ(Core_HMI.Interface.iPageDisplayed,12)[MOVE(UM_Machine.PAL.iSelData,UM_HMI.Product.St_iSizeRecallNum) ,MOVE(UM_Machine.PAL.iSelData,UM_HMI.Pal.St_iSizeDelete_Number) ,MOVE(UM_Machine.PAL.iSelData,UM_HMI.Pal.St_iSizeToDisplay_Number) ,MOVE(UM_Machine.PAL.iSelData,UM_HMI.Pal.St_iActualDisplayedSize_Number) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PAL_SizeSave" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[SAVE PAGE FOR SIZE CHANGE]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_RqPulse)XIC(UM_Machine.PAL.SizeSave_ConditionOk)[MOVE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber) ,OTL(UM_Machine.PAL.SizeSave_FunctionIsDone) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Size save sequence restore request]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_FunctionIsDone)XIC(Timers.N[305].DN)[OTU(UM_Machine.PAL.SizeSave_FunctionIsDone) ,OTU(UM_HMI.Pal.St_xModSizeArchivedSave) ,OTL(UM_Machine.PAL.SizeSave_SequenceRestoreRq) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Size save condition]]>
</Comment>
<Text>
<![CDATA[GT(UM_HMI.Pal.St_iActualDisplayedSize_Number,0)XIO(UM_Machine.PAL.SizeChange_InProgress)XIO(UM_Machine.PAL.SizeDisplay_InProgress)XIO(UM_Machine.PAL.SizeCopy_InProgress)XIO(UM_Machine.PAL.SizeDelete_InProgress)OTE(UM_Machine.PAL.SizeSave_ConditionOk);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Size save rq
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Pal.Rq_xConfirmModSizeArchivedSave)[NE(PAL_SizeDisplayed.WorkingCode,L_EMPTYCODE) ONS(UM_Machine.axPTrig[46]) OTE(UM_Machine.PAL.SizeSave_RqPulse) ,EQ(PAL_SizeDisplayed.WorkingCode,L_EMPTYCODE) OTL(MSG[07]) ,OTU(UM_HMI.Pal.Rq_xConfirmModSizeArchivedSave) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Size save restore sequence
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_SequenceRestoreRq)[OTU(UM_Machine.PAL.SizeSave_InProgress) ,OTU(UM_Machine.PAL.SizeSave_SequenceRestoreRq) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Increase pointer size save
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_PointerIncreaseRq)[ADD(1,UM_Machine.PAL.iSequenceSaveData,UM_Machine.PAL.iSequenceSaveData) ,OTU(UM_Machine.PAL.SizeSave_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Preset size save]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_RqPulse)XIO(UM_Machine.PAL.SizeSave_InProgress)MOVE(1,UM_Machine.PAL.iSequenceSaveData);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Start sequence size save]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_RqPulse)XIC(UM_Machine.PAL.SizeSave_ConditionOk)OTL(UM_Machine.PAL.SizeSave_InProgress);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 1: Check size number between limits
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_InProgress)EQ(UM_Machine.PAL.iSequenceSaveData,1)[LIMIT(1,UM_HMI.Pal.St_iActualDisplayedSize_Number,UM_Machine.PAL.iMaxNumberData) OTL(UM_Machine.PAL.SizeSave_PointerIncreaseRq) ,[GT(UM_HMI.Pal.St_iActualDisplayedSize_Number,UM_Machine.PAL.iMaxNumberData) ,LT(UM_HMI.Pal.St_iActualDisplayedSize_Number,1) ] MOVE(101,UM_Machine.PAL.iSequenceSaveData) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 2: Check existing size (not emty)]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_InProgress)EQ(UM_Machine.PAL.iSequenceSaveData,2)[NE(PAL_SizeDisplayed.WorkingCode,L_EMPTYCODE) OTL(UM_Machine.PAL.SizeSave_PointerIncreaseRq) ,EQ(PAL_SizeDisplayed.WorkingCode,L_EMPTYCODE) MOVE(101,UM_Machine.PAL.iSequenceSaveData) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 3: Check size data correct
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_InProgress)EQ(UM_Machine.PAL.iSequenceSaveData,3)OTL(UM_Machine.PAL.SizeSave_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 4: Rq. size save request
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_InProgress)EQ(UM_Machine.PAL.iSequenceSaveData,4)COP(PAL_SizeDisplayed,PAL_Size[UM_HMI.Pal.St_iActualDisplayedSize_Number],1)[OTL(UM_Machine.PAL.SizeSave_PointerIncreaseRq) ,OTL(UM_HMI.Pal.St_xModSizeArchivedSave) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Step 5: Size save ended]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_InProgress)EQ(UM_Machine.PAL.iSequenceSaveData,5)XIO(UM_HMI.Pal.Rq_xConfirmModSizeArchivedSave)[OTU(UM_HMI.Pal.St_xModSizeArchivedSave) ,TON(Timers.N[305],?,?) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[generate MSG09 Unvalid size or size not set]]>
</Comment>
<Text>
<![CDATA[EQ(UM_Machine.PAL.iSequenceSaveData,101)XIC(UM_Machine.PAL.SizeSave_InProgress)[OTL(BB.Alarm_AuxSizeDataWrongOrNotSet) ,OTL(UM_Machine.PAL.SizeSave_SequenceRestoreRq) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[generate MSG10 Data archive access not allowed]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.SizeSave_RqPulse)XIO(UM_Machine.PAL.SizeSave_ConditionOk)OTL(MSG[13]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PAL_SizeSpeedUpDate" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[save speed update from Sizework to Size storage]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Pal.Rq_xConfirmModWorkingSizeSave)[COP(PAL_SizeWork,PAL_Size[UM_HMI.Pal.St_iActualWorkingSize_Number],1) ,COP(PAL_SizeWork,PAL_SizeDisplayed,1) ,OTL(UM_Machine.PAL.PageRq_UpdateSpeedToSize) ,MOVE(2,Core_HMI.Interface.iPageToDisplay) ,OTU(UM_HMI.Pal.Rq_xConfirmModWorkingSizeSave) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Speed updated text done reset bit]]>
</Comment>
<Text>
<![CDATA[XIC(UM_Machine.PAL.PageRq_UpdateSpeedToSize)XIO(UM_HMI.Pal.Rq_xConfirmModWorkingSizeSave)TON(Timers.N[306],?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Aux page rq reset bit]]>
</Comment>
<Text>
<![CDATA[XIC(Timers.N[306].DN)[MOVE(67,Core_HMI.Interface.iPageToDisplay) ,OTU(UM_Machine.PAL.PageRq_UpdateSpeedToSize) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PAL_SystemData" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Core_HMI.PB.Rq_xPalSysData_ScrollUp)ONS(UM_Machine.axPTrig[47])[ADD(iAux[4],1,iAux[4]) ,GE(iAux[4],DataDefined.PalSysDataNoMax) MOVE(0,iAux[4]) ,LT(iAux[4],0) CPT(iAux[4],DataDefined.PalSysDataNoMax-1) ,MOVE(iAux[4],SYS_Pal.SelSys) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Core_HMI.PB.Rq_xPalSysData_ScrollDown)ONS(UM_Machine.axPTrig[38])[SUB(iAux[4],1,iAux[4]) ,GE(iAux[4],DataDefined.PalSysDataNoMax) MOVE(0,iAux[4]) ,LT(iAux[4],0) CPT(iAux[4],DataDefined.PalSysDataNoMax-1) ,MOVE(iAux[4],SYS_Pal.SelSys) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Core_HMI.PB.Rq_xConfirm_PalSysDataSave)XIO(BB.PalSysData_SaveInProgress)ONS(UM_Machine.axPTrig[39])[OTE(BB.PalSysData_ChangeRq) ,OTU(Core_HMI.PB.Rq_xConfirm_PalSysDataSave) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB.PalSysData_ChangeRq)[MOVE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber) ,OTL(BB.PalSysData_SaveInProgress) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(BB.PalSysData_SaveInProgress) NE(Core_HMI.Interface.iPageDisplayed,67) ,XIC(BB.FirstScan) ]OTU(BB.PalSysData_SaveInProgress);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BB.PalSysData_ChangeRq)XIC(BB.PalSysData_SaveInProgress)[MOVE(SYS_Pal.NewValue,SYS_Pal.N[SYS_Pal.SelSys]) ,MOVE(SYS_Pal.NewValue,SYS_Pal.ActValue) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[GE(SYS_Pal.SelSys,DataDefined.PalSysDataNoMax) ,LT(SYS_Pal.SelSys,0) ][MOVE(iAux[5],SYS_Pal.SelSys) ,OTL(MSG[12]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NE(SYS_Pal.SelSys,iAux[5])[MOVE(SYS_Pal.SelSys,iAux[5]) ,MOVE(SYS_Pal.SelSys,iAux[4]) ,MOVE(SYS_Pal.N[SYS_Pal.SelSys],SYS_Pal.NewValue) ,MOVE(SYS_Pal.N[SYS_Pal.SelSys],SYS_Pal.ActValue) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="PresetTimer" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Core_HMI.PB.Rq_xTimer_ScrollUp)ONS(UM_Machine.axPTrig[28])[ADD(iAux[1],1,iAux[1]) ,GE(iAux[1],DataDefined.TimerNoMax) MOVE(0,iAux[1]) ,LT(iAux[1],0) CPT(iAux[1],DataDefined.TimerNoMax-1) ,MOVE(iAux[1],Timers.No) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Core_HMI.PB.Rq_xTimer_ScrollDown)ONS(UM_Machine.axPTrig[27])[SUB(iAux[1],1,iAux[1]) ,GE(iAux[1],DataDefined.TimerNoMax) MOVE(0,iAux[1]) ,LT(iAux[1],0) CPT(iAux[1],DataDefined.TimerNoMax-1) ,MOVE(iAux[1],Timers.No) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Core_HMI.PB.Rq_xConfirm_TimerSave)XIO(BB.Timer_SaveInProgress)ONS(UM_Machine.axPTrig[26])[OTE(BB.Timer_ChangeRq) ,OTU(Core_HMI.PB.Rq_xConfirm_TimerSave) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB.Timer_ChangeRq)[MOVE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber) ,OTL(BB.Timer_SaveInProgress) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(BB.Timer_SaveInProgress) NE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber) ,XIC(BB.FirstScan) ]OTU(BB.Timer_SaveInProgress);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BB.Timer_ChangeRq)XIC(BB.Timer_SaveInProgress)[MOVE(Timers.NewPreset,Timers.N[Timers.No].PRE) ,MOVE(Timers.NewPreset,Timers.ActPreset) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[GE(Timers.No,DataDefined.TimerNoMax) ,LT(Timers.No,0) ][MOVE(iAux[0],Timers.No) ,OTL(MSG[12]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NE(Timers.No,iAux[0])[MOVE(Timers.No,iAux[0]) ,MOVE(Timers.No,iAux[1]) ,MOVE(Timers.N[Timers.No].PRE,Timers.ActPreset) ,MOVE(Timers.N[Timers.No].PRE,Timers.NewPreset) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="ProductionCounter" Type="RLL">
<Description>
<![CDATA[Siemens FB3]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB.Automatic_CycleActive)OTE(BB.Count_EnableCounts);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB.Clock_500ms)ONS(UM_Machine.axPTrig[5])OTE(BB.Count_PulsePerSecond);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB.Count_EnableCounts)XIC(BB.Count_PulsePerSecond)[ADD(UM_HMI.Production.diPartialCounterSeconds,1,UM_HMI.Production.diPartialCounterSeconds) ,ADD(UM_HMI.Production.diTotalCounterSeconds,1,UM_HMI.Production.diTotalCounterSeconds) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[*************************
Partial Time Section Management
************************]]>
</Comment>
<Text>
<![CDATA[GE(UM_HMI.Production.diPartialCounterSeconds,60)[ADD(UM_HMI.Production.diPartialCounterMin,1,UM_HMI.Production.diPartialCounterMin) ,CLR(UM_HMI.Production.diPartialCounterSeconds) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GE(UM_HMI.Production.diPartialCounterMin,60)[ADD(UM_HMI.Production.diPartialCounterHours,1,UM_HMI.Production.diPartialCounterHours) ,CLR(UM_HMI.Production.diPartialCounterMin) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[*************************
Partial Hours Limit Clear
************************]]>
</Comment>
<Text>
<![CDATA[GE(UM_HMI.Production.diPartialCounterHours,1000000000)CLR(UM_HMI.Production.diPartialCounterHours);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[*************************
Total Time Section Management
************************]]>
</Comment>
<Text>
<![CDATA[GE(UM_HMI.Production.diTotalCounterSeconds,60)[ADD(UM_HMI.Production.diTotalCounterMin,1,UM_HMI.Production.diTotalCounterMin) ,CLR(UM_HMI.Production.diTotalCounterSeconds) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[GE(UM_HMI.Production.diTotalCounterMin,60)[ADD(UM_HMI.Production.diTotalCounterHours,1,UM_HMI.Production.diTotalCounterHours) ,CLR(UM_HMI.Production.diTotalCounterMin) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[*************************
Total Hours Limit Clear
************************]]>
</Comment>
<Text>
<![CDATA[GE(UM_HMI.Production.diTotalCounterHours,1000000000)CLR(UM_HMI.Production.diTotalCounterHours);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[*************************
Partial Time Manual Button Clear
************************]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Production.Rq_xResetPartialCounter_Time)[OTE(UM_HMI.Production.St_xResetPartialCounter_Time) ,CLR(UM_HMI.Production.diPartialCounterSeconds) ,CLR(UM_HMI.Production.diPartialCounterMin) ,CLR(UM_HMI.Production.diPartialCounterHours) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_Time) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Machine cycles]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.CaseP_xRqCountingCycles)[ADD(UM_HMI.Production.diPartialCounterCycles,1,UM_HMI.Production.diPartialCounterCycles) ,ADD(UM_HMI.Production.diTotalCounterCycles,1,UM_HMI.Production.diTotalCounterCycles) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Case good counter]]>
</Comment>
<Text>
<![CDATA[XIC(OM_ShiftCases_HMI.Pos4_Outfeed.St_xCaseGoodness)ONS(UM_Machine.axPTrig[61])[ADD(UM_HMI.Production.diPartialCounterGood,1,UM_HMI.Production.diPartialCounterGood) ,ADD(UM_HMI.Production.diTotalCounterGood,1,UM_HMI.Production.diTotalCounterGood) ,ADD(UM_HMI.Production.diPartialCounterProd,1,UM_HMI.Production.diPartialCounterProd) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Case Reject counter]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.Outfeed_xCountingRejectCases)ONS(UM_Machine.axPTrig[62])[[ADD(UM_HMI.Production.diPartialCounterReject,1,UM_HMI.Production.diPartialCounterReject) ,ADD(UM_HMI.Production.diTotalCounterReject,1,UM_HMI.Production.diTotalCounterReject) ,ADD(UM_HMI.Production.diPartialCounterProd,1,UM_HMI.Production.diPartialCounterProd) ] ,OTU(OM_Interface.Outfeed_xCountingRejectCases) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[CASE NOT FULL COUNTER]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.CaseP_xTransferEnableToPickUp)ONS(UM_Machine.axPTrig[57])XIO(OM_ShiftCases_HMI.Pos2_Closing.St_xCaseFull)[ADD(UM_HMI.Production.diPartialCounterReject_NotFull,1,UM_HMI.Production.diPartialCounterReject_NotFull) ,ADD(UM_HMI.Production.diTotalCounterReject_NotFull,1,UM_HMI.Production.diTotalCounterReject_NotFull) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[FLAPS OPEN COUNTER]]>
</Comment>
<Text>
<![CDATA[XIC(ALRM[246])ONS(UM_Machine.axPTrig[8])[ADD(UM_HMI.Production.diPartialCounterReject_FlapsOpen,1,UM_HMI.Production.diPartialCounterReject_FlapsOpen) ,ADD(UM_HMI.Production.diTotalCounterReject_FlapsOpen,1,UM_HMI.Production.diTotalCounterReject_FlapsOpen) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[PALETTIZER
Robot cases picked up]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.Pal_xRobot_HeadBusy)ONS(UM_Machine.axPTrig[4])XIC(BB.Automatic_CycleActive)[ADD(UM_HMI.Production.diPartialCounterCasePickedup,1,UM_HMI.Production.diPartialCounterCasePickedup) ,ADD(UM_HMI.Production.diTotalCounterCasePickedup,1,UM_HMI.Production.diTotalCounterCasePickedup) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[PALETTIZER
Robot cases placed on pallet]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.Pal_xCaseDepOnPallet)ONS(UM_Machine.axPTrig[2])XIC(BB.Automatic_CycleActive)[ADD(UM_HMI.Production.diPartialCounterCasePlacedonPallet,1,UM_HMI.Production.diPartialCounterCasePlacedonPallet) ,ADD(UM_HMI.Production.diTotalCounterCasePlacedonPallet,1,UM_HMI.Production.diTotalCounterCasePlacedonPallet) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[PALETTIZER
Pallets completed]]>
</Comment>
<Text>
<![CDATA[XIC(DB_Pal_RobotIO.DO.x81)ONS(UM_Machine.axPTrig[3])XIC(BB.Automatic_CycleActive)[ADD(UM_HMI.Production.diPartialCounterPalletCompleted,1,UM_HMI.Production.diPartialCounterPalletCompleted) ,ADD(UM_HMI.Production.diTotalCounterPalletCompleted,1,UM_HMI.Production.diTotalCounterPalletCompleted) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[*************************
Prod Cycles Clear Management
************************]]>
</Comment>
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterCycles,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounter_Cycles) ][OTE(UM_HMI.Production.St_xResetPartialCounter_Cycles) ,CLR(UM_HMI.Production.diPartialCounterCycles) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_Cycles) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterGood,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounter_Good) ][OTE(UM_HMI.Production.St_xResetPartialCounter_Good) ,CLR(UM_HMI.Production.diPartialCounterGood) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_Good) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterReject,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounter_Reject) ][OTE(UM_HMI.Production.St_xResetPartialCounter_Reject) ,CLR(UM_HMI.Production.diPartialCounterReject) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_Reject) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterReject_FlapsOpen,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounter_Reject_FlapsOpen) ][OTE(UM_HMI.Production.St_xResetPartialCounter_Reject_FlapsOpe) ,CLR(UM_HMI.Production.diPartialCounterReject_FlapsOpen) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_Reject_FlapsOpen) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterReject_LabelCtrl,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounter_Reject_LabelCtrl) ][OTE(UM_HMI.Production.St_xResetPartialCounter_Reject_LabelCtrl) ,CLR(UM_HMI.Production.diPartialCounterReject_LabelCtrl) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_Reject_LabelCtrl) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterReject_NotFull,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounter_Reject_NotFull) ][OTE(UM_HMI.Production.St_xResetPartialCounter_Reject_NotFull) ,CLR(UM_HMI.Production.diPartialCounterReject_NotFull) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_Reject_NotFull) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[RP2 Reset partials counter
]]>
</Comment>
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterCasePickedup,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounterCasePickedup) ][OTE(UM_HMI.Production.St_xResetPartialCounterCasePickedup) ,CLR(UM_HMI.Production.diPartialCounterCasePickedup) ,OTU(UM_HMI.Production.Rq_xResetPartialCounterCasePickedup) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterCasePlacedonPallet,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounter_CasePlacedonPall) ][OTE(UM_HMI.Production.St_xResetPartialCounter_CasePlacedonPall) ,CLR(UM_HMI.Production.diPartialCounterCasePlacedonPallet) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_CasePlacedonPall) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterPalletCompleted,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounter_Pallet) ][OTE(UM_HMI.Production.St_xResetPartialCounter_Pallet) ,CLR(UM_HMI.Production.diPartialCounterPalletCompleted) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_Pallet) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[[GE(UM_HMI.Production.diPartialCounterProd,1000000000) ,XIC(UM_HMI.Production.Rq_xResetPartialCounter_Prod) ][OTE(UM_HMI.Production.St_xResetPartialCounter_Prod) ,CLR(UM_HMI.Production.diPartialCounterProd) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_Prod) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Reset tutti i contatori parziali
valutare se implementarlo HMI]]>
</Comment>
<Text>
<![CDATA[[XIC(UM_HMI.Production.Rq_xResetPartialCounter_All) ,XIC(OM_Interface.xRq_ResetCounters_BatchManagement) ][CLR(UM_HMI.Production.diPartialCounterCycles) ,CLR(UM_HMI.Production.diPartialCounterSeconds) ,CLR(UM_HMI.Production.diPartialCounterMin) ,CLR(UM_HMI.Production.diPartialCounterHours) ,CLR(UM_HMI.Production.diPartialCounterGood) ,CLR(UM_HMI.Production.diPartialCounterReject) ,CLR(UM_HMI.Production.diPartialCounterReject_LabelCtrl) ,CLR(UM_HMI.Production.diPartialCounterReject_FlapsOpen) ,CLR(UM_HMI.Production.diPartialCounterReject_NotFull) ,CLR(UM_HMI.Production.diPartialCounterReject_AggrFail) ,CLR(UM_HMI.Production.diPartialCounterCasePickedup) ,CLR(UM_HMI.Production.diPartialCounterCasePlacedonPallet) ,CLR(UM_HMI.Production.diPartialCounterPalletCompleted) ,CLR(UM_HMI.Production.diPartialCounterProd) ,OTU(UM_HMI.Production.Rq_xResetPartialCounter_All) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SizeChange" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB.Count_EnableCheckOfResetCounts)XIO(BB.Count_GrtZero)OTU(BB.Count_EnableCheckOfResetCounts);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GT(UM_HMI.Machine.St_iSizeChange_NewSize_Number,0)XIO(BB.SizeDisplay_InProgress)XIO(BB.SizeSave_InProgress)XIO(BB.SizeCopy_InProgress)XIO(BB.SizeDelete_InProgress)XIO(BB.SizeChange_Inhibition)OTE(BB.SizeChange_ConditionsOk);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_Inhibition)OTU(BB.SizeChange_Inhibition);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[sostituire il PlcPanel.KeyPanel.4 con quello sopra (base)]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Machine.Rq_xConfirmSizeChange)ONS(UM_Machine.axPTrig[24])[XIC(BB.SizeChange_ConditionsOk) OTE(BB.SizeChange_CheckDataRq) ,XIO(BB.SizeChange_ConditionsOk) OTL(MSG[8]) ,OTU(UM_HMI.Machine.Rq_xConfirmSizeChange) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_RestoreRq)[OTU(BB.SizeChange_InProgress) ,OTU(BB.SizeChange_DeviceSizeChangeRq) ,OTU(BB.SizeChange_RestoreRq) ,OTU(BB.SizeChange_OK) ,MOVE(0,UM_HMI.Machine.St_iSizeChange_NewSize_Number) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_PointerIncreaseRq)[ADD(1,SizeAux[2],SizeAux[2]) ,OTU(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_CheckDataRq)JSR(SizeDataCheck,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(BB.SizeChange_OK) ,XIC(BB.SizeChange_RqAdjustmentDataTable) ]XIO(BB.SizeChange_InProgress)[OTU(BB.SetSize) ,OTU(BB.SizeChange_RqAdjustmentDataTable) ,NE(UM_HMI.Machine.St_iSizeChange_NewSize_Number,UM_HMI.Machine.St_iActualWorkingSize_Number) OTL(BB.Count_EnableCheckOfResetCounts) ,OTL(BB.SizeChange_InProgress) ,OTL(UM_HMI.Machine.St_xSizeChange) ,MOVE(1,SizeAux[2]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 1:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],1)OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 2:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],2)OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 3:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],3)[COP(Size[UM_HMI.Machine.St_iSizeChange_NewSize_Number],SizeWork,1) ,MOVE(UM_HMI.Machine.St_iSizeChange_NewSize_Number,UM_HMI.Machine.St_iActualWorkingSize_Number) ,COP(Size[UM_HMI.Machine.St_iSizeChange_NewSize_Number],SizeDisplayed,1) ,MOVE(UM_HMI.Machine.St_iSizeChange_NewSize_Number,UM_HMI.Machine.St_iActualDisplayedSize_Number) ]OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 4:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],4)[MOVE(0,UM_Machine.iDevice_Total) ,MOVE(0,UM_Machine.iDevice_Ok) ,MOVE(0,UM_Machine.iDevice_Bad) ][OTL(BB.SizeChange_Rq) ,OTL(BB.SizeChange_DeviceSizeChangeRq) ,OTL(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Step 5:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],5)[XIC(BB.SizeChange_DataTransferFromAxisOk) ,XIO(UM_Config.Core.Enable_SchneiderAxis) ]OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Step 6:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],6)CMP(UM_Machine.iDevice_Ok+UM_Machine.iDevice_Bad=UM_Machine.iDevice_Total)[OTU(BB.SizeChange_Rq) ,OTL(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)XIC(BB.SizeChange_Rq)EQ(SizeAux[2],6)[MOVE(0,UM_Machine.iDevice_Total) ,MOVE(0,UM_Machine.iDevice_Ok) ,MOVE(0,UM_Machine.iDevice_Bad) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Step 7:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],7)[EQ(UM_Machine.iDevice_Bad,0) [OTL(BB.SizeChange_PointerIncreaseRq) ,OTL(UM_HMI.Machine.St_xSizeChange) ] ,NE(UM_Machine.iDevice_Bad,0) MOVE(102,SizeAux[2]) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Step 8:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],8)XIO(UM_HMI.Machine.Rq_xConfirmSizeChange)TON(Timers.N[128],?,?);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)XIC(Timers.N[128].DN)[OTL(BB.SetSize) ,OTL(BB.SizeChange_RestoreRq) ,OTU(UM_HMI.Machine.St_xSizeChange) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)[TON(Timers.N[121],?,?) ,XIC(Timers.N[121].DN) [OTE(ALRM[25]) ,OTL(BB.SizeChange_RestoreRq) ,OTU(OM_Interface.AutoSizeChange_xInProgress) ,OTU(OM_Interface.AutoSizeChange_xRq) ,MOVE(65,Core_HMI.Interface.iPageToDisplay) ] ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(BB.Machine_Enable)XIO(BB.SetSize)[XIO(BB.SizeChange_InProgress) OTL(MSG[7]) ,OTL(BB.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[EQ(SizeAux[2],102)XIC(BB.SizeChange_InProgress)OTL(BB.SizeChange_RestoreRq);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(BB.Count_EnableCheckOfResetCounts)XIC(BB.Count_GrtZero)[OTL(MSG[17]) ,OTL(BB.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(BB.Count_GrtZero)OTU(BB.Count_GrtZero);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)OTL(MSG[6]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
