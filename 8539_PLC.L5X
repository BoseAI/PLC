<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(EM_CaseF.xRowsManualResetOn)OTL(BB.Movement_InhibitionRq);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[[NE(EM_CaseF.CM_Pusher.AxisOUT_POS_iPosDone,1) ,XIO(UM_Config.CP.EnableHopperTransf) NE(EM_CaseF.CM_Hopper.AxisOUT_POS_iPosDone,1) ,XIC(UM_Config.CP.EnableHopperTransf) NE(EM_CaseF.CM_HopperMaster.AxisOUT_POS_iPosDone,1) ]OTL(OM_Interface.BundleTrans_xInhibit);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[############################
ADVANCE HOPPER ENABLE
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[CPT(EM_CaseF.iWidthTotalRows,OM_Interface.Machine_rProdWidth * SizeWork.Pusher.RowsNr);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[LE(EM_CaseF.iWidthTotalRows,SizeWork.General.HopperDepth)XIC(SizeWork.Pusher.Sel.HopperStackAdvance)OTE(EM_CaseF.xStackInsideHopperEnable);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
