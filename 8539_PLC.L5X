<Rung Number="0" Type="N">
<Text>
<![CDATA[[NE(0,I_Period) [SUB(I_TargetPos,I_DeltaOn,L_OnPos) ADD(L_OnPos,I_Period,L_OnPos) MOD(L_OnPos,I_Period,L_OnPos) ,ADD(I_TargetPos,I_DeltaOff,L_OffPos) ADD(L_OffPos,I_Period,L_OffPos) MOD(L_OffPos,I_Period,L_OffPos) ] ,EQ(0,I_Period) [SUB(I_TargetPos,I_DeltaOn,L_OnPos) ,ADD(I_TargetPos,I_DeltaOff,L_OffPos) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[F_PH_v01(L_PH,I_Enable,I_ActPos,I_Period,I_ActSpeed,L_OnPos,L_OffPos,0,O_InPosition);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
