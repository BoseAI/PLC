<Rung Number="163" Type="N">
<Text>
<![CDATA[[EQ(iq_Axis.AxisIN_CAM_iTypeRephasingMam,2) ,EQ(iq_Axis.AxisIN_CAM_iTypeRephasingMam,3) ,EQ(iq_Axis.AxisIN_CAM_iTypeRephasingMam,4) ]XIC(iq_Axis.AxisIN_CAM_xForwardOnlyAxisTravelUnlimit)OTE(xActiveRephasingRotary);]]>
