<![CDATA[XIC(BB_CRS.Manual_CmdEnable)[XIC(EM_Infeed_HMI_PB_CRS.St_xManual_Trap_ON) ONS(EM_Infeed.axPTrig[10]) [OTL(YV_Trap.iq_xRqON) ,OTU(YV_Trap.iq_xRqOFF) ,OTU(EM_Infeed_HMI_PB_CRS.St_xManual_Trap_OFF) ] ,XIC(EM_Infeed_HMI_PB_CRS.St_xManual_Trap_OFF) ONS(EM_Infeed.axPTrig[11]) [OTL(YV_Trap.iq_xRqOFF) ,OTU(YV_Trap.iq_xRqON) ,OTU(EM_Infeed_HMI_PB_CRS.St_xManual_Trap_ON) ] ];]]>
