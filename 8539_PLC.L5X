<![CDATA[XIC(OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_xPalletPresence)[XIC(OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_xPalletTransit_FWD) MOVE(2,OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_iPallet_Hmi) ,XIC(OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_xPalletTransit_BWD) MOVE(3,OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_iPallet_Hmi) ,XIO(OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_xPalletTransit_FWD) XIO(OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_xPalletTransit_BWD) MOVE(1,OM_ShiftPalChange_HMI.Pos6_Outfeed_Barrier.St_iPallet_Hmi) ];]]>
