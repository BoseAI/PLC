</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(iq_xRqAbort) ,XIC(xRqAbortInt) ][XIC(xAbortEnb) [OTE(xAuxAbort) ,OTU(xMemStarted) ] ,OTU(iq_xHomingDone) ];]]>
