<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)XIC(BB.SizeChange_Rq)EQ(SizeAux[2],6)[MOVE(0,UM_Machine.iDevice_Total) ,MOVE(0,UM_Machine.iDevice_Ok) ,MOVE(0,UM_Machine.iDevice_Bad) ];]]>
