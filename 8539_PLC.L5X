<Text>
<![CDATA[XIC(EM_PalMag_Hmi_PB.Rq_xJog_MagPallet_Enable)[OTL(EM_PalMag_Hmi_PB.St_xJog_MagPallet_Enable) ,OTU(EM_PalMag_Hmi_PB.Rq_xJog_MagPallet_Enable) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Clear Mag Pallet Jog direction]]>
</Comment>
<Text>
<![CDATA[XIO(EM_PalMag_Hmi_PB.St_xJog_MagPallet_Enable)MOVE(0,EM_PalMag_Hmi_PB.Rq_iJog_MagPallet_Direction);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[Mag Pallet: Jog Direction Rq-St copying]]>
</Comment>
<Text>
<![CDATA[MOVE(EM_PalMag_Hmi_PB.Rq_iJog_MagPallet_Direction,EM_PalMag_Hmi_PB.St_iJog_MagPallet_Direction);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[JOG: Mag Pallet Up]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PalMag_Hmi_PB.St_xJog_MagPallet_Enable)EQ(EM_PalMag_Hmi_PB.St_iJog_MagPallet_Direction,1005)XIC(IN.S1100_03)OTE(EM_PalMag.CM_MultiPalletsMagazine.IN_xRqJogUp);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[JOG: Mag Pallet Down]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PalMag_Hmi_PB.St_xJog_MagPallet_Enable)EQ(EM_PalMag_Hmi_PB.St_iJog_MagPallet_Direction,1006)XIC(IN.S1100_03)OTE(EM_PalMag.CM_MultiPalletsMagazine.IN_xRqJogDown);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[///////////////////////////////////////////////////
MANUAL PALLET MAG
///////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Clear Mag Pallet Command Pos - forks Command Pos]]>
</Comment>
<Text>
<![CDATA[[XIC(BB.Automatic_CycleActive) ,XIO(BB.Machine_Ready) ,XIO(BB.SetSize) ,XIC(BB.SizeDisplay_ChangePagePulse) ][MOVE(0,EM_PalMag_Hmi_PB.Rq_iManual_PalletMag_CmdPos) ,MOVE(0,EM_PalMag_Hmi_PB.Rq_iManual_Forks_CmdPos) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Pallet Mag Cmd service message: Manual functions off]]>
</Comment>
<Text>
<![CDATA[NE(EM_PalMag_Hmi_PB.Rq_iManual_PalletMag_CmdPos,0)XIO(BB.Manual_CmdEnable)[OTL(MSG[18]) ,MOVE(0,EM_PalMag_Hmi_PB.Rq_iManual_PalletMag_CmdPos) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Mag Pallet: Clear HMI Rq Command position]]>
</Comment>
<Text>
<![CDATA[EQ(EM_PalMag_Hmi_PB.Rq_iManual_PalletMag_CmdPos,EM_PalMag_Hmi_PB.St_iManual_PalletMag_CmdPos)MOVE(0,EM_PalMag_Hmi_PB.Rq_iManual_PalletMag_CmdPos);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[XIO(BB.AlwaysOFF)EQ(EM_PalMag_Hmi_PB.Rq_iManual_PalletMag_CmdPos,3)OTL(EM_PalMag.CM_MultiPalletsMagazine.IN_xRqManualHigh);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[XIO(BB.AlwaysOFF)EQ(EM_PalMag_Hmi_PB.Rq_iManual_PalletMag_CmdPos,2)OTL(EM_PalMag.CM_MultiPalletsMagazine.IN_xRqManualMiddle);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIO(BB.AlwaysOFF)EQ(EM_PalMag_Hmi_PB.Rq_iManual_PalletMag_CmdPos,1)OTL(EM_PalMag.CM_MultiPalletsMagazine.IN_xRqManualLow);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIO(BB.AlwaysOFF)XIC(UM_Config.PAL.MagPal_EnableSafetyPos)EQ(EM_PalMag_Hmi_PB.Rq_iManual_PalletMag_CmdPos,4)OTL(EM_PalMag.CM_MultiPalletsMagazine.IN_xRqSafetyPos);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[MOVE(0,EM_PalMag_Hmi_PB.St_iManual_PalletMag_CmdPos) ,XIC(EM_PalMag.CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) MOVE(1,EM_PalMag_Hmi_PB.St_iManual_PalletMag_CmdPos) ,XIC(EM_PalMag.CM_MultiPalletsMagazine.OUT_xMagazineInMiddlePos) MOVE(2,EM_PalMag_Hmi_PB.St_iManual_PalletMag_CmdPos) ,XIC(EM_PalMag.CM_MultiPalletsMagazine.OUT_xMagazineInHighPos) MOVE(3,EM_PalMag_Hmi_PB.St_iManual_PalletMag_CmdPos) ,XIC(EM_PalMag.CM_MultiPalletsMagazine.OUT_xMagazineInSafetyPos) XIC(UM_Config.PAL.MagPal_EnableSafetyPos) MOVE(4,EM_PalMag_Hmi_PB.St_iManual_PalletMag_CmdPos) ];]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Comment>
<![CDATA[///////////////////////////////////////////////////
MANUAL FORK PNEUM
///////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[Fork Cmd Position, service message: Manual functions off
]]>
</Comment>
<Text>
<![CDATA[NE(EM_PalMag_Hmi_PB.Rq_iManual_Forks_CmdPos,0)XIO(BB.Manual_CmdEnable)[OTL(MSG[18]) ,MOVE(0,EM_PalMag_Hmi_PB.Rq_iManual_Forks_CmdPos) ];]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[Closing Fork HMI Rq]]>
</Comment>
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[EQ(EM_PalMag_Hmi_PB.Rq_iManual_Forks_CmdPos,1) OTL(EM_PalMag.CM_MultiPalletsMagazine.IN_xRqForkClosing) ,EQ(EM_PalMag_Hmi_PB.Rq_iManual_Forks_CmdPos,3) OTL(EM_PalMag.CM_MultiPalletsMagazine.IN_xRqForkOpening) ];]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Comment>
<![CDATA[Fork: Closed Position Reached]]>
</Comment>
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[XIC(EM_PalMag.CM_MultiPalletsMagazine.OUT_xClosedFork) MOVE(1,EM_PalMag_Hmi_PB.St_iManual_Forks_CmdPos) ,XIC(EM_PalMag.CM_MultiPalletsMagazine.OUT_xOpenedFork) MOVE(3,EM_PalMag_Hmi_PB.St_iManual_Forks_CmdPos) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CM_PalMag_PneumaticCircuit" Type="RLL">
