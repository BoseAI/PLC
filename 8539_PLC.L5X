<Rung Number="4" Type="N">
<Text>
<![CDATA[MOVE(EM_PalMag.CM_Encoder_PalletMagazine.lrActualPos,EM_PalMag_Hmi_PB.St_iAxisPosition_MagPallet);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[/////////////////////////////////////////////////////////////
PARAMETERIZATION ADDON MAGAZINE MULTI PALLET
/////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
