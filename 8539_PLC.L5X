<Routines>
<Routine Name="AlarmView_TEMP" Type="ST">
<Description>
<![CDATA[da cancellare]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[j := 0;]]>
</Line>
<Line Number="1">
<![CDATA[IF(BB_CRS.Alarm_ResetRqPulse) then]]>
</Line>
<Line Number="2">
<![CDATA[for k := 0 TO 63 BY 1 DO]]>
</Line>
<Line Number="3">
<![CDATA[	Num_Alrm_CRS[k]:=0;]]>
</Line>
<Line Number="4">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[FOR k := 0 TO 1023 BY 1 DO]]>
</Line>
<Line Number="7">
<![CDATA[	IF ALRM_CRS[k] then]]>
</Line>
<Line Number="8">
<![CDATA[		Num_Alrm_CRS[j]:=k;]]>
</Line>
<Line Number="9">
<![CDATA[		j := j+1;]]>
</Line>
<Line Number="10">
<![CDATA[	End_IF;]]>
</Line>
<Line Number="11">
<![CDATA[end_for;]]>
</Line>
</STContent>
</Routine>
<Routine Name="AuxFirstScan" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[CPS(IN_Clear_CRS,IN_CRS,1) ,CPS(OUT_Clear_CRS,OUT_CRS,1) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CPS(UM_Config_Clear_CRS,UM_Config_CRS,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(0,Core_HMI_CRS.Interface.iPasswordState)MOVE('guest',CurrentUserName_CRS);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[OTU(xCipDrive_Ready);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CM_BatteryCheck" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(Timers_CRS.N[126].DN) TON(Timers_CRS.N[126],?,?) ,XIC(Timers_CRS.N[126].DN) GSV(FaultLog,,MinorFaultBits,diDataDWord[2]) ,XIC(diDataDWord[2].10) OTE(BB_CRS.WrngRq_PlcBattery) ,XIC(BB_CRS.Automatic_CycleActive) XIC(BB_CRS.WrngRq_PlcBattery) OTL(WRNG_CRS[20]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
