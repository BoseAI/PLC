<Routine Name="CM_Pneum_LowerTraps" Type="RLL">
<Description>
<![CDATA[v0.2        : 28/03/2022
Author      : Ing.Arsene Silviu 
Comment:Closing traps when the trapper exceeds their pos

v0.1        : Initial creation
Author      : Ing.Utili Nicola
Comment: Note software
Last Change : 02.10.2020]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[**************************
Logic add Traps
**************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[m218.0]]>
</Comment>
<Text>
<![CDATA[NE(SizeWork.Infeed.FifthFlapEnable,0)OTE(EM_Infeed.Stacker_xFifthFlapEnable);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[NE(SYS.N[131],0)OTE(EM_Infeed.Stacker_xOpenTrapsEnable);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed.Stacker_xOpenTrapsEnable) GT(EM_Infeed.Stacker_iActualPosWithProd,SYS.N[5]) ,EQ(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,1) ,EQ(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,2) ][OTU(YV_Traps.iq_xRqON) ,OTL(YV_Traps.iq_xRqOFF) ,OTL(EM_Infeed.Stacker_xOpenIntTrapsInhibit) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed.Stacker_xPreStackerExclusion) ,[XIC(EM_Infeed.Stacker_xFifthFlapEnable) ,XIC(EM_Infeed.Stacker_xOpenTrapsEnable) ] GT(EM_Infeed.Stacker_iActualPosWithProd,SYS.N[5]) XIO(EM_Infeed.Stacker_xOpenIntTrapsInhibit) ONS(EM_Infeed.axPTrig[2]) ][OTL(YV_Traps.iq_xRqON) ,OTU(YV_Traps.iq_xRqOFF) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[m195.5]]>
</Comment>
<Text>
<![CDATA[[EQ(EM_Infeed.CM_Stacker.AxisOUT_POS_iPosDone,1) ,XIO(EM_Infeed.Stacker_xOpenTrapsEnable) XIO(EM_Infeed.Stacker_xFifthFlapEnable) ]OTU(EM_Infeed.Stacker_xOpenIntTrapsInhibit);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[**************************
Cmd Traps
**************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(BB.AlwaysOFF)[OTL(YV_Traps.iq_xRqON) ,OTU(YV_Traps.iq_xRqON) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(BB.AlwaysOFF)[OTU(YV_Traps.iq_xRqON) ,OTL(YV_Traps.iq_xRqOFF) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(YV_Traps.q_xCmdON)OTE(YV_Traps.i_xSensorON);]]>
</Text>
</Rung>
