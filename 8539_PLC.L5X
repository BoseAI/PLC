<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB.Count_EnableCheckOfResetCounts)XIO(BB.Count_GrtZero)OTU(BB.Count_EnableCheckOfResetCounts);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_Inhibition)[OTU(OM_Interface.AutoSizeChange_xRq) ,OTE(OM_Interface.AutoSizeChange_xInhibition) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[GT(UM_HMI.Machine.St_iSizeChange_NewSize_Number,0)XIO(BB.SizeDisplay_InProgress)XIO(BB.SizeSave_InProgress)XIO(BB.SizeCopy_InProgress)XIO(BB.SizeDelete_InProgress)XIO(BB.SizeChange_Inhibition)OTE(BB.SizeChange_ConditionsOk);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_Inhibition)OTU(BB.SizeChange_Inhibition);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(UM_HMI.Machine.Rq_xConfirmSizeChange)ONS(UM_Machine.axPTrig[23])[XIC(BB.SizeChange_ConditionsOk) OTE(BB.SizeChange_CheckDataRq) ,XIO(BB.SizeChange_ConditionsOk) OTL(MSG[8]) ,OTU(UM_HMI.Machine.Rq_xConfirmSizeChange) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_RestoreRq)[OTU(BB.SizeChange_InProgress) ,OTU(BB.SizeChange_DeviceSizeChangeRq) ,OTU(BB.SizeChange_RestoreRq) ,OTU(BB.SizeChange_OK) ,MOVE(0,UM_HMI.Machine.St_iSizeChange_NewSize_Number) ,OTL(BB.SizeChange_InProgress_completed) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_PointerIncreaseRq)[ADD(1,SizeAux[2],SizeAux[2]) ,OTU(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_CheckDataRq)JSR(SizeDataCheck,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_OK)XIO(BB.SizeChange_InProgress)[NE(UM_HMI.Machine.St_iSizeChange_NewSize_Number,UM_HMI.Machine.St_iActualWorkingSize_Number) OTL(BB.Count_EnableCheckOfResetCounts) ,ONS(UM_Machine.axPTrig[22]) OTL(OM_Interface.AutoSizeChange_xRq) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_OK)XIO(BB.SizeChange_InProgress)[OTU(BB.SetSize) ,OTU(BB.SizeChange_RqAdjustmentDataTable) ,OTL(BB.SizeChange_InProgress) ,MOVE(1,SizeAux[2]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 1:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],1)OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 2:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],2)OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Step 3:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],3)[COP(Size[UM_HMI.Machine.St_iSizeChange_NewSize_Number],SizeWork,1) ,MOVE(UM_HMI.Machine.St_iSizeChange_NewSize_Number,UM_HMI.Machine.St_iActualWorkingSize_Number) ,COP(Size[UM_HMI.Machine.St_iSizeChange_NewSize_Number],SizeDisplayed,1) ,MOVE(UM_HMI.Machine.St_iSizeChange_NewSize_Number,UM_HMI.Machine.St_iActualDisplayedSize_Number) ]OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Step 4:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],4)[MOVE(0,UM_Machine.iDevice_Total) ,MOVE(0,UM_Machine.iDevice_Ok) ,MOVE(0,UM_Machine.iDevice_Bad) ][OTL(BB.SizeChange_Rq) ,OTL(BB.SizeChange_DeviceSizeChangeRq) ,OTL(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Step 5:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],5)[XIC(BB.SizeChange_DataTransferFromAxisOk) ,XIO(UM_Config.Core.Enable_SchneiderAxis) ]OTL(BB.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Step 6:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],6)CMP(UM_Machine.iDevice_Ok+UM_Machine.iDevice_Bad=UM_Machine.iDevice_Total)[OTU(BB.SizeChange_Rq) ,OTL(BB.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Step 7:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],7)[EQ(UM_Machine.iDevice_Bad,0) OTL(BB.SizeChange_PointerIncreaseRq) ,NE(UM_Machine.iDevice_Bad,0) MOVE(102,SizeAux[2]) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Step 8:]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)EQ(SizeAux[2],8)XIO(UM_HMI.Machine.Rq_xConfirmSizeChange)TON(Timers.N[128],?,?);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)XIC(Timers.N[128].DN)[OTL(BB.SetSize) ,OTL(BB.SizeChange_RestoreRq) ,OTU(UM_HMI.Machine.St_xSizeChange) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)[TON(Timers.N[120],?,?) ,XIC(Timers.N[120].DN) [OTE(ALRM[25]) ,OTL(BB.SizeChange_RestoreRq) ,OTU(OM_Interface.AutoSizeChange_xInProgress) ,OTU(OM_Interface.AutoSizeChange_xRq) ] ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(BB.Machine_Enable)XIO(BB.SetSize)[XIO(BB.SizeChange_InProgress) OTL(MSG[7]) ,OTL(BB.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[EQ(SizeAux[2],102)XIC(BB.SizeChange_InProgress)OTL(BB.SizeChange_RestoreRq);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(BB.Count_EnableCheckOfResetCounts)XIC(BB.Count_GrtZero)[OTL(MSG[17]) ,OTL(BB.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(BB.Count_GrtZero)OTU(BB.Count_GrtZero);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(BB.SizeChange_InProgress)OTL(MSG[6]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SizeCopy" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Page save for size copy]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_RqPulse)XIC(BB.SizeCopy_ConditionOk)[MOVE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber) ,OTL(BB.SizeCopy_FunctionKeyCopyDone) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Function key auxiliary after copy done reset]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_FunctionKeyCopyDone)NE(Core_HMI.Interface.iPageDisplayed,Core_HMI.Interface.iSavingPageNumber)OTU(BB.SizeCopy_FunctionKeyCopyDone);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Size copy conditions]]>
</Comment>
<Text>
<![CDATA[GT(UM_HMI.Machine.St_iSizeToDisplay_Number,0)XIO(BB.SizeChange_InProgress)XIO(BB.SizeDisplay_InProgress)XIO(BB.SizeSave_InProgress)XIO(BB.SizeDelete_InProgress)OTE(BB.SizeCopy_ConditionOk);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Copy size Rq
]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI.Machine.Rq_xConfirmSizeCopy)ONS(UM_Machine.axPTrig[21])[OTE(BB.SizeCopy_RqPulse) ,OTU(UM_HMI.Machine.Rq_xConfirmSizeCopy) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Restore size copy sequence
]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_SequenceRestoreRq)[OTU(BB.SizeCopy_InProgress) ,OTU(BB.SizeCopy_SequenceRestoreRq) ,MOVE(0,UM_HMI.Machine.Rq_iSizeCopy_Destination) ,MOVE(0,UM_HMI.Machine.St_iSizeCopy) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Increase pointer size copy
]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_PointerIncreaseRq)[ADD(1,SizeAux[5],SizeAux[5]) ,OTU(BB.SizeCopy_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Preset size copy]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_RqPulse)XIO(BB.SizeCopy_InProgress)MOVE(1,SizeAux[5]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Sequence start size copy]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_RqPulse)XIC(BB.SizeCopy_ConditionOk)[OTL(BB.SizeCopy_InProgress) ,MOVE(2,UM_HMI.Machine.St_iSizeCopy) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 1: Check size number between limits
]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_InProgress)EQ(SizeAux[5],1)[LIMIT(1,UM_HMI.Machine.Rq_iSizeCopy_Destination,SizeAux[17]) OTL(BB.SizeCopy_PointerIncreaseRq) ,[GT(UM_HMI.Machine.Rq_iSizeCopy_Destination,SizeAux[17]) ,LT(UM_HMI.Machine.Rq_iSizeCopy_Destination,1) ] [MOVE(101,SizeAux[5]) ,MOVE(12,UM_HMI.Machine.St_iSizeCopy) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 2: Check existing size (not emty), predisposition]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_InProgress)EQ(SizeAux[5],2)[NE(Size[UM_HMI.Machine.St_iSizeToDisplay_Number].WorkingCode,'') OTL(BB.SizeCopy_PointerIncreaseRq) ,EQ(Size[UM_HMI.Machine.St_iSizeToDisplay_Number].WorkingCode,'') [MOVE(101,SizeAux[5]) ,MOVE(12,UM_HMI.Machine.St_iSizeCopy) ] ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 3: Check size data correct, predisposition
]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_InProgress)EQ(SizeAux[5],3)OTL(BB.SizeCopy_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 4: Rq. Size copy in progress and on display
]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_InProgress)EQ(SizeAux[5],4)COP(Size[UM_HMI.Machine.St_iSizeToDisplay_Number],Size[UM_HMI.Machine.Rq_iSizeCopy_Destination],1)OTL(BB.SizeCopy_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Step 5: Size copy ended]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_InProgress)EQ(SizeAux[5],5)XIO(UM_HMI.Machine.Rq_xConfirmSizeCopy)[TON(Timers.N[129],?,?) ,MOVE(4,UM_HMI.Machine.St_iSizeCopy) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Size copy sequence restore request]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_InProgress)XIC(Timers.N[129].DN)OTL(BB.SizeCopy_SequenceRestoreRq);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[generate MSG09 Unvalid size or size not set]]>
</Comment>
<Text>
<![CDATA[EQ(SizeAux[5],101)XIC(BB.SizeCopy_InProgress)[OTL(BB.Alarm_AuxSizeDataWrongOrNotSet) ,OTL(BB.SizeCopy_SequenceRestoreRq) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[generate MSG10 Data archive access not allowed]]>
</Comment>
<Text>
<![CDATA[XIC(BB.SizeCopy_RqPulse)XIO(BB.SizeSave_ConditionOk)OTL(MSG[13]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SizeDataCheck" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CLR(SYS.N[0]);]]>
</Text>
