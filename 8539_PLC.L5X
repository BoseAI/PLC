</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(OM_Interface.PalMag_xPnumaticEnergyEnabled)OTE(EM_PalMag.CM_MultiPalletsMagazine.HW_IN_xAirOK);]]>
