<Routine Name="CPH2_RP4_ResetPB_OppOpSide" Type="RLL" SafetySignature="D476549D - 73F3F2F0 - 74B256C8 - 85482CF6 - B5196B32 - 4535081E - C2EF643F - 3BA23D57" SafetySignatureTimestamp="12/10/2025, 10:12:51.707 AM">
<Description>
<![CDATA[Reset Carter 7]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(sDCS.S1491.DCS.FP)XIC(SafetyIN.S1491_01_CH0)XIC(SafetyIN.S1491_01_CH1)XIC(SafetyValidationInterface.31)OSF(sDCS.axFTrig[10],sDCS.xFEdgeResetOppOperatorSideAutoReset);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(K0605_01:8:I.Pt03Status)XIC(K0605_01:8:I.Pt04Status)OTE(sDCS.S1491.InputStatus);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[RESET PB (OPP OPERATOR SIDE)]]>
</Comment>
<Text>
<![CDATA[DCS(sDCS.S1491.DCS,USER DEFINED,EQUIVALENT - ACTIVE HIGH,500,AUTOMATIC,AUTOMATIC,SafetyIN.S1491_01_CH0,SafetyIN.S1491_01_CH1,sDCS.S1491.InputStatus,sDCS.xFEdgeResetOppOperatorSideAutoReset);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(sDCS.S1491.DCS.O1)OSF(sDCS.axFTrig[11],sDCS.sDCSxFEdgeOppOperatorSide_PBSafetyRESET);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[*********************************************************************************************************************************************
ISO 13849-1 stipulates that instruction reset functions must occur on falling edge signals.
To comply with this requirement, add a One Shot Falling instruction to the rung immediately preceding the OutputEnable rung, 
then use the OSF instruction Output Bit tag as the Reset bit for the following rung. 
The CROut_Enable bit is then used to Enable the CROUT instruction.
*********************************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(sDCS.sDCSxFEdgeOppOperatorSide_PBSafetyRESET)XIO(sDCS.S1491.DCS.FP)OSF(sDCS.axFTrig[12],sDCS.xFEdgeOppOpSideBlockReset);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
