<Rung Number="51" Type="N">
<Text>
<![CDATA[XIC(iq_xRqHome)XIO(iq_Robot_DO.x01)OTL(iq_xMsgHomeNotPossible);]]>
</Text>
</Rung>
<Rung Number="52" Type="N">
<Text>
<![CDATA[XIC(iq_xRqHome)OTU(iq_xRqHome);]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Text>
<![CDATA[XIC(iq_xHomingDone)NE(iq_Robot_GO.i05,0)OTU(iq_xHomingDone);]]>
</Text>
</Rung>
<Rung Number="54" Type="N">
<Comment>
<![CDATA[Robot program start in progress]]>
</Comment>
<Text>
<![CDATA[XIC(iq_xRqStart)[XIO(xMemStarted) XIC(iq_Robot_DO.x01) XIO(iq_Robot_DO.x03) [OTL(xStartInProg) ,OTU(iq_xHomingDone) ] ,OTU(iq_xRqStart) ];]]>
</Text>
</Rung>
<Rung Number="55" Type="N">
<Text>
<![CDATA[XIC(xStartInProg)XIO(iq_Robot_DO.x03)[XIO(iq_Robot_DO.x04) OTE(xStartPrg) ,XIC(iq_Robot_DO.x04) OTE(xContinuePrg) ];]]>
</Text>
</Rung>
<Rung Number="56" Type="N">
<Text>
<![CDATA[XIC(xStartPrg)XIO(iq_Robot_DO.x11)OTE(iq_Robot_DI.x09);]]>
</Text>
</Rung>
<Rung Number="57" Type="N">
<Comment>
<![CDATA[Robot alarm active]]>
</Comment>
<Text>
<![CDATA[XIC(xContinuePrg)XIC(i_xClock_800ms)OTE(iq_Robot_DI.x06);]]>
</Text>
</Rung>
<Rung Number="58" Type="N">
<Comment>
<![CDATA[Memory robot program started]]>
</Comment>
<Text>
<![CDATA[XIC(iq_Robot_DO.x03)[XIC(xStartInProg) OTL(xMemStarted) ,[XIC(xMemStarted) ,XIC(q_xManRobot) ] [OTE(q_xStartRobot) ,OTU(xStartInProg) ] ];]]>
</Text>
</Rung>
<Rung Number="59" Type="N">
<Text>
<![CDATA[[XIC(xStartInProg) XIO(iq_Robot_DO.x03) OTE(Ifb_TOStartRobot.I_xSensor) ,InputFilter(Ifb_TOStartRobot,i_tTStartRobot,0) ];]]>
</Text>
</Rung>
<Rung Number="60" Type="N">
<Text>
<![CDATA[XIC(Ifb_TOStartRobot.Q_xSensor)[OTE(q_xAlrmStartRobot) ,OTL(iq_xRqStopImm) ,OTU(xStartInProg) ];]]>
</Text>
</Rung>
<Rung Number="61" Type="N">
<Text>
<![CDATA[XIC(iq_xRqStop)[OTL(xStopInProg) ,OTU(iq_xRqStop) ,OTU(xMemStarted) ];]]>
</Text>
</Rung>
<Rung Number="62" Type="N">
<Comment>
<![CDATA[Request pause Fanuc program]]>
</Comment>
<Text>
<![CDATA[XIC(xStopInProg)[OTL(iq_xRqHold) ,OTU(xMemStarted) ];]]>
</Text>
</Rung>
<Rung Number="63" Type="N">
<Text>
<![CDATA[XIC(xStopInProg)XIC(q_xHoldRobot)OTU(xStopInProg);]]>
</Text>
</Rung>
<Rung Number="64" Type="N">
<Comment>
<![CDATA[Request start program Fanuc]]>
</Comment>
<Text>
<![CDATA[XIO(iq_Robot_DO.x01)[OTU(iq_xRqStart) ,OTU(iq_xRqStop) ];]]>
</Text>
</Rung>
<Rung Number="65" Type="N">
<Comment>
<![CDATA[Robot short stop (active low)]]>
</Comment>
<Text>
<![CDATA[XIO(iq_xRqHold)OTE(iq_Robot_DI.x02);]]>
</Text>
</Rung>
<Rung Number="66" Type="N">
<Text>
<![CDATA[XIC(iq_Robot_DO.x05)OTE(q_xHoldRobot);]]>
</Text>
</Rung>
<Rung Number="67" Type="N">
<Text>
<![CDATA[XIC(q_xHoldRobot)OTU(iq_xRqHold);]]>
</Text>
</Rung>
<Rung Number="68" Type="N">
<Comment>
<![CDATA[Emergency with immediate stop of fanuc robot]]>
</Comment>
<Text>
<![CDATA[XIC(q_xStopImm)XIC(iq_BB.Machine_Enable)OTU(q_xStopImm);]]>
</Text>
</Rung>
<Rung Number="69" Type="N">
<Comment>
<![CDATA[Emergency with immediate stop of fanuc robot]]>
</Comment>
<Text>
<![CDATA[[XIC(iq_xRqStopImm) ,[XIC(iq_BB.St_Emergency_ImmediateStop) XIC(DB_Force.Bit[13]) ,XIC(i_xEmgStop) XIO(DB_Force.Bit[13]) ] ONS(xPulse2) ][OTL(q_xStopImm) ,OTU(iq_xRqStopImm) ];]]>
</Text>
</Rung>
<Rung Number="70" Type="N">
<Text>
<![CDATA[XIO(iq_Robot_DO.x01)XIO(i_xSelRobotON_OFF)OTL(iq_BB.Automatic_CycleInhibition);]]>
</Text>
</Rung>
<Rung Number="71" Type="N">
<Comment>
<![CDATA[Automatic cycle robot]]>
</Comment>
<Text>
<![CDATA[XIC(iq_BB.Automatic_CycleActive)XIO(q_xStopImm)XIC(iq_BB.SetSize)OTE(q_xAutoRobot);]]>
</Text>
</Rung>
<Rung Number="72" Type="N">
<Text>
<![CDATA[XIC(iq_xKeyJogRobot)XIO(i_xAbManual)[OTL(iq_xMsgManualOFF) ,OTU(iq_xKeyJogRobot) ];]]>
</Text>
</Rung>
<Rung Number="73" Type="N">
<Text>
<![CDATA[XIO(i_xMcOk)OTU(iq_xKeyJogRobot);]]>
</Text>
</Rung>
<Rung Number="74" Type="N">
<Comment>
<![CDATA[Manual cycle robot]]>
</Comment>
<Text>
<![CDATA[[XIC(iq_xKeyJogRobot) XIC(i_xJogMan) ,XIC(xMemBypass) XIC(iq_Robot_DO.x23) ]XIC(i_xAbManual)XIC(iq_BB.SetSize)XIO(q_xStopImm)[OTE(q_xManRobot) ,OTU(xMemStarted) ];]]>
</Text>
</Rung>
<Rung Number="75" Type="N">
<Text>
<![CDATA[XIC(iq_xKeyJogRobot)OTL(xMemBypass);]]>
</Text>
</Rung>
<Rung Number="76" Type="N">
<Text>
<![CDATA[XIO(iq_xKeyJogRobot)XIO(iq_Robot_DO.x23)OTU(xMemBypass);]]>
</Text>
</Rung>
<Rung Number="77" Type="N">
<Text>
<![CDATA[[XIC(iq_xKeyJogRobot) XIC(i_xJogMan) OTE(Ifb_RitStopJogRbt.I_xSensor) ,InputFilter(Ifb_RitStopJogRbt,0,10) ];]]>
</Text>
</Rung>
<Rung Number="78" Type="N">
<Text>
<![CDATA[XIC(i_xAbManual)XIO(iq_Robot_DO.x08)XIO(q_xManRobot)XIC(iq_Robot_DO.x03)XIC(Ifb_RitStopJogRbt.Q_xSensor)OTL(iq_xRqHold);]]>
</Text>
</Rung>
<Rung Number="79" Type="N">
<Comment>
<![CDATA[Alarm: teach pendant robot enabled]]>
</Comment>
<Text>
<![CDATA[XIC(iq_Robot_DO.x08)ONS(xPulse3)[OTE(q_xAlrmTCP) ,OTL(iq_xRqStopImm) ,OTL(xMemTCP) ];]]>
</Text>
</Rung>
<Rung Number="80" Type="N">
<Text>
<![CDATA[XIC(i_xRqCheckHeightRbt)OTL(xMemTCP);]]>
</Text>
</Rung>
<Rung Number="81" Type="N">
<Text>
<![CDATA[XIC(iq_Robot_DO.x07)XIO(iq_Robot_DO.x08)OTU(xMemTCP);]]>
</Text>
</Rung>
<Rung Number="82" Type="N">
<Comment>
<![CDATA[Homing min. height request]]>
</Comment>
<Text>
<![CDATA[[XIC(xMemTCP) [OTE(iq_Robot_DI.x16) ,XIC(iq_Robot_DO.x08) OSF(xOSFStorageBit,xPulse5) ] ,XIC(xPulse5) OTL(xRqAbortInt) ];]]>
</Text>
</Rung>
<Rung Number="83" Type="N">
<Comment>
<![CDATA[Alarm: minimum Height]]>
</Comment>
<Text>
<![CDATA[XIC(xMemTCP)XIC(iq_Robot_DO.x16)XIO(iq_Robot_DO.x08)[OTE(q_xAlrmMinHeight) ,OTL(iq_xRqStopImm) ,OTU(xHomeInProg) ];]]>
</Text>
</Rung>
<Rung Number="84" Type="N">
<Text>
<![CDATA[XIC(iq_Robot_DO.x08)XIC(iq_Robot_DO.x02)OTL(iq_xRqForceEnable);]]>
</Text>
</Rung>
<Rung Number="85" Type="N">
<Comment>
<![CDATA[Alarm: robot mode selector not set to automatic]]>
</Comment>
<Text>
<![CDATA[XIO(iq_Robot_DO.x13)ONS(xPulse4)[OTE(q_xAlrmAutoMode) ,OTL(iq_xRqStopImm) ];]]>
</Text>
</Rung>
<Rung Number="86" Type="N">
<Text>
<![CDATA[XIC(iq_Robot_DO.x09)OTL(iq_xMsgBattery);]]>
</Text>
</Rung>
<Rung Number="87" Type="N">
<Text>
<![CDATA[XIC(iq_Robot_DO.x08)[[XIC(i_xRqMov) ,XIC(i_xRqInhChangeFormatFromPanel) ,XIC(i_xMcOk) ] OTL(iq_xMsgTCP) ,OTL(iq_BB.SizeChange_Inhibition) ];]]>
</Text>
</Rung>
<Rung Number="88" Type="N">
<Text>
<![CDATA[XIO(iq_Robot_DO.x13)[[XIC(i_xRqMov) ,XIC(i_xRqInhChangeFormatFromPanel) ,XIC(i_xMcOk) ] OTL(iq_xMsgAutoMode) ,OTL(iq_BB.SizeChange_Inhibition) ];]]>
</Text>
</Rung>
<Rung Number="89" Type="N">
<Text>
<![CDATA[[[XIC(q_xStopImm) ,XIO(iq_Robot_DI.x02) ] XIC(iq_Robot_DO.x23) [OTL(iq_Robot_DI.x20) ,XIO(i_xMcOk) XIC(iq_Robot_DO.x03) OTE(iq_Robot_DI.x23) ] ,XIC(i_xMcOk) XIO(iq_Robot_DO.x23) OTU(iq_Robot_DI.x20) ];]]>
</Text>
</Rung>
<Rung Number="90" Type="N">
<Comment>
<![CDATA[Alarm: Torque check]]>
</Comment>
<Text>
<![CDATA[XIC(iq_Robot_DO.x45)[OTE(q_xAlrmTorqueCheck) ,OTL(iq_xRqStopImm) ,OTL(xRqAbortInt) ];]]>
</Text>
</Rung>
<Rung Number="91" Type="N">
<Comment>
<![CDATA[Alarm: Software error]]>
</Comment>
<Text>
<![CDATA[XIC(iq_Robot_DO.x20)[OTE(q_xAlrmSoftwareError) ,OTL(iq_xRqStopImm) ];]]>
</Text>
</Rung>
<Rung Number="92" Type="N">
<Text>
<![CDATA[[XIC(iq_Robot_DO.x22) OTE(Ifb_RitOutOfWorkingArea.I_xSensor) ,InputFilter(Ifb_RitOutOfWorkingArea,i_tTRobotOutOfWorkingArea,0) ];]]>
</Text>
</Rung>
<Rung Number="93" Type="N">
<Text>
<![CDATA[XIC(Ifb_RitOutOfWorkingArea.Q_xSensor)[OTE(q_xAlrmRobotOutOfWorkingArea) ,OTL(iq_xRqStopImm) ];]]>
</Text>
</Rung>
<Rung Number="94" Type="N">
<Comment>
<![CDATA[DA QUI IN POI RAMI RIMOSSI]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="95" Type="N">
<Comment>
<![CDATA[First Scan Program]]>
</Comment>
<Text>
<![CDATA[XIC(S:FS)[OTL(xRbtDisable) ,OTU(iq_xHomingDone) ,OTU(iq_xRqStopImm) ,OTU(iq_xRqAbort) ,OTU(iq_xRqHold) ,OTU(iq_xRqForceEnable) ,OTU(iq_xRqHome) ,OTU(iq_xRqMaintenance) ,OTU(iq_xRqMaintHeadChange) ,OTU(iq_xRqStart) ,OTU(iq_xRqStop) ,OTU(iq_xKeyJogRobot) ,OTU(iq_xMsgHomeNotPossible) ,OTU(iq_xMsgBattery) ,OTU(iq_xMsgTCP) ,OTU(iq_xMsgAutoMode) ,OTU(iq_xMsgHomeInProgress) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
