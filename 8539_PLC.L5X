</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(iq_Robot_DO.x21) ONS(xPulse6) ,XIO(iq_Robot_DO.x21) ONS(xPulse7) ]TOF(Ifb_RobotON,?,?);]]>
