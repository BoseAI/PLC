</Comment>
<Text>
<![CDATA[XIC(EM_Pal_HMI_PB.Rq_xSampling)[XIO(EM_PAL.Sampling_xCASE_IN_EXIT) OTL(EM_PAL.Sampling_xIN_PROGRESS) ,XIC(EM_PAL.Sampling_xCASE_IN_EXIT) OTL(MSG[12]) ,OTU(EM_Pal_HMI_PB.Rq_xSampling) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[EMPTYING RESET SAMPLING REQUEST IF NOT ACTIVE]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Empty.xEnable)XIO(OM_ShiftCases_HMI.Pos2_Closing.St_xCasePresence)XIO(OM_ShiftCases_HMI.Pos3_Outfeed.St_xCasePresence)XIO(OM_ShiftCases_HMI.Pos4_Outfeed.St_xCasePresence)XIO(EM_PAL.Sampling_xCASE_SELECTED)OTU(EM_PAL.Sampling_xIN_PROGRESS);]]>
