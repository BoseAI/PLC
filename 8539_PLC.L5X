</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletPresenceUnderMag) ,XIC(OM_ShiftPalChange_HMI.Pos2_Infeed_Wait.St_xPalletPresence) ,XIC(OUT.K7903_01_FWD) ]OTE(EM_PalMag.CM_MultiPalletsMagazine.IN_xLower_Inhibition);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////////////////////////////////
EM_PalMag.CM_MultiPalletsMagazine.IN_xMachineMoving = FALSE => necessary imemdiate alrm for stop Inverter
//////////////////////////////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[XIC(BB.AlwaysOFF)OTE(EM_PalMag.CM_MultiPalletsMagazine.IN_xMachineMoving);]]>
