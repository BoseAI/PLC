<![CDATA[XIC(iq_Axis.AxisOUT_POS_xInPos)XIC(iq_Axis.AxisOUT_HOME_xHomeDone)EQ(iq_Axis.AxisIN_POS_arTargetPos[iq_Axis.AxisIN_POS_iRqPos],iq_Axis.AxisIN_POS_rTargetPos)MOVE(iq_Axis.AxisIN_POS_iRqPos,iq_Axis.AxisOUT_POS_iPosDone);]]>
</Text>
</Rung>
<Rung Number="123" Type="N">
<Comment>
<![CDATA[######################################################################################################################################################
EXIT
######################################################################################################################################################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="124" Type="N">
<Text>
<![CDATA[XIC(iq_Axis.AxisIN_xRqStop)[OTL(iq_CIP_Axis.StdBits.IO_StopRq) ,OTU(iq_Axis.AxisIN_xRqStop) ];]]>
</Text>
</Rung>
<Rung Number="125" Type="N">
<Text>
<![CDATA[LBL(L_Exit)TND();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AOI_ChecksumCalculation" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2024-10-23T09:08:57.898Z" CreatedBy="DESKTOP-I4HL37F\admin" EditedDate="2024-12-30T17:07:40.137Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v36.00"
>
<Description>
<![CDATA[Routine to compute the checksum of an array with esclusive XOR algorithm]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="IQ_arrDataToCumputeChecksum" TagType="Base" DataType="DINT" Dimensions="256" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Q_diChecksum" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="L_diArrayDimension" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="diCounter" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="L_diChecksumCalculation" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Routine to compute he checksum of an array with the MOD 256 algorithm]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[SIZE(IQ_arrDataToCumputeChecksum, 0, L_diArrayDimension);]]>
</Line>
<Line Number="1">
<![CDATA[//Sum of all the components of the array]]>
</Line>
<Line Number="2">
<![CDATA[L_diChecksumCalculation := 0;]]>
</Line>
<Line Number="3">
<![CDATA[for diCounter:=0 to L_diArrayDimension-1 do]]>
</Line>
<Line Number="4">
<![CDATA[	//L_diChecksumCalculation := L_diChecksumCalculation XOR (IQ_arrDataToCumputeChecksum[diCounter] XOR diCounter);]]>
</Line>
<Line Number="5">
<![CDATA[	L_diChecksumCalculation := L_diChecksumCalculation XOR IQ_arrDataToCumputeChecksum[diCounter];]]>
</Line>
<Line Number="6">
<![CDATA[end_for;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[Q_diChecksum := L_diChecksumCalculation;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AOI_ProblueFlex" Class="Standard" Revision="8.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2019-08-26T18:35:56.591Z" CreatedBy="WIN-ROSIUGO875N\Wei.Wang" EditedDate="2024-03-25T16:28:15.121Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v35.00"
