<Rung Number="7" Type="N">
<Text>
<![CDATA[F_ACT_PNEUM_CRS(DB_YV_Trap,YV_Trap.i_xSensorON,YV_Trap.i_xSensorOFF,YV_Trap.i_xTimeOutEsclusion,BB_CRS.EPN_ON,BB_CRS.Machine_MovingForSubModule,YV_Trap.iq_xRqON,YV_Trap.iq_xRqOFF,YV_Trap.iq_xChkON,YV_Trap.iq_xChkOFF,EM_Infeed.xRq_ImmediateStop,BB_CRS.Rq_EmergencyPneum,YV_Trap.q_xON,YV_Trap.q_xOFF,YV_Trap.q_xCmdON,YV_Trap.q_xCmdOFF,YV_Trap.q_xTimeOutAlarm);]]>
