<Line Number="5">
<![CDATA[*)]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[	//Read AnyBus state]]>
</Line>
<Line Number="8">
<![CDATA[	q_xAnybusFaulted:=iq_HW_READ_Anybus.ConnectionFaulted AND I_xEnable;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[	//Read node communication]]>
</Line>
<Line Number="11">
<![CDATA[	IF diNode > i_diNrNodesPresent ]]>
</Line>
<Line Number="12">
<![CDATA[	then]]>
</Line>
<Line Number="13">
<![CDATA[		diNode:=1;]]>
</Line>
<Line Number="14">
<![CDATA[			]]>
</Line>
<Line Number="15">
<![CDATA[	elsif diNode=0]]>
</Line>
<Line Number="16">
<![CDATA[	then]]>
</Line>
<Line Number="17">
<![CDATA[		diNode:=1;]]>
</Line>
<Line Number="18">
<![CDATA[	end_if;]]>
</Line>
<Line Number="19">
<![CDATA[		]]>
</Line>
<Line Number="20">
<![CDATA[		]]>
</Line>
<Line Number="21">
<![CDATA[	IF NOT iq_HW_READ_Anybus.ConnectionFaulted]]>
</Line>
<Line Number="22">
<![CDATA[	AND I_xEnable	]]>
</Line>
<Line Number="23">
<![CDATA[	then]]>
</Line>
<Line Number="24">
<![CDATA[		//ENABLE NODE]]>
</Line>
<Line Number="25">
<![CDATA[		//////////////////////////////////////////////////////////]]>
</Line>
<Line Number="26">
<![CDATA[		//Data 0]]>
</Line>
<Line Number="27">
<![CDATA[		iq_HW_WRITE_Anybus.Data[0].0:=iq_aCOMM[1].IN_xNodeEnabled;]]>
</Line>
<Line Number="28">
<![CDATA[		iq_HW_WRITE_Anybus.Data[0].1:=iq_aCOMM[2].IN_xNodeEnabled;]]>
</Line>
