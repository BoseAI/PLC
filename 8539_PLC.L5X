</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Network 6
]]>
</Comment>
<Text>
<![CDATA[[XIC(EM_Infeed.xManualCycle) ,XIC(EM_Infeed.xAutoCycle) ]XIC(IN_CRS.B9680_01)XIO(IN_CRS.B9680_02)XIO(BB_CRS.NoLoadRun_Enable)[MOVE(SizeWork.General.InfeedBeltStop,EM_Infeed.TON_InfeedBeltStop.PRE) ,TON(EM_Infeed.TON_InfeedBeltStop,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main_Infeed" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[############################
MAIN SIGNAL
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xRq_ImmediateStop)[OTE(EM_Infeed.xSt_ImmediateStop) ,OTU(EM_Infeed.xRq_ImmediateStop) ,OTL(BB_CRS.Rq_EmergencyImmediateStop) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.Machine_Ready) ,XIC(EM_Infeed.xEnableModule) ]XIO(EM_Infeed.xSt_ImmediateStop)OTE(EM_Infeed.xEnableModule);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Automatic_CycleActive)XIC(EM_Infeed.xInputRqAuto)OTE(EM_Infeed.xAutoCycle);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[MANUAL CYCLE INFEED]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed_HMI_PB_CRS.Rq_xManual_Cycle)XIO(BB_CRS.Manual_CmdEnable)[OTL(MSG_CRS[18]) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed_HMI_PB_CRS.Rq_xManual_Cycle)XIO(EM_Infeed_HMI_PB_CRS.St_xManual_Cycle)[XIC(BB_CRS.Manual_CmdEnable) [OTL(EM_Infeed_HMI_PB_CRS.St_xManual_Cycle) ,OTL(EM_Outfeed_HMI_PB_CRS.St_xManual_Cycle) ] ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed_HMI_PB_CRS.Rq_xManual_Cycle) XIC(EM_Infeed_HMI_PB_CRS.St_xManual_Cycle) ,XIO(BB_CRS.Manual_CmdEnable) ,XIC(EM_Infeed.xAutoCycle) ,XIC(EM_Infeed.xSt_ImmediateStop) ][OTU(EM_Infeed_HMI_PB_CRS.St_xManual_Cycle) ,OTU(EM_Outfeed_HMI_PB_CRS.St_xManual_Cycle) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xManual_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Programmare gestione manuale alimentazione]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed_HMI_PB_CRS.St_xManual_Cycle)OTE(EM_Infeed.xManualCycle);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[DEBUFFERING SELECTION .... End batch  or Downstream waiting product ?]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed_HMI_PB_CRS.Rq_xOptGr_DebufferingOnEndBatch)XIC(EM_Infeed.xAutoCycle)[OTL(MSG_CRS[18]) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xOptGr_DebufferingOnEndBatch) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed_HMI_PB_CRS.Rq_xOptGr_DebufferingOnEndBatch)XIO(EM_Infeed_HMI_PB_CRS.St_xOptGr_DebufferingOnEndBatch)[OTL(EM_Infeed_HMI_PB_CRS.St_xOptGr_DebufferingOnEndBatch) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xOptGr_DebufferingOnEndBatch) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed_HMI_PB_CRS.Rq_xOptGr_DebufferingOnEndBatch)XIC(EM_Infeed_HMI_PB_CRS.St_xOptGr_DebufferingOnEndBatch)[OTU(EM_Infeed_HMI_PB_CRS.St_xOptGr_DebufferingOnEndBatch) ,OTU(EM_Infeed_HMI_PB_CRS.Rq_xOptGr_DebufferingOnEndBatch) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[############################
INPUT SIGNALS
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xEnableModule)XIC(BB_CRS.SetSize)[XIC(OM_Interface_CRS.CRS_xStackerHomeOk) ,]XIO(xInputRqJog)OTE(EM_Infeed.xInputRqAuto);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xEnableModule)XIC(BB_CRS.SetSize)XIC(OM_Interface_CRS.CRS_xStackerHomeOk)[XIC(EM_Infeed.CM_Stacker_CRS.AxisIN_JOG_xEnableFwdJogY) ,XIC(EM_Infeed_HMI_PB_CRS.St_xJog_Stacker_Enable) ]OTE(EM_Infeed.xPusherRqJog);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xEnableModule)XIO(OM_Interface_CRS.Infeed_xCycleInhibition)OTE(EM_Infeed.xInputStart);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[OTU(OM_Interface_CRS.Infeed_xCycleInhibition);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[############################
OUTPUT SIGNALS
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.CM_Stacker_CRS.AxisOUT_HOME_xHomeDone)OTE(OM_Interface_CRS.CRS_xStackerHomeOk);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.CM_Stacker_CRS.AxisOUT_xMoving)OTE(OM_Interface_CRS.Infeed_xPusherAxesMoving);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.CM_Stacker_CRS.AxisOUT_xStopped)OTE(OM_Interface_CRS.Infeed_xPusherAxesStopped);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xAutoCycle)XIC(BB_CRS.NoLoadRun_Enable)[XIC(IN_CRS.B9680_01) ,XIC(IN_CRS.B9680_02) ,XIC(IN_CRS.B9681_01) XIC(BB_CRS.AlwaysOFF) ,XIC(IN_CRS.B9691_01) ,XIC(IN_CRS.B9691_02) ,XIC(IN_CRS.B9692_01) ,XIC(IN_CRS.B9692_02) ][OTE(ALRM_CRS[21]) ,OTL(EM_Infeed.xRq_ImmediateStop) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Mode_Change" Type="RLL">
<Description>
<![CDATA[v01: 17/11/2025
Author :Tabacco Alessio]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[EQ(EM_Infeed.iMachineState,0)MOVE(1,EM_Infeed.iMachineState);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.NoLoadRun_Enable)[XIC(OM_CRS_HMI.CRS_Empty) OTL(EM_Infeed.xBuffer_RqCycleStart) ,XIC(OM_CRS_HMI.CRS_Full) OTU(EM_Infeed.xBuffer_RqCycleStart) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(BB_CRS.Automatic_CycleActive)ONS(EM_Infeed.axPTrig[31])OTU(EM_Infeed.xBuffer_RqCycleStart);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Core_HMI_CRS.PB.xSt_PurgeBuffer)XIC(EM_Infeed.xBuffer_RqCycleStart)[OTU(EM_Infeed.xBuffer_RqCycleStart) ,OTL(MSG_CRS[12]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(IN_CRS.B9680_02)XIO(OM_CRS_HMI.Debuffering_MachineBeltReady)[XIC(Timers_CRS.N[61].DN) OTL(OM_CRS_HMI.Debuffering_MachineBeltReady) ,TON(Timers_CRS.N[61],?,?) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIO(IN_CRS.B9695_03) ,XIC(IN_CRS.B9680_02) ,XIC(IN_CRS.B9680_01) ]OTU(OM_CRS_HMI.Debuffering_MachineBeltReady);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[AUTOMATIC MACHINE MODE: DEBUFFING]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.Automatic_CycleActive)[XIO(EM_Infeed.xBuffer_RqCycleStart) XIC(OM_CRS_HMI.Debuffering_MachineBeltReady) ,XIC(Core_HMI_CRS.PB.xSt_PurgeBuffer) ][XIO(BB_CRS.Outfeed_Inhibition) ,XIC(BB_CRS.NoLoadRun_Enable) ]XIO(OM_CRS_HMI.CRS_Empty)MOVE(3,EM_Infeed_HMI_PB_CRS.Rq_iForce_BypassBuffDebuff);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[AUTOMATIC MACHINE MODE: BYPASS]]>
</Comment>
<Text>
<![CDATA[[EQ(EM_Infeed.iMachineState,2) [XIC(OM_CRS_HMI.CRS_Full) ,XIO(EM_Infeed.xBuffer_RqCycleStart) ] ,EQ(EM_Infeed.iMachineState,3) XIC(OM_CRS_HMI.CRS_Empty) ,XIC(BB_CRS.Outfeed_Inhibition) XIO(BB_CRS.NoLoadRun_Enable) ,XIC(IN_CRS.B9680_01) ]MOVE(1,EM_Infeed_HMI_PB_CRS.Rq_iForce_BypassBuffDebuff);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[AUTOMATIC MACHINE MODE: BUFFERING]]>
</Comment>
<Text>
<![CDATA[XIO(OM_CRS_HMI.CRS_Full)XIC(EM_Infeed.xBuffer_RqCycleStart)XIO(Core_HMI_CRS.PB.xSt_PurgeBuffer)[GT(Core_HMI_CRS.Interface.iPasswordState,1) MOVE(2,EM_Infeed_HMI_PB_CRS.Rq_iForce_BypassBuffDebuff) ,EQ(Core_HMI_CRS.Interface.iPasswordState,0) OTL(MSG_CRS[12]) MOVE(1,EM_Infeed_HMI_PB_CRS.Rq_iForce_BypassBuffDebuff) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(BB_CRS.NoLoadRun_Enable)ONS(EM_Infeed.axPTrig[1])MOVE(0,EM_Infeed_HMI_PB_CRS.Rq_iManual_Force_BypassBuffDebuff);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[NE(EM_Infeed_HMI_PB_CRS.Rq_iForce_BypassBuffDebuff,0)[MOVE(EM_Infeed_HMI_PB_CRS.Rq_iForce_BypassBuffDebuff,EM_Infeed_HMI_PB_CRS.St_iForce_BypassBuffDebuff) ,MOVE(0,EM_Infeed_HMI_PB_CRS.Rq_iForce_BypassBuffDebuff) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[SAVE OLD WORK MODE]]>
</Comment>
<Text>
<![CDATA[MOVE(EM_Infeed.iMachineState,xMachineState_Old);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[ASSIGN NEW WORK MODE]]>
</Comment>
<Text>
<![CDATA[[EQ(EM_Infeed.iMachineState,1) ,EQ(EM_Infeed.iMachineState,2) [XIC(OM_CRS_HMI.CRS_Full) ,XIC(EM_Infeed.xCycle_Buffering_StopEnable) ] ,EQ(EM_Infeed.iMachineState,3) [XIC(OM_CRS_HMI.CRS_Empty) ,XIC(EM_Infeed.xCycle_Debuffing_StopEnable) ] ][EQ(EM_Infeed_HMI_PB_CRS.St_iForce_BypassBuffDebuff,1) ,EQ(EM_Infeed_HMI_PB_CRS.St_iForce_BypassBuffDebuff,2) XIO(OM_CRS_HMI.CRS_Full) ,EQ(EM_Infeed_HMI_PB_CRS.St_iForce_BypassBuffDebuff,3) XIO(OM_CRS_HMI.CRS_Empty) XIO(EM_Infeed.xBuffer_RqCycleStart) ][XIC(EM_Infeed.xCycle_Buffering_StopEnable) ,LT(EM_Infeed.iBuffering_SeqChange,30) XIC(xBuffering_ProdottoInTramoggia) ][XIC(EM_Infeed.xCycle_Debuffing_StopEnable) ,LE(EM_Infeed.xDebuffering_SeqChange,40) ]XIO(OM_CRS_HMI.St_ManualPurgeBuffer)XIO(OM_CRS_HMI.St_AutoPurgeBuffer)MOVE(EM_Infeed_HMI_PB_CRS.St_iForce_BypassBuffDebuff,EM_Infeed.iMachineState);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[REINTRODUCTION TIMEOUT ALARM
mode activate but non products at infeed]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.Automatic_CycleActive)XIO(BB_CRS.NoLoadRun_Enable)EQ(EM_Infeed.iMachineState,2)XIC(EM_Infeed.xBuffer_RqCycleStart)[XIO(IN_CRS.B9691_02) [[XIO(EM_Infeed.xBuffering_FirstProductInfeed) ,] [,TON(Timers_CRS.N[17],?,?) ] XIC(Timers_CRS.N[17].DN) [XIC(BB_CRS.AlwaysOFF) [OTE(ALRM_CRS[27]) ,OTL(BB_CRS.Rq_EmergencyPhaseStop) ] ,MOVE(1,EM_Infeed_HMI_PB_CRS.Rq_iForce_BypassBuffDebuff) ,OTU(EM_Infeed.xBuffer_RqCycleStart) ] ,OTU(EM_Infeed.xBuffering_FirstProductInfeed) ] ,XIC(IN_CRS.B9691_02) OTL(EM_Infeed.xBuffering_FirstProductInfeed) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[NE(EM_Infeed.iMachineState,2)OTU(EM_Infeed.xBuffering_FirstProductInfeed);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[RESET STATE MACHINE
if mode change]]>
</Comment>
<Text>
<![CDATA[NE(EM_Infeed.iMachineState,xMachineState_Old)[OTL(EM_Infeed.xSeqReset) ,OTL(EM_Infeed.xBuffering_SeqReset) ,OTL(EM_Infeed.xDebuffering_SeqReset) ,OTU(xBufferingFirstCicle) ,OTU(xDebufferingFirstCicle) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[NE(EM_Infeed.iMachineState,2) OTL(EM_Infeed.xBuffering_SeqReset) ,NE(EM_Infeed.iMachineState,3) OTL(EM_Infeed.xDebuffering_SeqReset) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[STOP IN PHASE]]>
</Comment>
<Text>
<![CDATA[EQ(EM_Infeed.iBypass_SeqChange,0)OTE(EM_Infeed.xCycle_Bypass_StopEnable);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[LE(EM_Infeed.iBuffering_SeqChange,10)XIC(xBuffering_ProdottoInTramoggia)OTE(EM_Infeed.xCycle_Buffering_StopEnable);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[LE(EM_Infeed.xDebuffering_SeqChange,40)OTE(EM_Infeed.xCycle_Debuffing_StopEnable);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xCycle_Buffering_StopEnable)XIC(EM_Infeed.xCycle_Debuffing_StopEnable)OTE(OM_Interface_CRS.Machine_xBufferStopInPhase);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[DEBUFFERING FORCE FOR PURGE]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)[XIC(OM_CRS_HMI.St_ManualPurgeBuffer) ,XIC(OM_CRS_HMI.St_AutoPurgeBuffer) ][XIO(BB_CRS.Outfeed_Inhibition) MOVE(3,EM_Infeed.iMachineState) ,XIC(BB_CRS.Outfeed_Inhibition) MOVE(1,EM_Infeed.iMachineState) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[MESSAGE
Actual mode indication on HMI]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)XIO(OM_CRS_HMI.St_ManualPurgeBuffer)XIO(OM_CRS_HMI.St_AutoPurgeBuffer)[EQ(EM_Infeed_HMI_PB_CRS.St_iForce_BypassBuffDebuff,1) OTL(MSG_CRS[26]) ,EQ(EM_Infeed_HMI_PB_CRS.St_iForce_BypassBuffDebuff,2) OTL(MSG_CRS[27]) ,EQ(EM_Infeed_HMI_PB_CRS.St_iForce_BypassBuffDebuff,3) OTL(MSG_CRS[28]) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[MOVE(EM_Infeed.iMachineState,OM_Interface_CRS.Infeed_iMachineState);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Purge_Management" Type="RLL">
<Description>
<![CDATA[v01: 25/09/2025
Author :Tabacco Alessio]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[MANUAL PURGE BUFFER INHIBITE]]>
</Comment>
<Text>
<![CDATA[XIC(OM_CRS_HMI.Rq_ManualPurgeBuffer)XIC(EM_Infeed.xCycleInProgress)[OTL(MSG_CRS[12]) ,OTU(OM_CRS_HMI.Rq_ManualPurgeBuffer) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[MANUAL PURGE BUFFER]]>
</Comment>
<Text>
<![CDATA[XIC(OM_CRS_HMI.Rq_ManualPurgeBuffer)XIO(EM_Infeed.xCycleInProgress)[XIO(OM_CRS_HMI.St_AutoPurgeBuffer) OTL(OM_CRS_HMI.St_ManualPurgeBuffer) ,OTU(OM_CRS_HMI.Rq_ManualPurgeBuffer) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[AUTOMATIC PURGE BUFFER
For Timeout]]>
</Comment>
<Text>
<![CDATA[CPT(OM_CRS_HMI.TON_MaximumProductDowntime.PRE,((SizeWork_CRS.General.MaximumProductDowntime_hh*3600)+(SizeWork_CRS.General.MaximumProductDowntime_mm*60))*1000);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Timer Start]]>
</Comment>
<Text>
<![CDATA[XIO(OM_CRS_HMI.CRS_Empty)TON(OM_CRS_HMI.TON_MaximumProductDowntime,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[CPT(UM_HMI_CRS.Production.diProduct_Downtime_hh,(OM_CRS_HMI.TON_MaximumProductDowntime.PRE-OM_CRS_HMI.TON_MaximumProductDowntime.ACC)/1000/60/60) ,CPT(UM_HMI_CRS.Production.diProduct_Downtime_mm,((OM_CRS_HMI.TON_MaximumProductDowntime.PRE-OM_CRS_HMI.TON_MaximumProductDowntime.ACC)/1000/60)-(UM_HMI_CRS.Production.diProduct_Downtime_hh*60)) ,CPT(UM_HMI_CRS.Production.diProduct_Downtime_ss,((OM_CRS_HMI.TON_MaximumProductDowntime.PRE-OM_CRS_HMI.TON_MaximumProductDowntime.ACC)/1000)-(UM_HMI_CRS.Production.diProduct_Downtime_hh*60*60)-(UM_HMI_CRS.Production.diProduct_Downtime_mm*60)) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(OM_CRS_HMI.TON_MaximumProductDowntime.DN)[OTL(WRNG_CRS[13]) ,OTL(OM_CRS_HMI.Rq_AutoPurgeBuffer) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[AUTOMATIC PURGE BUFFER
For Temperature]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface_CRS.Machine_xRqEmptyingDueToHighTemperature)[OTL(WRNG_CRS[12]) ,OTL(OM_CRS_HMI.Rq_AutoPurgeBuffer) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(OM_CRS_HMI.Rq_AutoPurgeBuffer)[OTL(OM_CRS_HMI.St_AutoPurgeBuffer) ,OTU(OM_CRS_HMI.Rq_AutoPurgeBuffer) OTU(OM_CRS_HMI.St_ManualPurgeBuffer) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[PURGE FINISH]]>
</Comment>
<Text>
<![CDATA[[XIC(OM_CRS_HMI.St_ManualPurgeBuffer) ,XIC(OM_CRS_HMI.St_AutoPurgeBuffer) ]XIC(OM_CRS_HMI.CRS_Empty)[OTU(OM_CRS_HMI.Rq_AutoPurgeBuffer) OTU(OM_CRS_HMI.St_AutoPurgeBuffer) ,OTU(OM_CRS_HMI.Rq_ManualPurgeBuffer) OTU(OM_CRS_HMI.St_ManualPurgeBuffer) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(OM_CRS_HMI.St_ManualPurgeBuffer) ,XIC(OM_CRS_HMI.St_AutoPurgeBuffer) ][OTL(MSG_CRS[29]) ,OTE(Core_HMI_CRS.PB.xSt_PurgeBuffer) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
