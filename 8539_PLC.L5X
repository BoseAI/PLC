<![CDATA[XIC(BB_CRS.Timer_ChangeRq)XIC(BB_CRS.Timer_SaveInProgress)[MOVE(Timers_CRS.NewPreset,Timers_CRS.N[Timers_CRS.No].PRE) ,MOVE(Timers_CRS.NewPreset,Timers_CRS.ActPreset) ,OTL(Core_HMI_CRS.PB.St_xTimerSave) ];]]>
