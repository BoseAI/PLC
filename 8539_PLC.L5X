</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[F_ACT_PNEUM_CRS(DB_YV_Pusher,YV_Pusher.i_xSensorON,YV_Pusher.i_xSensorOFF,YV_Pusher.i_xTimeOutEsclusion,BB_CRS.EPN_ON,BB_CRS.Machine_MovingForSubModule,YV_Pusher.iq_xRqON,YV_Pusher.iq_xRqOFF,YV_Pusher.iq_xChkON,YV_Pusher.iq_xChkOFF,EM_Infeed.xRq_ImmediateStop,BB_CRS.Rq_EmergencyPneum,YV_Pusher.q_xON,YV_Pusher.q_xOFF,YV_Pusher.q_xCmdON,YV_Pusher.q_xCmdOFF,YV_Pusher.q_xTimeOutAlarm);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(YV_Pusher.q_xCmdON)XIC(YV_Hopper.i_xSensorON)OTE(OUT_CRS.Q9685_01_12);]]>
