<Routine Name="CM_PAL_RejectRoller" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(Timers.N[80].PRE,EM_PAL.TON_MaxLoadRejectOutfeedDelay.PRE)MOVE(Timers.N[129].PRE,EM_PAL.TON_RejectionOutfeedTimeout.PRE)MOVE(Timers.N[167].PRE,EM_PAL.TON_MaxTimeRejectNotOccurred.PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Reject robot done]]>
</Comment>
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[EQ(106,DB_Pal_RobotIO.GO.i05) XIO(BB.NoLoadRun_Enable) ONS(EM_PAL.AxPtrig[13]) OTL(EM_PAL.xRobot_RejectDone) ,XIO(IN.B7430_02_NC) OTU(EM_PAL.xRobot_RejectDone) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Alarm reject case fault]]>
</Comment>
<Text>
<![CDATA[[XIC(EM_PAL.xRobot_RejectDone) TON(EM_PAL.TON_MaxTimeRejectNotOccurred,?,?) ,XIO(IN.B7440_02_NC) TON(EM_PAL.TON_RejectionOutfeedTimeout,?,?) ][OTE(ALRM[558]) ,OTU(EM_PAL.xRobot_RejectDone) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(IN.B7440_02_NC)OTE(DB_Time_SensorRejectDone.I_xSensor);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[F_InputFilter(DB_Time_SensorRejectDone,Timers.N[290].PRE,Timers.N[291].PRE);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Maximun case on reject roller]]>
</Comment>
<Text>
<![CDATA[XIC(IN.B7440_01)TON(EM_PAL.TON_MaxLoadRejectOutfeedDelay,?,?)[OTL(WRNG[34]) ,OTL(BB.Safe_RqBuzzerForWrngStopProduction) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Inibizione scarto uscita]]>
</Comment>
<Text>
<![CDATA[[XIO(DB_Time_SensorRejectDone.Q_xSensor) ,XIC(EM_PAL.TON_MaxLoadRejectOutfeedDelay.DN) ]OTE(EM_PAL.xRejectInhibit);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CM_PAL_Rework" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[MOVE(Timers.N[97].PRE,EM_PAL.TON_DelayCaseMovementWaitingForRework.PRE)MOVE(Timers.N[98].PRE,EM_PAL.TON_DelayCaseTransitWaitingForRework.PRE)MOVE(Timers.N[99].PRE,EM_PAL.TON_DelayCasePickupWaitingForRework.PRE)MOVE(Timers.N[106].PRE,EM_PAL.TON_DelayCasePickedUpWaitingForRework.PRE)MOVE(Timers.N[145].PRE,EM_PAL.TON_Delay_RqAbortForRework.PRE)MOVE(Timers.N[146].PRE,EM_PAL.TON_Delay_StartBeltRework.PRE)MOVE(Timers.N[147].PRE,EM_PAL.TON_Delay_StopBeltRework.PRE);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[REWORK REQUEST]]>
</Comment>
<Text>
<![CDATA[XIC(IN.S7425_01)ONS(EM_PAL.AxPtrig[1])OTL(EM_PAL.Rework_xREQUEST);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Service message: Function not allowed]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL.Rework_xREQUEST)[XIC(EM_PAL.Sampling_xIN_PROGRESS) XIO(OM_TeT.OUT_Pal.xRework_Massive) ,XIC(EM_PAL.Rework_xIN_PROGRESS) XIC(EM_PAL.Rework_xCASE_PRESENCE) ,XIO(IN.B7430_01_NC) ][OTL(MSG[12]) ,OTU(EM_PAL.Rework_xREQUEST) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[NE(OM_TeT_HMI_PB.iSelReworkType,1)OTU(EM_PAL.Rework_xMASSIVE);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(EM_PAL.Rework_xMASSIVE)ONS(EM_PAL.AxPtrig[31])OTU(EM_PAL.Rework_xIN_PROGRESS);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[REWORK IN PROGRESS]]>
</Comment>
<Text>
<![CDATA[[XIC(EM_PAL.Rework_xREQUEST) ,XIC(EM_PAL.Rework_xMASSIVE) ][XIO(EM_PAL.Sampling_xIN_PROGRESS) ,XIC(OM_TeT.OUT_Pal.xRework_Massive) ]XIO(EM_PAL.Rework_xIN_PROGRESS)[OTL(EM_PAL.Rework_xIN_PROGRESS) ,OTU(EM_PAL.Rework_xREQUEST) ,XIC(OM_TeT.OUT_Pal.xRework_Massive) OTU(EM_PAL.Rework_xMASSIVE) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[CASE OUT INHIBITION WITH MASSIVE REWORK SELECTED]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL.Rework_xMASSIVE)[OTL(OM_Interface.CaseF_xRqCycleInhibition) ,OTL(OM_Interface.CaseP_xRqCycleInhibition) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Sampling: lampada reintroduzione]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL.Sampling_xIN_PROGRESS)[[[XIC(BB.Clock_1000ms) ,XIC(EM_PAL.Rework_xCASE_PRESENCE) ] XIO(OM_TeT.OUT_Pal.xRework_Massive) ,[XIC(BB.Clock_1000ms) ,XIC(EM_PAL.Rework_xAuxMassive) ] XIC(OM_TeT.OUT_Pal.xRework_Massive) ] OTE(OUT.P7425_01) ,OTL(MSG[93]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Consenso introduzione test rework massive 0=off Blink=Ok Deposito fisso=in work]]>
</Comment>
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[XIO(IN.B7430_01_NC) ONS(EM_PAL.AxPtrig[35]) OTL(EM_PAL.Rework_xAuxMassive) ,XIO(IN.B7430_01_NC) ONS(EM_PAL.AxPtrig[36]) OTU(EM_PAL.Rework_xAuxMassive) ,XIO(EM_PAL.Rework_xMASSIVE) OTU(EM_PAL.Rework_xAuxMassive) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Service message:]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL.Rework_xIN_PROGRESS)XIO(EM_PAL.Rework_xCASE_PRESENCE)OTL(MSG[94]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[REWORK_CASE_PRESENCE]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL.Rework_xIN_PROGRESS)XIC(BB.Machine_Ready)[XIC(IN.B7430_02_NC) ,XIC(EM_PAL.Rework_xMASSIVE) ]OTL(EM_PAL.Rework_xCASE_PRESENCE);]]>
