<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(i_iForwardPosition,lrForwardPos)MOVE(i_iBackwardPosition,lrBackwardPos)MOVE(i_iPosWindow,lrPosWindow)MOVE(i_iForwardPosWindSlowdwn,lrForwardPosWindSlowdwn)MOVE(i_iBackwarPosWindSlowdwn,lrBackwarPosWindSlowdwn);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[SUB(lrForwardPos,i_iPosWindow,lrForwardPos_Advance)ADD(lrBackwardPos,i_iPosWindow,lrBackwardPos_Advance);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[SUB(lrForwardPos,lrForwardPosWindSlowdwn,lrForwardPosSlowdwn)ADD(lrBackwardPos,lrBackwarPosWindSlowdwn,lrBackwarPosSlowdwn);]]>
