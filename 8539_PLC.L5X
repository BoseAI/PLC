</Routine>
<Routine Name="Cycle_BundleTransfer_T1" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[m151.0]]>
</Comment>
<Text>
<![CDATA[[XIC(EM_BundleTransfer.xAutoCycle) ,XIC(EM_BundleTransfer.xManualCycle) ]XIC(BB.Machine_Ready)XIO(EM_BundleTransfer.xSt_ImmediateStop)OTL(EM_BundleTransfer.xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[m151.0]]>
</Comment>
<Text>
<![CDATA[[XIC(BB.St_Emergency_ImmediateStop) ,XIC(EM_BundleTransfer.xSt_ImmediateStop) ]OTU(EM_BundleTransfer.xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[m151.0]]>
</Comment>
<Text>
<![CDATA[XIC(EM_BundleTransfer.xCycleInProgress)[EQ(EM_BundleTransfer.iSeqChange,0) ,EQ(EM_BundleTransfer.iSeqChange,1) ]XIO(EM_BundleTransfer.xAutoCycle)XIO(EM_BundleTransfer.xManualCycle)OTU(EM_BundleTransfer.xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[m151.0]]>
</Comment>
<Text>
<![CDATA[XIC(BB.St_Emergency_PhaseStop)[EQ(EM_BundleTransfer.iSeqChange,0) ,EQ(EM_BundleTransfer.iSeqChange,1) ]XIO(EM_BundleTransfer.xAutoCycle)XIO(EM_BundleTransfer.xManualCycle)OTU(EM_BundleTransfer.xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[############################
STATE MACHINE
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[m160.2]]>
</Comment>
<Text>
<![CDATA[XIC(EM_BundleTransfer.xCycleInProgress)EQ(EM_BundleTransfer.iSeqChange,0)[[XIC(CM_Pneum_BundleTransferLift.q_xOFF) ,XIO(UM_Config.CP.EnablePneumSingleElevatorBundle) ] XIC(OM_Interface.Infeed_xCompleteProdForBundleTransfer) OTL(EM_BundleTransfer.xSeqChangeIncreaseAux) ,XIO(OM_Interface.Infeed_xCompleteProdForBundleTransfer) XIC(OM_Interface.Infeed_xStackerOutObstruction) NE(EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone,1) MOVE(1,EM_BundleTransfer.CM_Transfer.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[m160.2]]>
</Comment>
<Text>
<![CDATA[XIC(EM_BundleTransfer.xCycleInProgress)EQ(1,EM_BundleTransfer.iSeqChange)[XIO(OM_Interface.BundleTrans_xMemBundleForEachLayerComple) XIO(OM_Interface.BundleTrans_xInhibit) OTL(EM_BundleTransfer.xSeqChangeIncreaseAux) ,XIC(OM_Interface.BundleTrans_xMemBundleForEachLayerComple) MOVE(3,EM_BundleTransfer.iSeqChange) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[m160.2]]>
</Comment>
<Text>
<![CDATA[XIC(EM_BundleTransfer.xCycleInProgress)EQ(2,EM_BundleTransfer.iSeqChange)[OTU(OM_Interface.BundleTrans_xBackstrokeConsent) ,NE(EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone,2) MOVE(2,EM_BundleTransfer.CM_Transfer.AxisIN_POS_iRqPos) ,EQ(EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone,2) [OTL(OM_Interface.BundleTransfer_xBundleReady) ,OTL(EM_BundleTransfer.xRqCounterIncrease) ,MOVE(0,EM_BundleTransfer.iSeqChange) ,GT(EM_BundleTransfer.CM_Transfer.AxisOUT_rActualPos,EM_BundleTransfer.iBundleTransferPosForStacker) OTL(OM_Interface.bundleTransfer_xInForwardPosForCycle) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[m160.2]]>
</Comment>
<Text>
<![CDATA[XIC(EM_BundleTransfer.xCycleInProgress)EQ(3,EM_BundleTransfer.iSeqChange)[XIC(OM_Interface.BundleTrans_xBackstrokeConsent) ,XIO(OM_Interface.BundleTransfer_xBundleReady) ][[XIC(CM_Pneum_BundleTransferLift.q_xON) ,XIO(UM_Config.CP.EnablePneumSingleElevatorBundle) ] [OTU(OM_Interface.BundleTrans_xBackstrokeConsent) ,OTL(EM_BundleTransfer.xSeqChangeIncreaseAux) ] ,XIC(UM_Config.CP.EnablePneumSingleElevatorBundle) XIO(CM_Pneum_BundleTransferLift.q_xON) OTL(CM_Pneum_BundleTransferLift.iq_xRqON) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[m160.2]]>
</Comment>
<Text>
<![CDATA[XIC(EM_BundleTransfer.xCycleInProgress)EQ(4,EM_BundleTransfer.iSeqChange)[EQ(EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone,1) [OTL(EM_BundleTransfer.xCountRqBundlesReset) ,OTU(OM_Interface.Infeed_xCompleteProdForBundleTransfer) ,MOVE(0,EM_BundleTransfer.iSeqChange) ] ,XIC(OM_Interface.Infeed_xStackerOutObstruction) NE(EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone,1) MOVE(1,EM_BundleTransfer.CM_Transfer.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Stacking sequence increase auxiliary]]>
</Comment>
<Text>
<![CDATA[XIC(EM_BundleTransfer.xSeqChangeIncreaseAux)[ADD(EM_BundleTransfer.iSeqChange,1,EM_BundleTransfer.iSeqChange) ,OTU(EM_BundleTransfer.xSeqChangeIncreaseAux) ,OTL(BB.Machine_Moving) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(OM_Interface.BundleTrans_xInhibit)OTU(OM_Interface.BundleTrans_xInhibit);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB.FirstScan)FLL(0,EM_BundleTransfer,1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Config,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(CM_Axis_BundleTransfer,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(Calc_CountProd_BundleTransfer,0);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[JSR(Calc_Pos_BundleTransfer_T1,0);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[JSR(Cycle_BundleTransfer_T1,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(UM_Config.CP.EnablePneumSingleElevatorBundle)JSR(CM_BundleTransfer_SinglePneum_Lifter,0);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[m153.3]]>
</Comment>
<Text>
<![CDATA[[XIC(EM_BundleTransfer.xRq_ImmediateStop) ,XIC(BB.St_Emergency_ImmediateStop) ,XIC(BB.Rq_EmergencyPhaseStop) ][OTE(EM_BundleTransfer.xSt_ImmediateStop) ,OTU(EM_BundleTransfer.xRq_ImmediateStop) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[m2.7]]>
</Comment>
<Text>
<![CDATA[XIC(EM_BundleTransfer.xRqAutomaticCycleInhibition)[OTL(BB.Automatic_CycleInhibition) ,OTU(EM_BundleTransfer.xRqAutomaticCycleInhibition) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[m153.0]]>
</Comment>
<Text>
<![CDATA[XIC(BB.Automatic_CycleActive)OTE(EM_BundleTransfer.xAutoCycle);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[RESET COUNT]]>
</Comment>
<Text>
<![CDATA[XIO(BB.AlwaysOFF)OTE(L_xBundleResetEnable);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[m178.5]]>
</Comment>
<Text>
<![CDATA[[XIC(EM_BundleTransfer.xRqManualReset) ,XIC(BB.FirstScan) ][MOVE(0,EM_BundleTransfer.iSeqChange) ,OTU(OM_Interface.Infeed_xIncompleteProdForBundleTransfer) ,OTU(OM_Interface.Infeed_xCompleteProdForBundleTransfer) ,OTU(OM_Interface.BundleTransfer_xBundleReady) ,OTU(OM_Interface.BundleTrans_xBackstrokeConsent) ,OTL(EM_BundleTransfer.xRq_ResetHomeFromResetCount) ,MOVE(1,EM_BundleTransfer.CM_Transfer.AxisIN_POS_iRqPos) ,OTL(BB.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Reset Counter]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed_HMI_PB.St_xManual_Cycle)OTE(EM_BundleTransfer.xManualCycle);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[F_ResetCounter(DB_ResetBundle,L_xBundleResetEnable,BB.FirstScan,BB.Automatic_CycleActive,UM_HMI.MachineWorkData.Rq_xResetActualBundleNumber,UM_HMI.MachineWorkData.Rq_xResetActualBundleNumber,xNotUsed[1],BB.Movement_InhibitionRq,MSG[12],EM_BundleTransfer.xRqManualReset);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[m151.1]]>
</Comment>
<Text>
<![CDATA[[[XIO(OM_Interface.Infeed_xEnabled_ElevatorTransferUP) NE(EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone,1) ,XIC(OM_Interface.Infeed_xEnabled_ElevatorTransferUP) NE(EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone,1) [GT(UM_HMI.MachineWorkData.St_iActualLayerNumber,OM_Interface.Infeed_iLayersAboveTopTrap) ,XIC(CM_Pneum_BundleTransferLift.q_xOFF) ] ] ,XIC(OM_Interface.Infeed_xCompleteProdForBundleTransfer) EQ(EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone,1) ]OTL(OM_Interface.Infeed_xStackerInhibit);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[A205-Bundle transfer wall out of position]]>
</Comment>
<Text>
<![CDATA[XIC(BB.Machine_Ready)XIO(IN.B2131_02)OTE(ALRM[205]);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(OM_Interface.BundleTransfer_xBundleReady)OTL(OM_Interface.BundleTrans_xInhibit);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
