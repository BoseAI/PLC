<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[=============================
MAINS SUBROUTINES
=============================]]>
</Comment>
<Text>
<![CDATA[JSR(HMI_VitalityCheck,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Interface_HMI,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(NTP_Synchronization,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(HMI_GMP_Management,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(HMI_MachineStateVisualization,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="NTP_Synchronization" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[/*	Disclaimer - All information provided  -- No warranty or implied merchantability.]]>
</Line>
<Line Number="1">
<![CDATA[Refer to the RSLogix 5000 End User License Agreement (EULA) in the Release Notes.]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[This AOI_SNTP_QUERY instruction retrieves the current time from a NTP (Network Time Protocol) server and returns the date to SNTP_Time_Retrieved and optionally the controller's clock as well.]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[Update "SNTP_SERVER_ADDRESS" tag with <IP address> or <Hostname> of the NTP server.]]>
</Line>
<Line Number="6">
<![CDATA[Examples "2.pool.ntp.org" , "192.168.1.1"]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[Fill in Query_Interval_in_Min with the number of minutes to periodocally update between successful queries. 0 disables query.]]>
</Line>
<Line Number="9">
<![CDATA[Fill in Query_Error_in_Min with the number fo minutes to retry after an error.]]>
</Line>
<Line Number="10">
<![CDATA[Fill in the Sync_Controller_Clock with a 1 to automatically update controller clock, 0 otherwise.]]>
</Line>
<Line Number="11">
<![CDATA[Next_Query_in_Min will display minutes remaining before the next update.]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[IMPORTANT! Set the Enable instruction to a 1 to enable the instruction. Set Trigger Update Now if an immediate update is desired (Enable_Instruction must also be set).]]>
</Line>
<Line Number="15">
<![CDATA[Set Sync controller clock to have the controllers clock updated by the instruction at the time of a query.]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[Note: 1440 minutes = 1 day.]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[*/]]>
</Line>
<Line Number="20">
<![CDATA[	]]>
</Line>
<Line Number="21">
<![CDATA[	AOI_SNTP_Synchronization.Enable_Instruction := OM_HMI_SntpSynchro.St_xEnableSntpCommunication;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[	IF OM_HMI_SntpSynchro.St_xEnableSntpCommunication THEN]]>
</Line>
<Line Number="24">
<![CDATA[		]]>
</Line>
<Line Number="25">
<![CDATA[		AOI_SNTP_Synchronization.Trigger_Update_Now := OM_HMI_SntpSynchro.Rq_xTriggerUpdateNow;]]>
</Line>
<Line Number="26">
<![CDATA[		IF OM_HMI_SntpSynchro.Rq_xTriggerUpdateNow THEN]]>
</Line>
<Line Number="27">
<![CDATA[			OM_HMI_SntpSynchro.Rq_xTriggerUpdateNow := FALSE;]]>
</Line>
<Line Number="28">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="29">
<![CDATA[		]]>
</Line>
<Line Number="30">
<![CDATA[		AOI_SNTP_Synchronization.Sync_Controller_Clock := OM_HMI_SntpSynchro.St_xEnableSyncController;]]>
</Line>
<Line Number="31">
<![CDATA[		AOI_SNTP_Synchronization.Query_Interval_in_Min := OM_HMI_SntpSynchro.St_diQueryInterval;]]>
</Line>
<Line Number="32">
<![CDATA[		AOI_SNTP_Synchronization.Query_Error_Retry_in_Min:=OM_HMI_SntpSynchro.St_diQueryIntervalAfterError;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[	ELSE]]>
</Line>
<Line Number="35">
<![CDATA[		AOI_SNTP_Synchronization.Trigger_Update_Now := FALSE;	]]>
</Line>
<Line Number="36">
<![CDATA[		AOI_SNTP_Synchronization.Sync_Controller_Clock := FALSE;]]>
</Line>
<Line Number="37">
<![CDATA[		AOI_SNTP_Synchronization.Query_Interval_in_Min := 0;]]>
</Line>
<Line Number="38">
<![CDATA[		AOI_SNTP_Synchronization.Query_Error_Retry_in_Min:= 0;]]>
</Line>
<Line Number="39">
<![CDATA[]]>
</Line>
<Line Number="40">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[AOI_SNTP_QUERY(AOI_SNTP_Synchronization, ]]>
</Line>
<Line Number="44">
<![CDATA[				OM_HMI_SntpSynchro.St_dtRetrievedTime,]]>
</Line>
<Line Number="45">
<![CDATA[				OM_HMI_SntpSynchro.St_sSntpServerAddress,]]>
</Line>
<Line Number="46">
<![CDATA[				L_SNTP_MSG_DATA,]]>
</Line>
<Line Number="47">
<![CDATA[				L_SNTP_MSG_CREATE,]]>
</Line>
<Line Number="48">
<![CDATA[				L_SNTP_MSG_OPEN,]]>
</Line>
<Line Number="49">
<![CDATA[				L_SNTP_MSG_WRITE,]]>
</Line>
<Line Number="50">
<![CDATA[				L_SNTP_MSG_READ, ]]>
</Line>
<Line Number="51">
<![CDATA[				L_SNTP_MSG_DELETE);]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[OM_HMI_SntpSynchro.St_xSntpAoiError := AOI_SNTP_Synchronization.ER;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
