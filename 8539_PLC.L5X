<![CDATA[	]]>
</Line>
<Line Number="10">
<![CDATA[//REMOTE 8 (K9660_03)]]>
</Line>
<Line Number="11">
<![CDATA[IN_CRS.Q9500_01_P1		:=	K9605_01:I.Data[8].0;]]>
</Line>
<Line Number="12">
<![CDATA[IN_CRS.Q9500_01_P2		:=	K9605_01:I.Data[8].1;]]>
</Line>
<Line Number="13">
<![CDATA[IN_CRS.K9682_01			:=	K9605_01:I.Data[8].2;]]>
</Line>
<Line Number="14">
<![CDATA[IN_CRS.K9681_01			:=	K9605_01:I.Data[8].3;]]>
