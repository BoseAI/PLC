<AddOnInstructionDefinition Name="F_2SINT_To_INT" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2023-04-03T08:12:17.912Z" CreatedBy="DESKTOP-I4HL37F\admin" EditedDate="2023-06-08T12:38:59.645Z" EditedBy="DESKTOP-I4HL37F\admin" SoftwareRevision="v33.01"
>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="i_siLowPart" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="i_siHighPart" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="q_iResult" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="iHighPart" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="iLowPart" DataType="INT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//Clear value]]>
</Line>
<Line Number="1">
<![CDATA[iLowPart := 0;]]>
</Line>
<Line Number="2">
<![CDATA[iHighPart := 0;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[//OR Bit a bit to convert the GI from INT to DINT rappresentation (In that way the value is the same as in the FANUC) ]]>
</Line>
<Line Number="5">
<![CDATA[iLowPart :=i_siLowPart OR iLowPart;]]>
</Line>
<Line Number="6">
<![CDATA[iHighPart := i_siHighPart OR iHighPart;]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[IF (iHighPart < 128) THEN]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[	//Positive Register]]>
</Line>
<Line Number="11">
<![CDATA[	q_iResult := ((iHighPart * 256) + iLowPart) ;]]>
</Line>
<Line Number="12">
<![CDATA[ ]]>
</Line>
<Line Number="13">
<![CDATA[ ELSE ]]>
</Line>
<Line Number="14">
<![CDATA[			 ]]>
</Line>
<Line Number="15">
<![CDATA[  	//Negative Register]]>
</Line>
<Line Number="16">
<![CDATA[  	q_iResult :=(((iHighPart - 256) * 256) + iLowPart) ;]]>
</Line>
<Line Number="17">
<![CDATA[ ]]>
</Line>
<Line Number="18">
<![CDATA[ END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
