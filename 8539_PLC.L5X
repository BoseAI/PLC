<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[IF xStatusWord_DriveRunning ]]>
</Line>
<Line Number="39">
<![CDATA[	then]]>
</Line>
<Line Number="40">
<![CDATA[	xDriveRunningActive:=1;]]>
</Line>
<Line Number="41">
<![CDATA[elsif xErrorActive or not i_xEnable]]>
</Line>
<Line Number="42">
<![CDATA[	then]]>
</Line>
<Line Number="43">
<![CDATA[	xDriveRunningActive:=0;]]>
</Line>
<Line Number="44">
<![CDATA[end_if;]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[xErrorPower_Active:=]]>
</Line>
<Line Number="47">
<![CDATA[		xStatusWord_MotorPowerWasMissing]]>
</Line>
<Line Number="48">
<![CDATA[		OR (iq_xRqCmdPos AND NOT xStatusWord_MotorPowerPresent) ]]>
</Line>
<Line Number="49">
<![CDATA[		OR (iq_xRqJogBw AND NOT xStatusWord_MotorPowerPresent)]]>
</Line>
<Line Number="50">
<![CDATA[		OR ( iq_xRqJogFw AND NOT xStatusWord_MotorPowerPresent);]]>
</Line>
<Line Number="51">
<![CDATA[]]>
</Line>
<Line Number="52">
<![CDATA[xErrorActive:= (]]>
</Line>
<Line Number="53">
<![CDATA[		xStatusWord_DragError ]]>
</Line>
<Line Number="54">
<![CDATA[		OR xStatusWord_Error ]]>
</Line>
<Line Number="55">
<![CDATA[		OR  xErrorPower_Active]]>
</Line>
<Line Number="56">
<![CDATA[		OR (xStatusWord_PositioningError AND xDriveRunningActive)]]>
</Line>
<Line Number="57">
<![CDATA[		OR xStatusWord_IncorrectTargetValue ]]>
</Line>
<Line Number="58">
<![CDATA[		OR (xStatusWord_TemperatureExceeded AND xDriveRunningActive)]]>
</Line>
<Line Number="59">
<![CDATA[		) And i_xEnable ;]]>
</Line>
<Line Number="60">
<![CDATA[		]]>
</Line>
<Line Number="61">
<![CDATA[		]]>
</Line>
<Line Number="62">
<![CDATA[]]>
</Line>
<Line Number="63">
<![CDATA[//Decimal correction selection]]>
</Line>
<Line Number="64">
<![CDATA[diDecimalCorr := 0;]]>
</Line>
<Line Number="65">
<![CDATA[case i_iDecimalCorrDigits of]]>
</Line>
<Line Number="66">
<![CDATA[	0:]]>
</Line>
<Line Number="67">
<![CDATA[		diDecimalCorr := 1;]]>
</Line>
<Line Number="68">
<![CDATA[	1:]]>
</Line>
<Line Number="69">
<![CDATA[		diDecimalCorr := 10;]]>
</Line>
<Line Number="70">
<![CDATA[	2:]]>
</Line>
<Line Number="71">
<![CDATA[		diDecimalCorr := 100;]]>
</Line>
<Line Number="72">
<![CDATA[	3:]]>
</Line>
<Line Number="73">
<![CDATA[		diDecimalCorr := 1000;]]>
</Line>
<Line Number="74">
<![CDATA[	4:]]>
</Line>
<Line Number="75">
<![CDATA[		diDecimalCorr := 10000;]]>
</Line>
<Line Number="76">
<![CDATA[	5:]]>
</Line>
<Line Number="77">
<![CDATA[		diDecimalCorr := 100000;]]>
</Line>
<Line Number="78">
<![CDATA[end_case;]]>
</Line>
<Line Number="79">
<![CDATA[]]>
</Line>
<Line Number="80">
<![CDATA[//Actual motor position with decimal correction]]>
</Line>
<Line Number="81">
<![CDATA[q_iActual_Position 		:= (i_diActual_Position) / diDecimalCorr;]]>
</Line>
<Line Number="82">
<![CDATA[q_iMaxTargetValue		:= i_diZeroUpperLimit_36 / diDecimalCorr;]]>
</Line>
<Line Number="83">
<![CDATA[q_iMinTargetValue		:=i_diZeroLowerLimit_38 / diDecimalCorr;]]>
</Line>
<Line Number="84">
<![CDATA[]]>
</Line>
<Line Number="85">
<![CDATA[diPosWindow				:= i_iPosWindow * diDecimalCorr;]]>
</Line>
<Line Number="86">
<![CDATA[]]>
</Line>
<Line Number="87">
<![CDATA[IF i_iPosTarget_Value  > i_diZeroUpperLimit_36]]>
</Line>
<Line Number="88">
<![CDATA[	then]]>
</Line>
<Line Number="89">
<![CDATA[	iPosTarget:=i_diZeroUpperLimit_36 ;]]>
</Line>
<Line Number="90">
<![CDATA[ELSIF	i_iPosTarget_Value < i_diZeroLowerLimit_38]]>
</Line>
<Line Number="91">
<![CDATA[	then]]>
</Line>
<Line Number="92">
<![CDATA[	iPosTarget:=i_diZeroLowerLimit_38 ;	]]>
</Line>
<Line Number="93">
<![CDATA[else]]>
</Line>
<Line Number="94">
<![CDATA[	iPosTarget:=i_iPosTarget_Value ;	]]>
</Line>
<Line Number="95">
<![CDATA[END_IF;]]>
</Line>
