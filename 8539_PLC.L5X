<Routine Name="Calc_StackerPos" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[EM_Infeed.arStacker_TargetPos_dmm[1] := SizeWork_CRS.Stacker.Position.Lower;]]>
</Line>
<Line Number="2">
<![CDATA[EM_Infeed.arStacker_TargetPos_dmm[2] := SizeWork_CRS.Stacker.Position.Traps;]]>
</Line>
<Line Number="3">
<![CDATA[EM_Infeed.arStacker_TargetPos_dmm[3] := SizeWork_CRS.Stacker.Position.AboveTraps;]]>
</Line>
<Line Number="4">
<![CDATA[EM_Infeed.arStacker_TargetPos_dmm[4] := SizeWork_CRS.Stacker.Position.DebufferingPos;]]>
</Line>
<Line Number="5">
<![CDATA[EM_Infeed.arStacker_TargetPos_dmm[5] := SizeWork_CRS.Stacker.Position.Position2;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[//]]>
</Line>
<Line Number="8">
<![CDATA[EM_Infeed.CM_Stacker_CRS.AxisIN_POS_arTargetPos[1] := EM_Infeed.arStacker_TargetPos_dmm[1];]]>
</Line>
<Line Number="9">
<![CDATA[EM_Infeed.CM_Stacker_CRS.AxisIN_POS_arTargetPos[2] := EM_Infeed.arStacker_TargetPos_dmm[2];]]>
</Line>
<Line Number="10">
<![CDATA[EM_Infeed.CM_Stacker_CRS.AxisIN_POS_arTargetPos[3] := EM_Infeed.arStacker_TargetPos_dmm[3];]]>
</Line>
<Line Number="11">
<![CDATA[EM_Infeed.CM_Stacker_CRS.AxisIN_POS_arTargetPos[4] := EM_Infeed.arStacker_TargetPos_dmm[4];]]>
</Line>
<Line Number="12">
<![CDATA[EM_Infeed.CM_Stacker_CRS.AxisIN_POS_arTargetPos[5] := EM_Infeed.arStacker_TargetPos_dmm[5];]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
</STContent>
