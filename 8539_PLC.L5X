<Routines>
<Routine Name="Calc_Pos" Type="ST">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// v0.1        : 07.05.2026]]>
</Line>
<Line Number="1">
<![CDATA[// Author      : Boselli Mattia]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// SYS.N[15]  --> Bundle transfer: Phase On magazine speed]]>
</Line>
<Line Number="4">
<![CDATA[// SYS.N[16] --> Bundle transfer: Phase Off magazine speed]]>
</Line>
<Line Number="5">
<![CDATA[// SYS.N[35] --> Pusher: Distance pos zero and pos case]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[EM_CaseP.iPhaseOn_ChangeSpeed  := SYS.N[15];]]>
</Line>
<Line Number="8">
<![CDATA[EM_CaseP.iPhaseOn_ChangeAcc    := SYS.N[15];]]>
</Line>
<Line Number="9">
<![CDATA[EM_CaseP.iPhaseOff_ChangeAcc   := SYS.N[16];]]>
</Line>
<Line Number="10">
<![CDATA[EM_CaseP.iPhaseOff_ChangeSpeed := SYS.N[16] - 200;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[EM_CaseP.iPusherP2TempPosition := (SYS.N[35] - 210) * 10;]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Cam_CaseOpening" Type="ST">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//Calc cam point from data size and sys]]>
</Line>
<Line Number="1">
<![CDATA[	EM_CaseP.rOpenMotor_Cam_MagazinePos	:=	SYS.N[258] ;	]]>
</Line>
<Line Number="2">
<![CDATA[	EM_CaseP.rOpenMotor_Cam_OpenCasePos	:=	SYS.N[259];	]]>
</Line>
<Line Number="3">
<![CDATA[	EM_CaseP.rOpenMotor_Cam_FillingPos	:=	SYS.N[260] ;	]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[//Clean up Cam Point Array to prevent error]]>
</Line>
<Line Number="6">
<![CDATA[SIZE(EM_CaseP.CIP_CaseOpening.Cam_Data,0,EM_CaseP.CIP_CaseOpening.Cam_diArraySize);]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[FOR EM_CaseP.CIP_CaseOpening.Cam_index:=0 TO (EM_CaseP.CIP_CaseOpening.Cam_diArraySize-1) BY 1 DO]]>
</Line>
<Line Number="9">
<![CDATA[	]]>
</Line>
<Line Number="10">
<![CDATA[	EM_CaseP.CIP_CaseOpening.Cam_Data[EM_CaseP.CIP_CaseOpening.Cam_index].Master_Position			:=		0;]]>
</Line>
<Line Number="11">
<![CDATA[	EM_CaseP.CIP_CaseOpening.Cam_Data[EM_CaseP.CIP_CaseOpening.Cam_index].Slave_Position			:=		0;]]>
</Line>
<Line Number="12">
<![CDATA[	EM_CaseP.CIP_CaseOpening.Cam_Data[EM_CaseP.CIP_CaseOpening.Cam_index].Slave_Velocity			:=		0;									]]>
</Line>
<Line Number="13">
<![CDATA[	EM_CaseP.CIP_CaseOpening.Cam_Data[EM_CaseP.CIP_CaseOpening.Cam_index].Slave_Acceleration		:=		0;]]>
</Line>
<Line Number="14">
<![CDATA[	EM_CaseP.CIP_CaseOpening.Cam_Data[EM_CaseP.CIP_CaseOpening.Cam_index].Slave_Jerk				:=		0;]]>
</Line>
<Line Number="15">
<![CDATA[	EM_CaseP.CIP_CaseOpening.Cam_Data[EM_CaseP.CIP_CaseOpening.Cam_index].SegmentType				:=		0;]]>
</Line>
<Line Number="16">
<![CDATA[	EM_CaseP.CIP_CaseOpening.Cam_Data[EM_CaseP.CIP_CaseOpening.Cam_index].Steps						:=		0;]]>
</Line>
<Line Number="17">
<![CDATA[	]]>
</Line>
<Line Number="18">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[//]]>
</Line>
<Line Number="21">
<![CDATA[//	SegmentType		0=Linear, 		1=Cubic, 			2=5th Order, 		3=7th Order, 	4=9th Order, 	5=Elliptical and Simple Harmonic, ]]>
</Line>
<Line Number="22">
<![CDATA[//					6=Epicyclical,	7=Double Harmonic,	8=Modified Sine,	9=Modified Trapezoid]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[//---------------------------------------------------------------------------------------------------------------]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[//			X0]]>
</Line>
<Line Number="29">
<![CDATA[				EM_CaseP.CIP_CaseOpening.Cam_Data[0].Master_Position		:=		0;]]>
</Line>
<Line Number="30">
<![CDATA[				EM_CaseP.CIP_CaseOpening.Cam_Data[0].Slave_Position			:=		EM_CaseP.rOpenMotor_Cam_FillingPos;]]>
</Line>
<Line Number="31">
<![CDATA[				EM_CaseP.CIP_CaseOpening.Cam_Data[0].Slave_Velocity			:=		0;									]]>
</Line>
<Line Number="32">
<![CDATA[				EM_CaseP.CIP_CaseOpening.Cam_Data[0].Slave_Acceleration		:=		0;]]>
</Line>
<Line Number="33">
<![CDATA[				EM_CaseP.CIP_CaseOpening.Cam_Data[0].Slave_Jerk				:=		0;]]>
</Line>
<Line Number="34">
<![CDATA[				EM_CaseP.CIP_CaseOpening.Cam_Data[0].SegmentType			:=		0;]]>
</Line>
<Line Number="35">
<![CDATA[				EM_CaseP.CIP_CaseOpening.Cam_Data[0].Steps					:=		1;]]>
