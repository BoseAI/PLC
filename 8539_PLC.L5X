<Routine Name="CM_ElectromotiveForce_CAT3" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.Machine_Enable) ,XIC(BB_CRS.EMF_ON) ]XIC(BB_CRS.Pilz_StorageActivated)XIO(BB_CRS.EMF_Inhibition)OTE(BB_CRS.EMF_ON);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.EMF_Inhibition)OTU(BB_CRS.EMF_Inhibition);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.FirstScan)[OTU(BB_CRS.stHardwareReset) ,MOVE(-1,Core_HMI_CRS.Interface.iPageDisplayed) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[NE(Core_HMI_CRS.Interface.iPageDisplayed,-1)OTE(BB_CRS.PageDisplayed_OnPanel);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(BB_CRS.FirstScan)XIO(BB_CRS.stHardwareReset)XIC(BB_CRS.PageDisplayed_OnPanel)[OTE(ALRM_CRS[11]) ,OTL(BB_CRS.Rq_EmergencyImmediateStop) ,TON(Timers_CRS.N[49],?,?) OTL(BB_CRS.stHardwareReset) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[UTILIZZO INGRESSO CP38 PERCHé SU CRS NO ALI]]>
</Comment>
<Text>
<![CDATA[XIO(IN.F0120_02)[OTE(ALRM_CRS[46]) ,OTL(BB_CRS.Rq_EmergencyImmediateStop) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CM_EmergencyRelay" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(IN_CRS.K9440_01)TON(Timers_CRS.N[0],?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(IN_CRS.K9440_01)TON(UM_Machine_CRS.TON_DelayForSafetyOpen,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(UM_Machine_CRS.TON_DelayForSafetyOpen.DN)ONS(UM_Machine_CRS.axPTrig[10])OTE(BB_CRS.Pilz_DownstrokePulse);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Alarm_ResetRqPulse)XIC(BB_CRS.Pilz_StorageOFF)XIO(BB_CRS.Pilz_InhbitionRestore)OTL(BB_CRS.Pilz_RestoreInProgress);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Pilz_InhbitionRestore)OTU(BB_CRS.Pilz_InhbitionRestore);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.Rq_AlrmPushButton) ,XIC(BB_CRS.Rq_AlrmGuard) ,XIC(xRq_AlrmDCS) ,XIC(BB_CRS.Pilz_DownstrokePulse) ][OTL(BB_CRS.Rq_EmergencyImmediateStop) ,XIC(BB_CRS.AlwaysOFF) OTL(BB_CRS.Pilz_StorageOFF) ,OTU(BB_CRS.Pilz_RestoreInProgress) ,OTU(BB_CRS.Pilz_StorageActivated) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(IN_CRS.K9440_01)[OTL(BB_CRS.Pilz_StorageOFF) ,OTU(BB_CRS.Pilz_StorageActivated) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Pilz_RestoreInProgress)XIO(Timers_CRS.N[0].DN)TON(Timers_CRS.N[3],?,?);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Pilz_StorageOFF)XIC(Timers_CRS.N[0].DN)XIC(SafetyCircut_EN_CRS)TON(Timers_CRS.N[1],?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(Timers_CRS.N[3].DN) ,XIC(Timers_CRS.N[1].DN) ]XIC(BB_CRS.AlwaysOFF)[OTE(ALRM_CRS[9]) ,OTL(BB_CRS.Rq_EmergencyImmediateStop) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Pilz_RestoreInProgress)XIC(Timers_CRS.N[0].DN)[OTL(BB_CRS.Pilz_StorageActivated) ,OTU(BB_CRS.Pilz_StorageOFF) ,OTU(BB_CRS.Pilz_RestoreInProgress) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Pilz_RestoreInProgress)XIC(BB_CRS.Movement_GenericRq)OTL(MSG_CRS[1]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CM_EmergencyRelayDelay" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(IN_CRS.K9440_01_DELAYED)TOF(Timers_CRS.N[13],?,?);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Timers_CRS.N[13].DN)OTE(BB_CRS.Pilz_ContactDelayed);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(BB_CRS.Pilz_ContactDelayed)OTL(BB_CRS.EMF_Inhibition);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[per port resettare]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.Pilz_ContactDelayed)XIC(BB_CRS.EMF_ON)OTL(BB_CRS.Pilz_InhbitionRestore);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Pilz_ContactDelayed)XIC(BB_CRS.Pilz_StorageOFF)OTL(BB_CRS.Alarm_ResetInhibition);]]>
</Text>
</Rung>
