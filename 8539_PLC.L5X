<Routine Name="WarningManagement" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(UM_Config.Core.Enable_HMI_SE) JMP(ME) ,XIC(UM_Config.Core.Enable_HMI_SE) JMP(SE) ];]]>
