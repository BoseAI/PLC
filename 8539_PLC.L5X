<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(O_State);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[EQ(I_OnValue,I_OffValue) ,XIO(I_Enable) ]JMP(L_Exit);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[DIV(I_SpeedDegreeSec,1000,CalcPos) ,MUL(I_Advance,CalcPos,CalcPos) ,ADD(I_ActPos,CalcPos,CalcPos) ,GE(CalcPos,I_PosUnwind) SUB(CalcPos,I_PosUnwind,CalcPos) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[LT(I_OnValue,I_OffValue) GE(CalcPos,I_OnValue) LE(CalcPos,I_OffValue) ,GT(I_OnValue,I_OffValue) [GE(CalcPos,I_OnValue) ,LE(CalcPos,I_OffValue) ] ]OTL(O_State);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[LBL(L_Exit)TND();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
