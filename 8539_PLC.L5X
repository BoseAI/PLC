<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[############################
INPUT FB AXIS
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(iq_BB.AlwaysOFF)[OTU(iq_Axis.xNotUsed) ,MOVE(0,iq_Axis.iNotUsed) ];]]>
</Text>
