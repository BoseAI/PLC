<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
<DataValueMember Name="Status" DataType="DINT" Radix="Hex" Value="16#0000_0000"/>
<DataValueMember Name="InstructFault" DataType="BOOL" Value="0"/>
<DataValueMember Name="PresetInv" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="CM_Radar" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(UM_HMI.Machine.Rq_xAccessSensorRecondition)XIC(BB.Automatic_CycleActive)[OTL(MSG[12]) ,OTU(UM_HMI.Machine.Rq_xAccessSensorRecondition) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(UM_HMI.Machine.Rq_xAccessSensorRecondition)XIO(UM_HMI.Machine.St_xAccessSensorRecondition)[OTL(UM_HMI.Machine.St_xAccessSensorRecondition) ,OTU(UM_HMI.Machine.Rq_xAccessSensorRecondition) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(UM_HMI.Machine.St_xAccessSensorRecondition)OTE(OUT.K6340_04_IN1_CH1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(UM_HMI.Machine.St_xAccessSensorRecondition)[TON(Timers.N[330],?,?) ,XIC(Timers.N[330].DN) OTU(UM_HMI.Machine.St_xAccessSensorRecondition) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(UM_HMI.Machine.St_xAccessSensorRecondition)OTL(MSG[52]);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="DataExchange_Machine_Supervisor_CPH2" Type="ST">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment : Startup from 7929 and core cph2_V125]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[// Copy Bool[1024] Alarm to DataScada.Faults ]]>
</Line>
<Line Number="2">
<![CDATA[For i:=0 to 1023 by 1 do]]>
</Line>
<Line Number="3">
<![CDATA[	]]>
</Line>
<Line Number="4">
<![CDATA[	DataScada.Faults[i]:=ALRM[i];]]>
</Line>
<Line Number="5">
<![CDATA[	]]>
</Line>
<Line Number="6">
<![CDATA[	end_for;]]>
</Line>
<Line Number="7">
<![CDATA[	]]>
</Line>
<Line Number="8">
<![CDATA[// Copy Bool[160] MSG to DataScada.Message 	]]>
</Line>
<Line Number="9">
<![CDATA[For j:=0 to 159 by 1 do]]>
</Line>
<Line Number="10">
<![CDATA[	]]>
</Line>
<Line Number="11">
<![CDATA[	DataScada.Message[j]:=MSG[j];]]>
</Line>
<Line Number="12">
<![CDATA[	]]>
</Line>
<Line Number="13">
<![CDATA[	end_for;	]]>
</Line>
<Line Number="14">
<![CDATA[	]]>
</Line>
<Line Number="15">
<![CDATA[// Copy Bool[160] WRNG to DataScada.Warning 	]]>
</Line>
<Line Number="16">
<![CDATA[For k:=0 to 159 by 1 do]]>
</Line>
<Line Number="17">
<![CDATA[	]]>
</Line>
<Line Number="18">
<![CDATA[	DataScada.Warning[k]:=WRNG[k];]]>
</Line>
<Line Number="19">
<![CDATA[	]]>
</Line>
<Line Number="20">
<![CDATA[	end_for;	]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[	]]>
</Line>
<Line Number="23">
<![CDATA[DataScada.MachineSpeed:=Core_HMI.Interface.iMachine_UnitsPerMinute;]]>
</Line>
<Line Number="24">
<![CDATA[]]>
</Line>
<Line Number="25">
<![CDATA[DataScada.ReadyToStart:=BB.WrngRq_MachineReadyForAuto;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[DataScada.Running:=BB.WrngRq_MachineRunning;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[//DataScada.WaitingProduct:=OUT.P0500_02;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[DataScada.LowLevelMaterial:=BB.WrngRq_PackingMatOutCondition;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[DataScada.StopWithAlarm:=BB.WrngRq_MachineAlarms or BB.WrngRq_MachineResetAlarms;]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[DataScada.Clock:=BB.Clock_1000ms;]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[DataScada.TotalProductionHours:=UM_HMI.Production.diTotalCounterHours;]]>
</Line>
<Line Number="38">
<![CDATA[]]>
</Line>
<Line Number="39">
<![CDATA[DataScada.TotalProductionMinutes:=UM_HMI.Production.diTotalCounterMin;]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[DataScada.PartialProductionHours:=UM_HMI.Production.diPartialCounterHours;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[DataScada.PartialProductionMinutes:=UM_HMI.Production.diPartialCounterMin;]]>
</Line>
<Line Number="44">
<![CDATA[]]>
</Line>
<Line Number="45">
<![CDATA[DataScada.TotalOutputProducts:=UM_HMI.Production.diTotalCounterCycles;]]>
</Line>
<Line Number="46">
<![CDATA[]]>
</Line>
<Line Number="47">
<![CDATA[DataScada.PartialOutputProducts:=UM_HMI.Production.diPartialCounterCycles;]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[DataScada.TotalOutputProductsGood:=UM_HMI.Production.diTotalCounterGood;]]>
</Line>
<Line Number="50">
<![CDATA[]]>
</Line>
<Line Number="51">
<![CDATA[DataScada.PartialOutputProductsGood:=UM_HMI.Production.diPartialCounterGood;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Empty" Type="ST">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment : Startup from 7929 and core cph2_V125
]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// Fist Scan]]>
</Line>
<Line Number="1">
<![CDATA[IF BB.FirstScan THEN	]]>
</Line>
<Line Number="2">
<![CDATA[	CPS(OM_Empty_Hmi_Clear,OM_Empty_Hmi,1);]]>
</Line>
<Line Number="3">
<![CDATA[	CPS(OM_Empty_Hmi_PB_Clear,OM_Empty_Hmi_PB,1);	]]>
</Line>
<Line Number="4">
<![CDATA[END_IF;]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[// Rq Empty Enabling]]>
</Line>
<Line Number="7">
<![CDATA[IF OM_Empty_Hmi_PB.xRq_MachineEmptyEnabling THEN]]>
</Line>
<Line Number="8">
<![CDATA[	IF NOT BB.Automatic_CycleActive THEN		]]>
</Line>
<Line Number="9">
<![CDATA[		MSG[12] := 1;]]>
</Line>
<Line Number="10">
<![CDATA[		OM_Empty_Hmi_PB.xRq_MachineEmptyEnabling := 0;		]]>
</Line>
<Line Number="11">
<![CDATA[	END_IF;	]]>
</Line>
<Line Number="12">
<![CDATA[	IF NOT OM_Empty_Hmi_PB.xSt_MachineEmptyEnabling THEN		]]>
</Line>
<Line Number="13">
<![CDATA[		OM_Empty_Hmi_PB.xSt_MachineEmptyEnabling := 1;]]>
</Line>
<Line Number="14">
<![CDATA[		OM_Empty_Hmi_PB.xRq_MachineEmptyEnabling := 0;		]]>
</Line>
<Line Number="15">
<![CDATA[	ELSIF OM_Empty_Hmi_PB.xSt_MachineEmptyEnabling THEN		]]>
</Line>
<Line Number="16">
<![CDATA[		OM_Empty_Hmi_PB.xSt_MachineEmptyEnabling := 0;]]>
</Line>
<Line Number="17">
<![CDATA[		OM_Empty_Hmi_PB.xRq_MachineEmptyEnabling := 0;		]]>
</Line>
<Line Number="18">
<![CDATA[	END_IF;	]]>
</Line>
<Line Number="19">
<![CDATA[END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[// Enabled only in auto cycle]]>
</Line>
<Line Number="22">
<![CDATA[IF OM_Empty_Hmi_PB.xSt_MachineEmptyEnabling AND NOT BB.Automatic_CycleActive THEN]]>
</Line>
<Line Number="23">
<![CDATA[	OM_Empty_Hmi_PB.xSt_MachineEmptyEnabling := 0;	]]>
</Line>
<Line Number="24">
<![CDATA[END_IF;]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[OM_Empty.xEnable := OM_Empty_Hmi_PB.xSt_MachineEmptyEnabling;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[// WRNG 11]]>
</Line>
<Line Number="29">
<![CDATA[IF OM_Empty.xEnable THEN]]>
</Line>
<Line Number="30">
<![CDATA[	WRNG[11] := 1;	]]>
</Line>
<Line Number="31">
<![CDATA[END_IF;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[//Si usano?!]]>
</Line>
<Line Number="34">
<![CDATA[//OM_Empty.xRqDisableAirForEmptying 	:= OM_Empty.xEnable and not OM_Interface.infeed_xinCompleteprodInFrontPusher;]]>
</Line>
<Line Number="35">
<![CDATA[//OM_Empty.xRqDisableAirForEndOfDay 	:= 0;]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[TON_NoProductComingTO.PRE := Timers.N[150].PRE;]]>
</Line>
<Line Number="38">
<![CDATA[TON_NoProductComingTO.TimerEnable := OM_Empty.xEnable]]>
</Line>
<Line Number="39">
<![CDATA[	and IN.B39]]>
</Line>
<Line Number="40">
<![CDATA[	and IN.B38]]>
</Line>
<Line Number="41">
<![CDATA[	and not IN.B1700_02]]>
</Line>
<Line Number="42">
<![CDATA[	and IN.B1701_01]]>
</Line>
<Line Number="43">
<![CDATA[	and IN.B1700_01]]>
</Line>
<Line Number="44">
<![CDATA[	and not BB.Rq_AlrmGuard;]]>
</Line>
<Line Number="45">
<![CDATA[TONR(TON_NoProductComingTO);]]>
</Line>
<Line Number="46">
<![CDATA[OM_Empty.xNoProductComing := TON_NoProductComingTO.DN;]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[OM_Empty.xForcePusherFilling 		:= 0;]]>
</Line>
<Line Number="49">
<![CDATA[OM_Empty.xProductNotEnoughtToStack 	:= 0;]]>
</Line>
<Line Number="50">
<![CDATA[OM_Empty.xForceStackerStacking 		:= 0;]]>
</Line>
<Line Number="51">
<![CDATA[OM_Empty.xLastProductToPush 		:= 0;]]>
</Line>
<Line Number="52">
<![CDATA[OM_Empty.xSpr_24	:= 0;]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[if OM_Empty.xNoProductComing]]>
</Line>
<Line Number="55">
<![CDATA[then]]>
</Line>
<Line Number="56">
<![CDATA[	//if we have a row but some stacks too high for the highest traps we bring them up if under there is nothing]]>
</Line>
<Line Number="57">
<![CDATA[	//if we have a row and the stacks are not in interference with the pusher we push it inside]]>
</Line>
<Line Number="58">
<![CDATA[	if UM_HMI.MachineWorkData.St_iActualRowsNumber <> 0]]>
</Line>
<Line Number="59">
<![CDATA[	then]]>
</Line>
<Line Number="60">
<![CDATA[		if OM_Interface.Infeed_xStackerPreStackerCycleInhibit]]>
</Line>
<Line Number="61">
<![CDATA[		then]]>
</Line>
<Line Number="62">
<![CDATA[			if UM_HMI.MachineWorkData.St_iActualDosingProductNumber <> 0]]>
</Line>
<Line Number="63">
<![CDATA[			then]]>
</Line>
<Line Number="64">
<![CDATA[				OM_Empty.xProductNotEnoughtToStack := 1;	//product is not enough in the stacking area in order to go up]]>
</Line>
<Line Number="65">
<![CDATA[				;											//do nothing, the product overcomes the top traps and the pusher cannot go forward]]>
</Line>
<Line Number="66">
<![CDATA[			else]]>
</Line>
<Line Number="67">
<![CDATA[				OM_Empty.xRqLongStrokeAlways	:= 1;]]>
</Line>
<Line Number="68">
<![CDATA[				OM_Empty.xForceStackerStacking 	:= 1;		//force the product up]]>
</Line>
<Line Number="69">
<![CDATA[				OM_Empty.xSpr_24	:= 1;	//go up in order to easy the cleaning procedure]]>
</Line>
<Line Number="70">
<![CDATA[			end_if;]]>
</Line>
<Line Number="71">
<![CDATA[		else]]>
</Line>
<Line Number="72">
<![CDATA[			OM_Empty.xForcePusherFilling 	:= 1;		//force the product inside the case]]>
</Line>
<Line Number="73">
<![CDATA[			if UM_HMI.MachineWorkData.St_iActualRowsNumber <> SizeWork.Pusher.RowsNr]]>
</Line>
<Line Number="74">
<![CDATA[			then]]>
</Line>
<Line Number="75">
<![CDATA[				OM_Empty.axOSTrig[1].InputBit 	:= 1;	//force the product as a final incomplete case]]>
</Line>
<Line Number="76">
<![CDATA[			end_if;]]>
</Line>
<Line Number="77">
<![CDATA[		end_if;]]>
</Line>
<Line Number="78">
<![CDATA[	else]]>
</Line>
<Line Number="79">
<![CDATA[		//if we have some products under the traps we check if there is nothing up, in this case what is down can go up]]>
</Line>
<Line Number="80">
<![CDATA[		//if we have some stacks we stand still]]>
</Line>
<Line Number="81">
<![CDATA[		//if there is nothing down but we do have some stacks we force them up for a last case filling]]>
</Line>
<Line Number="82">
<![CDATA[		if UM_HMI.MachineWorkData.St_iActualDosingProductNumber <> 0]]>
</Line>
<Line Number="83">
<![CDATA[		then]]>
</Line>
<Line Number="84">
<![CDATA[			OM_Empty.xProductNotEnoughtToStack := 1;	//product is not enough in the stacking area in order to go up]]>
</Line>
<Line Number="85">
<![CDATA[		end_if;]]>
</Line>
<Line Number="86">
<![CDATA[		if OM_Empty.xProductNotEnoughtToStack]]>
</Line>
<Line Number="87">
<![CDATA[			and UM_HMI.MachineWorkData.St_iActualLayerNumber = 0	]]>
</Line>
<Line Number="88">
<![CDATA[		then]]>
</Line>
<Line Number="89">
<![CDATA[			OM_Empty.xForceStackerStacking := 1; 		//force the product up]]>
</Line>
<Line Number="90">
<![CDATA[		elsif UM_HMI.MachineWorkData.St_iActualDosingProductNumber = 0]]>
</Line>
<Line Number="91">
<![CDATA[			and UM_HMI.MachineWorkData.St_iActualLayerNumber <> 0]]>
</Line>
<Line Number="92">
<![CDATA[		then]]>
</Line>
<Line Number="93">
<![CDATA[			OM_Empty.xForceStackerStacking := 1;		//force the product up]]>
</Line>
<Line Number="94">
<![CDATA[		end_if;]]>
</Line>
<Line Number="95">
<![CDATA[		OM_Empty.xLastProductToPush := 1;]]>
</Line>
<Line Number="96">
<![CDATA[	end_if;]]>
</Line>
<Line Number="97">
<![CDATA[end_if;]]>
</Line>
<Line Number="98">
<![CDATA[]]>
</Line>
<Line Number="99">
<![CDATA[OSRI(OM_Empty.axOSTrig[1]);]]>
</Line>
<Line Number="100">
<![CDATA[if OM_Empty.axOSTrig[1].OutputBit then]]>
</Line>
<Line Number="101">
<![CDATA[		OM_Interface.infeed_xinCompleteprodInFrontPusher:= 1;]]>
</Line>
<Line Number="102">
<![CDATA[end_if;]]>
</Line>
<Line Number="103">
<![CDATA[]]>
</Line>
<Line Number="104">
<![CDATA[if OM_Empty.xNoProductComing]]>
</Line>
<Line Number="105">
<![CDATA[	and not BB.Machine_Moving]]>
</Line>
<Line Number="106">
<![CDATA[	and OM_Interface.CaseP_xStopInPhase]]>
</Line>
<Line Number="107">
<![CDATA[	//and not OM_ShiftCases_HMI.Pos1_Filling.St_xCasePresence]]>
</Line>
<Line Number="108">
<![CDATA[	and not OM_ShiftCases_HMI.Pos2_Closing.St_xCasePresence]]>
</Line>
<Line Number="109">
<![CDATA[	and not OM_ShiftCases_HMI.Pos3_Outfeed.St_xCasePresence]]>
</Line>
<Line Number="110">
<![CDATA[	and not OM_ShiftCases_HMI.Pos4_Outfeed.St_xCasePresence]]>
</Line>
<Line Number="111">
<![CDATA[	and not OM_ShiftCases_HMI.Pos5_Outfeed.St_xCasePresence]]>
</Line>
<Line Number="112">
<![CDATA[	and not OM_ShiftCases_HMI.Pos5_Outfeed.St_xCasePresence]]>
</Line>
<Line Number="113">
<![CDATA[	and not OM_ShiftCases_HMI.Pos_Robot.St_xCasePresence]]>
</Line>
<Line Number="114">
<![CDATA[then]]>
</Line>
<Line Number="115">
<![CDATA[	TON_EmptyingTO.TimerEnable := 1;]]>
</Line>
<Line Number="116">
<![CDATA[else]]>
</Line>
<Line Number="117">
<![CDATA[	TON_EmptyingTO.TimerEnable := 0;]]>
</Line>
<Line Number="118">
<![CDATA[end_if;]]>
</Line>
<Line Number="119">
<![CDATA[]]>
</Line>
<Line Number="120">
<![CDATA[TON_EmptyingTO.PRE := 5000;]]>
</Line>
<Line Number="121">
<![CDATA[TONR(TON_EmptyingTO);]]>
</Line>
<Line Number="122">
<![CDATA[ALRM[75] := TON_EmptyingTO.DN;]]>
</Line>
<Line Number="123">
<![CDATA[]]>
</Line>
<Line Number="124">
<![CDATA[IF ALRM[75]]]>
</Line>
<Line Number="125">
<![CDATA[THEN]]>
</Line>
<Line Number="126">
<![CDATA[	OM_Empty.xDetachCaseInFilling 				:= 1;]]>
</Line>
<Line Number="127">
<![CDATA[	OM_Empty_Hmi_PB.xSt_MachineEmptyEnabling 	:= 0;]]>
</Line>
<Line Number="128">
<![CDATA[	BB.Count_EnableCheckOfResetCounts			:= 1;]]>
</Line>
<Line Number="129">
<![CDATA[END_IF;]]>
</Line>
<Line Number="130">
<![CDATA[]]>
</Line>
<Line Number="131">
<![CDATA[if not (OM_ShiftCases_HMI.Pos1_Filling.St_xCasePresence]]>
</Line>
<Line Number="132">
<![CDATA[	or OM_ShiftCases_HMI.Pos1_Filling.St_xCasePresence_NoLoadRun]]>
</Line>
<Line Number="133">
<![CDATA[	or OUT.Q2930_01_SUC]]>
</Line>
<Line Number="134">
<![CDATA[	or OUT.Q2910_01_BLW)]]>
</Line>
<Line Number="135">
<![CDATA[then]]>
</Line>
<Line Number="136">
<![CDATA[	OM_Empty.xDetachCaseInFilling := 0;]]>
</Line>
<Line Number="137">
<![CDATA[end_if;]]>
</Line>
<Line Number="138">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Main" Type="RLL">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Empty,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(UM_Config.Core.Enable_RemoteAssistance)JSR(DataExchange_Machine_Supervisor_CPH2,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(UM_Config.Core.Enable_RemoteAssistance)JSR(TeleService,0);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(UM_Config.Core.Enable_UPS)JSR(UPS,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(CM_Radar,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="TeleService" Type="RLL">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[Teleservice(Teleservice,OUT.K0520_01,Core_HMI.PB.St_xOptGr_RemoteAssistanceEnabling,Core_HMI.PB.Rq_xOptGr_RemoteAssistanceEnabling,WRNG[14],MSG[12],BB.Automatic_CycleActive,IN.KA650);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="UPS" Type="RLL">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(IN.T0130_02_Alarm)[OTE(ALRM[65]) ,TON(Timers.N[390],?,?) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(IN.T0130_02_24V)[OTE(ALRM[66]) ,TON(Timers.N[391],?,?) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB.AlwaysOFF)[XIC(Timers.N[390].DN) ,XIC(Timers.N[391].DN) ]OTE(OM_Interface.Machine_xRqShutDown);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="CPH2_RP4_OM_Shift_Cases_T101" TestEdits="false" MainRoutineName="Main" Disabled="false" Class="Standard" UseAsFolder="false">
<Description>
<![CDATA[v0.1        : 04.07.2022
Author      : Ing.Utili Nicola
Comment : Startup Core Tia15.1 cph2_V330
			and Studio5000 CPH2_V125]]>
</Description>
<Tags>
<Tag Name="aux_Zero" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="DB_CaseShiftReset_Position" TagType="Base" DataType="F_ResetCounter" Dimensions="10" Constant="false" ExternalAccess="Read/Write" OpcUaAccess="None">
<Data Format="L5K">
<![CDATA[[[1,[0,250,0]],[32,[0,250,0]],[32,[0,250,0]],[32,[0,250,0]],[32,[0,250,0]],[32,[0,250,0]],[0,[0,250,0]],[1,[0,250,0]],[1,[0,250,0]],[1,[0,250,0]]]]]>
