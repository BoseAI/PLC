<![CDATA[        136:  //Package 35-37 - Size PeP R800]]>
</Line>
<Line Number="387">
<![CDATA[            iWordNumber := 24;          ]]>
</Line>
<Line Number="388">
<![CDATA[			CPS(iq_PeP_Size_Robot.R824, iq_Robot_GI.i02,iWordNumber);]]>
</Line>
<Line Number="389">
<![CDATA[ ]]>
</Line>
<Line Number="390">
<![CDATA[            iq_Robot_GI.i01 := 36;]]>
</Line>
<Line Number="391">
<![CDATA[            ]]>
</Line>
<Line Number="392">
<![CDATA[            IF iq_Robot_GI.i01 = iq_Robot_GO.i01 THEN]]>
</Line>
<Line Number="393">
<![CDATA[                iq_iCf_Step := 137;]]>
</Line>
<Line Number="394">
<![CDATA[            END_IF;]]>
</Line>
<Line Number="395">
<![CDATA[            ]]>
</Line>
<Line Number="396">
<![CDATA[        137:  //Package 35-37 - Size PeP R800]]>
</Line>
<Line Number="397">
<![CDATA[            iWordNumber := 24;        ]]>
</Line>
<Line Number="398">
<![CDATA[ 			CPS(iq_PeP_Size_Robot.R848, iq_Robot_GI.i02,iWordNumber);]]>
</Line>
<Line Number="399">
<![CDATA[]]>
</Line>
<Line Number="400">
<![CDATA[            iq_Robot_GI.i01 := 37;]]>
</Line>
<Line Number="401">
<![CDATA[            ]]>
</Line>
<Line Number="402">
<![CDATA[            IF iq_Robot_GI.i01 = iq_Robot_GO.i01 THEN]]>
</Line>
<Line Number="403">
<![CDATA[                iq_iCf_Step := 138;]]>
</Line>
<Line Number="404">
<![CDATA[            END_IF;]]>
</Line>
<Line Number="405">
<![CDATA[            ]]>
</Line>
<Line Number="406">
<![CDATA[        138:]]>
</Line>
<Line Number="407">
<![CDATA[            IF iq_Robot_DO.x18  THEN]]>
</Line>
<Line Number="408">
<![CDATA[                iq_xCF_Done := 1;]]>
</Line>
<Line Number="409">
<![CDATA[                IF i_xWorkSizePresent THEN]]>
</Line>
<Line Number="410">
<![CDATA[                    iq_iCountDevOk := iq_iCountDevOk + 1;]]>
</Line>
<Line Number="411">
<![CDATA[                END_IF;]]>
</Line>
<Line Number="412">
<![CDATA[            END_IF;]]>
</Line>
<Line Number="413">
<![CDATA[            ]]>
</Line>
<Line Number="414">
<![CDATA[        ELSE  // Statement section ELSE]]>
</Line>
<Line Number="415">
<![CDATA[            ;]]>
</Line>
<Line Number="416">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="417">
<![CDATA[    ]]>
</Line>
