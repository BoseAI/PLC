<Rung Number="30" Type="N">
<Text>
<![CDATA[MUL(DB_MaxValue_Hmi.MotorSizeChange.M5451_01_Pos,10,OM_SizeChangeMotor_HMI_PB.iOutOfObstructPos_M5451_01);]]>
