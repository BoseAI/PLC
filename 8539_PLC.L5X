<Routine Name="Cycle_SizeChangeMotor_T1" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(BB.FirstScan) ,XIC(OM_SizeChangeMotor.xOptionChanged) ,XIC(OM_SizeChangeMotor_HMI.St_xAbortAutoSizeChange) ][MOVE(0,OM_SizeChangeMotor_HMI.St_iSequenceProgress) ,OTU(OM_Interface.AutoSizeChange_xInProgress) ,XIC(OM_SizeChangeMotor_HMI.St_xAbortAutoSizeChange) OTL(OM_Interface.AutoSizeChange_xAbort) ,OTU(OM_SizeChangeMotor_HMI.St_xAbortAutoSizeChange) ,OTU(OM_SizeChangeMotor.xSizeChangeOverCompletePositive) ,OTU(OM_Interface.xAutoSizeChange_Rq) ,OTU(OM_SizeChangeMotor_HMI.St_xConfirmMechPartsReplacement_Done) ,OTU(OM_SizeChangeMotor.xRqAutoAdjustmentMachine) ,OTU(OM_SizeChangeMotor.xRqOutObstructionAdjustmentMachine) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Network 1
]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface.xAutoSizeChange_Rq)XIO(OM_Interface.AutoSizeChange_xInProgress)[MOVE(0,OM_SizeChangeMotor_HMI.St_iSequenceProgress) ,OTL(OM_Interface.AutoSizeChange_xInProgress) ,OTU(OM_SizeChangeMotor.xSizeChangeOverCompletePositive) ,OTU(OM_Interface.xAutoSizeChange_Rq) ,OTU(OM_SizeChangeMotor_HMI.St_xConfirmMechPartsReplacement_Done) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Network 2]]>
</Comment>
<Text>
<![CDATA[[[XIC(IN.S1100_01) XIC(IN.S1100_02) ,XIC(OM_SizeChangeMotor.xSizeChangeOverRunning) ] XIC(BB.Machine_ReadyDelayedForEnableDriver) ,XIO(OM_SizeChangeMotor_HMI.St_xSizeChangeMotorEnable) ]XIC(OM_Interface.xAutoSizeChange_InProgress)OTE(OM_SizeChangeMotor.xSizeChangeOverRunning);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Network 3]]>
</Comment>
<Text>
<![CDATA[XIO(OM_SizeChangeMotor.xSizeChangeOverCompletePositive)XIC(OM_SizeChangeMotor_HMI.St_xSizeChangeMotorEnable)[XIO(OM_SizeChangeMotor.M0451_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0452_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0453_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0454_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0455_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0456_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0457_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0458_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0459_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0460_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M0461_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M5451_01.xAdjustmentDone) ,XIO(OM_SizeChangeMotor.M5452_01.xAdjustmentDone) ][OTL(BB.Automatic_CycleInhibition) ,XIO(OM_Interface.xAutoSizeChange_InProgress) OTL(MSG[121]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(OM_Interface.xAutoSizeChange_InProgress)OTL(BB.Automatic_CycleInhibition);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(OM_Interface.xAutoSizeChange_InProgress)EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,0)OTL(OM_SizeChangeMotor.xRqIncreaseSequence);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(OM_Interface.xAutoSizeChange_InProgress)EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,1)MOVE(40,OM_SizeChangeMotor_HMI.St_iSequenceProgress);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[************************************************
Execute machine standard "Size" change
************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,40)[OTL(BB.SizeChange_RqAdjustmentDataTable) ,OTL(OM_SizeChangeMotor.xRqIncreaseSequence) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,41)OTL(OM_SizeChangeMotor.xRqIncreaseSequence);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,42)OTL(OM_SizeChangeMotor.xRqIncreaseSequence);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[************************************************
Ask for the mechanical partos to be ready
************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(BB.Machine_Ready)MOVE(2500,L_tonMcReady.PRE)TON(L_tonMcReady,?,?);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,43)XIC(OM_SizeChangeMotor.xSizeChangeOverRunning)XIC(L_tonMcReady.DN)[XIC(OM_SizeChangeMotor_HMI.St_xSizeChangeMotorEnable) XIC(OM_Interface.xMachine_StartSizeChangeMot) OTL(OM_Interface.xPAL_RqoutOfObstruction) ,MOVE(47,OM_SizeChangeMotor_HMI.St_iSequenceProgress) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[************************************************
Ask for the mechanical parts to be ready
************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,47)XIC(OM_SizeChangeMotor_HMI.Rq_xConfirmMechPartsReplacement_Done)[XIO(OM_Interface.xMechanicalAdjustmentNotInRange) ,XIO(OM_MechanicalAdjustment_HMI_PB.St_xEnable) ][OTU(OM_Interface.xAutoSizeChangeMot_ChangeSizeInhibition) ,OTL(OM_SizeChangeMotor.xRqIncreaseSequence) ,OTL(OM_SizeChangeMotor_HMI.St_xConfirmMechPartsReplacement_Done) ,OTU(OM_SizeChangeMotor_HMI.Rq_xConfirmMechPartsReplacement_Done) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,48)XIO(BB.SetSize)OTL(OM_SizeChangeMotor.xRqIncreaseSequence);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,49)XIC(BB.SetSize)OTL(OM_SizeChangeMotor.xRqIncreaseSequence);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,50)MOVE(65,OM_SizeChangeMotor_HMI.St_iSequenceProgress);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[************************************************
Confirm with the start button
************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,65)XIC(OM_SizeChangeMotor.xSizeChangeOverRunning)[XIC(OM_SizeChangeMotor_HMI.St_xSizeChangeMotorEnable) OTL(OM_SizeChangeMotor.xRqAutoAdjustmentMachine) ,MOVE(120,OM_SizeChangeMotor_HMI.St_iSequenceProgress) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[EQ(OM_SizeChangeMotor_HMI.St_iSequenceProgress,120)[OTU(OM_SizeChangeMotor.M0451_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0452_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0453_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0454_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0455_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0456_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0457_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0458_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0459_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0460_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M0461_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M5451_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.M5452_01.xAdjustmentDone) ,OTU(OM_SizeChangeMotor.xRqOutObstructionAdjustmentMachine) ,MOVE(180,OM_SizeChangeMotor_HMI.St_iSequenceProgress) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[************************************************
Wait for the machine to finish all adjustments
************************************************]]>
