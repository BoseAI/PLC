<Routines>
<Routine Name="CheckBundleType" Type="RLL">
<Description>
<![CDATA[v0.1        : 21.02.2023
Author      : Ing.Utili Nicola
Comment: Startup from 8032_Cph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////////////////////////////////////
SUMMARY:
"Size_Palletizer".R106 Type Asp
=0 A
 =1A+B indip. standard
  =2 A reinforced with B,
								               =3 A+B indip. linea, 										 

PAL_SizeWork.Palletizer.Generals.R123 Offset R =0,90,180, 270,

PAL_SizeWork.Palletizer.Generals.R113 => cases number in Y
PAL_SizeWork.Palletizer.Generals.R133 => cases number in X

PAL_SizeWork.Palletizer.Generals.R134 => rows number in channel A
PAL_SizeWork.Palletizer.Generals.R135 => rows number in channel B

Pickup Type => 
0= A+B
1 = Nothing
2 = A
3 = B

Release Type => 
0=A+B
2= A
3=B]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB.FirstScan)XIO(DB_DynamicBundle.xDynamicBundleInfeedActive)[MOVE(0,DB_DynamicBundle.iNumberCaseX_Requested) ,MOVE(0,DB_DynamicBundle.iNumberRowsY_Requested) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQ(DB_DynamicBundle.iUpdatePickCount_Cycle,0)XIC(DB_DynamicBundle.xDynamicBundleInfeedActive)XIO(OM_Interface.PAL_xPickUpTypeToPrepareSelected)MOVE(1,DB_DynamicBundle.iUpdatePickCount_Cycle);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[///////////////////////////////////
Saving previously saved bundle values
///////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[EQ(DB_DynamicBundle.iUpdatePickCount_Cycle,1)[MOVE(DB_DynamicBundle.iBundleTypeToPrepare,DB_DynamicBundle.iMemBundleType) ,MOVE(DB_DynamicBundle.iCurrentPickUpForLayer,DB_DynamicBundle.iNrPickUpBundle) ,MOVE(DB_DynamicBundle.iCurrentlLayer,DB_DynamicBundle.iNrBundleLayer) ,MOVE(5,DB_DynamicBundle.iUpdatePickCount_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[///////////////////////////////////
Check if an external counters reset has been requested (if products have been removed from the infeed and the counts reset)
///////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[EQ(DB_DynamicBundle.iUpdatePickCount_Cycle,5)[XIC(DB_DynamicBundle.xRqInfeedPickup) MOVE(10,DB_DynamicBundle.iUpdatePickCount_Cycle) ,XIO(DB_DynamicBundle.xRqInfeedPickup) MOVE(100,DB_DynamicBundle.iUpdatePickCount_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[///////////////////////////////////
Check if an external counters reset has been requested (if products have been removed from the infeed and the counts reset)
///////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[EQ(DB_DynamicBundle.iUpdatePickCount_Cycle,10)[ResetPickCounter(DB_ResetPickCounter,DB_Pal_RobotIO.GO.i04,DB_Pal_RobotIO.GO.i03,DB_DynamicBundle.iCurrentlLayer,DB_DynamicBundle.iCurrentPickUpForLayer) ,OTU(DB_DynamicBundle.xRqInfeedPickup) ,MOVE(105,DB_DynamicBundle.iUpdatePickCount_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[///////////////////////////////////
the pick-up number is updated (to the next one)
///////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[EQ(DB_DynamicBundle.iUpdatePickCount_Cycle,100)[UpdateNrPick(DB_UpdateNrPick,DB_DynamicBundle.iLayerType,PAL_SizeWork.Palletizer.Generals.R110,PAL_SizeWork.Palletizer.Generals.R111,PAL_SizeWork.Palletizer.Generals.R112,DB_DynamicBundle.iCurrentPickUpForLayer,DB_DynamicBundle.iCurrentPickUpForLayer) ,OTU(DB_DynamicBundle.xRqInfeedPickup) ,MOVE(105,DB_DynamicBundle.iUpdatePickCount_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[///////////////////////////////////
the pick-up number is updated (to the next one)
///////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[EQ(DB_DynamicBundle.iUpdatePickCount_Cycle,105)[FindPickType(DB_FindPickType,DB_DynamicBundle.iCurrentPickUpForLayer,DB_DynamicBundle.iCurrentlLayer,PAL_SizeWork.Palletizer.Generals,PAL_SizeWork.Palletizer.DepositTypeLayerA,PAL_SizeWork.Palletizer.DepositTypeLayerB,DB_DynamicBundle.iBundleTypeToPrepare,DB_DynamicBundle.iLayerType) ,MOVE(110,DB_DynamicBundle.iUpdatePickCount_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[///////////////////////////////////
I check if the Pickup type is A, B, A+B, NONE. In case it is NONE (=1), then I go back for a new pickup update, so that I consider the next one
///////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[EQ(DB_DynamicBundle.iUpdatePickCount_Cycle,110)[EQ(DB_DynamicBundle.iBundleTypeToPrepare,1) MOVE(100,DB_DynamicBundle.iUpdatePickCount_Cycle) ,NE(DB_DynamicBundle.iBundleTypeToPrepare,1) MOVE(120,DB_DynamicBundle.iUpdatePickCount_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[///////////////////////////////////
It is calculate how many boxes are required in X based on the pickup Type
///////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[EQ(DB_DynamicBundle.iUpdatePickCount_Cycle,120)[XIO(OM_Interface.Pal_xPickUpInPlane) [EQ(DB_DynamicBundle.iBundleTypeToPrepare,0) ADD(PAL_SizeWork.Palletizer.Generals.R134,PAL_SizeWork.Palletizer.Generals.R135,DB_DynamicBundle.iNumberCaseX_Requested) ,EQ(DB_DynamicBundle.iBundleTypeToPrepare,2) MOVE(PAL_SizeWork.Palletizer.Generals.R134,DB_DynamicBundle.iNumberCaseX_Requested) ,EQ(DB_DynamicBundle.iBundleTypeToPrepare,3) MOVE(PAL_SizeWork.Palletizer.Generals.R135,DB_DynamicBundle.iNumberCaseX_Requested) ] ,XIC(OM_Interface.Pal_xPickUpInPlane) NE(PAL_SizeWork.Palletizer.Generals.R106,3) MOVE(PAL_SizeWork.Palletizer.Generals.R133,DB_DynamicBundle.iNumberCaseX_Requested) ,MOVE(130,DB_DynamicBundle.iUpdatePickCount_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQ(DB_DynamicBundle.iUpdatePickCount_Cycle,130)[XIO(OM_Interface.Pal_xPickUpInPlane) MOVE(1,DB_DynamicBundle.iNumberRowsY_Requested) ,XIC(OM_Interface.Pal_xPickUpInPlane) NE(PAL_SizeWork.Palletizer.Generals.R106,3) [EQ(DB_DynamicBundle.iBundleTypeToPrepare,0) ADD(PAL_SizeWork.Palletizer.Generals.R134,PAL_SizeWork.Palletizer.Generals.R135,DB_DynamicBundle.iNumberRowsY_Requested) ,EQ(DB_DynamicBundle.iBundleTypeToPrepare,2) MOVE(PAL_SizeWork.Palletizer.Generals.R134,DB_DynamicBundle.iNumberRowsY_Requested) ,EQ(DB_DynamicBundle.iBundleTypeToPrepare,3) MOVE(PAL_SizeWork.Palletizer.Generals.R135,DB_DynamicBundle.iNumberRowsY_Requested) ] ,[MOVE(0,DB_DynamicBundle.iUpdatePickCount_Cycle) ,OTL(OM_Interface.PAL_xPickUpTypeToPrepareSelected) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CheckForResetInfeed" Type="RLL">
<Description>
<![CDATA[v0.1        : 21.02.2023
Author      : Ing.Utili Nicola
Comment: Startup from 8032_Cph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(DB_DynamicBundle.xDynamicBundleInfeedActive) ,XIC(BB.FirstScan) ]OTU(DB_DynamicBundle.xCalcInfeedResetCheckInProgress);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB.FirstScan)MOVE(DB_Pal_RobotIO.GO.i07,DB_DynamicBundle.iCurrentPickupTypeMem);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB.SetSize)[XIC(DB_DynamicBundle.xDynamicBundleInfeedActive) [EQ(OM_Interface.PAL_iRobotStatus,0) ,XIO(BB.NoLoadRun_Enable) XIO(BB.Automatic_CycleActive) XIO(OM_Interface.PAL_xCycleRunningAndMoving) ] XIC(OM_Interface.PAL_xPrdOnHeadTobePlaced) XIO(OM_Interface.Pal_xRobotHeadBusyForCheckResetInfeed) OTE(DB_DynamicBundle.xRqCheckForResetInfeedCount) ,XIO(DB_DynamicBundle.xDynamicBundleInfeedActive) MOVE(0,DB_DynamicBundle.iCheckRqResetInfeed_Cycle) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
