<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(DB_MiddlePos.q_xInPosition)OTE(iq_CM_MultiPalletsMagazine.OUT_xMagazineInMiddlePos);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
CMD MAGAZINE IN HIGH POS
//////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIO(xAlwaysOFF)[OTE(DB_HighPos.i_xEnable) ,OTE(DB_HighPos.i_xMot_Safety) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(xAlwaysOFF)[OTE(DB_HighPos.i_xJogEnable) ,OTE(DB_HighPos.i_xCheckEncMoving) ,OTE(DB_HighPos.i_xDisableAlrmSafety) ,OTE(DB_HighPos.i_xExclusionTimeout) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.HW_IN_xMagBarrier)XIC(iq_CM_MultiPalletsMagazine.HW_IN_xDelayEmergency)OTE(DB_HighPos.i_xDelayEmergency);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[Manag_Motor_Or_Inverter_TargetPos(DB_HighPos,i_iHighLimit,i_iLowLimit,i_iHighPos,i_DeltaMoveSlowSpeed,iWindow,i_WorkSpeed,i_SlowSpeed,i_iDeltaError_Speed,TON_MotorTimeOut.PRE,iq_CM_MultiPalletsMagazine.IN_xRqHighPos,xNotUsed,xNotUsed,xNotUsed,xNotUsed,iq_DB_Encoder);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(DB_HighPos.q_xInPosition)OTE(iq_CM_MultiPalletsMagazine.OUT_xMagazineInHighPos);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
CMD MAGAZINE IN SAFETY POS
//////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIO(xAlwaysOFF)[OTE(DB_SafetyPos.i_xEnable) ,OTE(DB_SafetyPos.i_xMot_Safety) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIC(xAlwaysOFF)[OTE(DB_SafetyPos.i_xJogEnable) ,OTE(DB_SafetyPos.i_xCheckEncMoving) ,OTE(DB_SafetyPos.i_xDisableAlrmSafety) ,OTE(DB_SafetyPos.i_xExclusionTimeout) ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.HW_IN_xMagBarrier)XIC(iq_CM_MultiPalletsMagazine.HW_IN_xDelayEmergency)OTE(DB_SafetyPos.i_xDelayEmergency);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.IN_xRqSafetyPos)OTL(db_force.0);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[Manag_Motor_Or_Inverter_TargetPos(DB_SafetyPos,i_iHighLimit,i_iLowLimit,i_iSafetyPos,i_DeltaMoveSlowSpeed,iWindow,i_WorkSpeed,i_SlowSpeed,i_iDeltaError_Speed,TON_MotorTimeOut.PRE,iq_CM_MultiPalletsMagazine.IN_xRqSafetyPos,xNotUsed,xNotUsed,xNotUsed,xNotUsed,iq_DB_Encoder);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIC(DB_SafetyPos.q_xInPosition)OTE(iq_CM_MultiPalletsMagazine.OUT_xMagazineInSafetyPos);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[/////CMD SPEED FOR INVERTER/////////////
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.IN_xRqHighPos)MOVE(DB_HighPos.q_iInverterCmdSpeed,q_iSpeedInverterRq);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.IN_xRqMiddlePos)MOVE(DB_MiddlePos.q_iInverterCmdSpeed,q_iSpeedInverterRq);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.IN_xRqLowPos)MOVE(DB_LowPos.q_iInverterCmdSpeed,q_iSpeedInverterRq);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.IN_xRqSafetyPos)MOVE(DB_SafetyPos.q_iInverterCmdSpeed,q_iSpeedInverterRq);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////////////////
UNLATCH ALL CMD 
///////////////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIO(xAlwaysOFF)[OTU(iq_CM_MultiPalletsMagazine.IN_xRqHighPos) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqMiddlePos) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqLowPos) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqSafetyPos) ];]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
MACHINE STATE
//////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.HW_IN_xSensor_PalletDropped)[MOVE(i_tSensorPalDropped,TON_tSensorPalDroppedTimer.PRE) ,TON(TON_tSensorPalDroppedTimer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[XIC(iq_xRqResetMagCycle)MOVE(0,q_iSeqChange);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Comment>
<![CDATA[CHECK PRESENCE PALLET IN DROPPED POS AND IF OK => GO TO LOW POS]]>
</Comment>
<Text>
<![CDATA[EQ(q_iSeqChange,0)[[XIC(xCycleRunning) ,XIC(iq_xRqResetMagCycle) ] [[XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) XIO(TON_tSensorPalDroppedTimer.DN) ,XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) ] OTL(xSeqChangeIncreaseAux) ,XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInHighPos) XIC(TON_tSensorPalDroppedTimer.DN) OTL(xAuxRqMagAlrmSensor) ,XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInHighPos) OTL(iq_CM_MultiPalletsMagazine.IN_xRqHighPos) ] ,OTU(iq_xRqResetMagCycle) ];]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Comment>
<![CDATA[MAGAZINE PALLET GO TO LOW POS FOR OPEN FORK]]>
</Comment>
<Text>
<![CDATA[EQ(q_iSeqChange,10)[XIC(xCycleRunning) [XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) [XIC(xOpeningForkStatus) [XIC(i_xConf_EnableSafetyPos) OTL(xSeqChangeIncreaseAux) ,XIO(i_xConf_EnableSafetyPos) MOVE(30,q_iSeqChange) ] ,XIO(xOpeningForkStatus) OTL(iq_CM_MultiPalletsMagazine.IN_xRqForkOpening) ] ,XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) OTL(iq_CM_MultiPalletsMagazine.IN_xRqLowPos) ] ,XIO(xCycleRunning) XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) MOVE(0,q_iSeqChange) ];]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Comment>
<![CDATA[MAGAZINE PALLET GO TO LOW POS FOR OPEN FORK]]>
</Comment>
<Text>
<![CDATA[EQ(q_iSeqChange,20)XIC(xCycleRunning)[XIC(xOpeningForkStatus) XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInSafetyPos) OTL(xSeqChangeIncreaseAux) ,XIC(xOpeningForkStatus) XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInSafetyPos) OTL(iq_CM_MultiPalletsMagazine.IN_xRqSafetyPos) ,XIO(xOpeningForkStatus) OTL(iq_CM_MultiPalletsMagazine.IN_xRqForkOpening) ];]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Comment>
<![CDATA[WAIT RQ NEW PALLET IN TRANSFER ZONE=> RQ MIDDLE POS]]>
</Comment>
<Text>
<![CDATA[EQ(q_iSeqChange,30)XIC(xCycleRunning)[XIO(iq_CM_MultiPalletsMagazine.IN_xNextCycle_Inhibition) [XIC(xOpeningForkStatus) XIC(iq_xRqStartCycle) [XIC(TON_tSensorPalDroppedTimer.DN) [XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInMiddlePos) OTL(xSeqChangeIncreaseAux) ,XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInMiddlePos) OTL(iq_CM_MultiPalletsMagazine.IN_xRqMiddlePos) ] ,XIO(TON_tSensorPalDroppedTimer.DN) [XIC(i_xConf_EnableSafetyPos) XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInSafetyPos) OTL(iq_CM_MultiPalletsMagazine.IN_xRqSafetyPos) ,XIO(i_xConf_EnableSafetyPos) XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) OTL(iq_CM_MultiPalletsMagazine.IN_xRqLowPos) ] ] ,XIO(xOpeningForkStatus) OTL(iq_CM_MultiPalletsMagazine.IN_xRqForkOpening) ] ,XIC(iq_CM_MultiPalletsMagazine.IN_xNextCycle_Inhibition) [XIO(xOpeningForkStatus) OTL(iq_CM_MultiPalletsMagazine.IN_xRqForkOpening) ,XIC(xOpeningForkStatus) [XIC(i_xConf_EnableSafetyPos) XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInSafetyPos) OTL(iq_CM_MultiPalletsMagazine.IN_xRqSafetyPos) ,XIO(i_xConf_EnableSafetyPos) XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) OTL(iq_CM_MultiPalletsMagazine.IN_xRqLowPos) ] ] ];]]>
</Text>
</Rung>
<Rung Number="48" Type="N">
<Text>
<![CDATA[EQ(q_iSeqChange,40)XIC(xCycleRunning)[XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInMiddlePos) [XIC(xClosingForkStatus) OTL(xSeqChangeIncreaseAux) ,XIO(xClosingForkStatus) OTL(iq_CM_MultiPalletsMagazine.IN_xRqForkClosing) ] ,XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInMiddlePos) [XIC(xOpeningForkStatus) OTL(iq_CM_MultiPalletsMagazine.IN_xRqMiddlePos) ,XIO(xOpeningForkStatus) OTL(iq_CM_MultiPalletsMagazine.IN_xRqForkOpening) ] ];]]>
</Text>
</Rung>
<Rung Number="49" Type="N">
<Text>
<![CDATA[EQ(q_iSeqChange,50)XIC(xCycleRunning)[XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInHighPos) [OTL(xSeqChangeIncreaseAux) ,XIC(TON_tSensorPalDroppedTimer.DN) OTL(iq_xMemPalletDroped) ,OTU(iq_xRqStartCycle) ] ,XIO(iq_CM_MultiPalletsMagazine.OUT_xMagazineInHighPos) OTL(iq_CM_MultiPalletsMagazine.IN_xRqHighPos) ];]]>
</Text>
</Rung>
<Rung Number="50" Type="N">
<Text>
<![CDATA[EQ(q_iSeqChange,60)XIC(xCycleRunning)XIO(iq_CM_MultiPalletsMagazine.IN_xLower_Inhibition)XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInHighPos)MOVE(0,q_iSeqChange);]]>
</Text>
</Rung>
<Rung Number="51" Type="N">
<Text>
<![CDATA[XIC(xSeqChangeIncreaseAux)[ADD(q_iSeqChange,10,q_iSeqChange) ,OTU(xSeqChangeIncreaseAux) ];]]>
</Text>
</Rung>
<Rung Number="52" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
PNEUM ACTUATORS
//////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="54" Type="N">
<Text>
<![CDATA[F_ACT_PNEUM(DB_Pneum_Forks,5000,iq_CM_MultiPalletsMagazine.HW_IN_xSensor_ForkOpened,iq_CM_MultiPalletsMagazine.HW_IN_xSensor_ForkClosed,xNotUsed,iq_CM_MultiPalletsMagazine.HW_IN_xAirOK,iq_CM_MultiPalletsMagazine.IN_xMachineMoving,iq_CM_MultiPalletsMagazine.IN_xRqForkOpening,iq_CM_MultiPalletsMagazine.IN_xRqForkClosing,xRqCheckOpeningForck,xRqCheckClosingForck,iq_xSelStopType,iq_xEmergencyPneum,xOpeningForkStatus,xClosingForkStatus,q_xCmdOpeningFork,q_xCmdClosingFork,q_xAlrmTimeOutFork);]]>
</Text>
</Rung>
<Rung Number="55" Type="N">
<Text>
<![CDATA[XIC(xOpeningForkStatus)OTE(iq_CM_MultiPalletsMagazine.OUT_xOpenedFork);]]>
</Text>
</Rung>
<Rung Number="56" Type="N">
<Text>
<![CDATA[XIC(xClosingForkStatus)OTE(iq_CM_MultiPalletsMagazine.OUT_xClosedFork);]]>
</Text>
</Rung>
<Rung Number="57" Type="N">
<Text>
<![CDATA[XIC(q_xAlrmTimeOutFork)OTL(xRqImmStop_Mag);]]>
</Text>
</Rung>
<Rung Number="58" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
MOTOR ACTUATORS
//////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="59" Type="N">
<Text>
<![CDATA[[XIC(DB_LowPos.q_xMovingFwd) ,XIC(DB_MiddlePos.q_xMovingFwd) ,XIC(DB_HighPos.q_xMovingFwd) ,XIC(DB_SafetyPos.q_xMovingFwd) ,XIC(iq_CM_MultiPalletsMagazine.IN_xRqJogUp) ]XIO(q_xCmdMagazineDown)XIO(iq_CM_MultiPalletsMagazine.HW_IN_xMagMotorThermalCutOut)LT(iEncoderPos,i_iHighLimit)OTE(q_xCmdMagazineUp);]]>
</Text>
</Rung>
<Rung Number="60" Type="N">
<Text>
<![CDATA[[XIC(DB_LowPos.q_xMovingBck) ,XIC(DB_MiddlePos.q_xMovingBck) ,XIC(DB_HighPos.q_xMovingBck) ,XIC(DB_SafetyPos.q_xMovingBck) ,XIC(iq_CM_MultiPalletsMagazine.IN_xRqJogDown) ]XIO(q_xCmdMagazineUp)XIO(iq_CM_MultiPalletsMagazine.HW_IN_xMagMotorThermalCutOut)GT(iEncoderPos,i_iLowLimit)OTE(q_xCmdMagazineDown);]]>
</Text>
</Rung>
<Rung Number="61" Type="N">
<Text>
<![CDATA[[XIC(q_xCmdMagazineUp) ,XIC(q_xCmdMagazineDown) ]XIC(iq_CM_MultiPalletsMagazine.HW_IN_xMagBarrier)XIC(iq_xMachineReady)[MOVE(i_tMagTimeOut,TON_MagTimeOut.PRE) ,TON(TON_MagTimeOut,?,?) ];]]>
</Text>
</Rung>
<Rung Number="62" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
MSG-WRNG-ALRM
//////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="63" Type="N">
<Text>
<![CDATA[[XIC(TON_MagTimeOut.DN) ,XIC(DB_LowPos.q_xTimeOutMovingAlrm) ,XIC(DB_MiddlePos.q_xTimeOutMovingAlrm) ,XIC(DB_HighPos.q_xTimeOutMovingAlrm) ,XIC(DB_SafetyPos.q_xSafetyAlrm) ][OTE(q_xAlrmTimeOutMagazine) ,OTL(xRqImmStop_Mag) ];]]>
</Text>
</Rung>
<Rung Number="64" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.HW_IN_xMagMotorThermalCutOut)[OTE(q_xAlrmThermalCutOut) ,OTL(xRqImmStop_Mag) ];]]>
</Text>
</Rung>
<Rung Number="65" Type="N">
<Text>
<![CDATA[XIC(xAuxRqMagAlrmSensor)[OTE(q_xRqAlrmMagSensor) ,OTL(xRqImmStop_Mag) ,OTU(xAuxRqMagAlrmSensor) ];]]>
</Text>
</Rung>
<Rung Number="66" Type="N">
<Text>
<![CDATA[XIC(iq_xAutoCycleActive)XIO(iq_xNoLoadRun_Enable)XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos)[XIO(TON_tSensorPalDroppedTimer.DN) [OTL(iq_xWRNGEmpty) ,OTL(iq_xWrngRq_PackingMatOutCondition) ] ,XIO(iq_CM_MultiPalletsMagazine.HW_IN_xSensor_LowLevel) [OTL(iq_xWRNGLowLevel) ,OTL(iq_xWrngRq_PackingMatOutCondition) ] ];]]>
</Text>
</Rung>
<Rung Number="67" Type="N">
<Text>
<![CDATA[[XIC(iq_CM_MultiPalletsMagazine.IN_xRqEnableCycle) ,XIC(xCycleRunning) [NE(q_iSeqChange,30) NE(q_iSeqChange,60) ,XIO(iq_xMemPalletDroped) XIO(TON_tSensorPalDroppedTimer.DN) XIO(iq_CM_MultiPalletsMagazine.IN_xLower_Inhibition) EQ(q_iSeqChange,60) ] ]XIO(xRqImmStop_Mag)[XIC(iq_CM_MultiPalletsMagazine.HW_IN_xMagBarrier) [OTE(xCycleRunning) ,XIO(iq_CM_MultiPalletsMagazine.IN_xNextCycle_Inhibition) OTE(q_xMoving) ] ,XIO(iq_CM_MultiPalletsMagazine.HW_IN_xMagBarrier) OTL(iq_xMsgMagBarrier) ];]]>
</Text>
</Rung>
<Rung Number="68" Type="N">
<Text>
<![CDATA[XIC(xRqImmStop_Mag)[OTL(iq_xSelStopType) ,OTU(xRqImmStop_Mag) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="F_ACT_PNEUM_CRS" Class="Standard" Revision="1.2" Vendor="rev - Francesco Tiberia - Utili Nicola" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2007-11-28T13:29:27.875Z" CreatedBy="SCL0038\alessandro.grazia" EditedDate="2025-12-03T12:34:41.971Z" EditedBy="DESKTOP-I4HL37F\admin"
 SoftwareRevision="v36.00">
<RevisionNote>
<![CDATA[V1.02   : Ing.Utili Nicola
Data 	: 03.05.2021
        : Add input InhibitAlrmPneum for stop when moving finish

02/09/2020
Author: Utili
Comment: Move Aux0, Aux1 in output for use external ADDON

22/05/2019
Allineamento alla v04 presa dal base flex 131 Siemens.
25/06/2020 - Corretto errore caricamento preset timer sensor off rung 2 - Chiarini L.]]>
</RevisionNote>
