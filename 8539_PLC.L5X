<Rung Number="19" Type="N">
<Text>
<![CDATA[XIO(Core_HMI.Interface.Rq_xShutDown)MultiPalletsMagazine(DB_Pal_ManagPalletMag,UM_Config.PAL.MagPal_EnableSafetyPos,Timers.N[208].PRE,Timers.N[209].PRE,Timers.N[211].PRE,SYS.N[389],PAL_SizeWork.MagPalletHighPos,PAL_SizeWork.MagPalletMiddlePos,PAL_SizeWork.MagPalletLowPos,SYS.N[384],SYS.N[385],SYS.N[386],SYS.N[387],SYS.N[391],SYS.N[383],SYS.N[392],OUT.K7820_01_FWD,OUT.K7820_01_BWD,ALRM[578],OUT.Q7831_01_12_OPN,OUT.Q7831_01_14_CLS,ALRM[579],ALRM[590],OM_Interface.PalMag_xMagazineMoving,ALRM[335],EM_PalMag.CM_PalletMagazineMotor.InverterIN_diWorkSpeed,BB.Automatic_CycleActive,BB.Machine_Ready,BB.NoLoadRun_Enable,BB.WrngRq_PackingMatOutCondition,OM_ShiftPalChange.xRq_ImmediateStop,OM_Interface.PalMag_xRqPalletPreparationAtMagazine,EM_PalMag_Hmi_PB.Rq_xManual_MagCycle_Reset,OM_ShiftPalChange_HMI.Pos1_PalletMagazine.St_xPalletPresenceUnderMag,WRNG[68],WRNG[66],WRNG[67],EM_PalMag.xPneumaticEmergencyRq,EM_PalMag.CM_Encoder_PalletMagazine,EM_PalMag.CM_MultiPalletsMagazine);]]>
