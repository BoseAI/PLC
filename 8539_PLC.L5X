<Routines>
<Routine Name="Calc_CountProd_BundleTransfer" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// v0.1        : 07.05.2026]]>
</Line>
<Line Number="1">
<![CDATA[// Author      : Boselli Mattia]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[IF EM_BundleTransfer.xRqCounterIncrease ]]>
</Line>
<Line Number="4">
<![CDATA[THEN]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[    UM_HMI.MachineWorkData.St_iActualBundleNumber := UM_HMI.MachineWorkData.St_iActualBundleNumber  + 1;]]>
</Line>
<Line Number="7">
<![CDATA[    EM_BundleTransfer.xRqCounterIncrease := 0;]]>
</Line>
<Line Number="8">
<![CDATA[	]]>
</Line>
<Line Number="9">
<![CDATA[ELSIF EM_BundleTransfer.xCountRqBundlesReset OR EM_BundleTransfer.xRqManualReset ]]>
</Line>
<Line Number="10">
<![CDATA[THEN]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[    UM_HMI.MachineWorkData.St_iActualBundleNumber  := 0;]]>
</Line>
<Line Number="13">
<![CDATA[    EM_BundleTransfer.xCountRqBundlesReset := 0;]]>
</Line>
<Line Number="14">
<![CDATA[	]]>
</Line>
<Line Number="15">
<![CDATA[END_IF;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[OM_Interface.BundleTrans_xMemBundleForEachLayerComple := UM_HMI.MachineWorkData.St_iActualBundleNumber >= SizeWork.BundleTransfer.Number;]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[EM_BundleTransfer.iNumberBundleForTransfer := SizeWork.BundleTransfer.Number - UM_HMI.MachineWorkData.St_iActualBundleNumber;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[IF (BB.Count_EnableCheckOfResetCounts OR OM_Interface.BundleTransfer_xWallOpenCheckCounts)]]>
</Line>
<Line Number="22">
<![CDATA[	AND (UM_HMI.MachineWorkData.St_iActualBundleNumber <> 0]]>
</Line>
<Line Number="23">
<![CDATA[    OR EM_BundleTransfer.iSeqChange <> 0) THEN]]>
</Line>
<Line Number="24">
<![CDATA[    BB.Count_GrtZero := 1;]]>
</Line>
<Line Number="25">
<![CDATA[END_IF;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Calc_Pos_BundleTransfer_T1" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// v0.1        : 07.05.2026]]>
</Line>
<Line Number="1">
<![CDATA[// Author      : Boselli Mattia]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[// SYS.N[12] --> Bundle trasfer: Min Value]]>
</Line>
<Line Number="4">
<![CDATA[// SYS.N[14] --> Bundle trasfer: Maximum stroke WITHOUT rotation]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[// EM_BundleTransfer.CM_Transfer.AxisIN_POS_arTargetPos[1] --> Back]]>
</Line>
<Line Number="7">
<![CDATA[// EM_BundleTransfer.CM_Transfer.AxisIN_POS_arTargetPos[2] --> For]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[IF BB.SetSize]]>
</Line>
<Line Number="10">
<![CDATA[THEN]]>
</Line>
<Line Number="11">
<![CDATA[ ]]>
</Line>
<Line Number="12">
<![CDATA[   	EM_BundleTransfer.CM_Transfer.AxisIN_POS_arTargetPos[1] := (SYS.N[12] / 10.0);]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[   	EM_BundleTransfer.iDimBundle ]]>
</Line>
<Line Number="15">
<![CDATA[		:=  TRUNC((OM_Interface.Machine_rProdLength * SizeWork.Stacker.ProductsEachLayer) / SizeWork.BundleTransfer.Number);]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[   	EM_BundleTransfer.iAuxForCalc :=]]>
</Line>
<Line Number="18">
<![CDATA[   		(EM_BundleTransfer.iDimBundle * EM_BundleTransfer.iNumberBundleForTransfer) - EM_BundleTransfer.iDimBundle;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[	IF (EM_BundleTransfer.iAuxForCalc < 0)]]>
</Line>
<Line Number="21">
<![CDATA[	THEN]]>
</Line>
<Line Number="22">
<![CDATA[	]]>
</Line>
<Line Number="23">
<![CDATA[		EM_BundleTransfer.CM_Transfer.AxisIN_POS_arTargetPos[2] := (SYS.N[14] / 10.0);]]>
</Line>
<Line Number="24">
<![CDATA[		]]>
</Line>
<Line Number="25">
<![CDATA[	ELSE]]>
</Line>
<Line Number="26">
<![CDATA[		]]>
</Line>
<Line Number="27">
<![CDATA[		EM_BundleTransfer.CM_Transfer.AxisIN_POS_arTargetPos[2] := (SYS.N[14] / 10.0) - EM_BundleTransfer.iAuxForCalc;]]>
</Line>
<Line Number="28">
<![CDATA[		]]>
</Line>
<Line Number="29">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[    EM_BundleTransfer.iBundleTransferPosForStacker := (SYS.N[14] / 10.0) - 20;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[END_IF;]]>
</Line>
<Line Number="34">
<![CDATA[     ]]>
</Line>
<Line Number="35">
<![CDATA[ ]]>
</Line>
</STContent>
</Routine>
<Routine Name="CM_Axis_BundleTransfer" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*****************************************************************************************************************************************************************************************************************************************************************************************
CALL AXIS MANAGEMENT
******************************************************************************************************************************************************************************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[MOVE(SYS.N[110],EM_BundleTrans_HMI_PB.St_iHomeAxisPosition) ,MOVE(403,EM_BundleTransfer.CM_Transfer.HmiIN_iPageToDisplayHomeAbs) ,MOVE(EM_BundleTransfer.CM_Transfer.AxisIN_POS_arTargetPos[1],EM_BundleTransfer.CM_Transfer.AxisIN_HOME_rTargetPos) ]MOVE(0.0,EM_BundleTransfer.CM_Transfer.rPeriode)[MOVE(1.0,EM_BundleTransfer.CM_Transfer.AxisIN_POS_rDeltaOn) ,MOVE(1.0,EM_BundleTransfer.CM_Transfer.AxisIN_POS_rDeltaOff) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[LOGIC Input from PLC]]>
</Comment>
<Text>
<![CDATA[XIO(BB.AlwaysOFF)OTU(EM_BundleTransfer.CM_Transfer.AxisIN_xInhibitMoving);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(UM_Config.CP.EnablePneumSingleElevatorBundle)XIC(EM_BundleTransfer.xRq_ResetHomeFromResetCount)NE(EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone,1)XIO(OM_Interface.BundleTransfer_xUpperLifterPos)[OTL(EM_BundleTransfer.CM_Transfer.AxisIN_xInhibitMoving) ,OTL(CM_Pneum_BundleTransferLift.iq_xRqON) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(OM_Interface.Infeed_xStackerOutObstruction)OTL(EM_BundleTransfer.CM_Transfer.AxisIN_xInhibitMoving);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[############################
INPUT
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(IN.S1100_03)OTE(EM_BundleTransfer.CM_Transfer.HwIN_xJog);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIO(EM_BundleTransfer.CM_Transfer.AxisOUT_HOME_xHomeDone) ,XIC(EM_BundleTransfer.xCycleInProgress) ]XIC(OM_Interface.Infeed_xStackerOutObstruction)NE(EM_BundleTransfer.CM_Transfer.AxisIN_POS_iRqPos,EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone)OTL(EM_BundleTransfer.CM_Transfer.AxisIN_POS_xEnableStartPos);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[MOVE(5,EM_BundleTransfer.CM_Transfer.AxisIN_JOG_di_PercentageSpeed)MOVE(5,EM_BundleTransfer.CM_Transfer.AxisIN_JOG_diPercentageMaxAcc)MOVE(20,EM_BundleTransfer.CM_Transfer.AxisIN_JOG_diPercentageMaxDec);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MOVE(0,EM_BundleTransfer.CM_Transfer.AxisIN_POS_iTypeFirstMam)MOVE(0,EM_BundleTransfer.CM_Transfer.AxisIN_POS_iTypeSecondMam);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[LIMIT(370,Core_HMI.Interface.iPageDisplayed,390)OTE(EM_BundleTransfer.CM_Transfer.AxisIN_xEnableOnlyJog);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[Manag_AllenBradleyAxis_Real(Axis_BundleTransfer,2131,0,1,0,1,EM_BundleTransfer.xSt_ImmediateStop,SYS.N[104],SYS.N[105],SYS.N[105],10,SYS.N[111],EM_BundleTrans_HMI_PB.St_iHomeAxisPosition,SYS.N[106],100,SYS.N[146],SYS.N[147],SYS.N[109],10,100,80,BB,OM_EthernetCom,M2131_01_BundleTransfer,Mv_Dummy,EM_BundleTransfer.CM_Transfer,EM_BundleTransfer.CIP_Transfer,TaskMotion,AxisFault.BundleTransfer,AxisFault,MSG_AxisBundleTransfer,MSG[17],MSG[17],MSG[3],MSG[18],MSG[12],EM_BundleTransfer.CM_Transfer.xNotUsed,EM_BundleTransfer.CM_Transfer.xNotUsed,EM_BundleTrans_HMI_PB.Rq_xJog_Enable,EM_BundleTrans_HMI_PB.St_xJog_Enable,EM_BundleTrans_HMI_PB.St_xJog_WithoutEnableMan,EM_BundleTrans_HMI_PB.Rq_iJog_Direction,EM_BundleTrans_HMI_PB.St_iJog_Direction,EM_BundleTrans_HMI_PB.Rq_iManual_CmdPos,EM_BundleTrans_HMI_PB.St_iManual_CmdPos,Core_HMI.Interface.iPageToDisplay,EM_BundleTransfer.CM_Transfer.xNotUsed,EM_BundleTransfer.CM_Transfer.xNotUsed,EM_BundleTrans_HMI_PB.Rq_xAbsHome_Axis_Save,EM_BundleTrans_HMI_PB.St_xAbsHome_Axis_Save,EM_BundleTransfer.CM_Transfer.xNotUsed,EM_BundleTransfer.CM_Transfer.xNotUsed,EM_BundleTransfer.CM_Transfer.xNotUsed,EM_BundleTransfer.CM_Transfer.xNotUsed,EM_BundleTransfer.xRq_ResetHomeFromResetCount,EM_BundleTransfer.xRq_ImmediateStop,EM_BundleTransfer.xRqAutomaticCycleInhibition,ALRM[853],ALRM[854],ALRM[855]);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[############################
OUTPUT
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(EM_BundleTransfer.CM_Transfer.AxisIN_JOG_xRqFwdJogX)OTE(EM_BundleTransfer.CM_Transfer.AxisIN_JOG_xEnableFwdJogX);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(EM_BundleTransfer.CM_Transfer.AxisIN_JOG_xRqBwdJogX)OTE(EM_BundleTransfer.CM_Transfer.AxisIN_JOG_xEnableBwdJogX);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[MUL(EM_BundleTransfer.CM_Transfer.AxisOUT_rActualPos,10,EM_BundleTrans_HMI_PB.St_iAxisPosition);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[############################
CMD POS
############################]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(EM_BundleTransfer.CM_Transfer.AxisIN_POS_xEnableStartPos)[EQ(EM_BundleTransfer.CM_Transfer.AxisIN_POS_iRqPos,1) [[MOVE(SizeWork.BundleTransfer.BackwardStroke_Speed,EM_BundleTransfer.CM_Transfer.AxisIN_POS_aiSpeed[1]) ,MOVE(SizeWork.BundleTransfer.BackwardStroke_Acc,EM_BundleTransfer.CM_Transfer.AxisIN_POS_aiAcc[1]) ,MOVE(SizeWork.BundleTransfer.BackwardStroke_Dec,EM_BundleTransfer.CM_Transfer.AxisIN_POS_aiDec[1]) ] ,NE(1,EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone) XIC(UM_Config.CP.EnablePneumSingleElevatorBundle) XIO(OM_Interface.BundleTransfer_xUpperLifterPos) OTL(CM_Pneum_BundleTransferLift.iq_xRqON) ] ,EQ(EM_BundleTransfer.CM_Transfer.AxisIN_POS_iRqPos,2) [[GE(UM_HMI.MachineWorkData.St_iActualBundleNumber,1) ,EQ(UM_HMI.MachineWorkData.St_iActualBundleNumber,SizeWork.BundleTransfer.Number) ] [MOVE(SizeWork.BundleTransfer.ForwardStroke_Speed,EM_BundleTransfer.CM_Transfer.AxisIN_POS_aiSpeed[2]) ,MOVE(SizeWork.BundleTransfer.ForwardStroke_Acc,EM_BundleTransfer.CM_Transfer.AxisIN_POS_aiAcc[2]) ,MOVE(SizeWork.BundleTransfer.ForwardStroke_Dec,EM_BundleTransfer.CM_Transfer.AxisIN_POS_aiDec[2]) ] ,LT(UM_HMI.MachineWorkData.St_iActualBundleNumber,1) NE(UM_HMI.MachineWorkData.St_iActualBundleNumber,SizeWork.BundleTransfer.Number) [MOVE(SizeWork.BundleTransfer.ForwardStrokeFirstRow_Speed,EM_BundleTransfer.CM_Transfer.AxisIN_POS_aiSpeed[2]) ,MOVE(SizeWork.BundleTransfer.ForwardStrokeFirstRow_Acc,EM_BundleTransfer.CM_Transfer.AxisIN_POS_aiAcc[2]) ,MOVE(SizeWork.BundleTransfer.ForwardStrokeFirstRow_Dec,EM_BundleTransfer.CM_Transfer.AxisIN_POS_aiDec[2]) ] ] ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[EQ(1,EM_BundleTransfer.CM_Transfer.AxisOUT_POS_iPosDone)XIC(UM_Config.CP.EnablePneumSingleElevatorBundle)XIO(CM_Pneum_BundleTransferLift.q_xOFF)OTL(CM_Pneum_BundleTransferLift.iq_xRqOFF);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Forward Pos]]>
</Comment>
<Text>
<![CDATA[CPT(EM_BundleTransfer.iDimOutbstructionTransferStacker,SYS.N[7] - ( EM_BundleTransfer.iDimBundle * 0.7));]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[GT(EM_BundleTransfer.CM_Transfer.AxisOUT_rActualPos,EM_BundleTransfer.iDimOutbstructionTransferStacker)OTE(OM_Interface.BundleTransfer_xInForwardPos);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CM_BundleTransfer_SinglePneum_Lifter" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB.AlwaysOFF)[OTL(CM_Pneum_BundleTransferLift.iq_xRqON) ,OTU(CM_Pneum_BundleTransferLift.iq_xRqOFF) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB.AlwaysOFF)[OTU(CM_Pneum_BundleTransferLift.iq_xRqON) ,OTL(CM_Pneum_BundleTransferLift.iq_xRqOFF) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(IN.B2131_01)OTE(CM_Pneum_BundleTransferLift.i_xSensorON);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(IN.B2131_01)OTE(CM_Pneum_BundleTransferLift.i_xSensorOFF);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(BB.AlwaysOFF)OTE(CM_Pneum_BundleTransferLift.i_xTimeOutEsclusion);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[F_ACT_PNEUM(DB_Pneum_BundleTransferLift,5000,CM_Pneum_BundleTransferLift.i_xSensorON,CM_Pneum_BundleTransferLift.i_xSensorOFF,CM_Pneum_BundleTransferLift.i_xTimeOutEsclusion,BB.EPN_ON,BB.Machine_MovingForSubModule,CM_Pneum_BundleTransferLift.iq_xRqON,CM_Pneum_BundleTransferLift.iq_xRqOFF,CM_Pneum_BundleTransferLift.iq_xChkON,CM_Pneum_BundleTransferLift.iq_xChkOFF,EM_BundleTransfer.xRq_ImmediateStop,BB.Rq_EmergencyPneum,CM_Pneum_BundleTransferLift.q_xON,CM_Pneum_BundleTransferLift.q_xOFF,CM_Pneum_BundleTransferLift.q_xCmdON,CM_Pneum_BundleTransferLift.q_xCmdOFF,CM_Pneum_BundleTransferLift.q_xTimeOutAlarm);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(CM_Pneum_BundleTransferLift.q_xCmdON)OTE(OUT.Q2131_01_UP);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(CM_Pneum_BundleTransferLift.q_xCmdOFF)OTE(OUT.Q2131_01_DN);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
