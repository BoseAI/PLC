</Comment>
<Text>
<![CDATA[XIO(Core_HMI.Interface.Rq_xShutDown)F_PneumCat3AndNotCat3(DB_Pal_AirGroupPalletMag,1,IN.B7830_01,IN.K7830_01,3000,BB.Machine_Enable,EM_PalMag.xAirPressureCondition,0,EM_PalMag.xPneumaticEmergencyRq,MSG[2],OM_ShiftPalChange.xRq_ImmediateStop,BB.Rq_EmergencyPhaseStop,EM_PalMag.xPressurizedPneumaticCircuit,xMagActivateValve,EM_PalMag.xNotUsed,ALRM[516],OM_Interface.PalMag_xPnumaticEnergyEnabled,ALRM[517]);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
