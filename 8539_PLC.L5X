<Parameter Name="My_CAM" TagType="Base" DataType="CAM" Dimensions="201" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Tag name of the cam array used as the resultant of the AOI_CAMM instruction.   Ellipsis launches Cam Profile Editor.]]>
</Description>
</Parameter>
