<Routine Name="CommunicationManagement" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[This version was modified from Version 2.00
The modification consisted only of a path change of the  _EWEB_PATH  tag to '$01$00' for support in 5370 LyyER CompactLogix plcs.

This application Client creates TCP Connection to a TCP server 
and writes/reads ASCII strings to the remote port


Local TCP port (this EWEB) specified in Socket.Addr.Port ex:10002 

Remote IP specified in Dest_IP tag ex: "100.100.106.50"  ( IP address of PC running test utility )
Remote Port specified in Dest_Port tag  ex: "?port=10001"]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[NE(Log_Enable,Log_Old)MOVE(Log_Enable,Log_Old)MSG(Change_Log_MSG);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Delete All Sockets
]]>
</Comment>
<Text>
<![CDATA[XIC(xRqDeleteAllSockets)[ONS(L_Trig[0]) CLR(Delete_All_Sockets_MSG.Flags) ,[MSG(Delete_All_Sockets_MSG) ,[XIC(Delete_All_Sockets_MSG.DN) ,XIC(Delete_All_Sockets_MSG.ER) ] OTU(xRqDeleteAllSockets) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Create Socket to Printer
]]>
</Comment>
<Text>
<![CDATA[XIC(xRqCreateSocket)[ONS(L_Trig[1]) CLR(Create_Socket_MSG.Flags) ,[MSG(Create_Socket_MSG) ,[XIC(Create_Socket_MSG.DN) ,XIC(Create_Socket_MSG.ER) ] OTU(xRqCreateSocket) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Connect To Remote Server
---
Additionally calculates message source length based on the length of the Destination Address.]]>
</Comment>
<Text>
<![CDATA[XIC(xRqConnectToSocket)[ONS(L_Trig[2]) CLR(Connect_To_Socket_MSG.Flags) ,ADD(Sock_Open_Par.DestAddr.LEN,8,Connect_To_Socket_MSG.REQ_LEN) ,[MOVE(Instance,Connect_To_Socket_MSG.Instance) MSG(Connect_To_Socket_MSG) ,[XIC(Connect_To_Socket_MSG.DN) ,XIC(Connect_To_Socket_MSG.ER) ] OTU(xRqConnectToSocket) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[This Rung will read incoming TCP message. 
Make sure timeout for read set less than MSG timeout (default 30 sec!!!)

This example uses: 
Read Timeout Read_Data_Req1.Timeout =1sec

]]>
</Comment>
<Text>
<![CDATA[XIC(xRqReadData)[ONS(L_Trig[3]) CLR(Read_Data_MSG.Flags) ,[MOVE(Instance,Read_Data_MSG.Instance) MSG(Read_Data_MSG) ,[XIC(Read_Data_MSG.DN) ,XIC(Read_Data_MSG.ER) ] OTU(xRqReadData) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[This Rung will send PLC clock value out every time Write_Request bit is set 
TIME string prepared in the dem0_CLOCK routine]]>
</Comment>
<Text>
<![CDATA[XIC(xRqWriteData)[ONS(L_Trig[4]) CLR(Write_Data_MSG.Flags) ,ADD(Write_Data_Out.Buffer.LEN,16,Write_Data_MSG.REQ_LEN) ,[MOVE(Instance,Write_Data_MSG.Instance) MSG(Write_Data_MSG) ,[XIC(Write_Data_MSG.DN) ,XIC(Write_Data_MSG.ER) ] OTU(xRqWriteData) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[This Rung will delete socket instance]]>
</Comment>
<Text>
<![CDATA[XIC(xRqDeleteSocket)[ONS(L_Trig[5]) CLR(Delete_Socket_MSG.Flags) ,[MOVE(Instance,Delete_Socket_MSG.Instance) MSG(Delete_Socket_MSG) ,[XIC(Delete_Socket_MSG.DN) ,XIC(Delete_Socket_MSG.ER) ] OTU(xRqDeleteSocket) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[[XIC(EM_PAL_Infeed_HMI_PB.St_xOptGr_Labeler1Enabling) ONS(L_Trig[8]) ,XIC(BB.FirstScan) ] MOVE(0,iCommunicationStep) ,XIC(DB_LabelerPhoenix.xRqTransferParameters) ONS(L_Trig[9]) OTU(xLabelerStateRead) ,XIC(xLabelerStateInReady) OTU(DB_LabelerPhoenix.xResetInProgress) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Timeout dei comandi in esecuzione]]>
</Comment>
<Text>
<![CDATA[XIC(EM_PAL_Infeed_HMI_PB.St_xOptGr_Labeler1Enabling)[XIC(xRqDeleteAllSockets) XIC(Delete_All_Sockets_MSG.ST) [TON(L_Timer[16],?,?) ,XIC(L_Timer[16].DN) OTU(xRqDeleteAllSockets) ] ,XIC(xRqCreateSocket) XIC(Create_Socket_MSG.ST) [TON(L_Timer[0],?,?) ,XIC(L_Timer[0].DN) OTU(xRqCreateSocket) ] ,XIC(xRqConnectToSocket) XIC(Connect_To_Socket_MSG.ST) [TON(L_Timer[1],?,?) ,XIC(L_Timer[1].DN) OTU(xRqConnectToSocket) ] ,XIC(xRqReadData) XIC(Read_Data_MSG.ST) [TON(L_Timer[2],?,?) ,XIC(L_Timer[2].DN) OTU(xRqReadData) ] ,XIC(xRqWriteData) XIC(Write_Data_MSG.ST) [TON(L_Timer[3],?,?) ,XIC(L_Timer[3].DN) OTU(xRqWriteData) ] ,XIC(xRqDeleteSocket) XIC(Delete_Socket_MSG.ST) [TON(L_Timer[17],?,?) ,XIC(L_Timer[17].DN) OTU(xRqDeleteSocket) ] ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(Delete_All_Sockets_MSG.ER) ONS(L_Trig[16]) ,XIC(Create_Socket_MSG.ER) ONS(L_Trig[12]) ,XIC(Connect_To_Socket_MSG.ER) ONS(L_Trig[13]) ,XIC(Read_Data_MSG.ER) ONS(L_Trig[14]) ,XIC(Write_Data_MSG.ER) ONS(L_Trig[15]) ,XIC(Delete_Socket_MSG.ER) ONS(L_Trig[17]) ,XIC(L_Timer[16].DN) ,XIC(L_Timer[0].DN) ,XIC(L_Timer[1].DN) ,XIC(L_Timer[2].DN) ,XIC(L_Timer[3].DN) ,XIC(L_Timer[17].DN) ]XIC(EM_PAL_Infeed_HMI_PB.St_xOptGr_Labeler1Enabling)[OTE(ALRM[192]) ,OTL(BB.Rq_EmergencyPhaseStop) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Dopo un errore di comunicazione aspetto 1 sec poi cancello la socket. Anche se fallisce la "DeleteSocket" va bene in quanto successivamente ricreo la socket e mi ci connetto]]>
</Comment>
<Text>
<![CDATA[[XIC(ALRM[192]) ONS(L_Trig[6]) TOF(L_Timer[4],?,?) ,XIC(L_Timer[4].DN) OSF(L_Trig[7],xFallingEdgeDelayToDeletSocketAfterErro) ,XIC(xFallingEdgeDelayToDeletSocketAfterErro) MOVE(50,iCommunicationStep) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[EQ(iCommunicationStep,1) TON(L_Timer[5],?,?) ,EQ(iCommunicationStep,4) TON(L_Timer[6],?,?) ,EQ(iCommunicationStep,6) TON(L_Timer[7],?,?) ,EQ(iCommunicationStep,8) TON(L_Timer[8],?,?) ,EQ(iCommunicationStep,12) TON(L_Timer[9],?,?) ,EQ(iCommunicationStep,15) TON(L_Timer[10],?,?) ,EQ(iCommunicationStep,18) TON(L_Timer[11],?,?) ,EQ(iCommunicationStep,25) TON(L_Timer[12],?,?) ,EQ(iCommunicationStep,30) TON(L_Timer[13],?,?) ,[EQ(iCommunicationStep,31) ,EQ(iCommunicationStep,34) ] XIC(Write_Data_MSG.DN) TON(L_Timer[18],?,?) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[JSR(CommunicationManagement_STSubRoutine,0);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(EM_PAL_Infeed_HMI_PB.St_xOptGr_Labeler1Enabling)XIC(xSocketConnectionEstablished)[XIC(xLabelerStateRead) [XIO(xLabelerStateInReady) ,XIC(xLabelerStateInAlarm) ] XIO(DB_LabelerPhoenix.xResetInProgress) XIO(DB_LabelerPhoenix.xDataSendingInProgress) [TON(L_Timer[14],?,?) ,XIC(L_Timer[14].DN) OTE(DB_LabelerPhoenix.PhysicalSignals.xLabelerInFault) ] ,XIC(DB_LabelerPhoenix.xResetInProgress) [TON(L_Timer[15],?,?) ,XIC(L_Timer[15].DN) OTU(DB_LabelerPhoenix.xResetInProgress) ] ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(xRqIncreaseStepSequence)[ADD(iCommunicationStep,1,iCommunicationStep) ,OTU(xRqIncreaseStepSequence) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIO(EM_PAL_Infeed_HMI_PB.St_xOptGr_Labeler1Enabling)ONS(L_Trig[10])XIO(BB.FirstScan)[OTU(DB_LabelerPhoenix.xRqTransferParameters) OTU(xLabelerStateRead) ,OTU(DB_LabelerPhoenix.xResetInProgress) OTU(DB_LabelerPhoenix.xDataSendingInProgress) ,OTU(xRqCreateSocket) OTU(xRqConnectToSocket) OTU(xRqReadData) OTU(xRqWriteData) ,XIC(xSocketConnectionEstablished) MOVE(50,iCommunicationStep) ,XIO(xSocketConnectionEstablished) MOVE(0,iCommunicationStep) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="CommunicationManagement_STSubRoutine" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Scompongo la distanza dei mm totali in due parti (i cm e i mm) in quanto bisogna all'etichettatore serve espresso come [cm,mm]]]>
</Line>
<Line Number="1">
<![CDATA[// perchè sono due parametri differenti per l'etichettatore]]>
</Line>
<Line Number="2">
<![CDATA[// NB: i mm vanno da 0 a 9, dopodichè si ha 1 cm in più]]>
</Line>
<Line Number="3">
<![CDATA[rApplicationDistance_mm := DB_LabelerPhoenix.iApplicationDistance_mm;]]>
</Line>
<Line Number="4">
<![CDATA[diCentimetriCorsaApplicatoreEtichetta := rApplicationDistance_mm / 10.0;]]>
</Line>
<Line Number="5">
<![CDATA[    ]]>
</Line>
<Line Number="6">
<![CDATA[diMillimetriCorsaApplicatoreEtichetta := DB_LabelerPhoenix.iApplicationDistance_mm - (diCentimetriCorsaApplicatoreEtichetta * 10);]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[//]]>
</Line>
<Line Number="9">
<![CDATA[// _______________ Creazione e gestione stringa dei millimetri _________________]]>
</Line>
<Line Number="10">
<![CDATA[// ]]>
</Line>
<Line Number="11">
<![CDATA[DTOS(diMillimetriCorsaApplicatoreEtichetta, sStringMillimetri);]]>
</Line>
<Line Number="12">
<![CDATA[  ]]>
</Line>
<Line Number="13">
<![CDATA[IF sStringMillimetri.LEN > 4 THEN]]>
</Line>
<Line Number="14">
<![CDATA[    sStringMillimetri := '009';]]>
</Line>
<Line Number="15">
<![CDATA[END_IF;  ]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[//Non esistendo in Rockwell il concetto di Char, definisco un array di 82 stringhe e dentro ciascuna stringa]]>
</Line>
<Line Number="21">
<![CDATA[//inserisco l'i-esimo carattere della stringa di partenza "sStringMillimetri"]]>
</Line>
<Line Number="22">
<![CDATA[//In questo modo passo da una stringa di (al più) 82 caratteri a 82 stringhe di 1 carattere]]>
</Line>
<Line Number="23">
<![CDATA[for iIndex := 1 to 82 do]]>
</Line>
<Line Number="24">
<![CDATA[	asArraySingoliCaratteriStringMillimetri[iIndex-1] := '';]]>
</Line>
<Line Number="25">
<![CDATA[	MID(sStringMillimetri, 1, iIndex, asArraySingoliCaratteriStringMillimetri[iIndex-1]);]]>
</Line>
<Line Number="26">
<![CDATA[end_for;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[//Avendo convertito la stringa "sStringMillimetri" in 82 stringhe da 1 carattere "asArraySingoliCaratteriStringMillimetri[]"]]>
</Line>
<Line Number="30">
<![CDATA[//posso confrontare ciascun carattere della stringa "sStringMillimetri" tramite ciascuna cella dell'array di stringhe]]>
</Line>
<Line Number="31">
<![CDATA[//"asArraySingoliCaratteriStringMillimetri[]". In particolare mi interessano i primi 4 caratteri ([0,3])]]>
</Line>
<Line Number="32">
<![CDATA[//Una volta fatto il confronto, riscrivo il carattere confrontato ed eventualmente modificato (che sarà sicuramente nella ]]>
</Line>
<Line Number="33">
<![CDATA[//posizione .DATA[0] di ciascuna stringa dell'array, poiché tutte da 1 carattere) nella stringa di partenza "sStringMillimetri"]]>
</Line>
<Line Number="34">
<![CDATA[//nella stessa posizione dal quale era stato prelevato]]>
</Line>
<Line Number="35">
<![CDATA[FOR iIndex := 0 TO 3 DO]]>
</Line>
<Line Number="36">
<![CDATA[    IF asArraySingoliCaratteriStringMillimetri[iIndex] = '+' THEN]]>
</Line>
<Line Number="37">
<![CDATA[        asArraySingoliCaratteriStringMillimetri[iIndex] := '0';]]>
</Line>
<Line Number="38">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="39">
<![CDATA[	sStringMillimetri.DATA[iIndex] := asArraySingoliCaratteriStringMillimetri[iIndex].DATA[0];]]>
</Line>
<Line Number="40">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="41">
<![CDATA[]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[IF sStringMillimetri.LEN = 4 THEN]]>
</Line>
<Line Number="44">
<![CDATA[	sStringMillimetri.DATA[0] := sStringMillimetri.DATA[1];]]>
</Line>
<Line Number="45">
<![CDATA[	sStringMillimetri.DATA[1] := sStringMillimetri.DATA[2];]]>
</Line>
<Line Number="46">
<![CDATA[	sStringMillimetri.DATA[2] := sStringMillimetri.DATA[3];]]>
</Line>
<Line Number="47">
<![CDATA[	DELETE(sStringMillimetri, 1, 4, sStringMillimetri);]]>
</Line>
<Line Number="48">
<![CDATA[	]]>
</Line>
<Line Number="49">
<![CDATA[ELSIF sStringMillimetri.LEN = 2 THEN]]>
</Line>
<Line Number="50">
<![CDATA[	sStringAppoggio := '0';]]>
</Line>
<Line Number="51">
<![CDATA[	CONCAT(sStringAppoggio, sStringMillimetri, sStringMillimetri);]]>
</Line>
<Line Number="52">
<![CDATA[	 ]]>
</Line>
<Line Number="53">
<![CDATA[END_IF;]]>
</Line>
<Line Number="54">
<![CDATA[  ]]>
</Line>
<Line Number="55">
<![CDATA[	]]>
</Line>
<Line Number="56">
<![CDATA[	]]>
</Line>
<Line Number="57">
<![CDATA[//]]>
</Line>
<Line Number="58">
<![CDATA[// ___________ Creazione e gestione stringa dei centimetri da inviare all'etichettatore _______________]]>
</Line>
<Line Number="59">
<![CDATA[// ]]>
</Line>
<Line Number="60">
<![CDATA[DTOS(diCentimetriCorsaApplicatoreEtichetta, sStringCentimetri);]]>
</Line>
<Line Number="61">
<![CDATA[  ]]>
</Line>
<Line Number="62">
<![CDATA[IF sStringCentimetri.LEN > 4 THEN]]>
</Line>
<Line Number="63">
<![CDATA[    sStringCentimetri := '999';]]>
</Line>
<Line Number="64">
<![CDATA[END_IF;]]>
</Line>
<Line Number="65">
<![CDATA[]]>
</Line>
<Line Number="66">
<![CDATA[ ]]>
</Line>
<Line Number="67">
<![CDATA[//Non esistendo in Rockwell il concetto di Char, definisco un array di 82 stringhe e dentro ciascuna stringa]]>
</Line>
<Line Number="68">
<![CDATA[//inserisco l'i-esimo carattere della stringa di partenza "sStringCentimetri"]]>
</Line>
<Line Number="69">
<![CDATA[//In questo modo passo da una stringa di (al più) 82 caratteri a 82 stringhe di 1 carattere]]>
</Line>
<Line Number="70">
<![CDATA[for iIndex := 1 to 82 do]]>
</Line>
<Line Number="71">
<![CDATA[	asArraySingoliCaratteriStringCentimetri[iIndex-1] := '';]]>
</Line>
<Line Number="72">
<![CDATA[	MID(sStringCentimetri, 1, iIndex, asArraySingoliCaratteriStringCentimetri[iIndex-1]);]]>
</Line>
<Line Number="73">
<![CDATA[end_for;]]>
</Line>
<Line Number="74">
<![CDATA[]]>
</Line>
<Line Number="75">
<![CDATA[]]>
</Line>
<Line Number="76">
<![CDATA[//Avendo convertito la stringa "sStringCentimetri" in 82 stringhe da 1 carattere "asArraySingoliCaratteriStringCentimetri[]"]]>
</Line>
<Line Number="77">
<![CDATA[//posso confrontare ciascun carattere della stringa "sStringCentimetri" tramite ciascuna cella dell'array di stringhe]]>
</Line>
<Line Number="78">
<![CDATA[//"asArraySingoliCaratteriStringCentimetri[]". In particolare mi interessano i primi 4 caratteri ([0,3])]]>
</Line>
<Line Number="79">
<![CDATA[//Una volta fatto il confronto, riscrivo il carattere confrontato ed eventualmente modificato (che sarà sicuramente nella ]]>
</Line>
<Line Number="80">
<![CDATA[//posizione .DATA[0] di ciascuna stringa dell'array, poiché tutte da 1 carattere) nella stringa di partenza "sStringCentimetri"]]>
</Line>
<Line Number="81">
<![CDATA[//nella stessa posizione dal quale era stato prelevato]]>
</Line>
<Line Number="82">
<![CDATA[FOR iIndex := 0 TO 3 DO]]>
</Line>
<Line Number="83">
<![CDATA[    IF asArraySingoliCaratteriStringCentimetri[iIndex] = '+' THEN]]>
</Line>
<Line Number="84">
<![CDATA[        asArraySingoliCaratteriStringCentimetri[iIndex] := '0';]]>
</Line>
<Line Number="85">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[	sStringCentimetri.DATA[iIndex] := asArraySingoliCaratteriStringCentimetri[iIndex].DATA[0];]]>
</Line>
<Line Number="87">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="88">
<![CDATA[]]>
</Line>
<Line Number="89">
<![CDATA[]]>
</Line>
<Line Number="90">
<![CDATA[IF sStringCentimetri.LEN = 4 THEN]]>
</Line>
<Line Number="91">
<![CDATA[	sStringCentimetri.DATA[0] := sStringCentimetri.DATA[1];]]>
</Line>
<Line Number="92">
<![CDATA[	sStringCentimetri.DATA[1] := sStringCentimetri.DATA[2];]]>
</Line>
<Line Number="93">
<![CDATA[	sStringCentimetri.DATA[2] := sStringCentimetri.DATA[3];]]>
</Line>
<Line Number="94">
<![CDATA[	DELETE(sStringCentimetri, 1, 4, sStringCentimetri);]]>
</Line>
<Line Number="95">
<![CDATA[	]]>
</Line>
<Line Number="96">
<![CDATA[ELSIF sStringCentimetri.LEN = 2 THEN]]>
</Line>
<Line Number="97">
<![CDATA[	sStringAppoggio := '0';]]>
</Line>
<Line Number="98">
<![CDATA[	CONCAT(sStringAppoggio, sStringCentimetri, sStringCentimetri);]]>
</Line>
<Line Number="99">
<![CDATA[	 ]]>
</Line>
<Line Number="100">
<![CDATA[END_IF;]]>
</Line>
<Line Number="101">
<![CDATA[	]]>
</Line>
<Line Number="102">
<![CDATA[		]]>
</Line>
<Line Number="103">
<![CDATA[			]]>
</Line>
<Line Number="104">
<![CDATA[]]>
</Line>
<Line Number="105">
<![CDATA[//Gestione comunicazione con etichettatore]]>
</Line>
<Line Number="106">
<![CDATA[CASE iCommunicationStep OF]]>
</Line>
<Line Number="107">
<![CDATA[    0:  // PASSO 0 - RESETTO TUTTO]]>
</Line>
<Line Number="108">
<![CDATA[        xRqDeleteAllSockets 							:= 0;]]>
</Line>
<Line Number="109">
<![CDATA[        xRqCreateSocket 								:= 0;]]>
</Line>
<Line Number="110">
<![CDATA[        xRqConnectToSocket 								:= 0;]]>
</Line>
<Line Number="111">
<![CDATA[        xRqReadData 									:= 0;]]>
</Line>
<Line Number="112">
<![CDATA[		xRqWriteData									:= 0;]]>
</Line>
<Line Number="113">
<![CDATA[		xRqDeleteSocket									:= 0;]]>
</Line>
<Line Number="114">
<![CDATA[        xSocketConnectionEstablished					:= 0;]]>
</Line>
<Line Number="115">
<![CDATA[        xLabelerStateRead 								:= 0;]]>
</Line>
<Line Number="116">
<![CDATA[        DB_LabelerPhoenix.xDataSendingInProgress 		:= 0;]]>
</Line>
<Line Number="117">
<![CDATA[        DB_LabelerPhoenix.xResetInProgress 				:= 0;]]>
</Line>
<Line Number="118">
<![CDATA[        ]]>
</Line>
<Line Number="119">
<![CDATA[		// Se etichettatore abilitato]]>
</Line>
<Line Number="120">
<![CDATA[        IF EM_PAL_Infeed_HMI_PB.St_xOptGr_Labeler1Enabling THEN]]>
</Line>
<Line Number="121">
<![CDATA[            xRqIncreaseStepSequence := 1;]]>
</Line>
<Line Number="122">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="123">
<![CDATA[        ]]>
</Line>
<Line Number="124">
<![CDATA[    1:  // PASSO 1 - RICHIESTA CREATE SOCKET]]>
</Line>
<Line Number="125">
<![CDATA[        IF L_Timer[5].DN]]>
</Line>
<Line Number="126">
<![CDATA[		THEN]]>
</Line>
<Line Number="127">
<![CDATA[            xRqCreateSocket := 1;]]>
</Line>
<Line Number="128">
<![CDATA[            xRqIncreaseStepSequence := 1;]]>
</Line>
<Line Number="129">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="130">
<![CDATA[        ]]>
</Line>
<Line Number="131">
<![CDATA[    2:  // PASSO 2 - ATTENDO TERMINE CREATE STOCKET e RICHEDO CONNESSIONE ALLA SOCKET CREATA]]>
</Line>
<Line Number="132">
<![CDATA[        IF Create_Socket_MSG.DN]]>
</Line>
<Line Number="133">
<![CDATA[		THEN]]>
</Line>
<Line Number="134">
<![CDATA[			xRqConnectToSocket	:= 1;]]>
</Line>
<Line Number="135">
<![CDATA[            xRqIncreaseStepSequence := 1;    ]]>
</Line>
<Line Number="136">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="137">
<![CDATA[        ]]>
</Line>
<Line Number="138">
<![CDATA[    3:  // PASSO 3 - ATTENDO TERMINE CONNESSIONE ALLA SOCKET CREATA]]>
</Line>
<Line Number="139">
<![CDATA[        IF Connect_To_Socket_MSG.DN]]>
</Line>
<Line Number="140">
<![CDATA[		THEN]]>
</Line>
<Line Number="141">
<![CDATA[            xSocketConnectionEstablished := 1;]]>
</Line>
<Line Number="142">
<![CDATA[            xRqIncreaseStepSequence := 1;]]>
</Line>
<Line Number="143">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="144">
<![CDATA[        ]]>
</Line>
<Line Number="145">
<![CDATA[//        ]]>
</Line>
<Line Number="146">
<![CDATA[// ___________________ PASSO 4 DI SCELTA PROSSIMO STEP _______________________]]>
</Line>
<Line Number="147">
<![CDATA[//]]>
</Line>
<Line Number="148">
<![CDATA[]]>
</Line>
<Line Number="149">
<![CDATA[    4:  // PASSO 4 - INVIO I PARAMETRI ALL'ETICHETTATORE (a seguito di una richiesta) OPPURE OGNI 100 ms LEGGO LO STATO DELL'ETICHETTATORE]]>
</Line>
<Line Number="150">
<![CDATA[       IF DB_LabelerPhoenix.xRqTransferParameters then]]>
</Line>
<Line Number="151">
<![CDATA[		   IF xLabelerStateRead THEN]]>
</Line>
<Line Number="152">
<![CDATA[			   IF xLabelerStateInReady THEN]]>
</Line>
<Line Number="153">
<![CDATA[				  iCommunicationStep := 6;]]>
</Line>
<Line Number="154">
<![CDATA[			   ELSE]]>
</Line>
<Line Number="155">
<![CDATA[				  iCommunicationStep := 9;]]>
</Line>
<Line Number="156">
<![CDATA[			   END_IF;]]>
</Line>
<Line Number="157">
<![CDATA[		   ELSE]]>
