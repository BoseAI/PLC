<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[COP(iq_LayerSequence.R276, LayerSequence[1],48);]]>
</Line>
<Line Number="1">
<![CDATA[COP(iq_DepositSequence_LayerTypeA.R400, PlaceSequence_LayerTypeA[1], 60);]]>
</Line>
<Line Number="2">
<![CDATA[COP(iq_DepositSequence_LayerTypeB.R600, PlaceSequence_LayerTypeB[1], 60);]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[xN_X:=0;]]>
</Line>
<Line Number="5">
<![CDATA[xN_Y:=0;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
