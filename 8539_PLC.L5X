<Text>
<![CDATA[ABS(IO_Axis.CommandVelocity,AxisSpeed)LT(AxisSpeed,2)OTL(O_xAxisStopped);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(IO_Axis.PositionCamStatus) ,XIC(IO_Axis.GearingStatus) ,XIC(IO_Axis.TransformStateStatus) ]OTL(O_xAxisCamGearTransfStatus);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQ(IO_Axis.AxisFault,0)XIO(IO_Axis.AlarmStatus)XIO(IO_Axis.ShutdownStatus)OTE(NoFaultAxis);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(I_xRqResetDrive)ONS(ResetDriveEdge)[CLR(IO_MotionControl_MAFR.FLAGS) ,CLR(IO_MotionControlImmStop_MAS.FLAGS) ,CLR(IO_MotionControlPhaseStop_MAS.FLAGS) ,CLR(IO_MotionControl_MASR.FLAGS) ,CLR(IO_MotionControl_MSF.FLAGS) ,CLR(IO_MotionControl_MSO.FLAGS) ,CLR(Step) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQ(Step,0)[XIC(IO_Axis.ShutdownStatus) MASR(IO_Axis,IO_MotionControl_MASR) ,XIO(IO_Axis.ShutdownStatus) ]ADD(Step,1,Step);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[EQ(Step,1)[XIC(NoFaultAxis) ADD(Step,1,Step) ,XIO(NoFaultAxis) MAFR(IO_Axis,IO_MotionControl_MAFR) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQ(Step,2)XIC(NoFaultAxis)XIC(IO_xRqEnableDrive)XIO(IO_Axis.DriveEnableStatus)XIC(O_xAxisStopped)[XIC(IO_Axis.DCBusUpStatus) XIC(IO_Axis.GuardGateDriveOutputStatus) XIC(IO_Axis.GuardOKStatus) [MOVE(600,TonEnable.PRE) TON(TonEnable,?,?) ,XIC(TonEnable.DN) [MSO(IO_Axis,IO_MotionControl_MSO) ,ADD(Step,1,Step) ] ] ,OTL(O_xAxisEnableInProgress) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[EQ(Step,3)XIC(NoFaultAxis)[XIC(IO_Axis.DriveEnableStatus) ADD(Step,1,Step) ,OTL(O_xAxisEnableInProgress) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[EQ(Step,4)[XIC(O_xAxisEnable) OTU(IO_xRqEnableDrive) ,XIC(NoFaultAxis) XIO(IO_Axis.DriveEnableStatus) CLR(Step) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(IO_xRqEnableDrive)OTU(O_xAxisEnableInProgress);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(IO_xRqImmedyateStop)OTU(IO_xRqEnableDrive);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(IO_xRqDisableDrive) XIC(O_xAxisEnable) OTL(DisableInProgress) ,XIC(DisableInProgress) [XIO(O_xAxisStopped) OTL(IO_xRqPhaseStop) ,[XIC(O_xAxisStopped) XIC(O_xAxisEnable) XIO(I_xAxisAlarm) ,XIC(IO_MotionControl_MSF.EN) ] MSF(IO_Axis,IO_MotionControl_MSF) ] ,XIO(O_xAxisEnable) XIC(O_xAxisStopped) OTU(DisableInProgress) OTU(IO_xRqDisableDrive) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[[XIO(O_xAxisCamGearTransfStatus) ,XIC(O_xAxisCamGearTransfStatus) XIC(I_xMasterStopped) ] XIC(IO_xRqImmedyateStop) XIC(O_xAxisEnable) XIO(IO_MotionControlImmStop_MAS.EN) XIO(IO_MotionControlImmStop_MAS.IP) XIO(IO_MotionControlPhaseStop_MAS.IP) XIO(I_xAxisAlarm) ,XIC(IO_MotionControl_MSO.ER) ]MAS(IO_Axis,IO_MotionControlImmStop_MAS,All,Yes,I_DecRateImmStop,% of Maximum,Yes,100.0,% of Time);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
UTILI:
STOP CMD MACHINE
]]>
</Comment>
<Text>
<![CDATA[[[XIO(O_xAxisCamGearTransfStatus) ,XIC(O_xAxisCamGearTransfStatus) XIC(I_xMasterStopped) ] XIC(IO_xRqPhaseStop) ,XIC(IO_xRqStopAxis) ]XIC(O_xAxisEnable)XIO(IO_MotionControlPhaseStop_MAS.EN)XIO(IO_MotionControlImmStop_MAS.IP)XIO(IO_MotionControlPhaseStop_MAS.IP)XIO(I_xAxisAlarm)[ONS(Ons.0) CLR(IO_MotionControlPhaseStop_MAS.FLAGS) ,MAS(IO_Axis,IO_MotionControlPhaseStop_MAS,All,Yes,I_DecRatePhaseStop,% of Maximum,Yes,100.0,% of Time) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIO(IO_Axis.AxisHomedStatus) MOVE(999999,O_rAxisActualPosition) MOVE(999999,O_rAxisCommandPosition) ,XIC(IO_Axis.AxisHomedStatus) MOVE(IO_Axis.ActualPosition,O_rAxisActualPosition) MOVE(IO_Axis.CommandPosition,O_rAxisCommandPosition) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[MOVE(IO_Axis.ActualVelocity,O_rAxisActualvelocity)MOVE(IO_Axis.CommandVelocity,O_rAxisCommandlvelocity);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[LBL(NoConn)[[XIC(IO_MotionControlPhaseStop_MAS.PC) ,XIC(IO_xRqImmedyateStop) ] [OTU(IO_xRqStopAxis) ,OTU(IO_xRqPhaseStop) ] ,OTU(IO_xRqImmedyateStop) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[XIC(IO_MotionControl_MAFR.ER) ,XIC(IO_MotionControlImmStop_MAS.ER) ,XIC(IO_MotionControlPhaseStop_MAS.ER) ,XIC(IO_MotionControl_MASR.ER) ,XIC(IO_MotionControl_MSF.ER) ,XIC(IO_MotionControl_MSO.ER) ]OTL(IO_xMotionInstructionError);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
