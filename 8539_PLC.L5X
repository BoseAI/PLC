<Routines>
<Routine Name="CM_Axis_Converter" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(L_Converter.Out.AxisFault) XIC(BB.Alarm_ResetRqPulse) ,XIC(OM_EthernetCom.xCipDrive_NetworkReady) ]MASR(T0110_PowerSupply,L_T0110_MASR1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[NE(T0110_PowerSupply.AxisFault,0)OTE(L_Converter.Out.AxisFault);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[CLR(AuxAxisFaultCode[1]) CPS(L_AxisFaultTextEmpty,AuxAxisFaultText[1],1) CPS(L_AuxAxisFaultClassEmpty,AuxAxisFaultClass[1],1) ,XIC(BB.Alarm_ResetRisingEdge) OTU(FaultPresent.1) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(OM_EthernetCom.xCipDrive_NetworkReady)ONS(OM_EthernetCom.axPTrig[37])OTL(xRqRefreshTextFault);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(OM_EthernetCom.xCipDrive_NetworkReady)AOI_CIP_Axis_Fault_Finder(FncAxisFaultFinder[1],TaskMotion,T0110_PowerSupply);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(FncAxisFaultFinder[1].FP)OTL(FaultPresent.1);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(FncAxisFaultFinder[1].FP) ,XIC(xRqRefreshTextFault) ]F_CIP_AxisFaultTextCompiler(FncCIPAxisFaultTextCompiler[1],FncAxisFaultFinder[1].FaultClass,FncAxisFaultFinder[1].Fault_1,AuxAxisFaultCode[1],AuxAxisFaultText[1],AuxAxisFaultClass[1],xRqRefreshTextFault);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[MOVE(AuxAxisFaultCode[1],AxisFault.T0110_Power.FaultCode)CPS(AuxAxisFaultText[1],AxisFault.T0110_Power.FaultText,1)CPS(AuxAxisFaultClass[1],AxisFault.T0110_Power.FaultClass,1)OTU(FirstScanAxisFault.1);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(L_Converter.Out.AxisFault)[OTE(ALRM[833]) ,OTL(BB.Rq_EmergencyImmediateStop) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(1000,OM_EthernetCom.TON_Cip_Drive_network_waiting_time.PRE)MOVE(1000,OM_EthernetCom.TON_Drive_first_automatic_reset.PRE)MOVE(500,OM_EthernetCom.TON_Dosing_stack_completed_delay.PRE)MOVE(1000,OM_EthernetCom.TON_Read_temperature_motor_clock.PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(TaskMotion.GroupSynced)XIO(TaskMotion.ModuleFault)[[EQ(TaskMotion.GroupFault,0) EQ(TaskMotion.AxisFault,0) ,XIC(OM_EthernetCom.xCipDrive_NetworkReady) ] TON(OM_EthernetCom.TON_Cip_Drive_network_waiting_time,?,?) ,XIC(OM_EthernetCom.TON_Cip_Drive_network_waiting_time.DN) OTE(OM_EthernetCom.xCipDrive_NetworkReady) ,XIO(OM_EthernetCom.xCipDrive_NetworkReady) CLR(OM_EthernetCom.diAuxCheckMotorTemp_NrOfTotalAxis) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(OM_EthernetCom.TON_Drive_first_automatic_reset.DN)[TON(OM_EthernetCom.TON_Drive_first_automatic_reset,?,?) ,XIO(OM_EthernetCom.TON_Drive_first_automatic_reset.DN) OTE(BB.AxisResetFromFirstPowerOn) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(OM_EthernetCom.TON_Cip_Drive_network_waiting_time.DN)OTL(BB.SizeChange_Inhibition);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(AxisFault.MotionInstructionAlarmRequest) [OTE(ALRM[832]) ,OTL(BB.Rq_EmergencyImmediateStop) ,OTU(AxisFault.MotionInstructionAlarmRequest) ] ,XIC(BB.Alarm_ResetRisingEdge) [CLR(AxisFault.NrInstructionError) ,CLR(AxisFault.NrAxisMotionInstructionError) ,CLR(AxisFault.NrErrorNumber) ,CLR(AxisFault.NrExtendedErrorNumber) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(BB.St_Emergency_ImmediateStop)XIC(BB.EMF_ON)XIC(BB.EPN_ON)[TON(OM_EthernetCom.TON_Dosing_stack_completed_delay,?,?) ,XIC(OM_EthernetCom.TON_Dosing_stack_completed_delay.DN) OTE(OM_EthernetCom.xReadyDelayedForEnableDriver) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIO(OM_EthernetCom.TON_Read_temperature_motor_clock.DN) TON(OM_EthernetCom.TON_Read_temperature_motor_clock,?,?) ,XIC(OM_EthernetCom.TON_Read_temperature_motor_clock.DN) ONS(OM_EthernetCom.axPTrig[1]) ADD(OM_EthernetCom.diAuxCheckMotorTemp,1,OM_EthernetCom.diAuxCheckMotorTemp) GT(OM_EthernetCom.diAuxCheckMotorTemp,OM_EthernetCom.diAuxCheckMotorTemp_NrOfTotalAxis) CLR(OM_EthernetCom.diAuxCheckMotorTemp) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main" Type="RLL">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Logic,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(CM_Axis_Converter,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
