<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[//Calc cam point from data size and sys]]>
</Line>
<Line Number="2">
<![CDATA[EM_CaseP.rPickupMotor_Cam_MagazinePos:=	SYS.N[246] ;	]]>
</Line>
<Line Number="3">
<![CDATA[EM_CaseP.rPickupMotor_Cam_OpenCasePos:=	SYS.N[247] ;	]]>
</Line>
<Line Number="4">
<![CDATA[EM_CaseP.rPickupMotor_Cam_FillingPos:=	SYS.N[248]  ;	]]>
</Line>
<Line Number="5">
