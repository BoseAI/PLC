<Routine Name="ProductionCounter" Type="RLL">
<Description>
<![CDATA[Siemens FB3]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Automatic_CycleActive)OTE(BB_CRS.Count_EnableCounts);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Clock_500ms)ONS(UM_Machine_CRS.axPTrig[5])OTE(BB_CRS.Count_PulsePerSecond);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Count_EnableCounts)XIC(BB_CRS.Count_PulsePerSecond)[ADD(UM_HMI_CRS.Production.diPartialCounterSeconds,1,UM_HMI_CRS.Production.diPartialCounterSeconds) ,ADD(UM_HMI_CRS.Production.diTotalCounterSeconds,1,UM_HMI_CRS.Production.diTotalCounterSeconds) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[*************************
Partial Time Section Management
************************]]>
</Comment>
<Text>
<![CDATA[GE(UM_HMI_CRS.Production.diPartialCounterSeconds,60)[ADD(UM_HMI_CRS.Production.diPartialCounterMin,1,UM_HMI_CRS.Production.diPartialCounterMin) ,CLR(UM_HMI_CRS.Production.diPartialCounterSeconds) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[GE(UM_HMI_CRS.Production.diPartialCounterMin,60)[ADD(UM_HMI_CRS.Production.diPartialCounterHours,1,UM_HMI_CRS.Production.diPartialCounterHours) ,CLR(UM_HMI_CRS.Production.diPartialCounterMin) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[*************************
Partial Hours Limit Clear
************************]]>
</Comment>
<Text>
<![CDATA[GE(UM_HMI_CRS.Production.diPartialCounterHours,1000000000)CLR(UM_HMI_CRS.Production.diPartialCounterHours);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[*************************
Total Time Section Management
************************]]>
</Comment>
<Text>
<![CDATA[GE(UM_HMI_CRS.Production.diTotalCounterSeconds,60)[ADD(UM_HMI_CRS.Production.diTotalCounterMin,1,UM_HMI_CRS.Production.diTotalCounterMin) ,CLR(UM_HMI_CRS.Production.diTotalCounterSeconds) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[GE(UM_HMI_CRS.Production.diTotalCounterMin,60)[ADD(UM_HMI_CRS.Production.diTotalCounterHours,1,UM_HMI_CRS.Production.diTotalCounterHours) ,CLR(UM_HMI_CRS.Production.diTotalCounterMin) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[*************************
Total Hours Limit Clear
************************]]>
</Comment>
<Text>
<![CDATA[GE(UM_HMI_CRS.Production.diTotalCounterHours,1000000000)CLR(UM_HMI_CRS.Production.diTotalCounterHours);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[*************************
Partial Time Manual Button Clear
************************]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Time)[OTE(UM_HMI_CRS.Production.St_xResetPartialCounter_Time) ,CLR(UM_HMI_CRS.Production.diPartialCounterSeconds) ,CLR(UM_HMI_CRS.Production.diPartialCounterMin) ,CLR(UM_HMI_CRS.Production.diPartialCounterHours) ,OTU(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Time) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Machine cycles]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface_CRS.xBuffer_RqCountingCycles)[ADD(UM_HMI_CRS.Production.diPartialCounterCycles,1,UM_HMI_CRS.Production.diPartialCounterCycles) ,ADD(UM_HMI_CRS.Production.diTotalCounterCycles,1,UM_HMI_CRS.Production.diTotalCounterCycles) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Machine cycles]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface_CRS.xBuffer_RqCountingProductsEntered)[ADD(UM_HMI_CRS.Production.diPartialCounterProductsEntered,1,UM_HMI_CRS.Production.diPartialCounterProductsEntered) ,ADD(UM_HMI_CRS.Production.diTotalCounterProductsEntered,1,UM_HMI_CRS.Production.diTotalCounterProductsEntered) ,OTU(OM_Interface_CRS.xBuffer_RqCountingProductsEntered) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Machine cycles]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface_CRS.xBuffer_RqCountingProductsReworked)[ADD(UM_HMI_CRS.Production.diPartialCounterProductsReworked,iProductsPushedOnBeltDuringLastPush,UM_HMI_CRS.Production.diPartialCounterProductsReworked) ,ADD(UM_HMI_CRS.Production.diTotalCounterProductsReworked,iProductsPushedOnBeltDuringLastPush,UM_HMI_CRS.Production.diTotalCounterProductsReworked) ,OTU(OM_Interface_CRS.xBuffer_RqCountingProductsReworked) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[*************************
Prod Cycles Clear Management
************************]]>
</Comment>
<Text>
<![CDATA[[[GE(UM_HMI_CRS.Production.diPartialCounterCycles,1000000000) ,XIC(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Cycles) ] [OTE(UM_HMI_CRS.Production.St_xResetPartialCounter_Cycles) ,CLR(UM_HMI_CRS.Production.diPartialCounterCycles) ,OTU(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Cycles) ] ,GE(UM_HMI_CRS.Production.diTotalCounterCycles,1000000000) CLR(UM_HMI_CRS.Production.diTotalCounterCycles) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[[GE(UM_HMI_CRS.Production.diPartialCounterProductsEntered,1000000000) ,XIC(UM_HMI_CRS.Production.Rq_xResetPartialCounter_ProductsEntered) ] [OTE(UM_HMI_CRS.Production.St_xResetPartialCounter_ProductsEntered) ,CLR(UM_HMI_CRS.Production.diPartialCounterProductsEntered) ,OTU(UM_HMI_CRS.Production.Rq_xResetPartialCounter_ProductsEntered) ] ,GE(UM_HMI_CRS.Production.diTotalCounterProductsEntered,1000000000) CLR(UM_HMI_CRS.Production.diTotalCounterProductsEntered) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[[GE(UM_HMI_CRS.Production.diPartialCounterProductsReworked,1000000000) ,XIC(UM_HMI_CRS.Production.Rq_xResetPartialCounter_ProductsReworked) ] [OTE(UM_HMI_CRS.Production.St_xResetPartialCounter_ProductsReworked) ,CLR(UM_HMI_CRS.Production.diPartialCounterProductsReworked) ,OTU(UM_HMI_CRS.Production.Rq_xResetPartialCounter_ProductsReworked) ] ,GE(UM_HMI_CRS.Production.diTotalCounterProductsReworked,1000000000) CLR(UM_HMI_CRS.Production.diTotalCounterProductsReworked) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[[GE(UM_HMI_CRS.Production.diPartialCounterReject_FlapsOpen,1000000000) ,XIC(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Reject_FlapsOpen) ] [OTE(UM_HMI_CRS.Production.St_xResetPartialCounter_Reject_FlapsOpe) ,CLR(UM_HMI_CRS.Production.diPartialCounterReject_FlapsOpen) ,OTU(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Reject_FlapsOpen) ] ,GE(UM_HMI_CRS.Production.diTotalCounterReject_FlapsOpen,1000000000) CLR(UM_HMI_CRS.Production.diTotalCounterReject_FlapsOpen) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[[GE(UM_HMI_CRS.Production.diPartialCounterReject_LabelCtrl,1000000000) ,XIC(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Reject_LabelCtrl) ] [OTE(UM_HMI_CRS.Production.St_xResetPartialCounter_Reject_LabelCtrl) ,CLR(UM_HMI_CRS.Production.diPartialCounterReject_LabelCtrl) ,OTU(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Reject_LabelCtrl) ] ,GE(UM_HMI_CRS.Production.diTotalCounterReject_LabelCtrl,1000000000) CLR(UM_HMI_CRS.Production.diTotalCounterReject_LabelCtrl) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[[GE(UM_HMI_CRS.Production.diPartialCounterReject_NotFull,1000000000) ,XIC(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Reject_NotFull) ] [OTE(UM_HMI_CRS.Production.St_xResetPartialCounter_Reject_NotFull) ,CLR(UM_HMI_CRS.Production.diPartialCounterReject_NotFull) ,OTU(UM_HMI_CRS.Production.Rq_xResetPartialCounter_Reject_NotFull) ] ,GE(UM_HMI_CRS.Production.diTotalCounterReject_NotFull,1000000000) CLR(UM_HMI_CRS.Production.diTotalCounterReject_NotFull) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Reset tutti i contatori parziali
valutare se implementarlo HMI]]>
</Comment>
<Text>
<![CDATA[[XIC(UM_HMI_CRS.Production.Rq_xResetPartialCounter_All) ,XIC(OM_Interface_CRS.xRq_ResetCounters_BatchManagement_CRS) ][CLR(UM_HMI_CRS.Production.diPartialCounterCycles) ,CLR(UM_HMI_CRS.Production.diPartialCounterSeconds) ,CLR(UM_HMI_CRS.Production.diPartialCounterMin) ,CLR(UM_HMI_CRS.Production.diPartialCounterHours) ,CLR(UM_HMI_CRS.Production.diPartialCounterProductsEntered) ,CLR(UM_HMI_CRS.Production.diPartialCounterProductsReworked) ,CLR(UM_HMI_CRS.Production.diPartialCounterReject_LabelCtrl) ,CLR(UM_HMI_CRS.Production.diPartialCounterReject_FlapsOpen) ,CLR(UM_HMI_CRS.Production.diPartialCounterReject_NotFull) ,CLR(UM_HMI_CRS.Production.diPartialCounterReject_AggrFail) ,CLR(UM_HMI_CRS.Production.diPartialCounterCasePickedup) ,CLR(UM_HMI_CRS.Production.diPartialCounterCasePlacedonPallet) ,OTU(UM_HMI_CRS.Production.Rq_xResetPartialCounter_All) ,OTU(OM_Interface_CRS.xRq_ResetCounters_BatchManagement_CRS) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SizeCalculation" Type="RLL"/>
<Routine Name="SizeChange" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Count_EnableCheckOfResetCounts)XIO(BB_CRS.Count_GrtZero)OTU(BB_CRS.Count_EnableCheckOfResetCounts);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GT(UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number,0)XIO(BB_CRS.SizeDisplay_InProgress)XIO(BB_CRS.SizeSave_InProgress)XIO(BB_CRS.SizeCopy_InProgress)XIO(BB_CRS.SizeDelete_InProgress)XIO(BB_CRS.SizeChange_Inhibition)OTE(BB_CRS.SizeChange_ConditionsOk);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_Inhibition)OTU(BB_CRS.SizeChange_Inhibition);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[sostituire il PlcPanel.KeyPanel.4 con quello sopra (base)]]>
</Comment>
<Text>
<![CDATA[XIC(UM_HMI_CRS.Machine.Rq_xConfirmSizeChange)ONS(UM_Machine_CRS.axPTrig[24])[XIC(BB_CRS.SizeChange_ConditionsOk) OTE(BB_CRS.SizeChange_CheckDataRq) ,XIO(BB_CRS.SizeChange_ConditionsOk) [OTL(MSG_CRS[8]) ,OTL(UM_HMI_CRS.Machine.xFormatChange_NOT_OK) ] ,OTU(UM_HMI_CRS.Machine.Rq_xConfirmSizeChange) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_RestoreRq)[OTU(BB_CRS.SizeChange_InProgress) ,OTU(BB_CRS.SizeChange_DeviceSizeChangeRq) ,OTU(BB_CRS.SizeChange_RestoreRq) ,OTU(BB_CRS.SizeChange_OK) ,MOVE(0,UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_PointerIncreaseRq)[ADD(1,SizeAux_CRS[2],SizeAux_CRS[2]) ,OTU(BB_CRS.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_CheckDataRq)JSR(SizeDataCheck,0);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.SizeChange_OK) ,XIC(BB_CRS.SizeChange_RqAdjustmentDataTable) ]XIO(BB_CRS.SizeChange_InProgress)[OTU(BB_CRS.SetSize) ,OTU(BB_CRS.SizeChange_RqAdjustmentDataTable) ,NE(UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number,UM_HMI_CRS.Machine.St_iActualWorkingSize_Number) OTL(BB_CRS.Count_EnableCheckOfResetCounts) ,OTL(BB_CRS.SizeChange_InProgress) ,OTL(UM_HMI_CRS.Machine.St_xSizeChange) ,MOVE(1,SizeAux_CRS[2]) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 1:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)EQ(SizeAux_CRS[2],1)OTL(BB_CRS.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 2:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)EQ(SizeAux_CRS[2],2)OTL(BB_CRS.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 3:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)EQ(SizeAux_CRS[2],3)[COP(Size_CRS[UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number],SizeWork_CRS,1) ,MOVE(UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number,UM_HMI_CRS.Machine.St_iActualWorkingSize_Number) ,COP(Size_CRS[UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number],SizeDisplayed_CRS,1) ,MOVE(UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number,UM_HMI_CRS.Machine.St_iActualDisplayedSize_Number) ]OTL(BB_CRS.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 4:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)EQ(SizeAux_CRS[2],4)[MOVE(0,UM_Machine_CRS.iDevice_Total) ,MOVE(0,UM_Machine_CRS.iDevice_Ok) ,MOVE(0,UM_Machine_CRS.iDevice_Bad) ][OTL(BB_CRS.SizeChange_Rq) ,OTL(BB_CRS.SizeChange_DeviceSizeChangeRq) ,OTL(BB_CRS.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Step 5:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)EQ(SizeAux_CRS[2],5)[XIC(BB_CRS.SizeChange_DataTransferFromAxisOk) ,XIO(UM_Config_CRS.Core.Enable_SchneiderAxis) ]OTL(BB_CRS.SizeChange_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Step 6:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)EQ(SizeAux_CRS[2],6)CMP(UM_Machine_CRS.iDevice_Ok+UM_Machine_CRS.iDevice_Bad=UM_Machine_CRS.iDevice_Total)[OTU(BB_CRS.SizeChange_Rq) ,OTL(BB_CRS.SizeChange_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)XIC(BB_CRS.SizeChange_Rq)EQ(SizeAux_CRS[2],6)[MOVE(0,UM_Machine_CRS.iDevice_Total) ,MOVE(0,UM_Machine_CRS.iDevice_Ok) ,MOVE(0,UM_Machine_CRS.iDevice_Bad) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Step 7:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)EQ(SizeAux_CRS[2],7)[EQ(UM_Machine_CRS.iDevice_Bad,0) [OTL(BB_CRS.SizeChange_PointerIncreaseRq) ,OTL(UM_HMI_CRS.Machine.St_xSizeChange) ] ,NE(UM_Machine_CRS.iDevice_Bad,0) MOVE(102,SizeAux_CRS[2]) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Step 8:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)EQ(SizeAux_CRS[2],8)XIO(UM_HMI_CRS.Machine.Rq_xConfirmSizeChange)TON(Timers_CRS.N[128],?,?);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)XIC(Timers_CRS.N[128].DN)[OTL(BB_CRS.SetSize) ,OTL(BB_CRS.SizeChange_RestoreRq) ,OTU(UM_HMI_CRS.Machine.St_xSizeChange) ,OTL(UM_HMI_CRS.Machine.xFormatChange_OK) ,MOVE(2,UM_HMI_CRS.PcPanel.iSizeChange_State) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)[TON(Timers_CRS.N[121],?,?) ,XIC(Timers_CRS.N[121].DN) [OTE(ALRM_CRS[25]) ,OTL(UM_HMI_CRS.Machine.xFormatChange_NOT_OK) ,OTL(BB_CRS.SizeChange_RestoreRq) ,OTU(OM_Interface_CRS.AutoSizeChange_xInProgress) ,OTU(OM_Interface_CRS.AutoSizeChange_xRq) ,MOVE(65,Core_HMI_CRS.Interface.iPageToDisplay) ] ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Machine_Enable)XIO(BB_CRS.SetSize)[XIO(BB_CRS.SizeChange_InProgress) OTL(MSG_CRS[7]) ,OTL(BB_CRS.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[EQ(SizeAux_CRS[2],102)[XIC(BB_CRS.SizeChange_InProgress) OTL(BB_CRS.SizeChange_RestoreRq) ,MOVE(3,UM_HMI_CRS.PcPanel.iSizeChange_State) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Count_EnableCheckOfResetCounts)XIC(BB_CRS.Count_GrtZero)[OTL(MSG_CRS[17]) ,OTL(BB_CRS.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.Count_GrtZero)OTU(BB_CRS.Count_GrtZero);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeChange_InProgress)OTL(MSG_CRS[6]);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[[XIC(UM_HMI_CRS.Machine.xFormatChange_OK) ,XIC(UM_HMI_CRS.Machine.xFormatChange_NOT_OK) ][TON(Timers_CRS.N[125],?,?) ,XIC(Timers_CRS.N[125].DN) [OTU(UM_HMI_CRS.Machine.xFormatChange_OK) ,OTU(UM_HMI_CRS.Machine.xFormatChange_NOT_OK) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SizeCopy" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_RqPulse)XIC(BB_CRS.SizeCopy_ConditionOk)[MOVE(Core_HMI_CRS.Interface.iPageDisplayed,Core_HMI_CRS.Interface.iSavingPageNumber) ,OTL(BB_CRS.SizeCopy_FunctionKeyCopyDone) ,MOVE(2,UM_HMI_CRS.Machine.St_iModSizeCopySave) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_FunctionKeyCopyDone)XIC(Timers_CRS.N[129].DN)[OTU(BB_CRS.SizeCopy_FunctionKeyCopyDone) ,OTU(UM_HMI_CRS.Machine.St_xSizeCopy) ,[OTL(BB_CRS.SizeCopy_SequenceRestoreRq) ,MOVE(0,UM_HMI_CRS.Machine.St_iModSizeCopySave) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[GT(UM_HMI_CRS.Machine.St_iSizeToDisplay_Number,0)XIO(BB_CRS.SizeChange_InProgress)XIO(BB_CRS.SizeDisplay_InProgress)XIO(BB_CRS.SizeSave_InProgress)XIO(BB_CRS.SizeDelete_InProgress)OTE(BB_CRS.SizeCopy_ConditionOk);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(UM_HMI_CRS.Machine.Rq_xConfirmSizeCopy)ONS(UM_Machine_CRS.axPTrig[18])[OTE(BB_CRS.SizeCopy_RqPulse) ,OTU(UM_HMI_CRS.Machine.Rq_xConfirmSizeCopy) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_SequenceRestoreRq)[OTU(BB_CRS.SizeCopy_InProgress) ,OTU(BB_CRS.SizeCopy_SequenceRestoreRq) ,MOVE(0,UM_HMI_CRS.Machine.Rq_iSizeCopy_Destination) ,MOVE(6,Core_HMI_CRS.Interface.iPageToDisplay) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_PointerIncreaseRq)[ADD(1,SizeAux_CRS[5],SizeAux_CRS[5]) ,OTU(BB_CRS.SizeCopy_PointerIncreaseRq) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_RqPulse)XIO(BB_CRS.SizeCopy_InProgress)MOVE(1,SizeAux_CRS[5]);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_RqPulse)XIC(BB_CRS.SizeCopy_ConditionOk)OTL(BB_CRS.SizeCopy_InProgress);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Step 1:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_InProgress)EQ(SizeAux_CRS[5],1)[LIMIT(1,UM_HMI_CRS.Machine.Rq_iSizeCopy_Destination,SizeAux_CRS[17]) OTL(BB_CRS.SizeCopy_PointerIncreaseRq) ,[GT(UM_HMI_CRS.Machine.Rq_iSizeCopy_Destination,SizeAux_CRS[17]) ,LT(UM_HMI_CRS.Machine.Rq_iSizeCopy_Destination,1) ] MOVE(101,SizeAux_CRS[5]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Step 2:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_InProgress)EQ(SizeAux_CRS[5],2)[NE(Size_CRS[UM_HMI_CRS.Machine.St_iSizeToDisplay_Number].WorkingCode,sEmptyCode_CRS) OTL(BB_CRS.SizeCopy_PointerIncreaseRq) ,EQ(Size_CRS[UM_HMI_CRS.Machine.St_iSizeToDisplay_Number].WorkingCode,sEmptyCode_CRS) MOVE(101,SizeAux_CRS[5]) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Step 3:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_InProgress)EQ(SizeAux_CRS[5],3)OTL(BB_CRS.SizeCopy_PointerIncreaseRq);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step 4:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_InProgress)EQ(SizeAux_CRS[5],4)COP(Size_CRS[UM_HMI_CRS.Machine.St_iSizeToDisplay_Number],Size_CRS[UM_HMI_CRS.Machine.Rq_iSizeCopy_Destination],1)[OTL(BB_CRS.SizeCopy_PointerIncreaseRq) ,OTL(UM_HMI_CRS.Machine.St_xSizeCopy) ,MOVE(4,UM_HMI_CRS.Machine.St_iModSizeCopySave) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Step 5:]]>
</Comment>
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_InProgress)EQ(SizeAux_CRS[5],5)TON(Timers_CRS.N[129],?,?);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[EQ(SizeAux_CRS[5],101)XIC(BB_CRS.SizeCopy_InProgress)[OTL(BB_CRS.Alarm_AuxSizeDataWrongOrNotSet) ,OTL(BB_CRS.SizeCopy_SequenceRestoreRq) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.SizeCopy_RqPulse)XIO(BB_CRS.SizeSave_ConditionOk)OTL(MSG_CRS[13]);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.SizeCopy_InProgress) XIO(UM_HMI_CRS.Machine.St_xSizeCopy) MOVE(2,UM_HMI_CRS.Machine.St_iModSizeCopySave) ,XIO(BB_CRS.SizeCopy_InProgress) XIC(BB_CRS.Alarm_AuxSizeDataWrongOrNotSet) [MOVE(12,UM_HMI_CRS.Machine.St_iModSizeCopySave) ,OTU(UM_HMI_CRS.Machine.Rq_xConfirmSizeCopy) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="SizeDataCheck" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CLR(SYS_CRS.N[0]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[ADD(SYS_CRS.N[0],1,SYS_CRS.N[0])EQ(Size_CRS[UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number].WorkingCode,sEmptyCode_CRS)[OTL(BB_CRS.SizeChange_NotCorrect) ,OTU(BB_CRS.SizeChange_OK) ,RET() ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[ADD(SYS_CRS.N[0],1,SYS_CRS.N[0])LE(Size_CRS[UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number].General.ProductLength,0)[OTL(BB_CRS.SizeChange_NotCorrect) ,OTU(BB_CRS.SizeChange_OK) ,RET() ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[ADD(SYS_CRS.N[0],1,SYS_CRS.N[0])LE(Size_CRS[UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number].General.ProductHeight,0)[OTL(BB_CRS.SizeChange_NotCorrect) ,OTU(BB_CRS.SizeChange_OK) ,RET() ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[ADD(SYS_CRS.N[0],1,SYS_CRS.N[0])LE(Size_CRS[UM_HMI_CRS.Machine.St_iSizeChange_NewSize_Number].General.ProductWidth,0)[OTL(BB_CRS.SizeChange_NotCorrect) ,OTU(BB_CRS.SizeChange_OK) ,RET() ];]]>
</Text>
</Rung>
