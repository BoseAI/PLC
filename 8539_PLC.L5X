<Routine Name="Cam_Data" Type="RLL">
<Description>
<![CDATA[v0.1        : 27.06.2022
Author      : Ing.Utili Nicola
Comment: Startup from core studio5000 Cph2]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(BB.FirstScan)OTU(EM_CaseP.Cam_xCalcNewSize);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(BB.FirstScan) ,XIC(EM_CaseP.Cam_xSizeChangeOverFault) XIC(BB.Machine_Ready) ]OTU(EM_CaseP.Cam_xSizeChangeOverFault);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(EM_CaseP.Cam_xDataCamOk)[OTE(EM_CaseP.CM_CasePickup.AxisIN_CAM_xDataCamOk) ,OTE(EM_CaseP.CM_CaseOpening.AxisIN_CAM_xDataCamOk) ,OTE(EM_CaseP.CM_CasePickupTranslator.AxisIN_CAM_xDataCamOk) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB.SetSize)XIO(EM_CaseP.Cam_xDataCamOk)XIO(EM_CaseP.Cam_xSizeChangeOverFault)[OTE(EM_CaseP.Cam_xRqDataRefresh) ,OTE(EM_CaseP.CM_CasePickup.AxisIN_CAM_xRqChangeData) ,OTE(EM_CaseP.CM_CaseOpening.AxisIN_CAM_xRqChangeData) ,OTE(EM_CaseP.CM_CasePickupTranslator.AxisIN_CAM_xRqChangeData) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIO(BB.SetSize) ,XIC(OM_EthernetCom.xCipDrive_NetworkReady) ONS(EM_CaseP.axPTrig[28]) ]OTU(EM_CaseP.Cam_xDataCamOk);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[CASE PACKER CAM MODIFICATION]]>
</Comment>
<Text>
<![CDATA[XIC(EM_CaseP.Cam_xRqDataRefresh)ONS(EM_CaseP.axPTrig[20])MOVE(1,EM_CaseP.Cam_diCalcStep);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(EM_CaseP.Cam_xRqDataRefresh)XIO(EM_CaseP.CM_MasterPickup.AxisIN_xOutputSlaveSynchro)GSV(Task,MainTask,Watchdog,EM_CaseP.Cam_diWatchdogActual)EQ(EM_CaseP.Cam_diWatchdogActual,2000000)ONS(EM_CaseP.axPTrig[21])OTL(EM_CaseP.Cam_xCalcNewSize);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(EM_CaseP.Cam_xRqDataRefresh)ONS(EM_CaseP.axPTrig[22])MOVE(2000000,EM_CaseP.Cam_diWatchdog)SSV(Task,MainTask,Watchdog,EM_CaseP.Cam_diWatchdog);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(EM_CaseP.Cam_xRqDataRefresh)ONS(EM_CaseP.axPTrig[23])GSV(Task,MainTask,Watchdog,EM_CaseP.Cam_diWatchdogActual)NE(EM_CaseP.Cam_diWatchdogActual,500000)MOVE(500000,EM_CaseP.Cam_diWatchdog)SSV(Task,MainTask,Watchdog,EM_CaseP.Cam_diWatchdog);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(EM_CaseP.Cam_xRqDataRefresh)EQ(EM_CaseP.Cam_diCalcStep,1)XIC(EM_CaseP.Cam_xCalcNewSize)MOVE(2,EM_CaseP.Cam_diCalcStep);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(EM_CaseP.Cam_xRqDataRefresh)EQ(EM_CaseP.Cam_diCalcStep,2)XIC(EM_CaseP.Cam_xCalcNewSize)[JSR(Cam_CaseOpening,0) ,JSR(Cam_CasePickup,0) ,JSR(Cam_CasePickupTranslator,0) ,MOVE(5,EM_CaseP.Cam_diCalcStep) ,OTU(EM_CaseP.Cam_xCalcNewSize) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(EM_CaseP.Cam_xRqDataRefresh)EQ(EM_CaseP.Cam_diCalcStep,5)XIC(EM_CaseP.CIP_CaseOpening.arMotionInstr[40].DN)XIC(EM_CaseP.CIP_CasePickup.arMotionInstr[40].DN)XIC(EM_CaseP.CIP_CasePickupTranslator.arMotionInstr[40].DN)MOVE(6,EM_CaseP.Cam_diCalcStep);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(EM_CaseP.Cam_xRqDataRefresh)EQ(EM_CaseP.Cam_diCalcStep,6)MOVE(15,EM_CaseP.Cam_diCalcStep);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(EM_CaseP.Cam_xRqDataRefresh)EQ(EM_CaseP.Cam_diCalcStep,15)[XIO(BB.Count_EnableCheckOfResetCounts) ,XIC(BB.Count_EnableCheckOfResetCounts) ][MOVE(0,EM_CaseP.Cam_diCalcStep) ,OTL(EM_CaseP.Cam_xDataCamOk) ];]]>
</Text>
</Rung>
