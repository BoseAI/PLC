<AddOnInstructionDefinition Name="ManagFanuc" Class="Standard" Revision="1.7" Vendor="Fortini Mirko - rev Tiberia - Utili" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2016-05-31T13:08:56.033Z" CreatedBy="ds-PC\ds" EditedDate="2024-03-18T15:15:20.859Z" EditedBy="DESKTOP-I4HL37F\admin"
 SoftwareRevision="v32.01">
