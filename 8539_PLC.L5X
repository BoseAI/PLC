<Line Number="406">
<![CDATA[// _________________ GESTIONE DATI RICEVUTI ______________________________]]>
</Line>
<Line Number="407">
<![CDATA[//]]>
</Line>
<Line Number="408">
<![CDATA[// Bit6 del byte è l'avviso fine etichette.]]>
</Line>
<Line Number="409">
<![CDATA[// Viene negato per coerenza col simbolo solito in quanto]]>
</Line>
<Line Number="410">
<![CDATA[// Phoenix invia 1 = Etichette ok; Phoenix invia 0 = Etichette quasi finite]]>
</Line>
<Line Number="411">
<![CDATA[DB_LabelerPhoenix.PhysicalSignals.xLowLabelWarning := NOT LabelerDataReceived.usiLabelerExternalState.6;]]>
</Line>
<Line Number="412">
<![CDATA[]]>
</Line>
<Line Number="413">
<![CDATA[// Bit6 del byte è la presenza dell'etichetta sul pad]]>
</Line>
<Line Number="414">
<![CDATA[//q_xLabelOnPad := LabelerDataReceived.usiLabelerExternalState.6;]]>
</Line>
<Line Number="415">
<![CDATA[// Removed because we use the digital I/O that is faster than TCP/IP]]>
</Line>
<Line Number="416">
<![CDATA[]]>
