</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(OM_ShiftPalChange_HMI.Pos3_Infeed_Transfer.St_xPalletPresence) ,XIO(OM_Interface.PalChange_xPusherInPos_BWD) ]OTE(EM_PalMag.CM_MultiPalletsMagazine.IN_xNextCycle_Inhibition);]]>
