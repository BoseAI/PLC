<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[OTU(EN) OTU(DN) OTU(FP) OTU(Start) MOVE(0,FaultClass) MOVE(0,Quantity_of_Fault_Present) ,MOVE(0,Fault_1) MOVE(0,Fault_2) MOVE(0,Fault_3) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTE(EN);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[NE(AXIS.AxisFault,0)OTE(FP);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[***********************************************************************************************************************************************

Ricerca "FAULT CLASS" Axis Fault

0  =  PhysicalAxisFault
1  =  ModuleFault         
2  =  ConfigurationFault
3  =  GroupFault          
4  =  MotionFault         
5  =  GuardFault          
6  =  InitializationFault  
7  =  APRFault             

***********************************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Start)XIC(FP)[MOVE(AXIS.AxisFault,Fault_Class[0]) MOVE(0,Fault_Class[1]) MOVE(0,Reference[0]) MOVE(0,Reference[1]) ,MOVE(64,FBC1.LEN) MOVE(5,FBC1_RC.LEN) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Start)XIC(FP)FBC(Fault_Class[0],Reference[0],Fault_Class_Array[0],FBC1,?,?,FBC1_RC,?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[***********************************************************************************************************************************************

Ricerca " Physical Axis Fault"

CipAxisFault

***********************************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(Start)XIC(FP)XIC(AXIS.AxisFault.0)[COP(AXIS.CIPAxisFaults,Fault_DINT[0],2) ,MOVE(64,FBC2.LEN) MOVE(5,FBC2_RC.LEN) ]FBC(Fault_DINT[0],Reference[0],Cip_Axis_Fault_Arrey[0],FBC2,?,?,FBC2_RC,?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[***********************************************************************************************************************************************

Ricerca " Module Faultt"

ModuleFaultt

***********************************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(Start)XIC(FP)XIC(AXIS.AxisFault.1)[MOVE(AXIS.ModuleFaults,Fault_DINT[0]) MOVE(0,Fault_DINT[1]) ,MOVE(64,FBC3.LEN) MOVE(5,FBC3_RC.LEN) ]FBC(Fault_DINT[0],Reference[0],Module_Fault_Arrey[0],FBC3,?,?,FBC3_RC,?,?);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[***********************************************************************************************************************************************

Ricerca "ConfigurationFault"

Configuration Fault

***********************************************************************************************************************************************]]>
</Comment>
<Text>
