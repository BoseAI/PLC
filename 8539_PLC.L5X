</Comment>
<Text>
<![CDATA[DCS(sDCS_CRS.S9100.DCS,USER DEFINED,EQUIVALENT - ACTIVE HIGH,500,AUTOMATIC,AUTOMATIC,SafetyIN_CRS.S9100_03_CH0,SafetyIN_CRS.S9100_03_CH1,sDCS_CRS.S9100.InputStatus,sDCS_CRS.FEdgeOpSideResetBlockAutoReset);]]>
</Text>
