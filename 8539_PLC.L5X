<Routines>
<Routine Name="CM_ElectronicTransfer" Type="RLL">
<Description>
<![CDATA[v0.1        : 21.02.2023
Author      : Ing.Utili Nicola
Comment: Startup from base cph2 V142]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[Sel_AbolsuteHomeSetPos(DB_SelAbsoluteHomeTransferPal,1,SYS.N[381],EM_PalChange_Hmi_PB.St_iHomeAxisPosition,BB);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(IN.T0130_02_24V)EncoderLika(DB_Encoder_TransferPal,-22.75,EM_PalChange_Hmi_PB.St_iHomeAxisPosition,10,B7850_01_EncoderPalletTransfer:C,B7850_01_EncoderPalletTransfer:I1,EM_PalChange.CM_Encoder_TransfPal,EM_PalChange_Hmi_PB.Rq_xAbsHome_EncoderTransferPal_Save,MSG[12],DB_Encoder_PresetMessage,DB_Encoder_PresetMessage1,ALRM[663],ALRM[664]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[DIV(EM_PalChange.CM_Encoder_TransfPal.lrActualPos,1,EM_PalChange_Hmi_PB.St_iAxisPosition);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(IN.T0130_02_24V)Manag_Motor_Or_PwrFlex525_ForwardBackwar(DB_TransferPallet_Manag,EM_PalChange.xEnableWithoutImmediateStop,IN.K1440_01_Delay,IN.B7850_02,EM_PalChange.xNotUsed,EM_PalChange.xNotUsed,PAL_SizeWork.TransferPalletBackwardPos,PAL_SizeWork.TransferPalletForwardPos,PAL_SizeWork.TransferPalletSlowDownWindowForward,PAL_SizeWork.TransferPalletSlowDownWindowBackward,SYS.N[379],PAL_SizeWork.TransferPalletSpeed,PAL_SizeWork.TransferPalletSpeedSlowDown,SYS.N[382],5000,OM_ShiftPalChange.xRq_ImmediateStop,EM_PalChange.CM_Encoder_TransfPal,EM_PalChange.CM_TransferPallet,ALRM[668],ALRM[669]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(EM_PalChange.CM_TransferPallet.InverterOUT_xInBackwardPos)OTE(OM_Interface.PalChange_xPusherInPos_BWD);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(EM_PalChange.CM_TransferPallet.InverterOUT_xInForwardPos)OTE(OM_Interface.PalChange_xPusherInPos_FWD);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(EM_PalChange.CM_TransferPallet.InverterOUT_xMoveToForward) ,XIC(EM_PalChange.CM_TransferPallet.InverterOUT_xMoveToBackward) ]OTE(OM_Interface.PalChange_xTransferPalletMoving);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[TRANSFER PALLET START REQUEST
(before reset and after check the condition)]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(IN.T0130_02_24V)[GSV(Module,T7850_01_PalletTransfer,EntryStatus,EM_PalChange.CM_TransferPallet.Inverter_diEntryStatus) MEQ(EM_PalChange.CM_TransferPallet.Inverter_diEntryStatus,61440,16384) OTE(EM_PalChange.CM_TransferPallet.Inverter_xNetworkOK) ,XIO(BB.FirstScan) MOVE(Timers.N[292].PRE,EM_PalChange.TON_DelayTimeSwitchOnAR26.PRE) TON(EM_PalChange.TON_DelayTimeSwitchOnAR26,?,?) ,XIC(EM_PalChange.TON_DelayTimeSwitchOnAR26.DN) XIO(EM_PalChange.CM_TransferPallet.Inverter_xNetworkOK) OTE(ALRM[666]) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[MOVE(SYS.N[380],EM_PalChange.CM_TransferPallet.Inverter_rSpeedAt50Hz);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[! ! ! ! ! ! ! ! ! ATTENTION ! ! ! ! ! ! ! ! !

REMEMBER TO SET THE VALUE OF ACC, DEC, MIN AND MAX OUTPUT FREQUENCY IN THE INVERTER PARAMETERS

! ! ! ! ! ! ! ! ! ATTENTION ! ! ! ! ! ! ! ! !
]]>
</Comment>
<Text>
<![CDATA[PowerFlex525(DB_PFlex525_TransferPallet,1,EM_PalChange.CM_TransferPallet.Inverter_xNetworkOK,Timers.N[12].DN,EM_PalChange.CM_TransferPallet.Inverter_rSpeedAt50Hz,BB.EMF_ON,80,5,EM_PalChange.CM_TransferPallet,BB,T7850_01_PalletTransfer:I,T7850_01_PalletTransfer:O,DB_PAL_MaxValue_Hmi.TransferPalletSpeed,DB_PAL_MinValue_Hmi.TransferPalletSpeed,ALRM[667]);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIO(BB.AlwaysOFF)[MOVE(DB_PAL_MaxValue_Hmi.TransferPalletSpeed,DB_PAL_MaxValue_Hmi.TransferPalletSpeedSlowDown) ,MOVE(DB_PAL_MinValue_Hmi.TransferPalletSpeed,DB_PAL_MinValue_Hmi.TransferPalletSpeedSlowDown) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[///////////////////////////////////////////////////
JOG PALLET TRANSFER
///////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Deactivation Jog Pallet Pusher]]>
</Comment>
<Text>
<![CDATA[[XIC(BB.Automatic_CycleActive) ,XIO(BB.SetSize) ,XIC(BB.SizeDisplay_ChangePagePulse) ]OTU(EM_PalChange_Hmi_PB.St_xJog_Enable);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Deactivation Jog Without Manual Pallet Pusher]]>
</Comment>
<Text>
<![CDATA[[XIC(BB.Automatic_CycleActive) ,XIO(BB.SetSize) ]OTU(EM_PalChange_Hmi_PB.St_xJog_WithoutEnableMan);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
