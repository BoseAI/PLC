<Parameter Name="iq_HW_Axis_Real" TagType="Base" DataType="AXIS_CIP_DRIVE" Usage="InOut" Required="true" Visible="true"/>
<Parameter Name="iq_CIP_Axis_Real" TagType="Base" DataType="UDT_CM_AxisCIP_ExchangeData_Real" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[-]]>
