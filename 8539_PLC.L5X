<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(5000,TON_MotorTimeOut.PRE)[OTU(xAlwaysOFF) ,OTU(xNotUsed) ,OTL(xAlwaysON) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQ(i_iWindowsInPos,0)MOVE(1,iWindow);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[GT(i_iWindowsInPos,0)MOVE(i_iWindowsInPos,iWindow);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOVE(iq_DB_Encoder.lrActualPos,iEncoderPos);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.IN_xRqManualLow)[OTL(iq_CM_MultiPalletsMagazine.IN_xRqLowPos) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualMiddle) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualHigh) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualSafety) ,XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos) OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualLow) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.IN_xRqManualMiddle)[OTL(iq_CM_MultiPalletsMagazine.IN_xRqMiddlePos) ,XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInMiddlePos) OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualMiddle) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualHigh) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualSafety) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualLow) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.IN_xRqManualHigh)[OTL(iq_CM_MultiPalletsMagazine.IN_xRqHighPos) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualMiddle) ,XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInHighPos) OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualHigh) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualSafety) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualLow) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.IN_xRqManualSafety)[OTL(iq_CM_MultiPalletsMagazine.IN_xRqManualSafety) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualMiddle) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualHigh) ,XIC(iq_CM_MultiPalletsMagazine.OUT_xMagazineInSafetyPos) OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualSafety) ,OTU(iq_CM_MultiPalletsMagazine.IN_xRqManualLow) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(iq_CM_MultiPalletsMagazine.IN_xRqLowPos) ,XIC(iq_CM_MultiPalletsMagazine.IN_xRqMiddlePos) ,XIC(iq_CM_MultiPalletsMagazine.IN_xRqHighPos) ,XIC(iq_CM_MultiPalletsMagazine.IN_xRqSafetyPos) ]XIO(iq_CM_MultiPalletsMagazine.HW_IN_xMagBarrier)OTL(iq_xMsgMagBarrier);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
CMD MAGAZINE IN LOW POS
//////////////////////////////////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(xAlwaysOFF)[OTE(DB_LowPos.i_xEnable) ,OTE(DB_LowPos.i_xMot_Safety) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(xAlwaysOFF)[OTE(DB_LowPos.i_xJogEnable) ,OTE(DB_LowPos.i_xCheckEncMoving) ,OTE(DB_LowPos.i_xDisableAlrmSafety) ,OTE(DB_LowPos.i_xExclusionTimeout) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(iq_CM_MultiPalletsMagazine.HW_IN_xMagBarrier)XIC(iq_CM_MultiPalletsMagazine.HW_IN_xDelayEmergency)OTE(DB_LowPos.i_xDelayEmergency);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[Manag_Motor_Or_Inverter_TargetPos(DB_LowPos,i_iHighLimit,i_iLowLimit,i_iLowPos,i_DeltaMoveSlowSpeed,iWindow,i_WorkSpeed,i_SlowSpeed,i_iDeltaError_Speed,TON_MotorTimeOut.PRE,iq_CM_MultiPalletsMagazine.IN_xRqLowPos,xNotUsed,xNotUsed,xNotUsed,xNotUsed,iq_DB_Encoder);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(DB_LowPos.q_xInPosition)OTE(iq_CM_MultiPalletsMagazine.OUT_xMagazineInLowPos);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[////////////////////////////////////////////////////
