<Routine Name="Cycle_Buffering" Type="RLL">
<Description>
<![CDATA[v0.1: 06/11/2025
Author: Tabacco Alessio
Carton Buffer 8492]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(BB_CRS.Manual_CmdEnable) ,XIC(EM_Infeed.xBuffering_CycleInProgress) ]OTU(EM_Infeed.xStacker_ManualCtrlEnabling);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed.xAutoCycle) ,XIC(EM_Infeed.xManualCycle) ]XIO(EM_Infeed.xSt_ImmediateStop)OTL(EM_Infeed.xBuffering_CycleInProgress);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.FirstScan) ,XIC(EM_Infeed.xBuffering_SeqReset) ]MOVE(0,EM_Infeed.iBuffering_SeqChange);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[**************************
Cycle
**************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[OPEN PRODUCTS GATE]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xBuffering_CycleInProgress)EQ(EM_Infeed.iBuffering_SeqChange,0)[XIC(IN_CRS.B9695_03) XIC(YV_Hopper.i_xSensorOFF) XIC(IN_CRS.B9685_02) [XIO(OM_CRS_HMI.ProductsOnStacker) [XIO(IN_CRS.B9684_02) XIC(EM_Infeed.xStacker_InPos1_P1Done_Home) XIC(OUT_CRS.K9682_01) XIC(OUT_CRS.K9681_01) XIC(OUT_CRS.K9690_01) OTL(EM_Infeed.xBuffering_SeqChangeIncreaseAux) ,XIC(IN_CRS.B9684_02) OTL(YV_ProductGate.iq_xRqON) ,XIO(EM_Infeed.xStacker_InPos1_P1Done_Home) MOVE(1,EM_Infeed.CM_Stacker_CRS.AxisIN_POS_iRqPos) ] ,XIC(OM_CRS_HMI.ProductsOnStacker) [LT(OM_CRS_HMI.iAct_Load_Prod,14) MOVE(10,EM_Infeed.iBuffering_SeqChange) ,GE(OM_CRS_HMI.iAct_Load_Prod,14) MOVE(30,EM_Infeed.iBuffering_SeqChange) ] ] ,XIO(IN_CRS.B9695_03) XIC(YV_Hopper.i_xSensorOFF) OTL(YV_ProductStop.iq_xRqON) ,XIO(YV_Hopper.i_xSensorOFF) OTL(YV_Hopper.iq_xRqOFF) ,XIO(IN_CRS.B9685_02) OTL(YV_Pusher.iq_xRqOFF) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[COUNT PRODUCTS]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xBuffering_CycleInProgress)EQ(EM_Infeed.iBuffering_SeqChange,10)[XIC(EM_Infeed.xStacker_InPos1_P1Done_Home) XIO(IN_CRS.B9684_02) GE(OM_CRS_HMI.iAct_Load_Prod,OM_CRS_HMI.iProd_By_Layer) [,TON(Timers_CRS.N[20],?,?) ] XIC(Timers_CRS.N[20].DN) OTL(EM_Infeed.xBuffering_SeqChangeIncreaseAux) ,XIO(EM_Infeed.xStacker_InPos1_P1Done_Home) MOVE(1,EM_Infeed.CM_Stacker_CRS.AxisIN_POS_iRqPos) ,XIC(IN_CRS.B9684_02) XIC(EM_Infeed.xBuffer_RqCycleStart) OTL(YV_ProductGate.iq_xRqON) ,XIO(EM_Infeed.xBuffer_RqCycleStart) OTL(YV_ProductGate.iq_xRqOFF) ,[XIC(IN_CRS.B9687_03) ,XIC(BB_CRS.NoLoadRun_Enable) [,LT(OM_CRS_HMI.iAct_Load_Prod,OM_CRS_HMI.iProd_By_Layer) XIO(OM_CRS_HMI.axNTrig[1]) TON(TON_CountProd_NoLoadRun,?,?) ] XIO(TON_CountProd_NoLoadRun.DN) ] OSF(OM_CRS_HMI.axNTrig[0],OM_CRS_HMI.axNTrig[1]) ,XIC(OM_CRS_HMI.axNTrig[1]) [ADD(OM_CRS_HMI.iAct_Load_Prod,1,OM_CRS_HMI.iAct_Load_Prod) ,XIO(BB_CRS.NoLoadRun_Enable) SUB(iCheckProdInfeed,1,iCheckProdInfeed) ,ADD(iTMP_Total_Batch_Prod,1,iTMP_Total_Batch_Prod) ,ADD(iTMP_Total_Cycle_Prod,1,iTMP_Total_Cycle_Prod) ,OTL(OM_Interface_CRS.xBuffer_RqCountingProductsEntered) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[STOP SIDE BELTS AND STACKER BELTS]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xBuffering_CycleInProgress)EQ(EM_Infeed.iBuffering_SeqChange,20)XIO(OUT_CRS.K9690_01)XIO(OUT_CRS.K9681_01)OTL(EM_Infeed.xBuffering_SeqChangeIncreaseAux);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[BEFFERING LAYER]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xBuffering_CycleInProgress)EQ(EM_Infeed.iBuffering_SeqChange,30)[XIC(EM_Infeed.xStacker_InPos2_P2Done) XIC(YV_Trap.i_xSensorOFF) [ONS(EM_Infeed.axPTrig[24]) OTL(OM_Interface_CRS.xInfeed_ProductOnBuffer) ,OTL(EM_Infeed.xBuffering_SeqChangeIncreaseAux) ] ,XIO(EM_Infeed.xStacker_InPos2_P2Done) MOVE(2,EM_Infeed.CM_Stacker_CRS.AxisIN_POS_iRqPos) ,XIO(YV_Trap.i_xSensorOFF) OTL(YV_Trap.iq_xRqOFF) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[STACKER GO BACK]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xBuffering_CycleInProgress)EQ(EM_Infeed.iBuffering_SeqChange,40)[XIC(EM_Infeed.xStacker_InPos1_P1Done_Home) OTL(EM_Infeed.xBuffering_SeqChangeIncreaseAux) ,XIO(EM_Infeed.xStacker_InPos1_P1Done_Home) MOVE(1,EM_Infeed.CM_Stacker_CRS.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[CHECK IF LAYERS FULL]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xBuffering_CycleInProgress)EQ(EM_Infeed.iBuffering_SeqChange,50)[XIC(OM_CRS_HMI.CRS_Full) OTL(EM_Infeed.xBuffering_SeqChangeIncreaseAux) ,XIO(OM_CRS_HMI.CRS_Full) MOVE(10,EM_Infeed.iBuffering_SeqChange) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[OPEN PRODUCTS GATE]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xBuffering_CycleInProgress)EQ(EM_Infeed.iBuffering_SeqChange,60)[XIC(IN_CRS.B9684_02) MOVE(0,EM_Infeed.iBuffering_SeqChange) ,XIO(IN_CRS.B9684_02) OTL(YV_ProductGate.iq_xRqOFF) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xBuffering_SeqChangeIncreaseAux)[XIC(IN_CRS.S9100_04) ONS(EM_Infeed.axPTrig[22]) ,XIO(BB_CRS.AlwaysOFF) ][ADD(EM_Infeed.iBuffering_SeqChange,10,EM_Infeed.iBuffering_SeqChange) ,OTU(EM_Infeed.xBuffering_SeqChangeIncreaseAux) ,OTL(BB_CRS.Machine_Moving) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[GT(EM_Infeed.iBuffering_SeqChange,70)MOVE(0,EM_Infeed.iBuffering_SeqChange);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.CM_Stacker_CRS.AxisOUT_xMoving)OTL(BB_CRS.Machine_Moving);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[OTL(xBufferingFirstCicle);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.FirstScan) ,XIC(EM_Infeed.xBuffering_SeqReset) ][MOVE(0,EM_Infeed.iBuffering_SeqChange) ,OTU(EM_Infeed.xBuffering_SeqReset) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Cycle_Bypass" Type="RLL">
<Description>
<![CDATA[v0.1: 01/15/2026
Author: Tabacco Alessio
CRS 8447]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(BB_CRS.Manual_CmdEnable)OTU(EM_Infeed.xStacker_ManualCtrlEnabling);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xAutoCycle)XIO(EM_Infeed.xSt_ImmediateStop)OTL(EM_Infeed.xBypass_CycleInProgress);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed.xSt_ImmediateStop) ,XIC(EM_Infeed.xBypass_CycleInProgress) EQ(EM_Infeed.iBypass_SeqChange,0) XIO(EM_Infeed.xAutoCycle) XIO(EM_Infeed.xManualCycle) ,EQ(EM_Infeed.iBypass_SeqChange,0) NE(EM_Infeed.iMachineState,1) ]OTU(EM_Infeed.xBypass_CycleInProgress);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(BB_CRS.FirstScan)MOVE(0,EM_Infeed.iBypass_SeqChange);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[**************************
Cycle
**************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xBypass_CycleInProgress)EQ(EM_Infeed.iBypass_SeqChange,0)[XIC(IN_CRS.B9695_03) XIC(IN_CRS.B9684_02) XIC(IN_CRS.B9685_02) XIC(YV_Trap.i_xSensorOFF) XIC(YV_Hopper.i_xSensorOFF) XIC(EM_Infeed.xStacker_InPos1_P1Done_Home) OTL(OM_Interface_CRS.xLineBeltInverterIN_xForward_Rq) XIC(BB_CRS.AlwaysOFF) OTL(EM_Infeed.xBypass_SeqChangeIncreaseAux) ,XIO(IN_CRS.B9695_03) XIC(YV_Hopper.i_xSensorOFF) OTL(YV_ProductStop.iq_xRqON) ,XIO(IN_CRS.B9684_02) OTL(YV_ProductGate.iq_xRqOFF) ,XIO(IN_CRS.B9685_02) OTL(YV_Pusher.iq_xRqOFF) ,XIO(YV_Hopper.i_xSensorOFF) OTL(YV_Hopper.iq_xRqOFF) ,XIO(OM_CRS_HMI.ProductsOnStacker) XIO(YV_Trap.i_xSensorOFF) OTL(YV_Trap.iq_xRqOFF) ,GT(OM_CRS_HMI.iAct_Load_Prod,OM_CRS_HMI.iProd_By_Layer) XIO(YV_Trap.i_xSensorON) OTL(YV_Trap.iq_xRqON) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xBypass_SeqChangeIncreaseAux)[XIC(IN_CRS.S9100_04) ONS(EM_Infeed.axPTrig[26]) ,XIO(BB_CRS.AlwaysOFF) ][ADD(EM_Infeed.iBypass_SeqChange,10,EM_Infeed.iBypass_SeqChange) ,OTU(EM_Infeed.xBypass_SeqChangeIncreaseAux) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[GT(EM_Infeed.iBypass_SeqChange,0)MOVE(0,EM_Infeed.iBypass_SeqChange);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Cycle_Debuffering" Type="RLL">
<Description>
<![CDATA[v0.1: 06/11/2025
Author: Tabacco Alessio
Carton Buffer 8492]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(BB_CRS.Manual_CmdEnable) ,XIC(EM_Infeed.xDebuffing_CycleInProgress) ]OTU(EM_Infeed.xStacker_ManualCtrlEnabling);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed.xAutoCycle) ,XIC(EM_Infeed.xManualCycle) ]XIO(EM_Infeed.xSt_ImmediateStop)OTL(EM_Infeed.xDebuffing_CycleInProgress);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.FirstScan) ,XIC(EM_Infeed.xDebuffering_SeqReset) ]MOVE(0,EM_Infeed.xDebuffering_SeqChange);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[**************************
Cycle
**************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[STOP LINE PRODUCTS]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffing_CycleInProgress)EQ(EM_Infeed.xDebuffering_SeqChange,0)[XIO(OM_CRS_HMI.ProductsOnStacker) [XIC(IN_CRS.B9684_02) XIC(IN_CRS.B9685_02) XIC(YV_Hopper.i_xSensorOFF) OTL(EM_Infeed.xDebuffering_SeqChangeIncreaseAux) ,XIO(IN_CRS.B9684_02) OTL(YV_ProductGate.iq_xRqOFF) ,XIO(IN_CRS.B9685_02) OTL(YV_Pusher.iq_xRqOFF) ,XIO(YV_Hopper.i_xSensorOFF) OTL(YV_Hopper.iq_xRqOFF) ] ,XIC(OM_CRS_HMI.ProductsOnStacker) [XIC(IN_CRS.B9684_02) MOVE(30,EM_Infeed.xDebuffering_SeqChange) ,XIO(IN_CRS.B9684_02) OTL(YV_ProductGate.iq_xRqOFF) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[STACKER INTERCEPTS THE PRODUCTS]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffing_CycleInProgress)EQ(EM_Infeed.xDebuffering_SeqChange,10)[[XIC(EM_Infeed.xStacker_InPos3_P3Done) ,XIC(OM_CRS_HMI.ProductsOnStacker) LT(OM_CRS_HMI.iAct_Load_Prod,14) ] OTL(EM_Infeed.xDebuffering_SeqChangeIncreaseAux) ,XIO(EM_Infeed.xStacker_InPos3_P3Done) [XIO(OM_CRS_HMI.ProductsOnStacker) ,GE(OM_CRS_HMI.iAct_Load_Prod,14) ] MOVE(3,EM_Infeed.CM_Stacker_CRS.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[OPEN TRAPS ]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffing_CycleInProgress)EQ(EM_Infeed.xDebuffering_SeqChange,20)[[XIC(EM_Infeed.xStacker_InPos3_P3Done) ,XIC(OM_CRS_HMI.ProductsOnStacker) LT(OM_CRS_HMI.iAct_Load_Prod,14) ] XIC(YV_Trap.i_xSensorON) [CPT(OM_CRS_HMI.iAct_Load_Prod,OM_CRS_HMI.iProd_By_Layer*OM_CRS_HMI.iAct_Load_Layer) ,MOVE(0,OM_CRS_HMI.iAct_Load_Layer) ,OTL(EM_Infeed.xDebuffering_SeqChangeIncreaseAux) ] ,XIO(YV_Trap.i_xSensorON) OTL(YV_Trap.iq_xRqON) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[STACKER GO TO DEBUFFERING POS]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffing_CycleInProgress)EQ(EM_Infeed.xDebuffering_SeqChange,30)[[XIC(EM_Infeed.xStacker_InPos4_P4Done) ,XIC(OM_CRS_HMI.ProductsOnStacker) LT(OM_CRS_HMI.iAct_Load_Prod,14) ] OTL(EM_Infeed.xDebuffering_SeqChangeIncreaseAux) ,XIO(EM_Infeed.xStacker_InPos4_P4Done) [XIO(OM_CRS_HMI.ProductsOnStacker) ,GE(OM_CRS_HMI.iAct_Load_Prod,14) ] MOVE(4,EM_Infeed.CM_Stacker_CRS.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(IN_CRS.B9680_01)XIO(IN_CRS.B9680_02)TON(Timers_CRS.N[60],?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[WAIT GAP]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffing_CycleInProgress)EQ(EM_Infeed.xDebuffering_SeqChange,40)[XIC(YV_Hopper.i_xSensorON) XIO(IN_CRS.B9695_03) XIC(EM_Infeed.xStacker_InPos4_P4Done) OTL(EM_Infeed.xDebuffering_SeqChangeIncreaseAux) ,XIO(YV_Hopper.i_xSensorON) XIC(IN_CRS.B9681_01) OTL(YV_Hopper.iq_xRqON) ,XIO(YV_ProductStop.iq_xRqOFF) XIC(Timers_CRS.N[60].DN) OTL(YV_ProductStop.iq_xRqOFF) ,XIO(EM_Infeed.xStacker_InPos4_P4Done) XIC(Timers_CRS.N[60].DN) MOVE(4,EM_Infeed.CM_Stacker_CRS.AxisIN_POS_iRqPos) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[PRODUCTS OUT OF BUFFER]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffing_CycleInProgress)EQ(EM_Infeed.xDebuffering_SeqChange,50)[XIC(IN_CRS.B9685_01) [ONS(EM_Infeed.axPTrig[25]) OTL(OM_Interface_CRS.xShift_RqClearPos1) ,OTL(EM_Infeed.xDebuffering_SeqChangeIncreaseAux) ] ,XIO(IN_CRS.B9685_01) XIC(EM_Infeed.xStacker_InPos4_P4Done) XIC(IN_CRS.B9681_01) OTL(YV_Pusher.iq_xRqON) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[MOVE(SizeWork_CRS.Outfeed.LineMaxLoad_OFF_forDebuffering,EM_Infeed.TON_ExitMaxLoadForDebuffering.PRE);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[PRODUCT OUT OF INFEED]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffing_CycleInProgress)EQ(EM_Infeed.xDebuffering_SeqChange,60)[XIC(EM_Infeed.TON_ExitMaxLoadForDebuffering.DN) OTL(EM_Infeed.xDebuffering_SeqChangeIncreaseAux) ,XIC(IN_CRS.B9681_01) TON(EM_Infeed.TON_ExitMaxLoadForDebuffering,?,?) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[PUSHER GO BACK]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffing_CycleInProgress)EQ(EM_Infeed.xDebuffering_SeqChange,70)[XIC(IN_CRS.B9685_02) OTL(EM_Infeed.xDebuffering_SeqChangeIncreaseAux) ,XIO(IN_CRS.B9685_02) OTL(YV_Pusher.iq_xRqOFF) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[CHECK IF LAYERS EMPTY]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffing_CycleInProgress)EQ(EM_Infeed.xDebuffering_SeqChange,80)[XIC(OM_CRS_HMI.CRS_Empty) MOVE(40,EM_Infeed.xDebuffering_SeqChange) ,XIO(OM_CRS_HMI.CRS_Empty) [XIC(OM_CRS_HMI.ProductsOnStacker) MOVE(30,EM_Infeed.xDebuffering_SeqChange) ,XIO(OM_CRS_HMI.ProductsOnStacker) MOVE(0,EM_Infeed.xDebuffering_SeqChange) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xDebuffering_SeqChangeIncreaseAux)[XIC(IN_CRS.S9100_04) ONS(EM_Infeed.axPTrig[23]) ,XIO(BB_CRS.AlwaysOFF) ][ADD(EM_Infeed.xDebuffering_SeqChange,10,EM_Infeed.xDebuffering_SeqChange) ,OTU(EM_Infeed.xDebuffering_SeqChangeIncreaseAux) ,OTL(BB_CRS.Machine_Moving) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[GT(EM_Infeed.xDebuffering_SeqChange,90)MOVE(0,EM_Infeed.xDebuffering_SeqChange);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.CM_Stacker_CRS.AxisOUT_xMoving)OTL(BB_CRS.Machine_Moving);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[LT(OM_CRS_HMI.iAct_Load_Prod,0)MOVE(0,OM_CRS_HMI.iAct_Load_Prod);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[OTL(xDebufferingFirstCicle);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.FirstScan) ,XIC(EM_Infeed.xDebuffering_SeqReset) ][MOVE(0,EM_Infeed.xDebuffering_SeqChange) ,OTU(EM_Infeed.xDebuffering_SeqReset) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Cycle_Infeed" Type="RLL">
<Description>
<![CDATA[v0.1: 06/11/2025
Author: Tabacco Alessio
Carton Buffer 8492]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(BB_CRS.Manual_CmdEnable) ,XIC(EM_Infeed.xCycleInProgress) ]OTU(EM_Infeed.xStacker_ManualCtrlEnabling);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed.xAutoCycle) ,XIC(EM_Infeed.xManualCycle) ]XIO(EM_Infeed.xSt_ImmediateStop)OTL(EM_Infeed.xCycleInProgress);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed.xSt_ImmediateStop) ,XIO(EM_Infeed.xAutoCycle) ][OTU(EM_Infeed.xCycleInProgress) ,OTL(EM_Infeed.xSeqReset) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xSeqReset)[MOVE(0,EM_Infeed.iSeqChange) ,OTU(EM_Infeed.xSeqReset) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(BB_CRS.Machine_Ready)MOVE(0,EM_Infeed.iBypass_SeqChange)MOVE(0,EM_Infeed.iBuffering_SeqChange)MOVE(0,EM_Infeed.xDebuffering_SeqChange);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[PRODOTTO CORRETTAMENTE ARRIVATO SULLO STACKER]]>
</Comment>
<Text>
<![CDATA[[[EQ(EM_Infeed.iBuffering_SeqChange,10) [XIO(Timers_CRS.N[19].DN) ,NE(iCheckProdInfeed,0) TOF(Timers_CRS.N[19],?,?) ] ,NE(EM_Infeed.iBuffering_SeqChange,10) ] OTL(xBuffering_ProdottoInTramoggia) ,NE(iCheckProdInfeed,0) OTU(xBuffering_ProdottoInTramoggia) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(IN_CRS.B9691_02)TON(Timers_CRS.N[16],?,?);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[CONTEGGIO PRODOTTI IN INGRESSO
controllo che tutti i prodotti reintrodotti arrivino in tramoggia]]>
</Comment>
<Text>
<![CDATA[EQ(EM_Infeed.iMachineState,2)XIC(Timers_CRS.N[16].DN)ONS(EM_Infeed.axPTrig[29])ADD(iCheckProdInfeed,1,iCheckProdInfeed);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[LT(iCheckProdInfeed,0) ,XIC(ALRM_CRS[20]) XIC(IN_CRS.B9405_01) ][OTE(ALRM_CRS[20]) ,OTL(BB_CRS.Rq_EmergencyPhaseStop) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[INFEED PRODUCTS JAM
almeno un prodotto reitrodotto non ha raggiunto il sensore di conteggio entro il tempo limite]]>
</Comment>
<Text>
<![CDATA[[EQ(EM_Infeed.iMachineState,2) GT(iCheckProdInfeed,0) [,XIC(IN_CRS.B9691_02) [TOF(Timers_CRS.N[18],?,?) ,TON(Timers_CRS.N[4],?,?) ] ] XIC(BB_CRS.Automatic_CycleActive) [XIO(Timers_CRS.N[18].DN) ,XIC(Timers_CRS.N[4].DN) ] ,XIC(ALRM_CRS[22]) NE(iCheckProdInfeed,0) ][OTE(ALRM_CRS[22]) ,OTL(BB_CRS.Rq_EmergencyPhaseStop) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[[XIC(ALRM_CRS[20]) ,XIC(ALRM_CRS[22]) ,XIO(IN_CRS.B9405_01) ] ,XIO(BB_CRS.AlwaysOFF) LT(iCheckProdInfeed,0) ]XIO(IN_CRS.B9405_01)MOVE(0,iCheckProdInfeed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[**************************
Cycle
**************************]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Machine state manager]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)EQ(EM_Infeed.iSeqChange,0)[EQ(EM_Infeed.iMachineState,1) [MOVE(0,EM_Infeed.iBuffering_SeqChange) MOVE(0,EM_Infeed.xDebuffering_SeqChange) ,MOVE(10,EM_Infeed.iSeqChange) ] ,EQ(EM_Infeed.iMachineState,2) [MOVE(0,EM_Infeed.iBypass_SeqChange) MOVE(0,EM_Infeed.xDebuffering_SeqChange) ,MOVE(30,EM_Infeed.iSeqChange) ] ,EQ(EM_Infeed.iMachineState,3) [MOVE(0,EM_Infeed.iBypass_SeqChange) MOVE(0,EM_Infeed.iBuffering_SeqChange) ,MOVE(100,EM_Infeed.iSeqChange) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[BYPASS (1)]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)EQ(EM_Infeed.iSeqChange,10)[JSR(Cycle_Bypass,0) ,XIC(EM_Infeed.xCycle_Bypass_StopEnable) NE(EM_Infeed.iMachineState,1) MOVE(0,EM_Infeed.iSeqChange) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[BUFFERING (2)]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)EQ(EM_Infeed.iSeqChange,30)GT(Core_HMI_CRS.Interface.iPasswordState,1)[XIC(EM_Infeed.xCycle_Debuffing_StopEnable) JSR(Cycle_Buffering,0) ,XIC(EM_Infeed.xCycle_Buffering_StopEnable) NE(EM_Infeed.iMachineState,2) MOVE(0,EM_Infeed.iSeqChange) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed.xSt_ImmediateStop) ,XIC(EM_Infeed.xBuffering_CycleInProgress) EQ(EM_Infeed.iBuffering_SeqChange,0) XIO(EM_Infeed.xAutoCycle) XIO(EM_Infeed.xManualCycle) ,EQ(EM_Infeed.iBuffering_SeqChange,0) NE(EM_Infeed.iMachineState,2) ]OTU(EM_Infeed.xBuffering_CycleInProgress);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[DEBUFFING (3)]]>
</Comment>
<Text>
<![CDATA[XIC(EM_Infeed.xCycleInProgress)EQ(EM_Infeed.iSeqChange,100)[XIC(EM_Infeed.xCycle_Buffering_StopEnable) JSR(Cycle_Debuffering,0) ,XIC(EM_Infeed.xCycle_Debuffing_StopEnable) NE(EM_Infeed.iMachineState,3) MOVE(0,EM_Infeed.iSeqChange) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(EM_Infeed.xSt_ImmediateStop) ,XIC(EM_Infeed.xDebuffing_CycleInProgress) EQ(EM_Infeed.xDebuffering_SeqChange,0) XIO(EM_Infeed.xAutoCycle) XIO(EM_Infeed.xManualCycle) ,EQ(EM_Infeed.xDebuffering_SeqChange,0) NE(EM_Infeed.iMachineState,3) ]OTU(EM_Infeed.xDebuffing_CycleInProgress);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xSeqChangeIncreaseAux)[ADD(EM_Infeed.iSeqChange,10,EM_Infeed.iSeqChange) ,OTU(EM_Infeed.xSeqChangeIncreaseAux) ,OTL(BB_CRS.Machine_Moving) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[NE(EM_Infeed.iSeqChange,10)OTU(EM_Infeed.xBypass_CycleInProgress);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[NE(EM_Infeed.iSeqChange,30)OTU(EM_Infeed.xBuffering_CycleInProgress);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[NE(EM_Infeed.iSeqChange,100)OTU(EM_Infeed.xDebuffing_CycleInProgress);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[MOVE(EM_Infeed.xDebuffering_SeqChange,OM_Interface_CRS.Infeed_iDebuffering_SeqChange);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Layering_Management" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[CPT(OM_CRS_HMI.iProd_By_Layer,SYS_CRS.N[15]/(SizeWork_CRS.General.ProductLength/10));]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[CPT(OM_CRS_HMI.iNumber_of_Layer,SYS_CRS.N[16]/(SizeWork_CRS.General.ProductHeight/10));]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[GE(OM_CRS_HMI.iAct_Load_Layer,OM_CRS_HMI.iNumber_of_Layer)CMP(OM_CRS_HMI.iAct_Load_Prod+iCheckProdInfeed=OM_CRS_HMI.iProd_By_Layer)OTE(OM_CRS_HMI.CRS_Full);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQ(OM_CRS_HMI.iAct_Load_Layer,0)EQ(OM_CRS_HMI.iAct_Load_Prod,0)OTE(OM_CRS_HMI.CRS_Empty);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[NE(OM_CRS_HMI.iAct_Load_Prod,0)OTE(OM_CRS_HMI.ProductsOnStacker);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[####### RESET COUNT ####### ]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.AlwaysOFF) XIC(BB_CRS.FirstScan) ,XIO(BB_CRS.SetSize) ,XIO(EM_Infeed_HMI_PB_CRS.St_xJog_Stacker_Enable) ONS(EM_Infeed.axPTrig[0]) ,XIO(BB_CRS.NoLoadRun_Enable) ONS(EM_Infeed.axPTrig[3]) ,XIC(Axis_Stacker.q_AxisFault) ,XIO(IN_CRS.B9688_04) ]OTL(OM_Interface_CRS.Infeed_xStackerLayerResetRq);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(OM_Interface_CRS.Infeed_xStackerLayerResetRq)XIO(EM_Infeed_HMI_PB_CRS.St_xJog_Stacker_Enable)[OTL(MSG_CRS[16]) ,OTL(BB_CRS.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(OM_CRS_HMI.Rq_xStackerLayerReset_Confirm)[OTL(UM_HMI_CRS.MachineWorkData.Rq_xConfirmReset) ,OTL(UM_HMI_CRS.MachineWorkData.Rq_xResetRows) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(OM_CRS_HMI.Rq_xStackerLayerReset_Cancel)OTE(UM_HMI_CRS.MachineWorkData.Rq_xCancelReset);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[F_ResetCounter_CRS(DB_ResetRows,BB_CRS.Automatic_CycleActive,UM_HMI_CRS.MachineWorkData.Rq_xResetRows,UM_HMI_CRS.MachineWorkData.Rq_xConfirmReset,UM_HMI_CRS.MachineWorkData.Rq_xCancelReset,Core_HMI_CRS.Interface.iPageDisplayed,638,Core_HMI_CRS.Interface.iPageToDisplay,Core_HMI_CRS.Interface.xTextPanel,MSG_CRS[12],BB_CRS.Movement_InhibitionRq,EM_Infeed.xRq_ManualResetRowsPerBundle);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xRq_ManualResetRowsPerBundle)ONS(EM_Infeed.axPTrig[20])[MOVE(0,OM_CRS_HMI.iAct_Load_Layer) ,OTU(OM_Interface_CRS.Infeed_xStackerLayerResetRq) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(BB_CRS.AlwaysOFF) XIC(BB_CRS.FirstScan) ,XIO(BB_CRS.SetSize) ,[XIC(EM_Infeed_HMI_PB_CRS.St_xManual_Hopper_ON) ,XIC(EM_Infeed_HMI_PB_CRS.St_xManual_Hopper_OFF) ] ONS(EM_Infeed.axPTrig[2]) ,XIO(EM_Infeed_HMI_PB_CRS.St_xJog_Stacker_Enable) ONS(EM_Infeed.axPTrig[4]) ,XIO(BB_CRS.NoLoadRun_Enable) ONS(EM_Infeed.axPTrig[5]) ,XIC(Axis_Stacker.q_AxisFault) ,XIO(IN_CRS.B9688_04) ]OTL(OM_Interface_CRS.Infeed_xStackerProdResetRq);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(OM_Interface_CRS.Infeed_xStackerProdResetRq)XIO(BB_CRS.Manual_CmdEnable)[OTL(MSG_CRS[17]) ,OTL(BB_CRS.Movement_InhibitionRq) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(OM_CRS_HMI.Rq_xStackerProdReset_Confirm)[OTL(UM_HMI_CRS.MachineWorkData.Rq_xConfirmReset) ,OTL(UM_HMI_CRS.MachineWorkData.Rq_xResetActualProductNumber) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(OM_CRS_HMI.Rq_xStackerProdReset_Cancel)OTE(UM_HMI_CRS.MachineWorkData.Rq_xCancelReset);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[F_ResetCounter_CRS(DB_ResetPrdPerRow,BB_CRS.Automatic_CycleActive,UM_HMI_CRS.MachineWorkData.Rq_xResetActualProductNumber,UM_HMI_CRS.MachineWorkData.Rq_xConfirmReset,UM_HMI_CRS.MachineWorkData.Rq_xCancelReset,Core_HMI_CRS.Interface.iPageDisplayed,7,Core_HMI_CRS.Interface.iPageToDisplay,Core_HMI_CRS.Interface.xTextPanel,MSG_CRS[12],BB_CRS.Movement_InhibitionRq,EM_Infeed.xRq_ManualResetPrdPerRow);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xRq_ManualResetPrdPerRow)ONS(EM_Infeed.axPTrig[21])[MOVE(0,OM_CRS_HMI.iAct_Load_Prod) ,OTU(OM_Interface_CRS.Infeed_xStackerProdResetRq) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[*************** Drawer 1 Full *****************]]>
</Comment>
<Text>
<![CDATA[XIC(OM_Interface_CRS.xInfeed_ProductOnBuffer)[CPT(OM_CRS_HMI.iAct_Load_Layer,OM_CRS_HMI.iAct_Load_Layer+(OM_CRS_HMI.iAct_Load_Prod/OM_CRS_HMI.iProd_By_Layer)) ,MOVE(0,OM_CRS_HMI.iAct_Load_Prod) ,OTU(OM_Interface_CRS.xInfeed_ProductOnBuffer) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(OM_Interface_CRS.xShift_RqClearPos1)[MOVE(OM_CRS_HMI.iAct_Load_Prod,iProductsPushedOnBeltDuringLastPush) ,OTL(OM_Interface_CRS.xBuffer_RqCountingProductsReworked) ,SUB(OM_CRS_HMI.iAct_Load_Prod,OM_CRS_HMI.iProd_By_Layer,OM_CRS_HMI.iAct_Load_Prod) ,OTU(OM_Interface_CRS.xShift_RqClearPos1) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[MOVE(OM_CRS_HMI.iAct_Load_Prod,OM_CRS_HMI.iAct_Load_Prod_For_HMI) ,GT(OM_CRS_HMI.iAct_Load_Prod_For_HMI,OM_CRS_HMI.iProd_By_Layer) MOVE(OM_CRS_HMI.iProd_By_Layer,OM_CRS_HMI.iAct_Load_Prod_For_HMI) ,CPT(OM_CRS_HMI.iAct_Load_Layer_For_HMI,OM_CRS_HMI.iAct_Load_Prod/OM_CRS_HMI.iProd_By_Layer+OM_CRS_HMI.iAct_Load_Layer) ,GT(OM_CRS_HMI.iAct_Load_Layer_For_HMI,OM_CRS_HMI.iNumber_of_Layer) MOVE(OM_CRS_HMI.iNumber_of_Layer,OM_CRS_HMI.iAct_Load_Layer_For_HMI) ,LT(OM_CRS_HMI.iAct_Load_Prod,OM_CRS_HMI.iProd_By_Layer) MOVE(OM_CRS_HMI.iAct_Load_Layer,OM_CRS_HMI.iAct_Load_Layer_For_HMI) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(EM_Infeed.xBuffer_RqCycleStart)MOVE(iTMP_Total_Cycle_Prod,OM_CRS_HMI.iTotal_Cycle_Prod);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIO(EM_Infeed.xBuffer_RqCycleStart)MOVE(0,iTMP_Total_Cycle_Prod);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(Core_HMI_CRS.PB.St_xBatch_StartEnabling)MOVE(iTMP_Total_Batch_Prod,OM_CRS_HMI.iTotal_Batch_Prod);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIO(Core_HMI_CRS.PB.St_xBatch_StopEnabling)MOVE(0,iTMP_Total_Batch_Prod);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
