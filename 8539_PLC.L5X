<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Clear Jog Enable]]>
</Comment>
<Text>
<![CDATA[[XIC(iq_BB.Automatic_CycleActive) ,XIO(iq_BB.SetSize) ,XIC(iq_BB.SizeDisplay_ChangePagePulse) ][OTU(iq_Hmi_xStJogEnable) ,OTU(iq_Hmi_xStJogWithoutEnableMan) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[/////////////////////////
//JOG ENABLE
////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[MSG: Manual Functions Off]]>
</Comment>
<Text>
<![CDATA[XIC(iq_Hmi_xRqJogEnable)XIO(iq_Hmi_xStJogWithoutEnableMan)XIO(iq_BB.Manual_CmdEnable)[OTL(iq_Msg_ManualFunctionOFF) ,OTU(iq_Hmi_xRqJogEnable) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Jog Enable]]>
</Comment>
<Text>
<![CDATA[[XIC(iq_Hmi_xRqJogEnable) XIC(iq_Hmi_xStJogEnable) ,XIO(iq_BB.Manual_CmdEnable) XIO(iq_Hmi_xStJogWithoutEnableMan) ][OTU(iq_Hmi_xStJogEnable) ,OTU(iq_Hmi_xRqJogEnable) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Jog Enable]]>
</Comment>
<Text>
<![CDATA[[XIC(iq_Hmi_xRqJogEnable) XIO(iq_Hmi_xStJogEnable) [OTL(iq_Hmi_xStJogEnable) ,OTU(iq_Hmi_xRqJogEnable) ] ,XIC(iq_Hmi_xStJogEnable) OTL(iq_BB.Safe_RqFixedOrangeLamp) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Jog Enable]]>
</Comment>
<Text>
<![CDATA[[XIC(iq_Hmi_xStJogEnable) ,XIC(iq_Hmi_xStJogWithoutEnableMan) ]OTE(xActivatedJog);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[/////////////////////////
//JOG DIRECTION
////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[MSG: Jog Not Active]]>
</Comment>
<Text>
<![CDATA[NE(iq_Hmi_iRqJogDirection,0)XIO(xActivatedJog)OTL(iq_Msg_JogNotActive);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(xActivatedJog)[MOVE(0,iq_Hmi_iRqJogDirection) ,ONS(PulseFP[0]) OTL(iq_xRqAbort) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Jog Direction]]>
</Comment>
<Text>
<![CDATA[MOVE(iq_Hmi_iRqJogDirection,iq_Hmi_iStJogDirection);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Jog Direction]]>
</Comment>
<Text>
<![CDATA[NE(iq_Hmi_iStJogDirection,0)OTE(xActivatedDirection);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[MSG: Jog Direction Not Active]]>
</Comment>
<Text>
<![CDATA[XIC(i_xButton_Jog)XIC(xActivatedJog)XIO(xActivatedDirection)OTL(iq_Msg_SelJogRobotDirection);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[/////////////////////////
//JOG TO ROBOT
////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[RqJogEnable]]>
</Comment>
<Text>
<![CDATA[XIC(xActivatedJog)XIC(xActivatedDirection)XIO(iq_RbtDI.x12)OTE(q_xDI_JogEnable);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[RqAbort]]>
</Comment>
<Text>
<![CDATA[XIC(i_xButton_Jog)XIC(xActivatedJog)XIC(xActivatedDirection)XIO(iq_RbtDI.x12)XIO(iq_RbtDI.x26)[XIC(iq_RbtDO.x03) ,XIC(iq_RbtDO.x04) ]OTL(iq_xRqAbort);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[RqMacro]]>
</Comment>
<Text>
<![CDATA[XIC(i_xButton_Jog)XIC(xActivatedJog)XIC(xActivatedDirection)XIO(iq_RbtDI.x12)[XIO(iq_RbtDO.x03) XIO(iq_RbtDO.x04) ,XIC(iq_RbtDI.x26) ][OTE(iq_RbtDI.x26) ,OTE(q_xDI_MacroJog) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[RqDirection]]>
</Comment>
<Text>
<![CDATA[XIO(iq_RbtDI.x12)MOVE(iq_Hmi_iStJogDirection,iq_RbtGI.i06);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[RqSpeed]]>
</Comment>
<Text>
<![CDATA[XIO(iq_RbtDI.x12)LIMIT(1,iq_Hmi_iRqJogSpeed,100)MOVE(iq_Hmi_iRqJogSpeed,iq_RbtGI.i11);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[/////////////////////////
//POSITIONS FROM ROBOT
////////////////////////]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Positions from Robot to Hmi]]>
</Comment>
<Text>
<![CDATA[XIO(iq_RbtDI.x12)[MOVE(iq_RbtGO.i15,q_Hmi_iAxisPosition_X) ,MOVE(iq_RbtGO.i16,q_Hmi_iAxisPosition_Y) ,MOVE(iq_RbtGO.i17,q_Hmi_iAxisPosition_Z) ,MOVE(iq_RbtGO.i18,q_Hmi_iAxisPosition_W) ,MOVE(iq_RbtGO.i19,q_Hmi_iAxisPosition_P) ,MOVE(iq_RbtGO.i20,q_Hmi_iAxisPosition_R) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
