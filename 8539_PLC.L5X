<Routine Name="Config" Type="ST">
<Description>
<![CDATA[v01: 06/09/2021
Author :Utili Nicola
Comment: Startup from Hywrap base TIA15.1-BaseCPH2 Studio5000]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// da EM_Outfeed TIA17 V63]]>
</Line>
<Line Number="1">
<![CDATA[//Hardware configuration]]>
</Line>
<Line Number="2">
<![CDATA[UM_Config.CP.ZONE3_WITH_STOP := 1;]]>
</Line>
<Line Number="3">
<![CDATA[UM_Config.CP.ZONE4_WITH_STOP := 1;]]>
</Line>
<Line Number="4">
<![CDATA[UM_Config.CP.ZONE5_WITH_STOP := 0;]]>
</Line>
<Line Number="5">
<![CDATA[//Option]]>
</Line>
<Line Number="6">
<![CDATA[UM_Config.CP.OpenFlapsCheck := 1;]]>
</Line>
<Line Number="7">
<![CDATA[UM_Config.CP.EnableTilter_DoubleSide := 0;]]>
</Line>
<Line Number="8">
<![CDATA[UM_Config.CP.EnableLabeller := 1;]]>
</Line>
<Line Number="9">
<![CDATA[UM_Config.CP.ZoneCheckLabel := 0;]]>
</Line>
<Line Number="10">
<![CDATA[UM_Config.CP.Zone3_DoubleStopForLabeller := 0;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[UM_Config.CP.EnableOutfeed_LabellerPhoenix := 1;]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[UM_Config.CP.EnableOutfeed_ControlledBelt1 := 0;]]>
