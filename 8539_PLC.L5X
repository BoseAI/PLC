<Text>
<![CDATA[XIC(EM_PAL_Infeed.xPos4_CycleInProgress)EQ(EM_PAL_Infeed.iPos4_SeqChange,6)[XIO(BB.NoLoadRun_Enable) XIC(EM_PAL_Infeed.TON_NoPresenceCaseForStopCycle_Pos4.DN) XIO(OM_Interface.Pal_xRobotInterferenceInfeed) XIC(OM_Interface.Pal_xEnableReturnOvertuning) ,XIC(BB.NoLoadRun_Enable) XIO(OM_Interface.Pal_xProdRdy) XIO(OM_Interface.Pal_xRobotInterferenceInfeed) XIC(OM_Interface.Pal_xEnableReturnOvertuning) ,XIC(BB.NoLoadRun_Enable) XIC(OM_Interface.Pal_xDisableRobot) ,XIO(OM_Interface.Outfeed_xPos4CasePresence) XIC(OM_Interface.Pal_xRobot_HomingDone) ]MOVE(0,EM_PAL_Infeed.iPos4_SeqChange);]]>
