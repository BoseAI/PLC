</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[//*************************************************************************************************************************]]>
</Line>
<Line Number="1">
<![CDATA[//Description]]>
</Line>
<Line Number="2">
<![CDATA[//This AOI is used with default ADI map]]>
</Line>
<Line Number="3">
<![CDATA[//Input : 	Word 0-3 : ADI 10(General Status), Word 4-7 : ADI 100(Pump Status), Word 8-11 :ADI 10000(Temperature Status]]>
</Line>
<Line Number="4">
<![CDATA[//			Word 12-15 : ADI 13000(Fill System Status)]]>
</Line>
<Line Number="5">
<![CDATA[//Output :  Word 0-3 : ADI 11(General Control), Word 4-7 : ADI 101(Pump Control), Word 8-11 : ADI 10001(Temperature Control]]>
</Line>
<Line Number="6">
<![CDATA[//			Word 12-15 : ADI 13001(Fill System Control)]]>
</Line>
<Line Number="7">
<![CDATA[//**************************************************************************************************************************]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[//******************************************************************************************************************]]>
</Line>
<Line Number="10">
<![CDATA[//Reading Section]]>
</Line>
<Line Number="11">
<![CDATA[//******************************************************************************************************************]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[Melter_HMI.b_r_SystemReady := IO_Input[0].0;]]>
</Line>
<Line Number="14">
<![CDATA[Melter_HMI.b_r_Fault := IO_Input[0].1;]]>
</Line>
<Line Number="15">
<![CDATA[Melter_HMI.b_r_Alert := IO_Input[0].2;]]>
</Line>
<Line Number="16">
<![CDATA[Melter_HMI.b_r_Stop := IO_Input[0].3;]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[Melter_HMI.b_r_HeatersOn := IO_Input[8].0;]]>
</Line>
<Line Number="19">
<![CDATA[Melter_HMI.b_r_StandbyOn := IO_Input[8].1;]]>
</Line>
<Line Number="20">
<![CDATA[Melter_HMI.b_r_TemperatureAlert := IO_Input[8].2;]]>
</Line>
<Line Number="21">
<![CDATA[Melter_HMI.b_r_TemperatureFault := IO_Input[8].3;]]>
</Line>
<Line Number="22">
<![CDATA[Melter_HMI.b_r_TemperatureReady := IO_Input[8].4;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[Melter_HMI.b_r_TankLevelEmpty := IO_Input[12].0;]]>
</Line>
<Line Number="25">
<![CDATA[Melter_HMI.b_r_TankLevelLow := IO_Input[12].1;]]>
</Line>
<Line Number="26">
<![CDATA[Melter_HMI.b_r_FillSysAlert := IO_Input[12].2;]]>
</Line>
<Line Number="27">
<![CDATA[Melter_HMI.b_r_FillSysFault := IO_Input[12].3;]]>
</Line>
<Line Number="28">
<![CDATA[Melter_HMI.b_r_Filling := IO_Input[12].4;]]>
</Line>
<Line Number="29">
<![CDATA[Melter_HMI.b_r_LidOpen := IO_Input[12].5;]]>
</Line>
<Line Number="30">
<![CDATA[Melter_HMI.b_r_PumpEnabled := IO_Input[4].1;]]>
</Line>
<Line Number="31">
<![CDATA[Melter_HMI.b_r_PumpRunning := IO_Input[4].2;]]>
</Line>
<Line Number="32">
<![CDATA[Melter_HMI.b_r_Purging := IO_Input[4].3;]]>
</Line>
<Line Number="33">
<![CDATA[Melter_HMI.b_r_EmptyCalibrated := IO_Input[12].6;]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[tm_Command.PRE :=500;]]>
</Line>
<Line Number="36">
<![CDATA[tm_Command.TimerEnable := Melter_HMI.b_w_ClearAlertFault OR Melter_HMI.b_w_CalibrateEmpty ;]]>
</Line>
<Line Number="37">
<![CDATA[TONR(tm_Command);]]>
</Line>
<Line Number="38">
<![CDATA[IF tm_Command.DN and b_CommandRising THEN]]>
</Line>
<Line Number="39">
<![CDATA[	Melter_HMI.b_w_CalibrateEmpty :=0;]]>
</Line>
<Line Number="40">
<![CDATA[	Melter_HMI.b_w_ClearAlertFault :=0;]]>
</Line>
<Line Number="41">
<![CDATA[END_IF;]]>
</Line>
<Line Number="42">
<![CDATA[b_CommandRising := NOT tm_Command.DN;]]>
</Line>
<Line Number="43">
<![CDATA[IO_Output[12].0 := Melter_HMI.b_w_ManualFill;]]>
</Line>
<Line Number="44">
<![CDATA[IO_Output[4].3 := Melter_HMI.b_w_Purge;]]>
</Line>
<Line Number="45">
<![CDATA[IO_Output[12].2 := Melter_HMI.b_w_CalibrateEmpty;]]>
</Line>
<Line Number="46">
<![CDATA[//Clear alert fault]]>
</Line>
<Line Number="47">
<![CDATA[IO_Output[0].0 := Melter_HMI.b_w_ClearAlertFault;]]>
</Line>
<Line Number="48">
<![CDATA[//******************************************************************************************************************]]>
</Line>
<Line Number="49">
<![CDATA[//Writing Section]]>
</Line>
<Line Number="50">
<![CDATA[//******************************************************************************************************************]]>
</Line>
<Line Number="51">
<![CDATA[//***********************************************************************************************************]]>
</Line>
<Line Number="52">
<![CDATA[// Heater On Control Bit Logic]]>
</Line>
<Line Number="53">
<![CDATA[//***********************************************************************************************************]]>
</Line>
<Line Number="54">
<![CDATA[//**************************************]]>
</Line>
<Line Number="55">
<![CDATA[//Prevent turnoff heater when comm lost ]]>
</Line>
<Line Number="56">
<![CDATA[//**************************************]]>
</Line>
<Line Number="57">
<![CDATA[tm_HeaterOff.PRE :=200;]]>
</Line>
<Line Number="58">
<![CDATA[tm_HeaterOff.TimerEnable := NOT Melter_HMI.b_r_HeatersOn ;]]>
</Line>
<Line Number="59">
<![CDATA[TONR(tm_HeaterOff);]]>
</Line>
<Line Number="60">
<![CDATA[b_HeaterOff := tm_HeaterOff.DN;]]>
</Line>
<Line Number="61">
<![CDATA[//**************************************]]>
</Line>
<Line Number="62">
<![CDATA[//Heater command only detect rising edge]]>
</Line>
<Line Number="63">
<![CDATA[//**************************************]]>
</Line>
<Line Number="64">
<![CDATA[IF Melter_HMI.b_w_HeatersOnOff AND NOT b_HeaterRisingTemp 	THEN ]]>
</Line>
<Line Number="65">
<![CDATA[		b_HeaterCommand :=1;]]>
</Line>
<Line Number="66">
<![CDATA[		b_HeaterRisingTemp :=1;]]>
</Line>
<Line Number="67">
<![CDATA[	ELSE]]>
</Line>
<Line Number="68">
<![CDATA[	 b_HeaterCommand :=0;]]>
</Line>
<Line Number="69">
<![CDATA[END_IF;]]>
</Line>
<Line Number="70">
<![CDATA[]]>
</Line>
<Line Number="71">
<![CDATA[IF NOT Melter_HMI.b_w_HeatersOnOff THEN  ]]>
</Line>
<Line Number="72">
<![CDATA[	b_HeaterRisingTemp :=0;]]>
</Line>
<Line Number="73">
<![CDATA[END_IF;]]>
</Line>
<Line Number="74">
<![CDATA[]]>
</Line>
<Line Number="75">
<![CDATA[//**********************************************************************]]>
</Line>
<Line Number="76">
<![CDATA[//The folloiwng logic is to detect the status changing from melter side, ]]>
</Line>
<Line Number="77">
<![CDATA[//so that the output command will match the status.]]>
</Line>
<Line Number="78">
<![CDATA[//**********************************************************************]]>
</Line>
<Line Number="79">
<![CDATA[IF Melter_HMI.b_r_HeatersOn AND b_TempStore1 THEN ]]>
</Line>
<Line Number="80">
<![CDATA[	b_HeaterOn := 1; ]]>
</Line>
<Line Number="81">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="82">
<![CDATA[b_TempStore1 := NOT Melter_HMI.b_r_HeatersOn ;]]>
</Line>
<Line Number="83">
<![CDATA[IF b_HeaterOff AND b_TempStore2 THEN]]>
</Line>
<Line Number="84">
<![CDATA[	b_HeaterOn := 0;]]>
</Line>
<Line Number="85">
<![CDATA[END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[b_TempStore2 := Melter_HMI.b_r_HeatersOn ;]]>
</Line>
<Line Number="87">
<![CDATA[]]>
</Line>
<Line Number="88">
<![CDATA[//************************************************************************]]>
</Line>
<Line Number="89">
<![CDATA[//This section is to determine the output based on the status of melter.]]>
</Line>
<Line Number="90">
<![CDATA[//************************************************************************]]>
</Line>
<Line Number="91">
<![CDATA[IF b_HeaterCommand AND NOT Melter_HMI.b_r_HeatersOn THEN ]]>
</Line>
<Line Number="92">
<![CDATA[	b_HeaterOn :=1; ]]>
</Line>
<Line Number="93">
<![CDATA[END_IF;]]>
</Line>
<Line Number="94">
<![CDATA[IF b_HeaterCommand AND Melter_HMI.b_r_HeatersOn THEN ]]>
</Line>
<Line Number="95">
<![CDATA[	b_HeaterOn :=0;]]>
</Line>
<Line Number="96">
<![CDATA[END_IF;]]>
</Line>
<Line Number="97">
<![CDATA[//***************************************************************]]>
</Line>
<Line Number="98">
<![CDATA[//Below logic is to prevent HeaterOn or HeaterOff stuck situation]]>
</Line>
<Line Number="99">
<![CDATA[//***************************************************************]]>
</Line>
<Line Number="100">
<![CDATA[tm_HeaterOnStuck.PRE :=5000;]]>
</Line>
<Line Number="101">
<![CDATA[tm_HeaterOnStuck.Reset := Melter_HMI.b_r_HeatersOn;]]>
</Line>
<Line Number="102">
<![CDATA[tm_HeaterOnStuck.TimerEnable := (NOT Melter_HMI.b_r_HeatersOn) AND b_HeaterOn ;]]>
</Line>
<Line Number="103">
<![CDATA[TONR(tm_HeaterOnStuck);]]>
</Line>
<Line Number="104">
<![CDATA[b_HeaterOnStuck := tm_HeaterOnStuck.DN;]]>
</Line>
<Line Number="105">
<![CDATA[]]>
</Line>
<Line Number="106">
<![CDATA[tm_HeaterOffStuck.PRE :=5000;]]>
</Line>
<Line Number="107">
<![CDATA[tm_HeaterOffStuck.Reset := NOT Melter_HMI.b_r_HeatersOn;]]>
</Line>
<Line Number="108">
<![CDATA[tm_HeaterOffStuck.TimerEnable := (Melter_HMI.b_r_HeatersOn) AND NOT b_HeaterOn ;]]>
</Line>
<Line Number="109">
<![CDATA[TONR(tm_HeaterOffStuck);]]>
</Line>
<Line Number="110">
<![CDATA[b_HeaterOffStuck := tm_HeaterOffStuck.DN;]]>
</Line>
<Line Number="111">
<![CDATA[]]>
</Line>
<Line Number="112">
<![CDATA[IF b_HeaterOnStuck AND b_HeaterOn THEN ]]>
</Line>
<Line Number="113">
<![CDATA[	b_HeaterOn :=0;]]>
</Line>
<Line Number="114">
<![CDATA[	b_HeaterOnStuck:=0; ]]>
</Line>
<Line Number="115">
<![CDATA[END_IF;]]>
</Line>
<Line Number="116">
<![CDATA[IF b_HeaterOffStuck AND NOT b_HeaterOn THEN ]]>
</Line>
<Line Number="117">
<![CDATA[	b_HeaterOn :=1; ]]>
</Line>
<Line Number="118">
<![CDATA[	b_HeaterOffStuck:=0; ]]>
</Line>
<Line Number="119">
<![CDATA[END_IF;]]>
</Line>
<Line Number="120">
<![CDATA[//********************************************************************]]>
</Line>
<Line Number="121">
<![CDATA[// Need to set the command back to zero after the command is processed]]>
</Line>
<Line Number="122">
<![CDATA[// to make the b_w_HeatersOnOff as a pulsing logic]]>
</Line>
<Line Number="123">
<![CDATA[//********************************************************************]]>
</Line>
<Line Number="124">
<![CDATA[IF Melter_HMI.b_w_HeatersOnOff THEN ]]>
</Line>
<Line Number="125">
<![CDATA[	Melter_HMI.b_w_HeatersOnOff :=0; ]]>
</Line>
<Line Number="126">
<![CDATA[END_IF;]]>
</Line>
<Line Number="127">
<![CDATA[IO_Output[8].0 := b_HeaterOn;]]>
</Line>
<Line Number="128">
<![CDATA[]]>
</Line>
<Line Number="129">
<![CDATA[//********************************************************************************************************************************]]>
</Line>
<Line Number="130">
<![CDATA[//Standby Logic]]>
</Line>
<Line Number="131">
<![CDATA[//********************************************************************************************************************************]]>
</Line>
<Line Number="132">
<![CDATA[//*********************************************************************]]>
</Line>
<Line Number="133">
<![CDATA[//The following section is to generate risng edge b_StandbyOnOffCommand ]]>
</Line>
<Line Number="134">
<![CDATA[//from HMI.b_w_StandbyOnOff]]>
</Line>
<Line Number="135">
<![CDATA[//*********************************************************************]]>
</Line>
<Line Number="136">
<![CDATA[IF Melter_HMI.b_w_StandbyOnOff AND NOT b_StandbyRisingTemp	THEN ]]>
</Line>
<Line Number="137">
<![CDATA[	b_StandbyOnOFFCommand :=1;]]>
</Line>
<Line Number="138">
<![CDATA[	b_StandbyRisingTemp:=1;]]>
</Line>
<Line Number="139">
<![CDATA[	ELSE b_StandbyOnOFFCommand :=0;]]>
</Line>
<Line Number="140">
<![CDATA[END_IF;]]>
</Line>
<Line Number="141">
<![CDATA[]]>
</Line>
<Line Number="142">
<![CDATA[IF NOT Melter_HMI.b_w_StandbyOnOff	THEN ]]>
</Line>
<Line Number="143">
<![CDATA[	b_StandbyRisingTemp :=0;]]>
</Line>
<Line Number="144">
<![CDATA[END_IF;]]>
</Line>
<Line Number="145">
<![CDATA[]]>
</Line>
<Line Number="146">
<![CDATA[//*************************************************************************************]]>
</Line>
<Line Number="147">
<![CDATA[//This section is to detect the status change on Standby mode by melter itself.]]>
</Line>
<Line Number="148">
<![CDATA[//Detecting falling edge of standby mode, at this moment if heater is still on]]>
</Line>
<Line Number="149">
<![CDATA[//then set b_StandbyOffByItself to 1 to enable standbyOff timer to fix the melter bug.]]>
</Line>
<Line Number="150">
<![CDATA[//*************************************************************************************]]>
</Line>
<Line Number="151">
<![CDATA[]]>
</Line>
<Line Number="152">
<![CDATA[//******************************************]]>
</Line>
<Line Number="153">
<![CDATA[//Make standby command following the status]]>
</Line>
<Line Number="154">
<![CDATA[//******************************************]]>
</Line>
<Line Number="155">
<![CDATA[IF NOT Melter_HMI.b_r_StandbyOn AND b_TempStore5 THEN ]]>
</Line>
<Line Number="156">
<![CDATA[	b_StandbyOn :=0;]]>
</Line>
<Line Number="157">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="158">
<![CDATA[b_TempStore5 := Melter_HMI.b_r_StandbyOn;]]>
</Line>
<Line Number="159">
<![CDATA[]]>
</Line>
<Line Number="160">
<![CDATA[IF Melter_HMI.b_r_StandbyOn AND b_TempStore6 THEN ]]>
</Line>
<Line Number="161">
<![CDATA[	b_StandbyOn :=1; ]]>
</Line>
<Line Number="162">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="163">
<![CDATA[b_TempStore6 := NOT Melter_HMI.b_r_StandbyOn;]]>
</Line>
<Line Number="164">
<![CDATA[]]>
</Line>
<Line Number="165">
<![CDATA[//*****************************************************************************]]>
</Line>
<Line Number="166">
<![CDATA[//This section is to determine the standby output based on the status of melter]]>
</Line>
<Line Number="167">
<![CDATA[//with the rising edge standby on command b_StandbyOnOFFCommand.]]>
</Line>
<Line Number="168">
<![CDATA[//*****************************************************************************]]>
</Line>
<Line Number="169">
<![CDATA[IF (Melter_HMI.b_r_TemperatureReady OR Melter_HMI.b_r_HeatersOn) AND (NOT Melter_HMI.b_r_StandbyOn) AND b_StandbyOnOFFCommand THEN ]]>
</Line>
<Line Number="170">
<![CDATA[	b_StandbyOn :=1;]]>
</Line>
<Line Number="171">
<![CDATA[END_IF;]]>
</Line>
<Line Number="172">
<![CDATA[IF Melter_HMI.b_r_StandbyOn AND b_StandbyOnOFFCommand THEN ]]>
</Line>
<Line Number="173">
<![CDATA[	b_StandbyOn :=0;]]>
</Line>
<Line Number="174">
<![CDATA[END_IF;]]>
</Line>
<Line Number="175">
<![CDATA[//********************************************************************]]>
</Line>
<Line Number="176">
<![CDATA[// Need to set the command back to zero after the command is processed]]>
</Line>
<Line Number="177">
<![CDATA[// to make the HMI.b_w_StandbyOnOff as a pulsing logic]]>
</Line>
<Line Number="178">
<![CDATA[//********************************************************************]]>
</Line>
<Line Number="179">
<![CDATA[IF Melter_HMI.b_w_StandbyOnOff THEN Melter_HMI.b_w_StandbyOnOff :=0; END_IF;]]>
</Line>
<Line Number="180">
<![CDATA[]]>
</Line>
<Line Number="181">
<![CDATA[//Below logic is to prevent StandbyOn or StandbyOff stuck situation]]>
</Line>
<Line Number="182">
<![CDATA[tm_StandbyOnStuck.PRE :=3000;]]>
</Line>
<Line Number="183">
<![CDATA[tm_StandbyOnStuck.Reset := Melter_HMI.b_r_StandbyOn;]]>
</Line>
<Line Number="184">
<![CDATA[tm_StandbyOnStuck.TimerEnable := (NOT Melter_HMI.b_r_StandbyOn) AND b_StandbyOn ;]]>
</Line>
<Line Number="185">
<![CDATA[TONR(tm_StandbyOnStuck);]]>
</Line>
<Line Number="186">
<![CDATA[b_StandbyOnStuck := tm_StandbyOnStuck.DN;]]>
</Line>
<Line Number="187">
<![CDATA[]]>
</Line>
<Line Number="188">
<![CDATA[tm_StandbyOffStuck.PRE :=3000;]]>
</Line>
<Line Number="189">
<![CDATA[tm_StandbyOffStuck.Reset := NOT Melter_HMI.b_r_StandbyOn;]]>
</Line>
<Line Number="190">
<![CDATA[tm_StandbyOffStuck.TimerEnable := Melter_HMI.b_r_StandbyOn AND NOT b_StandbyOn ;]]>
</Line>
<Line Number="191">
<![CDATA[TONR(tm_StandbyOffStuck);]]>
</Line>
<Line Number="192">
<![CDATA[b_StandbyOffStuck := tm_StandbyOffStuck.DN;]]>
</Line>
<Line Number="193">
<![CDATA[IF b_StandbyOnStuck AND b_StandbyOn THEN ]]>
</Line>
<Line Number="194">
<![CDATA[	b_StandbyOn :=0;]]>
</Line>
<Line Number="195">
<![CDATA[	b_StandbyOnStuck:=0; ]]>
</Line>
<Line Number="196">
<![CDATA[END_IF;]]>
</Line>
<Line Number="197">
<![CDATA[IF b_StandbyOffStuck AND NOT b_StandbyOn THEN ]]>
</Line>
<Line Number="198">
<![CDATA[	b_StandbyOn :=1; ]]>
</Line>
<Line Number="199">
<![CDATA[	b_StandbyOffStuck:=0; ]]>
</Line>
<Line Number="200">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="201">
<![CDATA[IO_Output[8].1 := b_StandbyOn;]]>
</Line>
<Line Number="202">
<![CDATA[]]>
</Line>
<Line Number="203">
<![CDATA[//*************************************************************************************************************************]]>
</Line>
<Line Number="204">
<![CDATA[//Pump Control Bit logic]]>
</Line>
<Line Number="205">
<![CDATA[//*************************************************************************************************************************]]>
</Line>
<Line Number="206">
<![CDATA[//**************************************]]>
</Line>
<Line Number="207">
<![CDATA[//Prevent turnoff Pump when comm lost ]]>
</Line>
<Line Number="208">
<![CDATA[//**************************************]]>
</Line>
<Line Number="209">
<![CDATA[tm_PumpOff.PRE :=200;]]>
</Line>
<Line Number="210">
<![CDATA[tm_PumpOff.TimerEnable := NOT Melter_HMI.b_r_PumpEnabled ;]]>
</Line>
<Line Number="211">
<![CDATA[TONR(tm_PumpOff);]]>
</Line>
<Line Number="212">
<![CDATA[b_PumpOff := tm_PumpOff.DN;]]>
</Line>
<Line Number="213">
<![CDATA[//******************************************************************]]>
</Line>
<Line Number="214">
<![CDATA[//The following section is to generate risng edge b_PumpOnOffCommand]]>
</Line>
<Line Number="215">
<![CDATA[// from HMI.b_w_PumpOnOff]]>
</Line>
<Line Number="216">
<![CDATA[//******************************************************************]]>
</Line>
<Line Number="217">
<![CDATA[IF (Melter_HMI.b_w_PumpOnOff ) AND NOT b_PumpRisingTemp THEN ]]>
</Line>
<Line Number="218">
<![CDATA[	b_PumpOnOFFCommand :=1;]]>
</Line>
<Line Number="219">
<![CDATA[	b_PumpRisingTemp :=1;]]>
</Line>
<Line Number="220">
<![CDATA[	ELSE b_PumpOnOFFCommand :=0;]]>
</Line>
<Line Number="221">
<![CDATA[END_IF;]]>
</Line>
<Line Number="222">
<![CDATA[]]>
</Line>
<Line Number="223">
<![CDATA[IF NOT Melter_HMI.b_w_PumpOnOff  THEN ]]>
</Line>
<Line Number="224">
<![CDATA[	b_PumpRisingTemp :=0;]]>
</Line>
<Line Number="225">
<![CDATA[END_IF;]]>
</Line>
<Line Number="226">
<![CDATA[]]>
</Line>
<Line Number="227">
<![CDATA[//************************************************************]]>
</Line>
<Line Number="228">
<![CDATA[//b_PumpOn has to match the pump running status, the following ]]>
</Line>
<Line Number="229">
<![CDATA[//logic will detect the pump status change from melter side.]]>
</Line>
<Line Number="230">
<![CDATA[//************************************************************]]>
</Line>
<Line Number="231">
<![CDATA[IF b_PumpOff AND b_TempStore3 THEN ]]>
</Line>
<Line Number="232">
<![CDATA[	b_PumpOn :=0; ]]>
</Line>
<Line Number="233">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="234">
<![CDATA[b_TempStore3 := Melter_HMI.b_r_PumpEnabled ;]]>
</Line>
<Line Number="235">
<![CDATA[]]>
</Line>
<Line Number="236">
<![CDATA[IF Melter_HMI.b_r_PumpEnabled AND b_TempStore4 ]]>
</Line>
<Line Number="237">
<![CDATA[	THEN b_PumpOn := 1; ]]>
</Line>
<Line Number="238">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="239">
<![CDATA[b_TempStore4 := NOT Melter_HMI.b_r_PumpEnabled;]]>
</Line>
<Line Number="240">
<![CDATA[]]>
</Line>
<Line Number="241">
<![CDATA[//******************************************************************]]>
</Line>
<Line Number="242">
<![CDATA[//This section is to determine the pump output based on the status ]]>
</Line>
<Line Number="243">
<![CDATA[//of melter with the rising edge pump on command b_PumpOnOffCommand.]]>
</Line>
<Line Number="244">
<![CDATA[//******************************************************************]]>
</Line>
<Line Number="245">
<![CDATA[IF b_PumpOnOFFCommand AND NOT Melter_HMI.b_r_PumpEnabled AND NOT Melter_HMI.b_r_StandbyOn	THEN ]]>
</Line>
<Line Number="246">
<![CDATA[	b_PumpOn :=1; ]]>
</Line>
<Line Number="247">
<![CDATA[END_IF;]]>
</Line>
<Line Number="248">
<![CDATA[IF b_PumpOnOFFCommand AND Melter_HMI.b_r_PumpEnabled THEN ]]>
</Line>
<Line Number="249">
<![CDATA[	b_PumpOn :=0; ]]>
</Line>
<Line Number="250">
<![CDATA[END_IF;]]>
</Line>
<Line Number="251">
<![CDATA[]]>
</Line>
<Line Number="252">
<![CDATA[//*******************************************]]>
</Line>
<Line Number="253">
<![CDATA[//This section is to prevent to turn the pump]]>
</Line>
<Line Number="254">
<![CDATA[// on in standby mode or heater is off]]>
</Line>
<Line Number="255">
<![CDATA[//*******************************************]]>
</Line>
<Line Number="256">
<![CDATA[IF Melter_HMI.b_r_StandbyOn OR b_HeaterOff OR Melter_HMI.b_r_Stop THEN ]]>
</Line>
<Line Number="257">
<![CDATA[	b_PumpOn :=0;]]>
</Line>
<Line Number="258">
<![CDATA[END_IF;]]>
</Line>
<Line Number="259">
<![CDATA[//********************************************************************]]>
</Line>
<Line Number="260">
<![CDATA[// Need to set the command back to zero after the command is processed]]>
</Line>
<Line Number="261">
<![CDATA[// to make the b_w_Pump_OnOff as a pulsing logic]]>
</Line>
<Line Number="262">
<![CDATA[//********************************************************************]]>
</Line>
<Line Number="263">
<![CDATA[IF Melter_HMI.b_w_PumpOnOff THEN ]]>
</Line>
<Line Number="264">
<![CDATA[	Melter_HMI.b_w_PumpOnOff :=0; ]]>
</Line>
<Line Number="265">
<![CDATA[END_IF;]]>
</Line>
<Line Number="266">
<![CDATA[//***************************************************************]]>
</Line>
<Line Number="267">
<![CDATA[//Below logic is to prevent PumpOn or PumpOff stuck situation]]>
</Line>
<Line Number="268">
<![CDATA[//***************************************************************]]>
</Line>
<Line Number="269">
<![CDATA[tm_PumpOnStuck.PRE :=5000;]]>
</Line>
<Line Number="270">
<![CDATA[tm_PumpOnStuck.Reset := Melter_HMI.b_r_PumpEnabled;]]>
</Line>
<Line Number="271">
<![CDATA[tm_PumpOnStuck.TimerEnable := (NOT Melter_HMI.b_r_PumpEnabled) AND b_PumpOn ;]]>
</Line>
<Line Number="272">
<![CDATA[TONR(tm_PumpOnStuck);]]>
</Line>
<Line Number="273">
<![CDATA[b_PumpOnStuck := tm_PumpOnStuck.DN;]]>
</Line>
<Line Number="274">
<![CDATA[]]>
</Line>
<Line Number="275">
<![CDATA[tm_PumpOffStuck.PRE :=5000;]]>
</Line>
<Line Number="276">
<![CDATA[tm_PumpOffStuck.Reset := NOT Melter_HMI.b_r_PumpEnabled;]]>
</Line>
<Line Number="277">
<![CDATA[tm_PumpOffStuck.TimerEnable := (Melter_HMI.b_r_PumpEnabled) AND NOT b_PumpOn ;]]>
</Line>
<Line Number="278">
<![CDATA[TONR(tm_PumpOffStuck);]]>
</Line>
<Line Number="279">
<![CDATA[b_PumpOffStuck := tm_PumpOffStuck.DN;]]>
</Line>
<Line Number="280">
<![CDATA[]]>
</Line>
<Line Number="281">
<![CDATA[IF b_PumpOnStuck AND b_PumpOn THEN ]]>
</Line>
<Line Number="282">
<![CDATA[	b_PumpOn :=0;]]>
</Line>
<Line Number="283">
<![CDATA[	b_PumpOnStuck:=0; ]]>
</Line>
<Line Number="284">
<![CDATA[END_IF;]]>
</Line>
<Line Number="285">
<![CDATA[IF b_PumpOffStuck AND NOT b_PumpOn THEN ]]>
</Line>
<Line Number="286">
<![CDATA[	b_PumpOn :=1; ]]>
</Line>
<Line Number="287">
<![CDATA[	b_PumpOffStuck:=0; ]]>
</Line>
<Line Number="288">
<![CDATA[END_IF; ]]>
</Line>
<Line Number="289">
<![CDATA[IO_Output[4].1 := b_PumpOn;]]>
</Line>
<Line Number="290">
<![CDATA[]]>
</Line>
<Line Number="291">
<![CDATA[//**************************]]>
</Line>
<Line Number="292">
<![CDATA[//Acyclic Read/Write Section]]>
</Line>
<Line Number="293">
<![CDATA[//**************************]]>
</Line>
<Line Number="294">
<![CDATA[//System Inventory]]>
</Line>
<Line Number="295">
<![CDATA[Melter_HMI.st_r_Devices.b_r_TempCtrl_Board1 := Melter_HMI.i_r_Gen_arr_SysInventory[0].0;]]>
</Line>
<Line Number="296">
<![CDATA[Melter_HMI.st_r_Devices.b_r_TempCtrl_Board2 := Melter_HMI.i_r_Gen_arr_SysInventory[0].1;]]>
</Line>
<Line Number="297">
<![CDATA[Melter_HMI.st_r_Devices.b_r_TempCtrl_Board3 := Melter_HMI.i_r_Gen_arr_SysInventory[0].2;]]>
</Line>
<Line Number="298">
<![CDATA[Melter_HMI.st_r_Devices.b_r_TempCtrl_Board4 := Melter_HMI.i_r_Gen_arr_SysInventory[0].3;]]>
</Line>
<Line Number="299">
<![CDATA[Melter_HMI.st_r_Devices.b_r_OEM_Unit:= Melter_HMI.i_r_Gen_arr_SysInventory[0].8;]]>
</Line>
<Line Number="300">
<![CDATA[Melter_HMI.st_r_Devices.b_r_OLED_Unit:= Melter_HMI.i_r_Gen_arr_SysInventory[0].9;]]>
</Line>
<Line Number="301">
<![CDATA[Melter_HMI.st_r_Devices.b_r_WIFI_Board:= Melter_HMI.i_r_Gen_arr_SysInventory[0].10;]]>
</Line>
<Line Number="302">
<![CDATA[Melter_HMI.st_r_Devices.b_r_Refill_Board:= Melter_HMI.i_r_Gen_arr_SysInventory[0].11;]]>
</Line>
<Line Number="303">
<![CDATA[Melter_HMI.st_r_Devices.b_r_Anybus_Board:= Melter_HMI.i_r_Gen_arr_SysInventory[0].12;]]>
</Line>
<Line Number="304">
<![CDATA[Melter_HMI.st_r_Devices.b_r_Press_Sensor:= Melter_HMI.i_r_Gen_arr_SysInventory[0].14;]]>
</Line>
<Line Number="305">
<![CDATA[Melter_HMI.st_r_Devices.b_r_Press_CtrlValve:= Melter_HMI.i_r_Gen_arr_SysInventory[0].15;]]>
</Line>
<Line Number="306">
<![CDATA[Melter_HMI.st_r_Devices.i_r_NumOfTempZones_External:= Melter_HMI.i_r_Gen_arr_SysInventory[1]/256;]]>
</Line>
<Line Number="307">
<![CDATA[Melter_HMI.st_r_Devices.i_r_NumOfTempZones_Internal:= Melter_HMI.i_r_Gen_arr_SysInventory[1]-Melter_HMI.st_r_Devices.i_r_NumOfTempZones_External*256;]]>
</Line>
<Line Number="308">
<![CDATA[Melter_HMI.st_r_Devices.i_r_NumOfPumps:= Melter_HMI.i_r_Gen_arr_SysInventory[2]/256;]]>
</Line>
<Line Number="309">
<![CDATA[Melter_HMI.st_r_Devices.i_r_NumOfMotors:= Melter_HMI.i_r_Gen_arr_SysInventory[2]-Melter_HMI.st_r_Devices.i_r_NumOfPumps*256;]]>
</Line>
<Line Number="310">
<![CDATA[Melter_HMI.st_r_Devices.i_r_NumOfWebClients := Melter_HMI.i_r_Gen_arr_SysInventory[3]/256;]]>
</Line>
<Line Number="311">
<![CDATA[Melter_HMI.st_r_Devices.i_r_NumOfATS:= Melter_HMI.i_r_Gen_arr_SysInventory[3]-Melter_HMI.st_r_Devices.i_r_NumOfWebClients*256;]]>
</Line>
<Line Number="312">
<![CDATA[//************]]>
</Line>
<Line Number="313">
<![CDATA[//Init Section]]>
</Line>
<Line Number="314">
<![CDATA[//************]]>
</Line>
<Line Number="315">
<![CDATA[IF S:FS THEN]]>
</Line>
<Line Number="316">
<![CDATA[	i_ADI_Size:= 38;]]>
</Line>
<Line Number="317">
<![CDATA[	i_rwADI_Count :=28;]]>
</Line>
<Line Number="318">
<![CDATA[	i_SizeofStruct := 116;]]>
</Line>
<Line Number="319">
<![CDATA[	i_rwDataSize := 68;]]>
</Line>
<Line Number="320">
<![CDATA[	i_ADI_Range := 0;]]>
</Line>
<Line Number="321">
<![CDATA[	i_ValueIndex :=0;]]>
</Line>
<Line Number="322">
<![CDATA[	i_Index:=0;]]>
</Line>
<Line Number="323">
<![CDATA[	b_readDN := 0;]]>
</Line>
<Line Number="324">
<![CDATA[	FOR i := 0 TO i_rwADI_Count  DO]]>
</Line>
<Line Number="325">
<![CDATA[		i_ADI_Range := i_ADI_Range +st_ADI_List[i].i_Size;]]>
</Line>
<Line Number="326">
<![CDATA[		arr_WriteIndex[i] := i_ADI_Range;//Index of all Read/Write ADI]]>
</Line>
<Line Number="327">
<![CDATA[		arr_WriteStartingAddress[i + 1] := i_ADI_Range;//All Read/Write ADI Starting Address]]>
</Line>
<Line Number="328">
<![CDATA[	END_FOR;]]>
</Line>
<Line Number="329">
<![CDATA[END_IF;]]>
</Line>
<Line Number="330">
<![CDATA[]]>
</Line>
<Line Number="331">
<![CDATA[tm_Acyc.PRE :=350;]]>
</Line>
<Line Number="332">
<![CDATA[tm_Acyc.TimerEnable := NOT b_Read AND NOT IO_AcycRdWt.b_WriteEvent;]]>
</Line>
<Line Number="333">
<![CDATA[TONR(tm_Acyc);]]>
</Line>
<Line Number="334">
<![CDATA[b_Read :=tm_Acyc.DN;]]>
</Line>
<Line Number="335">
<![CDATA[]]>
</Line>
<Line Number="336">
<![CDATA[//******************************************************************]]>
</Line>
<Line Number="337">
<![CDATA[//Sequentially read ALL ADIs and store into structure]]>
</Line>
<Line Number="338">
<![CDATA[//b_read will initiate when tm_Acyc Expired,b_AcycRD_Tick will]]>
</Line>
<Line Number="339">
<![CDATA[//trigger the funciton block when read is done,]]>
</Line>
<Line Number="340">
<![CDATA[//b_AcycRD_Enable only last during Acyclic reading in process]]>
</Line>
<Line Number="341">
<![CDATA[//When last ADI been read, it will stop reading until next cycle]]>
</Line>
<Line Number="342">
<![CDATA[//*******************************************************************]]>
</Line>
<Line Number="343">
<![CDATA[IO_AcycRdWt.i_ReadADI := st_ADI_List[i_Index].i_ADI;]]>
</Line>
<Line Number="344">
<![CDATA[i_Size := st_ADI_List[i_Index].i_Size;]]>
</Line>
<Line Number="345">
<![CDATA[//*******************************************************************]]>
</Line>
<Line Number="346">
<![CDATA[//Below is the section handling pressure reading, since the pressure]]>
</Line>
<Line Number="347">
<![CDATA[//over fieldbus is always in PSI, the following logic will convert]]>
</Line>
<Line Number="348">
<![CDATA[//Pressure value into different value based on the value setting]]>
</Line>
<Line Number="349">
<![CDATA[//To all the ADI reading back value, they need to store to arr_HMI array]]>
</Line>
<Line Number="350">
<![CDATA[//*******************************************************************]]>
</Line>
<Line Number="351">
<![CDATA[IF IO_AcycRdWt.b_ReadDone AND NOT IO_AcycRdWt.b_WriteEvent AND b_AcycRD_Rising THEN]]>
</Line>
<Line Number="352">
<![CDATA[	COP(IO_AcycRdWt.i_arr_ReadValue[0],arr_HMI[i_ValueIndex],i_Size);			]]>
</Line>
<Line Number="353">
<![CDATA[		IF i_Size = 2  THEN]]>
</Line>
<Line Number="354">
<![CDATA[			IF (IO_AcycRdWt.i_ReadADI > 6000) AND (IO_AcycRdWt.i_ReadADI < 8000) THEN]]>
</Line>
<Line Number="355">
<![CDATA[					COP(IO_AcycRdWt.i_arr_ReadValue[0],di_Temp,2);]]>
</Line>
<Line Number="356">
<![CDATA[					CASE arr_HMI[47] OF]]>
</Line>
<Line Number="357">
<![CDATA[						0://psi]]>
</Line>
<Line Number="358">
<![CDATA[							r_Press := di_Temp / 1000.000;]]>
</Line>
<Line Number="359">
<![CDATA[						1://kpa]]>
</Line>
<Line Number="360">
<![CDATA[							r_Press := di_Temp / 145.0377377;]]>
</Line>
<Line Number="361">
<![CDATA[						2://bar]]>
</Line>
<Line Number="362">
<![CDATA[							r_Press := di_Temp / 14503.77377;]]>
</Line>
<Line Number="363">
<![CDATA[					END_CASE;]]>
</Line>
<Line Number="364">
<![CDATA[					COP(r_Press,di_press,1);]]>
</Line>
<Line Number="365">
<![CDATA[					COP(di_press,arr_HMI[i_ValueIndex],2);]]>
</Line>
<Line Number="366">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="367">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="368">
<![CDATA[	//****************************************************]]>
</Line>
<Line Number="369">
<![CDATA[	//After reading the current ADI, index to next one]]>
</Line>
<Line Number="370">
<![CDATA[	//****************************************************]]>
</Line>
<Line Number="371">
<![CDATA[	i_ValueIndex := i_ValueIndex + st_ADI_List[i_Index].i_Size;]]>
</Line>
<Line Number="372">
<![CDATA[    i_Index := i_Index + 1;	]]>
</Line>
<Line Number="373">
<![CDATA[END_IF;]]>
</Line>
<Line Number="374">
<![CDATA[b_AcycRD_Rising := NOT IO_AcycRdWt.b_ReadDone;]]>
</Line>
<Line Number="375">
<![CDATA[//****************************************************	]]>
</Line>
<Line Number="376">
<![CDATA[//Copy all reading value into structure ]]>
</Line>
<Line Number="377">
<![CDATA[//****************************************************]]>
</Line>
<Line Number="378">
<![CDATA[IF b_Read THEN]]>
</Line>
<Line Number="379">
<![CDATA[	COP(arr_HMI[0],Melter_HMI.i_rw_Temp_arr_ZoneSP[0],i_SizeofStruct);]]>
</Line>
<Line Number="380">
<![CDATA[	COP(arr_HMI[0],arr_HMI_Buffer[0],i_rwDataSize);	]]>
</Line>
<Line Number="381">
<![CDATA[END_IF;]]>
</Line>
<Line Number="382">
<![CDATA[IF (i_Index = i_ADI_Size ) THEN]]>
</Line>
<Line Number="383">
<![CDATA[    i_Index := 0;]]>
</Line>
<Line Number="384">
<![CDATA[	i_ValueIndex :=0;]]>
</Line>
<Line Number="385">
<![CDATA[	b_readDN :=1;]]>
</Line>
<Line Number="386">
<![CDATA[END_IF;]]>
</Line>
<Line Number="387">
<![CDATA[]]>
</Line>
<Line Number="388">
<![CDATA[//**********************************************************************************************]]>
</Line>
<Line Number="389">
<![CDATA[//Copy all read/write ADI reading into arr_HMI_Buffer_Compare for further generating Write Event]]>
</Line>
<Line Number="390">
<![CDATA[//***********************************************************************************************]]>
</Line>
<Line Number="391">
<![CDATA[COP(Melter_HMI.i_rw_Temp_arr_ZoneSP[0],arr_HMI_Compare[0],i_rwDataSize);	]]>
</Line>
<Line Number="392">
<![CDATA[]]>
</Line>
<Line Number="393">
<![CDATA[//**************************************************************************************]]>
</Line>
<Line Number="394">
<![CDATA[//Compare arr_HMI_Compare with arr_HMI_Buffer to generate write event]]>
</Line>
<Line Number="395">
<![CDATA[//**************************************************************************************]]>
</Line>
<Line Number="396">
<![CDATA[tm_WriteEvent.PRE :=350;]]>
</Line>
<Line Number="397">
<![CDATA[tm_WriteEvent.TimerEnable :=IO_AcycRdWt.b_WriteEvent;]]>
</Line>
<Line Number="398">
<![CDATA[TONR(tm_WriteEvent);	   ]]>
</Line>
<Line Number="399">
<![CDATA[]]>
</Line>
<Line Number="400">
<![CDATA[IF tm_WriteEvent.DN OR (IO_AcycRdWt.b_WriteDone AND b_AcycWT_Rising) THEN]]>
</Line>
<Line Number="401">
<![CDATA[	IO_AcycRdWt.b_WriteEvent :=0;]]>
</Line>
<Line Number="402">
<![CDATA[END_IF;	]]>
</Line>
<Line Number="403">
<![CDATA[b_AcycWT_Rising := NOT IO_AcycRdWt.b_WriteDone;]]>
</Line>
<Line Number="404">
<![CDATA[]]>
</Line>
<Line Number="405">
<![CDATA[b_WriteEventONS := 0;]]>
</Line>
<Line Number="406">
<![CDATA[]]>
</Line>
<Line Number="407">
<![CDATA[FOR i:=0 TO i_rwDataSize-1 BY 1 DO]]>
</Line>
<Line Number="408">
<![CDATA[	IF (arr_HMI_Compare[i] <> arr_HMI_Buffer[i]) AND NOT IO_AcycRdWt.b_WriteEvent and b_readDN THEN]]>
</Line>
<Line Number="409">
<![CDATA[		i_CompareIndex := i;]]>
</Line>
<Line Number="410">
<![CDATA[		IO_AcycRdWt.b_WriteEvent := 1;]]>
</Line>
<Line Number="411">
<![CDATA[		b_WriteEventONS := 1;]]>
</Line>
<Line Number="412">
<![CDATA[		arr_HMI_Buffer[i] :=arr_HMI_Compare[i];]]>
</Line>
<Line Number="413">
<![CDATA[		]]>
</Line>
<Line Number="414">
<![CDATA[		EXIT;]]>
</Line>
<Line Number="415">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="416">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="417">
<![CDATA[]]>
</Line>
<Line Number="418">
<![CDATA[IF b_WriteEventONS THEN]]>
</Line>
<Line Number="419">
<![CDATA[	//***************************************************************]]>
</Line>
<Line Number="420">
<![CDATA[	//When write event locate the write index inside arr_WriteIndex]]>
</Line>
<Line Number="421">
<![CDATA[	//***************************************************************]]>
</Line>
<Line Number="422">
<![CDATA[    FOR i := 0 TO i_rwADI_Count DO]]>
</Line>
<Line Number="423">
<![CDATA[        IF i_CompareIndex < arr_WriteIndex[i] THEN]]>
</Line>
<Line Number="424">
<![CDATA[            i_Index_Write := i;]]>
</Line>
<Line Number="425">
<![CDATA[            EXIT;]]>
</Line>
<Line Number="426">
<![CDATA[        END_IF;]]>
</Line>
<Line Number="427">
<![CDATA[    END_FOR;]]>
</Line>
<Line Number="428">
<![CDATA[	//***************************************************************]]>
</Line>
<Line Number="429">
<![CDATA[	//If pressure ADI generate write event, conver the unit back to PSI]]>
</Line>
<Line Number="430">
<![CDATA[	//***************************************************************	]]>
</Line>
<Line Number="431">
<![CDATA[	i_WriteSizeTemp := st_ADI_List[i_Index_Write].i_Size;]]>
</Line>
<Line Number="432">
<![CDATA[	IO_AcycRdWt.i_WriteADI := st_ADI_List[i_Index_Write].i_ADI;]]>
</Line>
<Line Number="433">
<![CDATA[   	IF i_WriteSizeTemp = 2 THEN]]>
</Line>
<Line Number="434">
<![CDATA[		i_WritePtr := arr_WriteStartingAddress[i_Index_Write];]]>
</Line>
<Line Number="435">
<![CDATA[		COP(arr_HMI_Compare[i_WritePtr],r_PressConv,2);]]>
</Line>
<Line Number="436">
<![CDATA[		CASE arr_HMI[47] OF]]>
</Line>
<Line Number="437">
<![CDATA[	        0://psi]]>
</Line>
<Line Number="438">
<![CDATA[	            di_Press_psi := r_PressConv * 1000.000;]]>
</Line>
<Line Number="439">
<![CDATA[	        1://kpa]]>
</Line>
<Line Number="440">
<![CDATA[	            di_Press_psi :=r_PressConv* 145.0377377;]]>
</Line>
<Line Number="441">
<![CDATA[	        2://bar]]>
</Line>
<Line Number="442">
<![CDATA[	            di_Press_psi := r_PressConv* 14503.77377;]]>
</Line>
<Line Number="443">
<![CDATA[	    END_CASE;]]>
</Line>
<Line Number="444">
<![CDATA[		COP(di_Press_psi,IO_AcycRdWt.i_arr_WriteValue[0],2);]]>
</Line>
<Line Number="445">
<![CDATA[		COP(arr_HMI_Compare[i_WritePtr],arr_HMI[i_WritePtr],2);]]>
</Line>
<Line Number="446">
<![CDATA[    ELSE]]>
</Line>
<Line Number="447">
<![CDATA[		i_WritePtr := arr_WriteStartingAddress[i_Index_Write];]]>
</Line>
<Line Number="448">
<![CDATA[		COP(arr_HMI_Compare[i_WritePtr],IO_AcycRdWt.i_arr_WriteValue[0],i_WriteSizeTemp);]]>
</Line>
<Line Number="449">
<![CDATA[		COP(arr_HMI_Compare[i_WritePtr],arr_HMI[i_WritePtr],i_WriteSizeTemp);]]>
</Line>
<Line Number="450">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="451">
<![CDATA[	IO_AcycRdWt.i_WriteSize := i_WriteSizeTemp*2;]]>
</Line>
<Line Number="452">
<![CDATA[END_IF;]]>
</Line>
<Line Number="453">
<![CDATA[]]>
</Line>
<Line Number="454">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AOI_TIME_ADD" Class="Standard" Revision="1.0" RevisionExtension="Example" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2008-04-08T21:16:05.802Z" CreatedBy="NA\dereed" EditedDate="2012-06-16T03:05:46.922Z"
 EditedBy="NA\BKYER" SoftwareRevision="v20.00">
<Description>
<![CDATA[DateTime := DateTime + Time]]>
</Description>
<RevisionNote>
<![CDATA[Release for V17 CD as Date/Time Examples]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[T_Add : Add Date/Time plus Time to get new Date/Time

This instruction adds a given amount of Time to a Date/Time to arrive at a new Date/Time.  The new Date/Time is , that is, given as a valid (if possible) Gregorian Date and Time:

*  0 <= Microseconds < 1,000,000
*  0 <= Seconds < 60    (NOTE: this instruction cannot add leap seconds;  sorry!)
*  0 <= Minutes < 60
*  0 <= Hours < 24
*  1 <= Day <= 31 AND Date is a Valid Gregorian Date (see below)
*  1 <= Month <= 12

NOTE:  This instruction does NOT switch to Julian dates for dates before 1582 (or 1753 or whenever your place of interest switched to the Gregorian Calendar -- see Wikipedia on  for details)!  This instruction assumes the Gregorian Calendar extends  (about 5.8 million years) either side of  CE!  It DOES handle the Gregorian 4 / 100 / 400 year rules, so Feb. 29, 2000 is a valid date, but Feb. 29, 2100 is not.  It DOES NOT handle Daylight Savings Time hour offsets when the amount of Time added carries the Date/Time across summer/winter time boundaries.
]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Ref_DT" TagType="Base" DataType="DateTime" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[DT (Date/Time) to which to add Time]]>
</Description>
</Parameter>
<Parameter Name="Ref_Time" TagType="Base" DataType="DateTime" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Time to be added to DT (Date/Time)]]>
</Description>
</Parameter>
<Parameter Name="Ref_Out" TagType="Base" DataType="DateTime" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Date/Time = DT+Time]]>
</Description>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk_YrFromMo" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Years to add from Months]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_DaFromHr" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Days to add from Hours]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_HrFromMin" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Hours to add from Minutes]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_MinFromSec" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Minutes to add from Seconds]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_SecFrom_uSec" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Seconds to add from Microseconds]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_yyy" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Intermediate for year calculation]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_y" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Calculated YEAR from Gregorian Day Number]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_mmm" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Intermediate for month calculation]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_m" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Calculated MONTH from Gregorian Day Number]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_GD" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Gregorian Day Number (calculated for given Y/M/D)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_G" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Used in calculating Gregorian Day Number (function of Year and F)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_F" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Used in calculating Gregorian Day Number (function of month)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_ddd" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Intermediate for day calculation]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Add Date/Time plus Time to give new Date/Time]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// T_ADD : Add Date/Time plus Time to get new Date/Time]]>
</Line>
<Line Number="1">
<![CDATA[// ]]>
</Line>
<Line Number="2">
<![CDATA[// This instruction adds a given amount of Time to a Date/Time to arrive at a new Date/Time]]>
</Line>
<Line Number="3">
<![CDATA[// The new Date/Time is "normalized", that is, given as a valid (if possible) Gregorian Date and Time:]]>
</Line>
<Line Number="4">
<![CDATA[//]]>
</Line>
<Line Number="5">
<![CDATA[//   *  0 <= Microseconds < 1,000,000]]>
</Line>
<Line Number="6">
<![CDATA[//   *  0 <= Seconds < 60    (NOTE: this instruction cannot add leap seconds;  sorry!]]>
</Line>
<Line Number="7">
<![CDATA[//   *  0 <= Minutes < 60]]>
</Line>
<Line Number="8">
<![CDATA[//   *  0 <= Hours < 24]]>
</Line>
<Line Number="9">
<![CDATA[//   *  1 <= Day <= 31 AND Date is a Valid Gregorian Date (see below)]]>
</Line>
<Line Number="10">
<![CDATA[//   *  1 <= Month <= 12]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[//  NOTE:  This instruction does NOT switch to Julian dates for dates before 1582 (or 1753 or whenever your place of interest]]>
</Line>
<Line Number="13">
<![CDATA[//    switched to the Gregorian Calendar -- see Wikipedia on "Gregorian Calendar" for details)!  This instruction assumes the ]]>
</Line>
<Line Number="14">
<![CDATA[//    Gregorian Calendar extends "indefinitely" (about 5.8 million years) either side of "zero" CE!  It DOES handle the]]>
</Line>
<Line Number="15">
<![CDATA[//    Gregorian 4 / 100 / 400 year rules, so Feb. 29, 2000 is a valid date, but Feb. 29, 2100 is not.  It DOES NOT handle]]>
</Line>
<Line Number="16">
<![CDATA[//    Daylight Savings Time hour offsets when the amount of Time added carries the Date/Time across summer/winter time boundaries.]]>
</Line>
<Line Number="17">
<![CDATA[//]]>
</Line>
<Line Number="18">
<![CDATA[//  NOTE:  For algorithms used for Gregorian Date and Days Between Dates, see http://alcor.concordia.ca/~gpkatch/gdate-algorithm.html]]>
</Line>
<Line Number="19">
<![CDATA[//]]>
</Line>
<Line Number="20">
<![CDATA[//  Revision 1.0-Example:  2008-Jul-02, DER]]>
</Line>
<Line Number="21">
<![CDATA[//	Release for V17 CD as Date/Time Examples]]>
</Line>
<Line Number="22">
<![CDATA[//]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[// Add Microseconds (accounting for adding a negative number of Microseconds!)]]>
</Line>
<Line Number="25">
<![CDATA[Ref_Out.uSec := (Ref_DT.uSec+Ref_Time.uSec) MOD 1000000;]]>
</Line>
<Line Number="26">
<![CDATA[// Carry excess Seconds]]>
</Line>
<Line Number="27">
<![CDATA[Wrk_SecFrom_uSec := (Ref_DT.uSec+Ref_Time.uSec) / 1000000;]]>
</Line>
<Line Number="28">
<![CDATA[IF (Ref_Out.uSec < 0) THEN]]>
</Line>
<Line Number="29">
<![CDATA[  Ref_Out.uSec := Ref_Out.uSec + 1000000;]]>
</Line>
<Line Number="30">
<![CDATA[  Wrk_SecFrom_uSec := Wrk_SecFrom_uSec - 1;]]>
</Line>
<Line Number="31">
<![CDATA[END_IF;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
<Line Number="33">
<![CDATA[// Add Seconds]]>
</Line>
<Line Number="34">
<![CDATA[Ref_Out.Second := (Ref_DT.Second+Ref_Time.Second+Wrk_SecFrom_uSec) MOD 60;]]>
</Line>
<Line Number="35">
<![CDATA[// Carry excess Minutes]]>
</Line>
<Line Number="36">
<![CDATA[Wrk_MinFromSec := (Ref_DT.Second+Ref_Time.Second+Wrk_SecFrom_uSec) / 60;]]>
</Line>
<Line Number="37">
<![CDATA[// Handle negative sum]]>
</Line>
<Line Number="38">
<![CDATA[IF (Ref_Out.Second < 0) THEN]]>
</Line>
<Line Number="39">
<![CDATA[  Ref_Out.Second := Ref_Out.Second + 60;]]>
</Line>
<Line Number="40">
<![CDATA[  Wrk_MinFromSec := Wrk_MinFromSec - 1;]]>
</Line>
<Line Number="41">
<![CDATA[END_IF;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[// Add Minutes]]>
</Line>
<Line Number="44">
<![CDATA[Ref_Out.Minute := (Ref_DT.Minute+Ref_Time.Minute+Wrk_MinFromSec) MOD 60;]]>
</Line>
<Line Number="45">
<![CDATA[// Carry excess Hours]]>
</Line>
<Line Number="46">
<![CDATA[Wrk_HrFromMin := (Ref_DT.Minute+Ref_Time.Minute+Wrk_MinFromSec) / 60;]]>
</Line>
<Line Number="47">
<![CDATA[// Handle negative sum]]>
</Line>
<Line Number="48">
<![CDATA[IF (Ref_Out.Minute < 0) THEN]]>
</Line>
<Line Number="49">
<![CDATA[  Ref_Out.Minute := Ref_Out.Minute + 60;]]>
</Line>
<Line Number="50">
<![CDATA[  Wrk_HrFromMin := Wrk_HrFromMin - 1;]]>
</Line>
<Line Number="51">
<![CDATA[END_IF;]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[// Add Hours]]>
</Line>
<Line Number="54">
<![CDATA[Ref_Out.Hour := (Ref_DT.Hour+Ref_Time.Hour+Wrk_HrFromMin) MOD 24;]]>
</Line>
<Line Number="55">
<![CDATA[// Carry excess Days]]>
</Line>
<Line Number="56">
<![CDATA[Wrk_DaFromHr := (Ref_DT.Hour+Ref_Time.Hour+Wrk_HrFromMin) / 24;]]>
</Line>
<Line Number="57">
<![CDATA[// Handle negative sum]]>
</Line>
<Line Number="58">
<![CDATA[IF (Ref_Out.Hour < 0) THEN]]>
</Line>
<Line Number="59">
<![CDATA[  Ref_Out.Hour := Ref_Out.Hour + 24;]]>
</Line>
<Line Number="60">
<![CDATA[  Wrk_DaFromHr := Wrk_DaFromHr - 1;]]>
</Line>
<Line Number="61">
<![CDATA[END_IF;]]>
</Line>
<Line Number="62">
<![CDATA[]]>
</Line>
<Line Number="63">
<![CDATA[// That takes care of the time.  To add the days, we need to compute a Gregorian Day Number from the input Date,]]>
</Line>
<Line Number="64">
<![CDATA[// then add the days and compute a Date from the new total Gregorian Day Number.  This takes care of the days in the months.]]>
</Line>
<Line Number="65">
<![CDATA[// (After thet, we'll add the Months and Years like we did with the time.)]]>
</Line>
<Line Number="66">
<![CDATA[]]>
</Line>
<Line Number="67">
<![CDATA[// Compute the Gregorian Day Number for the input Date]]>
</Line>
<Line Number="68">
<![CDATA[Wrk_F := (Ref_DT.Month+9) MOD 12;]]>
</Line>
<Line Number="69">
<![CDATA[Wrk_G := Ref_DT.Year - Wrk_F/10;]]>
</Line>
<Line Number="70">
<![CDATA[Wrk_GD := 365*Wrk_G+Wrk_G/4-Wrk_G/100+Wrk_G/400+(Wrk_F*306+5)/10+Ref_DT.Day-1;]]>
</Line>
<Line Number="71">
<![CDATA[]]>
</Line>
<Line Number="72">
<![CDATA[// Add the days]]>
</Line>
<Line Number="73">
<![CDATA[Wrk_GD := Wrk_GD+Ref_Time.Day+Wrk_DaFromHr;]]>
</Line>
<Line Number="74">
<![CDATA[]]>
</Line>
<Line Number="75">
<![CDATA[// And back out from this Gregorian Day Number to a date]]>
</Line>
<Line Number="76">
<![CDATA[Wrk_yyy := TRUNC (Wrk_GD +1.5)/365.2425;]]>
</Line>
<Line Number="77">
<![CDATA[Wrk_ddd := Wrk_GD - (365*Wrk_yyy+Wrk_yyy/4-Wrk_yyy/100+Wrk_yyy/400);]]>
</Line>
<Line Number="78">
<![CDATA[IF (Wrk_ddd < 0) THEN]]>
</Line>
<Line Number="79">
<![CDATA[	Wrk_yyy := Wrk_yyy - 1;]]>
</Line>
<Line Number="80">
<![CDATA[	Wrk_ddd := Wrk_GD - (365*Wrk_yyy+Wrk_yyy/4-Wrk_yyy/100+Wrk_yyy/400);]]>
</Line>
<Line Number="81">
<![CDATA[	IF (Wrk_ddd < 0) THEN]]>
</Line>
<Line Number="82">
<![CDATA[		Wrk_yyy := Wrk_yyy - 1;]]>
</Line>
<Line Number="83">
<![CDATA[		Wrk_ddd := Wrk_GD - (365*Wrk_yyy+Wrk_yyy/4-Wrk_yyy/100+Wrk_yyy/400);]]>
</Line>
<Line Number="84">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="85">
<![CDATA[END_IF;]]>
</Line>
<Line Number="86">
<![CDATA[Wrk_mmm := (100*Wrk_ddd + 52)/3060;]]>
</Line>
<Line Number="87">
<![CDATA[Wrk_y := Wrk_yyy + (Wrk_mmm + 2)/12;]]>
</Line>
<Line Number="88">
<![CDATA[Wrk_m := ((Wrk_mmm + 2) MOD 12) + 1; ]]>
</Line>
<Line Number="89">
<![CDATA[Ref_Out.Day := Wrk_ddd - ((Wrk_mmm * 306) + 5)/10 + 1;]]>
</Line>
<Line Number="90">
<![CDATA[]]>
</Line>
<Line Number="91">
<![CDATA[// Add Months]]>
</Line>
<Line Number="92">
<![CDATA[Ref_Out.Month := ((Wrk_m+Ref_Time.Month-1) MOD 12)+1;]]>
</Line>
<Line Number="93">
<![CDATA[// Carry excess Years]]>
</Line>
<Line Number="94">
<![CDATA[Wrk_YrFromMo := (Wrk_m+Ref_Time.Month-1) / 12;]]>
</Line>
<Line Number="95">
<![CDATA[// Handle negative sum]]>
</Line>
<Line Number="96">
<![CDATA[IF (Ref_Out.Month < 1) THEN]]>
</Line>
<Line Number="97">
<![CDATA[  Ref_Out.Month := Ref_Out.Month + 12;]]>
</Line>
<Line Number="98">
<![CDATA[  Wrk_YrFromMo := Wrk_YrFromMo - 1;]]>
</Line>
<Line Number="99">
<![CDATA[END_IF;]]>
</Line>
<Line Number="100">
<![CDATA[]]>
</Line>
<Line Number="101">
<![CDATA[// Add Years]]>
</Line>
<Line Number="102">
<![CDATA[Ref_Out.Year := Wrk_y+Ref_Time.Year+Wrk_YrFromMo;]]>
</Line>
<Line Number="103">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AOI_TIME_DIFFERENCE" Class="Standard" Revision="1.0" RevisionExtension="Example" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2008-04-08T21:16:05.802Z" CreatedBy="NA\dereed" EditedDate="2012-06-16T03:05:47.063Z"
 EditedBy="NA\BKYER" SoftwareRevision="v20.00">
<Description>
<![CDATA[Time := DateTime - DateTime]]>
</Description>
<RevisionNote>
<![CDATA[Release for V17 CD as Date/Time Examples]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[T_DIFF : Date/Time minus Date/Time gives Time Difference

This instruction is given two Date/Time points and determines the amount of time between them.  The result is given in Days, Hours, Minutes, Seconds and Microseconds.  (Years and Months are returned as zero, as the number of months is generally not used.)  The Date/Time parameters must be valid Gregorian Dates and valid clock Times:

*  0 <= Microseconds < 1,000,000
*  0 <= Seconds < 60    (NOTE: this instruction cannot add leap seconds;  sorry!)
*  0 <= Minutes < 60
*  0 <= Hours < 24
*  1 <= Day <= 31 AND Date is a Valid Gregorian Date (see below)
*  1 <= Month <= 12

... for results to be meaningful.

NOTE:  This instruction does NOT switch to Julian dates for dates before 1582 (or 1753 or whenever your place of interest switched to the Gregorian Calendar -- see Wikipedia on  for details)!  This instruction assumes the Gregorian Calendar extends  (about 5.8 million years) either side of  CE!  It DOES handle the Gregorian 4 / 100 / 400 year rules, so Feb. 29, 2000 is a valid date, but Feb. 29, 2100 is not.  It DOES NOT handle Daylight Savings Time hour offsets when the Dates cross summer/winter time boundaries.
]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Ref_DT1" TagType="Base" DataType="DateTime" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[DT (Date/Time) to subtract from]]>
</Description>
</Parameter>
<Parameter Name="Ref_DT2" TagType="Base" DataType="DateTime" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[DT (Date/Time) to subtract]]>
</Description>
</Parameter>
<Parameter Name="Ref_Out" TagType="Base" DataType="DateTime" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Result: Amount of Time between Ref_DT1 and Ref_DT2]]>
</Description>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk_DaFromHr" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Days to add from Hours]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_HrFromMin" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Hours to add from Minutes]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_MinFromSec" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Minutes to add from Seconds]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_SecFrom_uSec" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Number of Seconds to add from Microseconds]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_GD1" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Gregorian Day Number (calculated for given Y/M/D)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_G1" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Used in calculating Gregorian Day Number (function of Year and F)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_F1" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Used in calculating Gregorian Day Number (function of month)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_F2" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Used in calculating Gregorian Day Number (function of month)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_G2" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Used in calculating Gregorian Day Number (function of Year and F)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_GD2" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Gregorian Day Number (calculated for given Y/M/D)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Out" DataType="DateTime" ExternalAccess="Read/Write">
<Description>
<![CDATA[Working accumulator for Output (Out)]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[[0,0,0,0,0,0,0]]]>
</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="DateTime">
<DataValueMember Name="Year" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Month" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Day" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Hour" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Minute" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Second" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="uSec" DataType="DINT" Radix="Decimal" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Calculate Days between Dates and Time Difference]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// T_DIFF : Difference between two Dates  (Date/Time minus Date/Time to get Amount of Time]]>
</Line>
<Line Number="1">
<![CDATA[// ]]>
</Line>
<Line Number="2">
<![CDATA[// This instruction finds the difference between one Date/Time and another (both assumed valid) and reports it as]]>
</Line>
<Line Number="3">
<![CDATA[// an Amount of Time.  The amount of time is given as a number of Days, Hours, Minutes, Seconds and Microseconds:]]>
</Line>
<Line Number="4">
<![CDATA[//]]>
</Line>
<Line Number="5">
<![CDATA[//  NOTE:  This instruction does NOT switch to Julian dates for dates before 1582 (or 1753 or whenever your place of interest]]>
</Line>
<Line Number="6">
<![CDATA[//    switched to the Gregorian Calendar -- see Wikipedia on "Gregorian Calendar" for details)!  This instruction assumes the ]]>
</Line>
<Line Number="7">
<![CDATA[//    Gregorian Calendar extends "indefinitely" (about 5.8 million years) either side of "zero" CE!  It DOES handle the]]>
</Line>
<Line Number="8">
<![CDATA[//    Gregorian 4 / 100 / 400 year rules, so Feb. 29, 2000 is a valid date, but Feb. 29, 2100 is not.  It DOES NOT handle]]>
</Line>
<Line Number="9">
<![CDATA[//    Daylight Savings Time hour offsets when one Date/Time is winter time and the other  is summer time boundaries.  This]]>
</Line>
<Line Number="10">
<![CDATA[//    instruction does not deal with Leap Seconds, and Date/Time parameters MUST be valid Gregorian, normalized Date/Time values:]]>
</Line>
<Line Number="11">
<![CDATA[//]]>
</Line>
<Line Number="12">
<![CDATA[//   *  0 <= Microseconds < 1,000,000]]>
</Line>
<Line Number="13">
<![CDATA[//   *  0 <= Seconds < 60]]>
</Line>
<Line Number="14">
<![CDATA[//   *  0 <= Minutes < 60]]>
</Line>
<Line Number="15">
<![CDATA[//   *  0 <= Hours < 24]]>
</Line>
<Line Number="16">
<![CDATA[//   *  0 <= Days <= 31 and a valid Gregorian Date (Feb = 28 or 29 days, etc.)]]>
</Line>
<Line Number="17">
<![CDATA[//   *  1 <= Month <= 12]]>
</Line>
<Line Number="18">
<![CDATA[//   *  year in the range (about) +/- 5.8 million]]>
</Line>
<Line Number="19">
<![CDATA[//]]>
</Line>
<Line Number="20">
<![CDATA[//  NOTE:  For algorithms used for Gregorian Date and Days Between Dates, see http://alcor.concordia.ca/~gpkatch/gdate-algorithm.html]]>
</Line>
<Line Number="21">
<![CDATA[//]]>
</Line>
<Line Number="22">
<![CDATA[//  Revision 1.0-Example:  2008-Jul-02, DER]]>
</Line>
<Line Number="23">
<![CDATA[//	Release for V17 CD as Date/Time Examples]]>
</Line>
<Line Number="24">
<![CDATA[//]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[// Add Microseconds]]>
</Line>
<Line Number="27">
<![CDATA[Wrk_Out.uSec := (Ref_DT1.uSec-Ref_DT2.uSec+1000000) MOD 1000000;]]>
</Line>
<Line Number="28">
<![CDATA[// Carry excess Seconds]]>
</Line>
<Line Number="29">
<![CDATA[Wrk_SecFrom_uSec := (Ref_DT1.uSec-Ref_DT2.uSec+1000000) / 1000000 - 1;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[// Add Seconds]]>
</Line>
<Line Number="32">
<![CDATA[Wrk_Out.Second := (Ref_DT1.Second-Ref_DT2.Second+Wrk_SecFrom_uSec+60) MOD 60;]]>
</Line>
<Line Number="33">
<![CDATA[// Carry excess Minutes]]>
</Line>
<Line Number="34">
<![CDATA[Wrk_MinFromSec := (Ref_DT1.Second-Ref_DT2.Second+Wrk_SecFrom_uSec+60) / 60 - 1;]]>
</Line>
<Line Number="35">
<![CDATA[]]>
</Line>
<Line Number="36">
<![CDATA[// Add Minutes]]>
</Line>
<Line Number="37">
<![CDATA[Wrk_Out.Minute := (Ref_DT1.Minute-Ref_DT2.Minute+Wrk_MinFromSec+60) MOD 60;]]>
</Line>
<Line Number="38">
<![CDATA[// Carry excess Hours]]>
</Line>
<Line Number="39">
<![CDATA[Wrk_HrFromMin := (Ref_DT1.Minute-Ref_DT2.Minute+Wrk_MinFromSec+60) / 60 - 1;]]>
</Line>
<Line Number="40">
<![CDATA[]]>
</Line>
<Line Number="41">
<![CDATA[// Add Hours]]>
</Line>
<Line Number="42">
<![CDATA[Wrk_Out.Hour := (Ref_DT1.Hour-Ref_DT2.Hour+Wrk_HrFromMin+24) MOD 24;]]>
</Line>
<Line Number="43">
<![CDATA[// Carry excess Days]]>
</Line>
<Line Number="44">
<![CDATA[Wrk_DaFromHr := (Ref_DT1.Hour-Ref_DT2.Hour+Wrk_HrFromMin+24) / 24 - 1;]]>
</Line>
<Line Number="45">
<![CDATA[]]>
</Line>
<Line Number="46">
<![CDATA[// That takes care of the time.  To add the days, we need to compute a Gregorian Day Number from the input Date,]]>
</Line>
<Line Number="47">
<![CDATA[// then add the days and compute a Date from the new total Gregorian Day Number.  This takes care of the days in the months.]]>
</Line>
<Line Number="48">
<![CDATA[// (After thet, we'll add the Months and Years like we did with the time.)]]>
</Line>
<Line Number="49">
<![CDATA[]]>
</Line>
<Line Number="50">
<![CDATA[// Compute the Gregorian Day Number for the input Date]]>
</Line>
<Line Number="51">
<![CDATA[Wrk_F1 := (Ref_DT1.Month+9) MOD 12;]]>
</Line>
<Line Number="52">
<![CDATA[Wrk_G1 := Ref_DT1.Year - Wrk_F1/10;]]>
</Line>
<Line Number="53">
<![CDATA[Wrk_GD1 := 365*Wrk_G1+Wrk_G1/4-Wrk_G1/100+Wrk_G1/400+(Wrk_F1*306+5)/10+Ref_DT1.Day-1;]]>
</Line>
<Line Number="54">
<![CDATA[]]>
</Line>
<Line Number="55">
<![CDATA[Wrk_F2 := (Ref_DT2.Month+9) MOD 12;]]>
</Line>
<Line Number="56">
<![CDATA[Wrk_G2 := Ref_DT2.Year - Wrk_F2/10;]]>
</Line>
<Line Number="57">
<![CDATA[Wrk_GD2 := 365*Wrk_G2+Wrk_G2/4-Wrk_G2/100+Wrk_G2/400+(Wrk_F2*306+5)/10+Ref_DT2.Day-1;]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[Wrk_Out.Day := Wrk_GD1 - Wrk_GD2 + Wrk_DaFromHr;]]>
</Line>
<Line Number="60">
<![CDATA[]]>
</Line>
<Line Number="61">
<![CDATA[// If the number of Days is negative, we need to bump it up by one and subtract 23 hours 59 minutes]]>
</Line>
<Line Number="62">
<![CDATA[//  59 seconds 1,000,000 microseconds (same amount of time) to make result look right...]]>
</Line>
<Line Number="63">
<![CDATA[//  Otherwise instead of -1 uSec we get -1 day +23 hours +59 minutes +59 seconds +999,999 microseconds]]>
</Line>
<Line Number="64">
<![CDATA[]]>
</Line>
<Line Number="65">
<![CDATA[If ( Wrk_Out.Day < 0 ) then]]>
</Line>
<Line Number="66">
<![CDATA[	Wrk_Out.Day := Wrk_Out.Day + 1;]]>
</Line>
<Line Number="67">
<![CDATA[	Wrk_Out.Hour := Wrk_Out.Hour - 23;]]>
</Line>
<Line Number="68">
<![CDATA[	Wrk_Out.Minute := Wrk_Out.Minute - 59;]]>
</Line>
<Line Number="69">
<![CDATA[	Wrk_Out.Second := Wrk_Out.Second - 59;]]>
</Line>
<Line Number="70">
<![CDATA[	Wrk_Out.uSec := Wrk_Out.uSec - 1000000;]]>
</Line>
<Line Number="71">
<![CDATA[	If ( Wrk_Out.uSec = -1000000 ) then]]>
</Line>
<Line Number="72">
<![CDATA[		Wrk_Out.uSec := 0;]]>
</Line>
<Line Number="73">
<![CDATA[		Wrk_Out.Second := Wrk_Out.Second - 1;]]>
</Line>
<Line Number="74">
<![CDATA[	End_If;]]>
</Line>
<Line Number="75">
<![CDATA[	If ( Wrk_Out.Second = -60 ) then]]>
</Line>
<Line Number="76">
<![CDATA[		Wrk_Out.Second := 0;]]>
</Line>
<Line Number="77">
<![CDATA[		Wrk_Out.Minute := Wrk_Out.Minute - 1;]]>
</Line>
<Line Number="78">
<![CDATA[	End_If;]]>
</Line>
<Line Number="79">
<![CDATA[	If ( Wrk_Out.Minute = -60 ) then]]>
</Line>
<Line Number="80">
<![CDATA[		Wrk_Out.Minute := 0;]]>
</Line>
<Line Number="81">
<![CDATA[		Wrk_Out.Hour := Wrk_Out.Hour - 1;]]>
</Line>
<Line Number="82">
<![CDATA[	End_If;]]>
</Line>
<Line Number="83">
<![CDATA[	If ( Wrk_Out.Hour = -24 ) then]]>
</Line>
<Line Number="84">
<![CDATA[		Wrk_Out.Hour := 0;]]>
</Line>
<Line Number="85">
<![CDATA[		Wrk_Out.Day := Wrk_Out.Day - 1;]]>
</Line>
<Line Number="86">
<![CDATA[	End_If;]]>
</Line>
<Line Number="87">
<![CDATA[End_If;]]>
</Line>
<Line Number="88">
<![CDATA[]]>
</Line>
<Line Number="89">
<![CDATA[// Copy the final numbers to the Output tag]]>
</Line>
<Line Number="90">
<![CDATA[]]>
</Line>
<Line Number="91">
<![CDATA[Ref_Out.Day := Wrk_Out.Day;]]>
</Line>
<Line Number="92">
<![CDATA[Ref_Out.Hour := Wrk_Out.Hour;]]>
</Line>
<Line Number="93">
<![CDATA[Ref_Out.Minute := Wrk_Out.Minute;]]>
</Line>
<Line Number="94">
<![CDATA[Ref_Out.Second := Wrk_Out.Second;]]>
</Line>
<Line Number="95">
<![CDATA[Ref_Out.uSec := Wrk_Out.uSec;]]>
</Line>
<Line Number="96">
<![CDATA[]]>
</Line>
<Line Number="97">
<![CDATA[// No Months]]>
</Line>
<Line Number="98">
<![CDATA[Ref_Out.Month := 0;]]>
</Line>
<Line Number="99">
<![CDATA[// No Years]]>
</Line>
<Line Number="100">
<![CDATA[Ref_Out.Year := 0;]]>
</Line>
<Line Number="101">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AOI_SNTP_QUERY" Class="Standard" Revision="1.0" Vendor="Rockwell Automation" ExecutePrescan="true" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2007-12-05T21:22:05.788Z" CreatedBy="RSBKYER3\bkyer" EditedDate="2014-04-02T15:31:19.017Z" EditedBy="RA-INT\BKYER"
 SoftwareRevision="v20.01">
<Description>
<![CDATA[SNTP Query and Clock Sync Instruction]]>
</Description>
<RevisionNote>
<![CDATA[Revision 1.0]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Enable_Instruction" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Trigger_Update_Now" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sync_Controller_Clock" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[1]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</DefaultData>
</Parameter>
<Parameter Name="Enet_Slot_Number" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Query_Interval_in_Min" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Defines how often to poll the SNT server for time. Units in minutes.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[3600]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="3600"/>
</DefaultData>
</Parameter>
<Parameter Name="Query_Error_Retry_in_Min" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Next_Query_in_Min" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Show how many seconds left until the next SNT query.]]>
</Description>
<DefaultData Format="L5K">
<![CDATA[0.00000000e+000]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
